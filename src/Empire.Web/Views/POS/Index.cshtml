    function displayInventoryResults(items) {
        const container = $('#inventoryResults');
        container.empty();
        
        if (items.length === 0) {
            container.html(`
                <div class="text-center text-muted py-4">
                    <i class="fas fa-inbox" style="font-size: 48px; opacity: 0.3;"></i>
                    <p class="mt-2">No inventory items found</p>
                </div>
            `);
            return;
        }
        
        const resultsHtml = '<div class="row">';
        container.append(resultsHtml);
        
        items.forEach(function(item, index) {
            const itemId = 'inv_' + item.id + '_' + index;
            const stock = item.stock || 0;
            const price = parseFloat(item.price || 0).toFixed(2);
            
            const card = $(`
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="card-title mb-0">${item.name}</h6>
                                <span class="badge bg-success">Stock: ${stock}</span>
                            </div>
                            <p class="card-text small text-muted mb-2">
                                ${item.description || ''}
                                ${item.sku ? '<br><strong>SKU:</strong> ' + item.sku : ''}
                            </p>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small mb-1">Quantity</label>
                                    <input type="number" class="form-control form-control-sm qty-input" 
                                           id="qty_${itemId}" 
                                           value="1" 
                                           min="1" 
                                           data-max="${stock}">
                                    <small class="text-muted">Max: ${stock}</small>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-1">Price</label>
                                    <input type="number" class="form-control form-control-sm" 
                                           id="price_${itemId}" 
                                           value="${price}" 
                                           min="0" 
                                           step="0.01">
                                </div>
                            </div>
                            <button class="btn btn-success btn-sm w-100" 
                                    onclick="addInventoryItemToCart('${itemId}', ${item.id}, '${item.name.replace(/'/g, "\\'")}',' ${item.description ? item.description.replace(/'/g, "\\'"): ''}', '${item.sku || ''}')">
                                <i class="fas fa-cart-plus me-1"></i>Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            `);
            
            // Add validation on quantity input change
            card.find('#qty_' + itemId).on('input change', function() {
                const val = parseInt($(this).val());
                const max = parseInt($(this).attr('data-max'));
                
                if (val > max) {
                    $(this).val(max);
                    alert('Quantity cannot exceed available stock (' + max + ')');
                } else if (val < 1) {
                    $(this).val(1);
                }
            });
            
            container.append(card);
        });
    }
    
    function addInventoryItemToCart(itemId, inventoryId, name, description, sku) {
        const qtyInput = $('#qty_' + itemId);
        const priceInput = $('#price_' + itemId);
        
        const quantity = parseInt(qtyInput.val());
        const price = parseFloat(priceInput.val());
        const maxQty = parseInt(qtyInput.attr('data-max'));
        
        // Validation
        if (!quantity || quantity < 1) {
            alert('Please enter a valid quantity (minimum 1)');
            qtyInput.focus();
            return;
        }
        
        if (quantity > maxQty) {
            alert('Quantity cannot exceed available stock (' + maxQty + ')');
            qtyInput.focus();
            return;
        }
        
        if (!price || price < 0) {
            alert('Please enter a valid price (minimum 0)');
            priceInput.focus();
            return;
        }
        
        // Add to cart
        addToCart({
            Id: 'inventory_' + inventoryId,
            Name: name,
            Description: description,
            Price: price,
            OriginalPrice: price,
            Type: 'Inventory',
            quantity: quantity,
            SKU: sku,
            Stock: maxQty,
            IsTaxable: true
        });
        
        // Show success message
        alert('Item added to cart successfully!');
        
        // Reset quantity to 1
        qtyInput.val(1);
        
        // Refresh inventory cart display
        displayInventoryCartItems();
    }
    
    function displayInventoryCartItems() {
        const inventoryItems = cart.filter(item => item.Type === 'Inventory');
        
        if (inventoryItems.length === 0) {
            $('#inventoryCartItems').hide();
            return;
        }
        
        $('#inventoryCartItems').show();
        const container = $('#inventoryCartItemsContainer');
        container.empty();
        
        inventoryItems.forEach(function(item, index) {
            // Find the actual cart index
            const cartIndex = cart.findIndex(c => c.Id === item.Id);
            
            const card = $(`
                <div class="card mb-2">
                    <div class="card-body p-3">
                        <div class="row align-items-center">
                            <div class="col-md-5">
                                <h6 class="mb-1">${item.Name}</h6>
                                <small class="text-muted">${item.Description || ''}</small>
                            </div>
                            <div class="col-md-2 text-center">
                                <small class="text-muted d-block">Quantity</small>
                                <strong>${item.quantity}</strong>
                            </div>
                            <div class="col-md-2 text-center">
                                <small class="text-muted d-block">Price</small>
                                <strong>$${parseFloat(item.Price).toFixed(2)}</strong>
                            </div>
                            <div class="col-md-2 text-center">
                                <small class="text-muted d-block">Total</small>
