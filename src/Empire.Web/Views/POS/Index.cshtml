    function showSearchTab() {
        currentFilter = 'search';
        $('.filter-tab').removeClass('active');
        $(`.filter-tab[data-type="search"]`).addClass('active');
        
        $('#productsContainer').hide();
        $('#customSaleContainer').hide();
        $('#searchContainer').show();
        $('#inventoryContainer').hide();
        $('#deviceSearchContainer').hide();
    }
    
    function performSearch() {
        const searchType = $('#searchType').val();
        const searchKeyword = $('#searchKeyword').val();
        
        if (!searchKeyword || searchKeyword.trim() === '') {
            alert('Please enter a search keyword');
            return;
        }
        
        const resultsContainer = $('#searchResults');
        resultsContainer.html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin"></i> Searching database...</div>');
        
        // Search database
        $.ajax({
            url: '@Url.Action("SearchItemsTab", "POS")',
            method: 'GET',
            data: {
                type: searchType,
                keyword: searchKeyword
            },
            success: function(response) {
                if (response.success && response.data && response.data.length > 0) {
                    displaySearchResults(response.data);
                } else {
                    resultsContainer.html(`
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-inbox" style="font-size: 48px; opacity: 0.3;"></i>
                            <p class="mt-2">No items found matching your search</p>
                        </div>
                    `);
                }
            },
            error: function(xhr, status, error) {
                console.error('Search error:', xhr.responseText);
                const errorMsg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : error;
                resultsContainer.html(`
                    <div class="text-center text-danger py-4">
                        <i class="fas fa-exclamation-triangle" style="font-size: 48px;"></i>
                        <p class="mt-2">Error searching database</p>
                        <small>${errorMsg}</small>
                        <br><small class="text-muted">Check console for details</small>
                    </div>
                `);
            }
        });
    }
    
    function displaySearchResults(items) {
        const container = $('#searchResults');
        container.empty();
        
        items.forEach(function(item) {
            const card = $(`
                <div class="product-card">
                    <div class="product-info">
                        <div class="product-name">${item.name}</div>
                        <div class="product-description">${item.description || ''}</div>
                        <div class="product-meta">
                            <span class="badge bg-primary">${item.type}</span>
                            ${item.sku ? '<span class="text-muted">SKU: ' + item.sku + '</span>' : ''}
                        </div>
                    </div>
                    <div class="product-footer">
                        <div class="product-price">$${(parseFloat(item.price) || 0).toFixed(2)}</div>
                        <button class="btn btn-sm btn-success add-search-item-btn" data-item='${JSON.stringify(item)}'>
                            <i class="fas fa-cart-plus"></i> Add
                        </button>
                    </div>
                </div>
            `);
            
            container.append(card);
        });
        
        // Attach click handlers to add buttons
        $('.add-search-item-btn').off('click').on('click', function() {
            const itemData = JSON.parse($(this).attr('data-item'));
            addToCart({
                Id: `${itemData.type.toLowerCase()}_${itemData.id}`,
                Name: itemData.name,
                Description: itemData.description || '',
                Price: parseFloat(itemData.price),
                OriginalPrice: parseFloat(itemData.price),
                Type: itemData.type,
                quantity: 1,
                ReferenceId: itemData.id
            });
            alert('Item added to cart!');
        });
    }
    
    function addSearchResultToCart(itemId, itemType) {
        // Fetch item details and add to cart
        $.ajax({
            url: '@Url.Action("GetItemDetails", "POS")',
            method: 'GET',
            data: {
                id: itemId,
                type: itemType
            },
            success: function(response) {
                console.log('GetItemDetails response:', response);
                if (response.success && response.data) {
                    const item = response.data;
                    try {
                        addToCart({
                            Id: item.id,
                            Name: item.name,
                            Description: item.description,
                            Price: parseFloat(item.price),
                            OriginalPrice: parseFloat(item.price),
                            Type: item.type,
                            quantity: 1
                        });
                        
                        // Show success message
                        alert('Item added to cart!');
                    } catch (error) {
                        console.error('Error in addToCart:', error);
                        alert('Error adding item to cart: ' + error.message);
                    }
                } else {
                    console.error('Invalid response:', response);
                    const errorMsg = response.message || 'Unknown error';
                    alert('Error adding item to cart: ' + errorMsg);
                }
            },
            error: function(xhr, status, error) {
                console.error('AJAX error fetching item details:', {
                    status: status,
                    error: error,
                    responseText: xhr.responseText,
                    response: xhr.responseJSON
                });
                const errorMsg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : error;
                alert('Error fetching item details: ' + errorMsg + '\nCheck console for details');
            }
        });
    }
    
    function displayCartItems(filterType) {
        const container = $('#productsContainer');
        container.empty();
        
        // Filter cart items by type
        let filteredItems = cart;
        if (filterType) {
            filteredItems = cart.filter(item => {
                const itemType = item.Type.toLowerCase();
                return itemType === filterType.toLowerCase();
            });
        }
        
        if (filteredItems.length === 0) {
            container.html(`
                <div class="no-products">
                    <i class="fas fa-shopping-cart"></i>
                    <p>${filterType ? 'No ' + filterType + ' items in cart' : 'Cart is empty'}</p>
                    <small>Add items to cart to see them here</small>
                </div>
            `);
            return;
        }
        
        // Display filtered cart items
        filteredItems.forEach(function(item) {
            // Find the actual index in the cart array
            const cartIndex = cart.findIndex(cartItem => cartItem.Id === item.Id);
            
            const card = $(`
                <div class="product-card">
                    <div class="product-info">
                        <div class="product-name">${item.Name}</div>
                        <div class="product-description">${item.Description || ''}</div>
                        <div class="product-meta">
                            <span class="badge bg-info">${item.Type}</span>
                            <span class="text-muted">Qty: ${item.quantity}</span>
                        </div>
                    </div>
                    <div class="product-footer">
                        <div class="product-price">$${(item.Price || 0).toFixed(2)}</div>
                        <button class="btn btn-sm btn-danger" onclick="removeFromCartAndRefresh(${cartIndex})">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>
                </div>
