    function clearDeviceFilters() {
        $('#deviceBrand').val('');
        $('#deviceCategory').val('');
        $('#deviceModel').val('');
        $('#deviceNetwork').val('');
        $('#deviceGB').val('');
        $('#deviceScratches').val('');
        $('#deviceIMEI').val('');
        
        // Clear models dropdown
        $('#deviceModel').empty();
        $('#deviceModel').append('<option value="">All Models</option>');
        
        // Clear results
        $('#deviceResults').html(`
            <div class="text-center text-muted py-4">
                <i class="fas fa-mobile-alt" style="font-size: 48px; opacity: 0.3;"></i>
                <p class="mt-2">Select filters and click "Search Devices" to find items</p>
            </div>
        `);
        
        // Clear cart display
        displayDeviceCartItems();
    }
    
    // Search Results Modal Functions
    function showSearchResultsModal(results, searchType) {
        const modalBody = $('#searchResultsModalBody');
        modalBody.empty();
        
        if (!results || results.length === 0) {
            modalBody.html('<p class="text-center text-muted">No results found</p>');
        } else {
            const resultHtml = results.map(item => createSearchResultCard(item, searchType)).join('');
            modalBody.html(resultHtml);
        }
        
        $('#searchResultsModal').modal('show');
    }
    
    function createSearchResultCard(item, type) {
        let cardHtml = '';
        
        if (type === 'Device') {
            cardHtml = `
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="mb-1">${item.Name || 'Device'}</h6>
                                <p class="mb-1 small text-muted">
                                    <strong>IMEI:</strong> ${item.IMEI || 'N/A'} | 
                                    <strong>Model:</strong> ${item.Model || 'N/A'} |
                                    <strong>Condition:</strong> ${item.Condition || 'N/A'}
                                </p>
                                <p class="mb-0"><strong class="text-success">$${(item.Price || 0).toFixed(2)}</strong></p>
                            </div>
                            <div class="col-md-4 text-end">
                                <button class="btn btn-primary btn-sm" onclick="addSearchResultToCart('${item.Id}', 'Device')">
                                    <i class="fas fa-cart-plus me-1"></i>Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        } else if (type === 'Repair') {
            cardHtml = `
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="mb-1">Repair #${item.RepairNumber || item.Id}</h6>
                                <p class="mb-1 small text-muted">
                                    <strong>Device:</strong> ${item.DeviceName || 'N/A'} |
                                    <strong>Issue:</strong> ${item.Issue || 'N/A'}
                                </p>
                                <p class="mb-0"><strong class="text-success">$${(item.Price || item.Cost || 0).toFixed(2)}</strong></p>
                            </div>
                            <div class="col-md-4 text-end">
                                <button class="btn btn-primary btn-sm" onclick="addSearchResultToCart('${item.Id}', 'Repair')">
                                    <i class="fas fa-cart-plus me-1"></i>Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        } else { // Inventory
            cardHtml = `
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="mb-1">${item.Name || 'Item'}</h6>
                                <p class="mb-1 small text-muted">
                                    <strong>SKU:</strong> ${item.SKU || 'N/A'} |
                                    <strong>Brand:</strong> ${item.Brand || 'N/A'} |
                                    <strong>Stock:</strong> ${item.Stock || 0}
                                </p>
                                <p class="mb-0"><strong class="text-success">$${(item.Price || 0).toFixed(2)}</strong></p>
                            </div>
                            <div class="col-md-4 text-end">
                                <button class="btn btn-primary btn-sm" onclick="addSearchResultToCart('${item.Id}', 'Inventory')">
                                    <i class="fas fa-cart-plus me-1"></i>Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }
        
        return cardHtml;
    }
    
    function addSearchResultToCart(itemId, itemType) {
        // Find the item in the products array or fetch it
        $.ajax({
            url: '@Url.Action("SearchItemsTab", "POS")',
            type: 'GET',
            data: { query: itemId, type: itemType },
            success: function(response) {
                if (response.success && response.data && response.data.length > 0) {
                    const product = response.data[0];
                    addToCart(product);
                    $('#searchResultsModal').modal('hide');
                    alert('Item added to cart!');
                } else {
                    alert('Error: Item not found');
                }
            },
            error: function(xhr) {
                console.error('Error adding item:', xhr);
                alert('Error adding item to cart');
            }
        });
    }
    
    // Listen for messages from iframes when items are created
    window.addEventListener('message', function(event) {
        if (event.data.type === 'itemCreated') {
            // Close the modal
            $('.modal').modal('hide');
            // Show success message
            alert(event.data.message || 'Item created successfully!');
            // Refresh the entire page to show the new item
            location.reload();
        }
    });
</script>

@* Include shared invoice edit modal *@
@await Html.PartialAsync("_InvoiceEditModal")
}
