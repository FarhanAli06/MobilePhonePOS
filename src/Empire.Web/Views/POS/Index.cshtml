@{
    ViewData["Title"] = "Point of Sale";
}

<!-- Include Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<style>
    .pos-container {
        height: calc(100vh - 100px);
        overflow: hidden;
    }
    
    .pos-search-section {
        background: #f8f9fa;
        padding: 20px;
        border-bottom: 2px solid #dee2e6;
    }
    
    .pos-main-content {
        display: flex;
        height: calc(100% - 120px);
    }
    
    .pos-products-section {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        border-right: 2px solid #dee2e6;
    }
    
    .pos-cart-section {
        width: 450px;
        display: flex;
        flex-direction: column;
        background: #f8f9fa;
    }
    
    .cart-header {
        padding: 20px;
        border-bottom: 2px solid #dee2e6;
    }
    
    .cart-items {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
    }
    
    .cart-item {
        background: white;
        padding: 15px;
        margin-bottom: 10px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
        position: relative;
    }
    
    .cart-item-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 10px;
    }
    
    .cart-item-name {
        font-weight: 600;
        font-size: 14px;
        flex: 1;
    }
    
    .cart-item-remove {
        color: #dc3545;
        cursor: pointer;
        font-size: 18px;
        margin-left: 10px;
        transition: all 0.2s;
    }
    
    .cart-item-remove:hover {
        color: #a71d2a;
        transform: scale(1.2);
    }
    
    .cart-item-details {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
    }
    
    .cart-item-quantity {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .qty-btn {
        width: 30px;
        height: 30px;
        border: 1px solid #dee2e6;
        background: white;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
    }
    
    .qty-btn:hover {
        background: #e9ecef;
    }
    
    .cart-item-price {
        font-size: 16px;
        font-weight: 600;
        color: #28a745;
    }
    
    .price-input {
        width: 100px;
        text-align: right;
        font-weight: 600;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 5px;
    }
    
    .price-input:focus {
        outline: none;
        border-color: #007bff;
    }
    
    .cart-summary {
        padding: 20px;
        border-top: 2px solid #dee2e6;
        background: white;
    }
    
    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 14px;
    }
    
    .summary-row.total {
        font-size: 20px;
        font-weight: bold;
        color: #28a745;
        padding-top: 10px;
        border-top: 2px solid #dee2e6;
    }
    
    .summary-row.balance {
        font-size: 16px;
        font-weight: bold;
        color: #dc3545;
        padding-top: 5px;
    }
    
    .product-card {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 15px;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .product-card:hover {
        border-color: #007bff;
        box-shadow: 0 2px 8px rgba(0,123,255,0.2);
    }
    
    .product-card-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 10px;
    }
    
    .product-name {
        font-weight: 600;
        font-size: 16px;
        color: #212529;
    }
    
    .product-type-badge {
        font-size: 11px;
        padding: 4px 8px;
    }
    
    .product-description {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 10px;
    }
    
    .product-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .product-price {
        font-size: 18px;
        font-weight: 700;
        color: #28a745;
    }
    
    .product-stock {
        font-size: 12px;
        color: #6c757d;
    }
    
    .filter-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
        flex-wrap: wrap;
    }
    
    .filter-tab {
        padding: 8px 16px;
        border: 1px solid #dee2e6;
        background: white;
        border-radius: 20px;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s;
    }
    
    .filter-tab:hover {
        background: #e9ecef;
    }
    
    .filter-tab.active {
        background: #007bff;
        color: white;
        border-color: #007bff;
    }
    
    .add-new-btns {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
    }
    
    .add-new-btn {
        flex: 1;
        padding: 10px;
        border: 2px dashed #007bff;
        background: #f8f9fa;
        border-radius: 8px;
        cursor: pointer;
        text-align: center;
        transition: all 0.2s;
        color: #007bff;
        font-weight: 600;
    }
    
    .add-new-btn:hover {
        background: #e7f1ff;
        border-color: #0056b3;
    }
    
    .empty-cart {
        text-align: center;
        padding: 40px 20px;
        color: #6c757d;
    }
    
    .empty-cart i {
        font-size: 48px;
        margin-bottom: 15px;
        opacity: 0.5;
    }
    
    .no-products {
        text-align: center;
        padding: 40px 20px;
        color: #6c757d;
    }
    
    /* Select2 customization */
    .select2-container--bootstrap-5 .select2-selection {
        min-height: 46px;
        padding: 8px;
    }
    
    .payment-amount-input {
        display: none;
    }
    
    .payment-amount-input.show {
        display: block;
    }
    
    /* Invoice styles */
    #invoicePrintArea {
        font-family: Arial, sans-serif;
        padding: 20px;
    }
    
    #invoicePrintArea .invoice-header {
        text-align: center;
        margin-bottom: 30px;
        border-bottom: 2px solid #000;
        padding-bottom: 20px;
    }
    
    #invoicePrintArea .invoice-header h1 {
        margin: 0;
        font-size: 28px;
    }
    
    #invoicePrintArea .invoice-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
    }
    
    #invoicePrintArea .invoice-info div {
        flex: 1;
    }
    
    #invoicePrintArea table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
    }
    
    #invoicePrintArea th,
    #invoicePrintArea td {
        padding: 10px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }
    
    #invoicePrintArea th {
        background-color: #f8f9fa;
        font-weight: bold;
    }
    
    #invoicePrintArea .text-right {
        text-align: right;
    }
    
    #invoicePrintArea .totals {
        margin-top: 20px;
        text-align: right;
    }
    
    #invoicePrintArea .totals div {
        margin: 5px 0;
    }
    
    #invoicePrintArea .total-row {
        font-size: 18px;
        font-weight: bold;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 2px solid #000;
    }
    
    #invoicePrintArea .footer {
        margin-top: 40px;
        text-align: center;
        font-size: 12px;
        color: #666;
    }
    
    /* Print styles */
    @@media print {
        .no-print {
            display: none !important;
        }
        
        #invoicePrintArea {
            display: block !important;
        }
        
        body > *:not(#invoicePrintArea) {
            display: none !important;
        }
    }
</style>

<div class="pos-container">
    <!-- Search Section -->
    <div class="pos-search-section">
        <div class="row g-3">
            <div class="col-12">
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" id="searchInput" placeholder="Search by name, IMEI, repair number, invoice number..." autocomplete="off">
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="pos-main-content">
        <!-- Products Section -->
        <div class="pos-products-section">
            <!-- Add New Buttons -->
            <div class="add-new-btns">
                <div class="add-new-btn" onclick="showAddRepairModal()">
                    <i class="fas fa-wrench me-2"></i>New Repair
                </div>
                <div class="add-new-btn" onclick="showAddDeviceModal()">
                    <i class="fas fa-mobile-alt me-2"></i>New Device
                </div>
                <div class="add-new-btn" onclick="showAddInventoryModal()">
                    <i class="fas fa-box me-2"></i>New Inventory
                </div>
            </div>
            
            <div class="filter-tabs">
                <button class="filter-tab active" data-type="" onclick="filterByType('')">
                    <i class="fas fa-th me-1"></i> All Items
                </button>
                <button class="filter-tab" data-type="device" onclick="filterByType('device')">
                    <i class="fas fa-mobile-alt me-1"></i> Devices
                </button>
                <button class="filter-tab" data-type="inventory" onclick="filterByType('inventory')">
                    <i class="fas fa-box me-1"></i> Inventory
                </button>
                <button class="filter-tab" data-type="repair" onclick="filterByType('repair')">
                    <i class="fas fa-wrench me-1"></i> Repairs
                </button>
                <button class="filter-tab" data-type="custom" onclick="showCustomSaleTab()">
                    <i class="fas fa-plus me-1"></i> Custom Sale
                </button>
                <button class="filter-tab" data-type="search" onclick="showSearchTab()">
                    <i class="fas fa-search me-1"></i> Search
                </button>
            </div>

            <div id="productsContainer">
                <div class="no-products">
                    <i class="fas fa-search"></i>
                    <p>Search for products to add to cart</p>
                </div>
            </div>
            
            <!-- Custom Sale Tab Content -->
            <div id="customSaleContainer" style="display: none; padding: 20px; background: white; border-radius: 8px;">
                <h4 class="mb-4">Add Custom Sale Item</h4>
                <div class="mb-3">
                    <label for="customItemName" class="form-label">Item Name</label>
                    <input type="text" class="form-control" id="customItemName" placeholder="e.g., Screen Protector Installation" required>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="customItemQuantity" class="form-label">Quantity</label>
                        <input type="number" class="form-control" id="customItemQuantity" value="1" min="1" required>
                    </div>
                    <div class="col-md-6">
                        <label for="customItemPrice" class="form-label">Price</label>
                        <input type="number" class="form-control" id="customItemPrice" step="0.01" min="0" value="0.00" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="customItemNote" class="form-label">Note (Optional)</label>
                    <textarea class="form-control" id="customItemNote" rows="2"></textarea>
                </div>
                <button class="btn btn-primary w-100" onclick="addCustomItemToCart()">
                    <i class="fas fa-cart-plus me-2"></i>Add to Cart
                </button>
            </div>
            
            <!-- Inventory Tab Content -->
            <div id="inventoryContainer" style="display: none; padding: 20px; background: white; border-radius: 8px;">
                <h4 class="mb-4"><i class="fas fa-box me-2"></i>Search Inventory</h4>
                
                <!-- Inventory Search Filters -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label for="inventoryBrand" class="form-label small mb-1">Brand</label>
                        <select class="form-select form-select-sm" id="inventoryBrand" onchange="onInventoryBrandChange()">
                            <option value="">All Brands</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="inventoryDeviceCategory" class="form-label small mb-1">Device Category</label>
                        <select class="form-select form-select-sm" id="inventoryDeviceCategory" onchange="onInventoryDeviceCategoryChange()">
                            <option value="">All Device Categories</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="inventoryModel" class="form-label small mb-1">Model</label>
                        <select class="form-select form-select-sm" id="inventoryModel">
                            <option value="">All Models</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="inventoryCategory" class="form-label small mb-1">Inventory Category</label>
                        <select class="form-select form-select-sm" id="inventoryCategory">
                            <option value="">All Categories</option>
                        </select>
                    </div>
                </div>
                
                <div class="row mb-4">
                    <div class="col-md-12">
                        <button class="btn btn-primary btn-sm" onclick="searchInventoryItems()">
                            <i class="fas fa-search me-2"></i>Search Inventory
                        </button>
                        <button class="btn btn-secondary btn-sm ms-2" onclick="clearInventoryFilters()">
                            <i class="fas fa-times me-2"></i>Clear Filters
                        </button>
                    </div>
                </div>
                
                <!-- Inventory Search Results -->
                <div id="inventoryResults">
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-box" style="font-size: 48px; opacity: 0.3;"></i>
                        <p class="mt-2">Select filters and click "Search Inventory" to find items</p>
                    </div>
                </div>
                
                <!-- Cart Items in Inventory Tab -->
                <div id="inventoryCartItems" style="margin-top: 30px; display: none;">
                    <h5 class="mb-3"><i class="fas fa-shopping-cart me-2"></i>Items in Cart</h5>
                    <div id="inventoryCartItemsContainer"></div>
                </div>
            </div>
            
            <!-- Device Tab Search Container -->
            <div id="deviceSearchContainer" style="display: none; padding: 20px; background: white; border-radius: 8px;">
                <h4 class="mb-4"><i class="fas fa-mobile-alt me-2"></i>Search Devices</h4>
                
                <!-- Device Search Filters -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label for="deviceBrand" class="form-label small mb-1">Brand</label>
                        <select class="form-select form-select-sm" id="deviceBrand" onchange="onDeviceBrandChange()">
                            <option value="">All Brands</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="deviceCategory" class="form-label small mb-1">Device Category</label>
                        <select class="form-select form-select-sm" id="deviceCategory" onchange="onDeviceCategoryChange()">
                            <option value="">All Categories</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="deviceModel" class="form-label small mb-1">Model</label>
                        <select class="form-select form-select-sm" id="deviceModel">
                            <option value="">All Models</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="deviceNetwork" class="form-label small mb-1">Network</label>
                        <select class="form-select form-select-sm" id="deviceNetwork">
                            <option value="">All Networks</option>
                            <option value="Unlocked">Unlocked</option>
                            <option value="AT&T">AT&T</option>
                            <option value="T-Mobile">T-Mobile</option>
                            <option value="Verizon">Verizon</option>
                            <option value="Sprint">Sprint</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label for="deviceGB" class="form-label small mb-1">Storage (GB)</label>
                        <select class="form-select form-select-sm" id="deviceGB">
                            <option value="">All Storage</option>
                            <option value="16">16 GB</option>
                            <option value="32">32 GB</option>
                            <option value="64">64 GB</option>
                            <option value="128">128 GB</option>
                            <option value="256">256 GB</option>
                            <option value="512">512 GB</option>
                            <option value="1024">1 TB</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="deviceScratches" class="form-label small mb-1">Scratches</label>
                        <select class="form-select form-select-sm" id="deviceScratches">
                            <option value="">All Conditions</option>
                            <option value="None">None</option>
                            <option value="Light">Light</option>
                            <option value="Moderate">Moderate</option>
                            <option value="Heavy">Heavy</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="deviceIMEI" class="form-label small mb-1">IMEI Number</label>
                        <input type="text" class="form-control form-control-sm" id="deviceIMEI" placeholder="Enter IMEI number...">
                    </div>
                </div>
                
                <div class="row mb-4">
                    <div class="col-md-12">
                        <button class="btn btn-primary btn-sm" onclick="searchDeviceItems()">
                            <i class="fas fa-search me-2"></i>Search Devices
                        </button>
                        <button class="btn btn-secondary btn-sm ms-2" onclick="clearDeviceFilters()">
                            <i class="fas fa-times me-2"></i>Clear Filters
                        </button>
                    </div>
                </div>
                
                <!-- Device Search Results -->
                <div id="deviceResults">
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-mobile-alt" style="font-size: 48px; opacity: 0.3;"></i>
                        <p class="mt-2">Select filters and click "Search Devices" to find items</p>
                    </div>
                </div>
                
                <!-- Cart Items in Device Tab -->
                <div id="deviceCartItems" style="margin-top: 30px; display: none;">
                    <h5 class="mb-3"><i class="fas fa-shopping-cart me-2"></i>Items in Cart</h5>
                    <div id="deviceCartItemsContainer"></div>
                </div>
            </div>
            
            <!-- Search Tab Content -->
            <div id="searchContainer" style="display: none; padding: 20px; background: white; border-radius: 8px;">
                <h4 class="mb-4"><i class="fas fa-search me-2"></i>Search Items</h4>
                
                <!-- Search Filters -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label for="searchType" class="form-label small mb-1">Item Type</label>
                        <select class="form-select form-select-sm" id="searchType">
                            <option value="">All Types</option>
                            <option value="Inventory">Inventory</option>
                            <option value="Repair">Repairs</option>
                            <option value="Device">Devices</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="searchKeyword" class="form-label small mb-1">Keyword</label>
                        <input type="text" class="form-control form-control-sm" id="searchKeyword" placeholder="Name, SKU, Barcode...">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1">&nbsp;</label>
                        <button class="btn btn-primary btn-sm w-100" onclick="performSearch()">
                            <i class="fas fa-search me-2"></i>Search Database
                        </button>
                    </div>
                </div>
                
                <!-- Search Results -->
                <div id="searchResults">
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-search" style="font-size: 48px; opacity: 0.3;"></i>
                        <p class="mt-2">Enter search criteria and click "Search Database"</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cart Section -->
        <div class="pos-cart-section">
            <div class="cart-header">
                <h4 class="mb-0">
                    <i class="fas fa-shopping-cart me-2"></i>Shopping Cart
                    <span class="badge bg-primary ms-2" id="cartCount">0</span>
                </h4>
            </div>

            <div class="cart-items" id="cartItems" style="overflow-x: auto; max-height: 400px;">
                <table id="cartTable" class="table table-sm table-hover" style="display: none;">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="cartTableBody">
                    </tbody>
                </table>
                <div class="empty-cart" id="emptyCartMessage">
                    <i class="fas fa-shopping-cart"></i>
                    <p>Cart is empty<br><small>Add items to get started</small></p>
                </div>
            </div>

            <div class="cart-summary" style="padding: 0.5rem 0;">
                <div class="summary-row" style="font-size: 0.9rem; padding: 0.25rem 0;">
                    <span>Subtotal:</span>
                    <span id="subtotal">$0.00</span>
                </div>
                <div class="summary-row" style="font-size: 0.9rem; padding: 0.25rem 0;">
                    <span>Tax (0%):</span>
                    <span id="tax">$0.00</span>
                </div>
                <div class="summary-row" style="font-size: 0.9rem; padding: 0.25rem 0;">
                    <span>Discount:</span>
                    <span id="discount">$0.00</span>
                </div>
                <div class="summary-row total" style="padding: 0.5rem 0;">
                    <span>Total:</span>
                    <span id="total">$0.00</span>
                </div>
                <div class="summary-row balance" id="balanceRow" style="display: none; padding: 0.25rem 0; font-size: 0.9rem;">
                    <span>Balance Due:</span>
                    <span id="balance">$0.00</span>
                </div>
                
                <div class="mt-2">
                    <!-- Customer Select -->
                    <label class="form-label small mb-1">Customer *</label>
                    <div class="d-flex gap-2 mb-2">
                        <select class="form-select form-select-sm" id="customerSelect" style="flex: 1;">
                            <option value="">Select Customer</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addNewCustomerModal" title="Add New Customer">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                    
                    <!-- Payment Type -->
                    <label class="form-label small mb-1">Payment Type *</label>
                    <select class="form-select form-select-sm mb-2 no-select2" id="paymentType">
                        <option value="full">Full Payment</option>
                        <option value="partial">Partial Payment</option>
                    </select>
                    
                    <!-- Payment Method -->
                    <label class="form-label small mb-1">Payment Method *</label>
                    <select class="form-select form-select-sm mb-2 no-select2" id="paymentMethod">
                        <option value="Cash">Cash</option>
                        <option value="Card">Card</option>
                        <option value="Check">Check</option>
                        <option value="Zelle">Zelle</option>
                        <option value="Venmo">Venmo</option>
                        <option value="Other">Other</option>
                    </select>
                    
                    <!-- Partial Payment Details -->
                    <div class="payment-amount-input" id="paymentAmountContainer">
                        <label class="form-label small mb-1">Amount Paid *</label>
                        <input type="number" class="form-control form-control-sm mb-2" id="paymentAmount" step="0.01" min="0" placeholder="0.00">
                        
                        <label class="form-label small mb-1">Balance</label>
                        <input type="text" class="form-control form-control-sm mb-2" id="remainingBalance" readonly placeholder="$0.00" style="background-color: #f8f9fa; font-weight: 600;">
                        
                        <!-- Second Payment Method -->
