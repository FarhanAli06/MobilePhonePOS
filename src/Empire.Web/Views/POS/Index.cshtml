    function filterByType(type) {
        currentFilter = type;
        
        // Update active tab
        $('.filter-tab').removeClass('active');
        $(`.filter-tab[data-type="${type}"]`).addClass('active');
        
        // Show inventory search container for inventory tab
        if (type === 'inventory') {
            $('#productsContainer').hide();
            $('#customSaleContainer').hide();
            $('#searchContainer').hide();
            $('#inventoryContainer').show();
            $('#deviceSearchContainer').hide();
            
            // Load dropdowns if not already loaded
            if ($('#inventoryBrand option').length === 1) {
                loadInventoryDropdowns();
            }
            
            // Display inventory cart items
            displayInventoryCartItems();
        } else if (type === 'device' || type === 'Device') {
            // Show device search container for device tab
            $('#productsContainer').hide();
            $('#customSaleContainer').hide();
            $('#searchContainer').hide();
            $('#inventoryContainer').hide();
            $('#deviceSearchContainer').show();
            
            // Load dropdowns if not already loaded
            if ($('#deviceBrand option').length === 1) {
                loadDeviceDropdowns();
            }
            
            // Display device cart items
            displayDeviceCartItems();
        } else {
            $('#productsContainer').show();
            $('#customSaleContainer').hide();
            $('#searchContainer').hide();
            $('#inventoryContainer').hide();
            $('#deviceSearchContainer').hide();
            
