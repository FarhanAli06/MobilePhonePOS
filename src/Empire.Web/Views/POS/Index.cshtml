    function addCustomItemToCart() {
        const name = $('#customItemName').val();
        const quantity = parseInt($('#customItemQuantity').val());
        const price = parseFloat($('#customItemPrice').val());
        const note = $('#customItemNote').val();

        if (!name || quantity <= 0 || price < 0) {
            alert('Please enter a valid item name, quantity, and price.');
            return;
        }

        const customItem = {
            Id: 'custom_' + Date.now(),
            Type: 'Custom',
            Name: name,
            Description: 'Custom Sale Item',
            Price: price,
            OriginalPrice: price,
            quantity: quantity,
            Note: note,
            ReferenceId: null
        };

        cart.push(customItem);
        updateCart();

        // Reset form
        $('#customItemName').val('');
        $('#customItemQuantity').val('1');
        $('#customItemPrice').val('0.00');
        $('#customItemNote').val('');
        
        filterByType('');
    }

    function addToCart(product) {
        console.log('addToCart called with product:', product);
        // Check if item already in cart
        const existingIndex = cart.findIndex(item => item.Id === product.Id);
        
        if (existingIndex >= 0) {
            // Increase quantity for inventory items
            if (product.Type === 'Inventory') {
                cart[existingIndex].quantity++;
            } else {
                alert('This item is already in the cart');
                return;
            }
        } else {
            // Parse ReferenceId safely
            let referenceId = null;
            if (product.Id && typeof product.Id === 'string' && product.Id.includes('_')) {
                referenceId = parseInt(product.Id.split('_')[1]);
            } else if (typeof product.Id === 'number') {
                referenceId = product.Id;
            }
            
            // Ensure Name and Price are never undefined
            const itemName = product.Name || product.name || 'Unknown Item';
            const itemPrice = parseFloat(product.Price || product.price || 0);
            const itemDescription = product.Description || product.description || '';
            
            cart.push({
                Id: product.Id || `custom_${Date.now()}`,
                Type: product.Type || 'Custom',
                Name: itemName,
                Description: itemDescription,
                Price: itemPrice,
                OriginalPrice: itemPrice,
                quantity: product.quantity || 1,
                ReferenceId: referenceId,
                RepairId: product.RepairId || product.repairId || null,
                Note: product.Note || product.note || '',
                IsCustomItem: product.Type === 'Custom',
                IsTaxable: true
            });
        }

        updateCart();
        
        // Refresh the current tab display to show the newly added item
        if (currentFilter !== 'custom' && currentFilter !== 'search') {
            displayCartItems(currentFilter);
        }
    }

    function removeFromCart(index) {
        cart.splice(index, 1);
        updateCart();
        saveCartToStorage();
    }
    
    function removeFromCartAndRefresh(index) {
        cart.splice(index, 1);
        updateCart();
        saveCartToStorage();
        
        // Refresh the current tab display
        if (currentFilter !== 'custom' && currentFilter !== 'search') {
            displayCartItems(currentFilter);
        }
    }

    function updateQuantity(index, delta) {
        const item = cart[index];
        
        if (item.Type !== 'Inventory' && item.Type !== 'Custom') {
            alert('Quantity can only be changed for inventory items');
            return;
        }

        item.quantity += delta;
        
        if (item.quantity < 1) {
            item.quantity = 1;
        }

        updateCart();
    }

    function updatePrice(index, newPrice) {
        cart[index].Price = parseFloat(newPrice) || 0;
        updateCart();
    }

    function updateCart() {
        const tableBody = $('#cartTableBody');
        const emptyMessage = $('#emptyCartMessage');
        const cartTable = $('#cartTable');
        
        tableBody.empty();

        if (cart.length === 0) {
            cartTable.hide();
            emptyMessage.show();
            $('#cartCount').text('0');
        } else {
            emptyMessage.hide();
            cartTable.show();
            
            cart.forEach(function(item, index) {
                // Safety checks for undefined properties
                if (!item || typeof item !== 'object') {
                    console.error('Invalid cart item at index', index, item);
                    return;
                }
                
                // Ensure required properties exist
                item.Name = item.Name || 'Unknown Item';
                item.Description = item.Description || '';
                item.Price = parseFloat(item.Price) || 0;
                item.OriginalPrice = parseFloat(item.OriginalPrice) || item.Price;
                item.quantity = parseInt(item.quantity) || 1;
                item.Type = item.Type || 'Custom';
                
                const itemTotal = item.Price * item.quantity;
                const priceChanged = item.Price !== item.OriginalPrice;

                const row = $(`
                    <tr>
                        <td>
                            <strong>${item.Name}</strong><br>
                            <small class="text-muted">${item.Description || ''}</small>
                            ${priceChanged ? '<br><small class="text-warning">Price adjusted from $' + (item.OriginalPrice || 0).toFixed(2) + '</small>' : ''}
                        </td>
                        <td>
                            $<input type="number" class="form-control form-control-sm" style="width: 80px; display: inline-block;" 
                                value="${(item.Price || 0).toFixed(2)}" 
                                onchange="updatePrice(${index}, this.value)" 
                                step="0.01" min="0">
                        </td>
                        <td>
                            ${item.Type === 'Inventory' || item.Type === 'Custom' ? `
                                <div class="btn-group btn-group-sm" role="group">
                                    <button class="btn btn-outline-secondary" onclick="updateQuantity(${index}, -1)">-</button>
                                    <button class="btn btn-outline-secondary" disabled>${item.quantity}</button>
                                    <button class="btn btn-outline-secondary" onclick="updateQuantity(${index}, 1)">+</button>
                                </div>
                            ` : `<span class="badge bg-secondary">${item.quantity}</span>`}
                        </td>
                        <td><strong>$${itemTotal.toFixed(2)}</strong></td>
                        <td>
                            <button class="btn btn-sm btn-danger" onclick="removeFromCart(${index})" title="Remove">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `);

                tableBody.append(row);
            });

            $('#cartCount').text(cart.length);
        }

        updateSummary();
        saveCartToStorage();
    }

    function updateSummary() {
        const subtotal = cart.reduce((sum, item) => {
            const price = parseFloat(item.Price) || 0;
            const quantity = parseInt(item.quantity) || 1;
            return sum + (price * quantity);
        }, 0);
        const taxRate = 0;
        const tax = subtotal * taxRate;
        const discount = 0;
        const total = subtotal + tax - discount;

        $('#subtotal').text('$' + subtotal.toFixed(2));
        $('#tax').text('$' + tax.toFixed(2));
        $('#discount').text('$' + discount.toFixed(2));
        $('#total').text('$' + total.toFixed(2));
        
        // Handle partial payment balance
        const paymentType = $('#paymentType').val();
        if (paymentType === 'partial') {
            const paymentAmount = parseFloat($('#paymentAmount').val()) || 0;
            const balance = total - paymentAmount;
            $('#balance').text('$' + balance.toFixed(2));
            $('#remainingBalance').val('$' + balance.toFixed(2)); // Update textbox
            $('#balanceRow').show();
        } else {
            $('#balanceRow').hide();
            $('#remainingBalance').val('$0.00');
        }
    }

    function clearCart() {
        if (cart.length === 0) return;
        
        if (confirm('Are you sure you want to clear the cart?')) {
            cart = [];
            updateCart();
            saveCartToStorage();
            // Refresh the page to reset everything
            location.reload();
        }
    }

    function completeSale() {
        // Validation
        if (cart.length === 0) {
            alert('Cart is empty. Please add items first.');
            return;
        }

        const customerId = $('#customerSelect').val();
        if (!customerId) {
            alert('Please select a customer');
            $('#customerSelect').focus();
            return;
        }

        const paymentType = $('#paymentType').val();
        const paymentMethod = $('#paymentMethod').val();

        // Calculate totals
        const subtotal = cart.reduce((sum, item) => sum + (item.Price * item.quantity), 0);
        const taxAmount = 0;
        const discountAmount = 0;
        const totalAmount = subtotal + taxAmount - discountAmount;
        
        let paymentAmount = totalAmount;
        let paymentStatus = 'Paid';
        
        if (paymentType === 'partial') {
            paymentAmount = parseFloat($('#paymentAmount').val()) || 0;
            
            if (paymentAmount <= 0) {
                alert('Please enter a valid payment amount');
                $('#paymentAmount').focus();
                return;
            }
            
            if (paymentAmount > totalAmount) {
                alert('Payment amount cannot exceed total amount');
                $('#paymentAmount').focus();
                return;
            }
            
            paymentStatus = paymentAmount >= totalAmount ? 'Paid' : 'Partial';
            
            // Check if second payment method is selected for remaining balance
            const secondPaymentMethod = $('#secondPaymentMethod').val();
            if (paymentStatus === 'Partial' && secondPaymentMethod) {
                // User wants to pay remaining balance with second payment method
                const remainingAmount = totalAmount - paymentAmount;
                paymentStatus = 'Paid'; // Mark as paid since both payments cover the total
            }
        }

        // Prepare payments array
        const payments = [{
            Amount: paymentAmount,
            PaymentMethod: paymentMethod,
            TransactionId: ''
        }];
        
        // Add second payment if applicable
        if (paymentType === 'partial') {
            const secondPaymentMethod = $('#secondPaymentMethod').val();
            if (secondPaymentMethod) {
                const remainingAmount = totalAmount - paymentAmount;
                payments.push({
                    Amount: remainingAmount,
                    PaymentMethod: secondPaymentMethod,
                    TransactionId: ''
                });
            }
        }

        // Prepare sale data
        const saleData = {
            CustomerId: parseInt(customerId),
            Items: cart.map(item => ({
                ItemType: item.Type,
                ItemReferenceId: item.ReferenceId,
                RepairId: item.RepairId,
                InventoryItemId: item.Type === 'Inventory' ? item.ReferenceId : null,
                ItemName: item.Name,
                Description: item.Description,
                Quantity: item.quantity,
                UnitPrice: item.Price,
                TotalPrice: item.Price * item.quantity,
                DiscountAmount: 0,
                Note: item.Note || '',
                IsCustomItem: item.Type === 'Custom',
                IsTaxable: item.IsTaxable,
                OriginalPrice: item.OriginalPrice,
            })),
            SubTotal: subtotal,
            TaxAmount: taxAmount,
            DiscountAmount: discountAmount,
            TotalAmount: totalAmount,
            PaymentStatus: paymentStatus,
            Payments: payments
        };

        // Submit sale
        $.ajax({
            url: '@Url.Action("CompleteSale", "POS")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(saleData),
            success: function(response) {
                if (response.success) {
                    // Store sale data for printing (before clearing cart)
                    const secondPaymentMethodVal = $('#secondPaymentMethod').val();
                    let paymentMethodDisplay = paymentMethod;
                    if (secondPaymentMethodVal) {
                        paymentMethodDisplay = `${paymentMethod} ($${paymentAmount.toFixed(2)}) + ${secondPaymentMethodVal} ($${(totalAmount - paymentAmount).toFixed(2)})`;
                    }
                    
                    // Prepare sale data
                    const customer = $('#customerSelect').select2('data')[0];
                    const customerName = customer ? customer.text : 'Walk-in Customer';
                    
                    const saleData = {
                        items: Object.assign([], cart),
                        customerId: customerId,
                        customerName: customerName,
                        paymentMethod: paymentMethod,
                        paymentStatus: paymentStatus,
                        totalAmount: totalAmount,
                        paymentAmount: paymentAmount
                    };
                    
                    $('#invoiceNumber').text(response.invoiceNumber);
                    
                    // Save last invoice data for printing
                    lastInvoiceNumber = response.invoiceNumber;
                    lastSaleData = saleData;
                    window.lastSaleId = response.saleId; // Store sale ID for invoice printing
                    
                    // Enable print button
                    $('#printLastInvoiceBtn').prop('disabled', false);
                    
                    if (paymentStatus === 'Partial') {
                        const balance = totalAmount - paymentAmount;
                        $('#paymentStatusMsg').html(`<small class="text-warning">Partial Payment: $${paymentAmount.toFixed(2)} paid, $${balance.toFixed(2)} remaining</small>`);
                    } else if (secondPaymentMethodVal) {
                        $('#paymentStatusMsg').html(`<small class="text-success">Fully Paid (${paymentMethod}: $${paymentAmount.toFixed(2)}, ${secondPaymentMethodVal}: $${(totalAmount - paymentAmount).toFixed(2)})</small>`);
                    } else {
                        $('#paymentStatusMsg').html('<small class="text-success">Fully Paid</small>');
                    }
                    
                    $('#successModal').modal('show');
                    
                    // Clear cart
                    cart = [];
                    updateCart();
                    saveCartToStorage();
                    
                    // Reset form
                    $('#customerSelect').val(null).trigger('change');
                    $('#paymentType').val('full');
                    $('#paymentAmountContainer').removeClass('show');
                    $('#paymentAmount').val('');
                    $('#paymentMethod').val('Cash');
                    $('#secondPaymentMethod').val('');
                    $('#secondPaymentContainer').hide();
                    selectedCustomerId = null;
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function(xhr) {
                console.error('Error completing sale:', xhr);
                alert('Error completing sale. Please try again.');
            }
        });
    }

    function printLastInvoice() {
        // If we have a recent sale in memory, use it
        if (window.lastSaleId) {
            printInvoiceById(window.lastSaleId);
            return;
        }
        
        // Otherwise, fetch the most recent invoice from the server
        $.ajax({
            url: '@Url.Action("GetLastInvoice", "POS")',
            type: 'GET',
            success: function(response) {
                if (response.success && response.saleId) {
                    window.lastSaleId = response.saleId;
                    printInvoiceById(response.saleId);
                } else {
                    alert('No invoices found. Please complete a sale first.');
                }
            },
            error: function(xhr) {
                console.error('Error fetching last invoice:', xhr);
                alert('Error loading last invoice. Please try again.');
            }
        });
    }
    
    function printInvoice() {
        const invoiceNumber = $('#invoiceNumber').text();
        if (!invoiceNumber) {
            alert('No invoice to print');
            return;
        }
        
        printInvoiceWithData(invoiceNumber, lastSaleData);
    }
    
    function printInvoiceWithData(invoiceNumber, saleData) {
        if (!invoiceNumber) {
            alert('Invoice number not available');
            return;
        }
        
        // Get the sale ID from the last completed sale
        // We'll need to store this when the sale completes
        if (!window.lastSaleId) {
            alert('Sale ID not available. Please try again.');
            return;
        }
        
        // Fetch complete invoice data from server
        $.ajax({
            url: '@Url.Action("GetInvoiceData", "POS")',
            type: 'GET',
            data: { saleId: window.lastSaleId },
            success: function(response) {
                if (response.success) {
                    generateAndPrintInvoice(response);
                } else {
                    alert('Error loading invoice: ' + response.message);
                }
            },
            error: function(xhr) {
                console.error('Error fetching invoice data:', xhr);
                alert('Error loading invoice data. Please try again.');
            }
        });
    }
    
    function generateAndPrintInvoice(data) {
        const shop = data.shop;
        const invoice = data.invoice;
        const customer = data.customer;
        const items = data.items;
        const totals = data.totals;
        const payment = data.payment;
        
        // Populate hidden template
        document.getElementById('printInvoiceNumber').textContent = invoice.number;
        document.getElementById('printInvoiceDate').textContent = new Date(invoice.date).toLocaleString();
        
        // Shop info
        document.getElementById('printShopName').textContent = shop.name;
        document.getElementById('printShopEmail').textContent = shop.email || '';
        
        // Split address into two lines
        document.getElementById('printShopAddressLine1').textContent = shop.address || '';
        const cityStateZip = [shop.city, shop.state, shop.zipCode].filter(x => x).join(' ');
        document.getElementById('printShopAddressLine2').textContent = cityStateZip;
        
        document.getElementById('printShopPhone').textContent = shop.phone || '';
        
        // Handle shop logo
        if (shop.logoPath && shop.logoPath.trim() !== '') {
            document.getElementById('printShopLogo').src = shop.logoPath;
            document.getElementById('printShopLogo').style.display = 'block';
        } else {
            document.getElementById('printShopLogo').style.display = 'none';
        }
        
        // Customer info (no phone)
        document.getElementById('printCustomerName').textContent = customer.name;
        
        // Populate items table
        const itemsBody = document.getElementById('printInvoiceItems');
        itemsBody.innerHTML = '';
        items.forEach(item => {
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>${item.name}</td>
                <td>${item.type || ''}</td>
                <td>${item.quantity}</td>
                <td>$${item.unitPrice.toFixed(2)}</td>
                <td>$${item.totalPrice.toFixed(2)}</td>
            `;
            itemsBody.appendChild(row);
        });
        
        // Populate totals
        document.getElementById('printSubtotal').textContent = '$' + totals.subtotal.toFixed(2);
        document.getElementById('printTax').textContent = '$' + totals.tax.toFixed(2);
        document.getElementById('printDiscount').textContent = '$' + totals.discount.toFixed(2);
        document.getElementById('printTotal').textContent = '$' + totals.total.toFixed(2);
        
        // Populate payment info
        document.getElementById('printPaymentStatus').textContent = payment.status;
        
        // Extract payment method names from objects
        const paymentMethodNames = payment.methods.map(pm => {
            if (typeof pm === 'string') {
                return pm;
            } else if (pm.method) {
                // Format: "Method ($Amount)"
                return `${pm.method} ($${pm.amount.toFixed(2)})`;
            }
            return 'Unknown';
        });
        document.getElementById('printPaymentMethod').textContent = paymentMethodNames.join(', ');
        
        if (payment.balance > 0) {
            document.getElementById('printBalance').textContent = '$' + payment.balance.toFixed(2);
            document.getElementById('printBalanceRow').style.display = 'block';
        } else {
            document.getElementById('printBalanceRow').style.display = 'none';
        }
        
        document.getElementById('printCashier').textContent = invoice.createdBy;
        
        // Print using hidden template (same method as Repair page)
        const printContent = document.getElementById('invoicePrintTemplate').innerHTML;
        const originalContent = document.body.innerHTML;
        
        // Replace body content with print content
        document.body.innerHTML = printContent;
        
        // Trigger print
        window.print();
        
        // Restore original content
        document.body.innerHTML = originalContent;
        
        // Reinitialize the page (reload to restore all event handlers)
        location.reload();
    }
    
