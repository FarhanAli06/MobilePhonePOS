@section Scripts {
<!-- Include Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    console.log('POS JavaScript loaded - Version 4.0 - Cart Persistence Fix');
    
    // Load cart from localStorage or initialize empty
    let cart = [];
    try {
        const savedCart = localStorage.getItem('pos_cart');
        if (savedCart) {
            cart = JSON.parse(savedCart);
            console.log('Loaded cart from localStorage:', cart.length, 'items');
        }
    } catch (e) {
        console.error('Error loading cart from localStorage:', e);
        cart = [];
    }
    
    let currentFilter = '';
    let lastInvoiceNumber = null;
    let lastSaleData = null;
    let selectedCustomerId = null;
    let allItems = []; // Central storage for all items loaded from database
    let searchTimeout = null; // Timeout for search debouncing

    // Save cart to localStorage
    function saveCartToStorage() {
        try {
            localStorage.setItem('pos_cart', JSON.stringify(cart));
            console.log('Cart saved to localStorage');
        } catch (e) {
            console.error('Error saving cart to localStorage:', e);
        }
    }

    $(document).ready(function() {
        // Check for pending cart items from other pages (Repair, Device, etc.)
        $.ajax({
            url: '@Url.Action("GetPendingCartItems", "POS")',
            type: 'GET',
            success: function(response) {
                if (response.success && response.items && response.items.length > 0) {
                    console.log('Found pending cart items:', response.items);
                    // Add each pending item to the cart
                    response.items.forEach(function(item) {
                        addToCart(item);
                    });
                }
            },
            error: function(xhr) {
                console.error('Error loading pending cart items:', xhr);
            },
            complete: function() {
                // Update cart display after loading pending items
                updateCart();
            }
        });
        
        // Check if there's a last invoice to enable print button
        if (lastInvoiceNumber) {
            $('#printLastInvoiceBtn').prop('disabled', false);
        }
        
        console.log('Initializing Select2 for customer dropdown');
        console.log('Customer select element:', $('#customerSelect').length);
        
        // Initialize Select2 for customer dropdown
        $('#customerSelect').select2({
            theme: 'bootstrap-5',
            placeholder: 'Search and select customer',
            allowClear: true,
            ajax: {
                url: '@Url.Action("GetCustomers", "POS")',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        search: params.term
                    };
                },
                processResults: function (data) {
                    console.log('GetCustomers response:', data);
                    // Controller returns { results: [...] }
                    if (data.results) {
                        console.log('Found', data.results.length, 'customers');
                        return {
                            results: data.results.map(function(customer) {
                                return {
                                    id: customer.id,
                                    text: customer.text
                                };
                            })
                        };
                    }
                    console.log('No results found in response');
                    return { results: [] };
                },
                cache: true
            },
            minimumInputLength: 0  // 0 means show all customers when dropdown opens
        });
        
        // Trigger Select2 to load all customers on first open
        $('#customerSelect').on('select2:open', function() {
            if (!$(this).data('loaded')) {
                $(this).data('loaded', true);
            }
        });
        
        // Handle customer selection change
        $('#customerSelect').on('change', function() {
            selectedCustomerId = $(this).val();
            if (selectedCustomerId) {
                loadCustomerRepairs(selectedCustomerId);
            }
        });
        
        // Handle payment type change
        $('#paymentType').on('change', function() {
            const paymentType = $(this).val();
            if (paymentType === 'partial') {
                $('#paymentAmountContainer').addClass('show');
                $('#paymentAmount').prop('required', true);
            } else {
                $('#paymentAmountContainer').removeClass('show');
                $('#paymentAmount').prop('required', false);
            }
            updateSummary();
        });
        
        // Handle payment amount change
        $('#paymentAmount').on('input', function() {
            updateSummary();
            
            // Show second payment method if there's a remaining balance
            const total = cart.reduce((sum, item) => sum + (item.Price * item.quantity), 0);
            const paymentAmount = parseFloat($(this).val()) || 0;
            const balance = total - paymentAmount;
            
            if (balance > 0 && paymentAmount > 0) {
                $('#secondPaymentContainer').show();
            } else {
                $('#secondPaymentContainer').hide();
                $('#secondPaymentMethod').val('');
            }
        });
        
        // Search input handler
        $('#searchInput').on('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                searchProducts();
            }, 300);
        });

        // Initial display - show all cart items on the default 'All Items' tab
        setTimeout(function() {
            displayCartItems(''); // Empty string for 'All Items' tab
        }, 100);
    });
    
    function loadCustomerRepairs(customerId) {
        if (!customerId) {
            return;
        }
        
        $.ajax({
            url: '@Url.Action("GetCustomerRepairs", "POS")',
            type: 'GET',
            data: { customerId: customerId },
            success: function(response) {
                console.log('Customer repairs response:', response);
                if (response.success && response.data.length > 0) {
                    console.log('Raw repair data:', response.data);
                    // Get IDs of items already in cart
                    const cartItemIds = cart.map(item => item.Id);
                    const cartRepairIds = cart.map(item => item.RepairId).filter(id => id != null);
                    
                    // Filter out repairs already in cart and normalize data
                    const availableRepairs = response.data
                        .filter(repair => {
                            const repairId = repair.RepairId || repair.Id;
                            const itemId = repair.Id;
                            // Don't show if already in cart
                            return !cartItemIds.includes(itemId) && !cartRepairIds.includes(repairId);
                        })
                        .map(repair => ({
                            Id: repair.Id || repair.id,  // Handle both cases
                            Type: 'Repair',
                            Name: repair.Name || repair.name || 'Repair',  // Handle both Pascal and camel case
                            Description: repair.Description || repair.description || '',
                            Price: parseFloat(repair.Price || repair.price || 0),  // Handle both cases
                            RepairId: repair.RepairId || repair.repairId,
                            RepairNumber: repair.RepairNumber || repair.repairNumber,
                            IMEI: repair.IMEI || repair.imei || '',
                            Stock: 1
                        }));
                    
                    if (availableRepairs.length > 0) {
                        console.log('Mapped available repairs:', availableRepairs);
                        // Display available repair items
                        displayProducts(availableRepairs);
                    } else {
                        // All repairs already in cart
                        $('#productsContainer').html(`
                            <div class="no-products">
                                <i class="fas fa-check-circle text-success"></i>
                                <p>All repairs for this customer are already in the cart</p>
                            </div>
                        `);
                    }
                } else {
                    // If no repairs, show empty state
                    $('#productsContainer').html(`
                        <div class="no-products">
                            <i class="fas fa-info-circle"></i>
                            <p>No repairs found for this customer</p>
                        </div>
                    `);
                }
            },
            error: function(xhr) {
                console.error('Error loading customer repairs:', xhr);
                $('#productsContainer').html(`
                    <div class="no-products">
                        <i class="fas fa-exclamation-triangle"></i>
                        <p>Error loading customer repairs</p>
                    </div>
                `);
            }
        });
    }

    // Dropdown functions removed - simplified search interface

    function searchProducts() {
        const query = $('#searchInput').val().trim();
        
        if (!query) {
            // Don't clear if we're on a tab that shows cart items
            if (currentFilter && currentFilter !== '' && currentFilter !== 'search' && currentFilter !== 'custom') {
                // We're on a tab showing cart items, don't interfere
                return;
            }
            // Clear results if empty
            products = [];
            displayProducts(products);
            return;
        }
        
        // Intelligent search detection
        let searchType = detectSearchType(query);
        
        // Check if query looks like an invoice number
        if (searchType === 'Invoice') {
            searchInvoiceByNumber(query);
            return;
        }
        
        // For other types, search and show in modal
        $.ajax({
            url: '@Url.Action("SearchItemsTab", "POS")',
            type: 'GET',
            data: { 
                query: query,
                type: searchType,
                customerId: selectedCustomerId
            },
            success: function(response) {
                if (response.success && response.data && response.data.length > 0) {
                    // Show results in modal
                    showSearchResultsModal(response.data, searchType);
                } else {
                    // No results - show empty modal
                    showSearchResultsModal([], searchType);
                }
            },
            error: function(xhr) {
                console.error('Error searching products:', xhr);
                alert('Error performing search');
            }
        });
    }
    
    // Detect search type based on query pattern
    function detectSearchType(query) {
        query = query.toUpperCase();
        
        // Invoice patterns
        if (query.startsWith('INV') || query.startsWith('SAL') || /^\d{4,}$/.test(query)) {
            return 'Invoice';
        }
        
        // IMEI pattern (15 digits)
        if (/^\d{15}$/.test(query)) {
            return 'Device';
        }
        
        // Repair number pattern
        if (query.startsWith('REP') || query.startsWith('R-')) {
            return 'Repair';
        }
        
        // SKU pattern (alphanumeric with dashes/underscores)
        if (/^[A-Z0-9\-_]{6,}$/.test(query)) {
            return 'Inventory';
        }
        
        // Default to inventory search for general queries
        return 'Inventory';
    }
    
    // Search for invoice by number
    function searchInvoiceByNumber(invoiceNumber) {
        $.ajax({
            url: '@Url.Action("SearchSaleByNumber", "POS")',
            type: 'GET',
            data: { saleNumber: invoiceNumber },
            success: function(response) {
                if (response.success && response.sale) {
                    // Open invoice edit modal
                    openInvoiceEditModal(response.sale.id);
                } else {
                    alert('Invoice not found: ' + invoiceNumber);
                }
            },
            error: function(xhr) {
                console.error('Error searching invoice:', xhr);
                alert('Error searching for invoice');
            }
        });
    }
    
    // Display invoice search result
    function displayInvoiceSearchResult(sale) {
        const container = $('#productsContainer');
        container.html(`
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-file-invoice me-2"></i>Invoice Found: ${sale.saleNumber}
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Date:</strong> ${new Date(sale.saleDate).toLocaleString()}</p>
                            <p class="mb-1"><strong>Customer:</strong> ${sale.customerName || 'Walk-in Customer'}</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Total:</strong> $${sale.totalAmount.toFixed(2)}</p>
                            <p class="mb-1"><strong>Status:</strong> <span class="badge bg-${sale.paymentStatus === 'Paid' ? 'success' : 'warning'}">${sale.paymentStatus}</span></p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" onclick="loadInvoiceForEdit(${sale.id})">
                            <i class="fas fa-edit me-1"></i>Edit Invoice
                        </button>
                        <button class="btn btn-secondary" onclick="printInvoiceById(${sale.id})">
                            <i class="fas fa-print me-1"></i>Print Invoice
                        </button>
                        <button class="btn btn-info" onclick="viewInvoiceDetails(${sale.id})">
                            <i class="fas fa-eye me-1"></i>View Details
                        </button>
                    </div>
                </div>
            </div>
        `);
    }
    
    // Print invoice by ID
    function printInvoiceById(saleId) {
        window.lastSaleId = saleId;
        
        // Fetch complete invoice data from server
        $.ajax({
            url: '@Url.Action("GetInvoiceData", "POS")',
            type: 'GET',
            data: { saleId: saleId },
            success: function(response) {
                if (response.success) {
                    generateAndPrintInvoice(response);
                } else {
                    alert('Error loading invoice data.');
                }
            },
            error: function(xhr) {
                console.error('Error:', xhr);
                alert('Error loading invoice. Please try again.');
            }
        });
    }
    
    // View invoice details
    function viewInvoiceDetails(saleId) {
        $.ajax({
            url: '@Url.Action("GetInvoiceData", "POS")',
            type: 'GET',
            data: { saleId: saleId },
            success: function(response) {
                if (response.success) {
                    showInvoiceDetailsModal(response);
                } else {
                    alert('Error loading invoice details');
                }
            },
            error: function(xhr) {
                console.error('Error:', xhr);
                alert('Error loading invoice details');
            }
        });
    }
    
    // Show invoice details in a modal
    function showInvoiceDetailsModal(data) {
        const items = data.items.map(item => `
            <tr>
                <td>${item.name}</td>
                <td>${item.quantity}</td>
                <td>$${item.unitPrice.toFixed(2)}</td>
                <td>$${item.totalPrice.toFixed(2)}</td>
            </tr>
        `).join('');
        
        const modalHtml = `
            <div class="modal fade" id="invoiceDetailsModal" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Invoice Details: ${data.invoice.number}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
