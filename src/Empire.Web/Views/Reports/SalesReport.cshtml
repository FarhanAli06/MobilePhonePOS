@{
    ViewData["Title"] = "Sales Report";
    var customers = ViewBag.Customers as List<dynamic> ?? new List<dynamic>();
    var users = ViewBag.Users as List<dynamic> ?? new List<dynamic>();
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<style>
    .stat-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .stat-card.success {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
    }
    .stat-card.warning {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }
    .stat-card.info {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    }
    .stat-card h3 {
        font-size: 2rem;
        margin: 0;
        font-weight: bold;
    }
    .stat-card p {
        margin: 5px 0 0 0;
        opacity: 0.9;
    }
    .chart-container {
        position: relative;
        height: 400px;
        margin-bottom: 30px;
    }
    .filter-section {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 30px;
    }
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-chart-line me-2"></i>Comprehensive Sales Report</h2>
        <div>
            <button type="button" class="btn btn-success" onclick="exportToExcel()">
                <i class="fas fa-file-excel me-2"></i>Export to Excel
            </button>
            <button type="button" class="btn btn-primary" onclick="printReport()">
                <i class="fas fa-print me-2"></i>Print Report
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-section">
        <h5 class="mb-3"><i class="fas fa-filter me-2"></i>Filters</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">From Date</label>
                <input type="date" class="form-control" id="dateFrom" value="@DateTime.Now.AddMonths(-1).ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-3">
                <label class="form-label">To Date</label>
                <input type="date" class="form-control" id="dateTo" value="@DateTime.Now.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-3">
                <label class="form-label">Customer</label>
                <select class="form-select" id="customerId">
                    <option value="">All Customers</option>
                    @foreach (var customer in customers)
                    {
                        <option value="@customer.Id">@customer.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Payment Status</label>
                <select class="form-select" id="paymentStatus">
                    <option value="">All Status</option>
                    <option value="Paid">Paid</option>
                    <option value="Partial">Partial</option>
                    <option value="Unpaid">Unpaid</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Payment Method</label>
                <select class="form-select" id="paymentMethod">
                    <option value="">All Methods</option>
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="Check">Check</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Item Type</label>
                <select class="form-select" id="itemType">
                    <option value="">All Types</option>
                    <option value="Device">Devices</option>
                    <option value="Inventory">Inventory</option>
                    <option value="Repair">Repairs</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Cashier</label>
                <select class="form-select" id="userId">
                    <option value="">All Cashiers</option>
                    @foreach (var user in users)
                    {
                        <option value="@user.Id">@user.Username</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="button" class="btn btn-primary w-100" onclick="loadReport()">
                    <i class="fas fa-search me-2"></i>Generate Report
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Statistics -->
    <div class="row" id="summarySection" style="display: none;">
        <div class="col-md-3">
            <div class="stat-card">
                <p><i class="fas fa-dollar-sign me-2"></i>Total Revenue</p>
                <h3 id="totalRevenue">$0.00</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card success">
                <p><i class="fas fa-shopping-cart me-2"></i>Total Sales</p>
                <h3 id="totalSales">0</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card warning">
                <p><i class="fas fa-check-circle me-2"></i>Paid Amount</p>
                <h3 id="totalPaid">$0.00</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card info">
                <p><i class="fas fa-chart-bar me-2"></i>Average Sale</p>
                <h3 id="averageSale">$0.00</h3>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row mt-4" id="chartsSection" style="display: none;">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-chart-line me-2"></i>Sales Over Time</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="salesByDateChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-chart-pie me-2"></i>Revenue by Payment Method</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="paymentMethodChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4" id="chartsSection2" style="display: none;">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-chart-bar me-2"></i>Top 10 Selling Items</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="topItemsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-chart-bar me-2"></i>Sales by Payment Status</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="paymentStatusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4" id="chartsSection3" style="display: none;">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-chart-pie me-2"></i>Revenue by Item Type</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="itemTypeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sales Analytics Chart -->
    <div class="row mt-4" id="analyticsSection" style="display: none;">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5><i class="fas fa-chart-line me-2"></i>Sales Analytics - Cost, Revenue & Profit</h5>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnDaily" onclick="loadAnalytics('day')">
                            <i class="fas fa-calendar-day me-1"></i>Daily
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnMonthly" onclick="loadAnalytics('month')">
                            <i class="fas fa-calendar-alt me-1"></i>Monthly
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnYearly" onclick="loadAnalytics('year')">
                            <i class="fas fa-calendar me-1"></i>Yearly
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <small class="text-muted">Total Inventory Cost</small>
                                <h4 class="mb-0 text-danger" id="analyticsTotalCost">$0.00</h4>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <small class="text-muted">Total Sales Revenue</small>
                                <h4 class="mb-0 text-primary" id="analyticsTotalSales">$0.00</h4>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <small class="text-muted">Total Profit</small>
                                <h4 class="mb-0 text-success" id="analyticsTotalProfit">$0.00</h4>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 bg-light rounded">
                                <small class="text-muted">Profit Margin</small>
                                <h4 class="mb-0 text-info" id="analyticsProfitMargin">0%</h4>
                            </div>
                        </div>
                    </div>
                    <div class="chart-container" style="height: 450px;">
                        <canvas id="analyticsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Sales Table -->
    <div class="card mt-4" id="tableSection" style="display: none;">
        <div class="card-header">
            <h5><i class="fas fa-table me-2"></i>Detailed Sales List</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="salesTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Invoice #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Subtotal</th>
                            <th>Tax</th>
                            <th>Discount</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Payment Method</th>
                            <th>Cashier</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="salesTableBody">
                        <!-- Data will be populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Invoice Print Template -->
<div id="salesReportInvoicePrintTemplate" style="display: none;">
    <div class="invoice-print-content">
        <!-- Header Section -->
        <div class="invoice-header-section">
            <div class="invoice-title">
                <h1>INVOICE</h1>
            </div>
            <div class="company-logo">
                <h2 id="printSalesShopName"></h2>
            </div>
        </div>
        
        <!-- Bill To and Invoice Info -->
        <div class="invoice-info-section">
            <div class="bill-to">
                <p class="section-label">BILL TO:</p>
                <p class="customer-name" id="printSalesCustomerName"></p>
                <p id="printSalesCustomerEmail"></p>
                <p id="printSalesCustomerAddress"></p>
                <p><span class="label-text">Phone #:</span> <span id="printSalesCustomerPhone"></span></p>
            </div>
            <div class="invoice-details">
                <p><span class="detail-label">Date:</span> <span id="printSalesInvoiceDate"></span></p>
                <p><span class="detail-label">Invoice NO.</span> <span id="printSalesInvoiceNumber"></span></p>
            </div>
        </div>
        
        <!-- From Section -->
        <div class="from-section">
            <p class="section-label">FROM:</p>
            <p class="shop-name-from" id="printSalesShopNameFrom"></p>
            <p id="printSalesShopEmail"></p>
            <p id="printSalesShopAddress"></p>
        </div>
        
        <!-- Items Table -->
        <table class="invoice-items-table">
            <thead>
                <tr>
                    <th class="desc-col">DESCRIPTION</th>
                    <th class="qty-col">QTY</th>
                    <th class="price-col">PRICE</th>
                    <th class="total-col">TOTAL</th>
                </tr>
            </thead>
            <tbody id="printSalesInvoiceItems">
            </tbody>
        </table>
        
        <!-- Total Section -->
        <div class="invoice-totals-section">
            <div class="totals-row" id="printSalesSubtotalRow">
                <span class="totals-label">Subtotal:</span>
                <span class="totals-value" id="printSalesSubtotal"></span>
            </div>
            <div class="totals-row" id="printSalesTaxRow" style="display: none;">
                <span class="totals-label">Tax:</span>
                <span class="totals-value" id="printSalesTax"></span>
            </div>
            <div class="totals-row" id="printSalesDiscountRow" style="display: none;">
                <span class="totals-label">Discount:</span>
                <span class="totals-value" id="printSalesDiscount"></span>
            </div>
            <div class="totals-row total-amount-row">
                <span class="totals-label">Total amount:</span>
                <span class="totals-value" id="printSalesTotal"></span>
            </div>
        </div>
        
        <!-- Payment and Notes -->
        <div class="payment-notes-section">
            <div class="payment-method">
                <p class="section-label">PAYMENT METHOD</p>
                <div id="printSalesPaymentMethods"></div>
            </div>
            <div class="notes-section">
                <p class="section-label">NOTES</p>
                <div id="printSalesNotes"></div>
            </div>
        </div>
        
        <!-- Footer -->
        <div class="invoice-footer-section">
            <div class="signature-section">
                <div class="signature-line">
                    <p>Date</p>
                </div>
                <div class="thank-you">
                    <h2>Thank you!</h2>
                </div>
                <div class="signature-line">
                    <p>Signature</p>
                </div>
            </div>
            <div class="website">
                <p id="printSalesShopWebsite"></p>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        .invoice-print-content, .invoice-print-content * {
            visibility: visible;
        }
        .invoice-print-content {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
    }
    
    /* Invoice Container */
    .invoice-print-content {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 900px;
        margin: 0 auto;
        padding: 50px;
        background: #f5f5f5;
        color: #333;
    }
    
    /* Header Section */
    .invoice-header-section {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 40px 0;
        background: #e8e8e8;
        margin: -50px -50px 40px -50px;
        padding: 40px 50px;
    }
    
    .invoice-title h1 {
        font-size: 56px;
        font-weight: 300;
        letter-spacing: 2px;
        color: #4a4a4a;
        margin: 0;
    }
    
    .company-logo h2 {
        font-size: 24px;
        font-weight: 600;
        color: #4a4a4a;
        margin: 0;
        text-align: right;
    }
    
    /* Bill To and Invoice Info Section */
    .invoice-info-section {
        display: flex;
        justify-content: space-between;
        margin-bottom: 40px;
    }
    
    .section-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #666;
        margin-bottom: 10px;
    }
    
    .bill-to .customer-name {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin: 5px 0;
    }
    
    .bill-to p {
        margin: 3px 0;
        color: #555;
        font-size: 14px;
    }
    
    .label-text {
        font-weight: 600;
    }
    
    .invoice-details {
        text-align: right;
    }
    
    .invoice-details p {
        margin: 8px 0;
        font-size: 14px;
    }
    
    .detail-label {
        font-weight: 600;
        margin-right: 10px;
    }
    
    /* From Section */
    .from-section {
        margin-bottom: 40px;
    }
    
    .shop-name-from {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin: 5px 0;
    }
    
    .from-section p {
        margin: 3px 0;
        color: #555;
        font-size: 14px;
    }
    
    /* Items Table */
    .invoice-items-table {
        width: 100%;
        border-collapse: collapse;
        margin: 40px 0;
        background: white;
    }
    
    .invoice-items-table thead {
        background: #e8e8e8;
    }
    
    .invoice-items-table th {
        padding: 15px;
        text-align: left;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #666;
        border-bottom: 2px solid #ddd;
    }
    
    .invoice-items-table th.qty-col,
    .invoice-items-table th.price-col,
    .invoice-items-table th.total-col {
        text-align: right;
    }
    
    .invoice-items-table td {
        padding: 15px;
        border-bottom: 1px solid #eee;
        font-size: 14px;
        color: #555;
    }
    
    .invoice-items-table td.qty-col,
    .invoice-items-table td.price-col,
    .invoice-items-table td.total-col {
        text-align: right;
    }
    
    /* Totals Section */
    .invoice-totals-section {
        margin: 40px 0;
        text-align: right;
    }
    
    .totals-row {
        display: flex;
        justify-content: flex-end;
        padding: 8px 0;
        font-size: 14px;
    }
    
    .totals-label {
        margin-right: 40px;
        color: #666;
    }
    
    .totals-value {
        min-width: 120px;
        text-align: right;
        color: #333;
    }
    
    .total-amount-row {
        background: #e8e8e8;
        padding: 15px 20px;
        margin-top: 10px;
        font-size: 16px;
        font-weight: 700;
    }
    
    .total-amount-row .totals-label,
    .total-amount-row .totals-value {
        color: #333;
    }
    
    /* Payment and Notes Section */
    .payment-notes-section {
        display: flex;
        justify-content: space-between;
        margin: 40px 0;
    }
    
    .payment-method,
    .notes-section {
        flex: 1;
        margin-right: 40px;
    }
    
    .notes-section {
        margin-right: 0;
    }
    
    .payment-method p.section-label,
    .notes-section p.section-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #666;
        margin-bottom: 10px;
    }
    
    .payment-method div,
    .notes-section div {
        color: #555;
        font-size: 14px;
        line-height: 1.6;
    }
    
    /* Footer Section */
    .invoice-footer-section {
        margin-top: 60px;
        padding-top: 30px;
        border-top: 1px solid #ddd;
    }
    
    .signature-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }
    
    .signature-line {
        text-align: center;
    }
    
    .signature-line p {
        margin: 0;
        padding-top: 40px;
        border-top: 1px solid #999;
        min-width: 150px;
        font-size: 12px;
        color: #666;
    }
    
    .thank-you h2 {
        font-size: 36px;
        font-weight: 300;
        color: #4a4a4a;
        margin: 0;
        text-align: center;
    }
    
    .website {
        text-align: center;
    }
    
    .website p {
        margin: 0;
        color: #666;
        font-size: 14px;
    }
</style>

@section Scripts {
    <!-- DataTables CSS and JS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        let salesData = null;
        let charts = {};

        $(document).ready(function() {
            // Load report on page load
            loadReport();
        });

        function loadReport() {
            const filters = {
                dateFrom: $('#dateFrom').val(),
                dateTo: $('#dateTo').val(),
                customerId: $('#customerId').val() || null,
                paymentStatus: $('#paymentStatus').val() || null,
                paymentMethod: $('#paymentMethod').val() || null,
                itemType: $('#itemType').val() || null,
                userId: $('#userId').val() || null
            };

            $.ajax({
                url: '@Url.Action("GetSalesReportData", "Reports")',
                type: 'GET',
                data: filters,
                success: function(response) {
                    if (response.success) {
                        salesData = response;
                        updateSummary(response.summary);
                        updateCharts(response.charts);
                        updateTable(response.sales);
                        
                        // Show sections
                        $('#summarySection').show();
                        $('#chartsSection').show();
                        $('#chartsSection2').show();
                        $('#chartsSection3').show();
                        $('#analyticsSection').show();
                        $('#tableSection').show();
                        
                        // Load analytics data (default to daily view)
                        loadAnalytics('day');
                    } else {
                        alert('Error loading report: ' + response.message);
                    }
                },
                error: function(xhr) {
                    console.error('Error loading report:', xhr);
                    alert('Error loading report data');
                }
            });
        }

        function updateSummary(summary) {
            $('#totalRevenue').text('$' + summary.totalRevenue.toFixed(2));
            $('#totalSales').text(summary.totalSales);
            $('#totalPaid').text('$' + summary.totalPaid.toFixed(2));
            $('#averageSale').text('$' + summary.averageSale.toFixed(2));
        }

        function updateCharts(chartData) {
            // Destroy existing charts
            Object.values(charts).forEach(chart => chart.destroy());
            charts = {};

            // Sales by Date - Line Chart
            const salesByDateCtx = document.getElementById('salesByDateChart').getContext('2d');
