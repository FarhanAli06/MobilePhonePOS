        let salesTable = null;
        
        function updateTable(sales) {
            // Destroy existing DataTable if it exists
            if (salesTable) {
                salesTable.destroy();
            }
            
            const tbody = $('#salesTableBody');
            tbody.empty();

            if (sales.length === 0) {
                tbody.append('<tr><td colspan="12" class="text-center">No sales found</td></tr>');
                return;
            }

            sales.forEach(sale => {
                const statusBadge = 
                    sale.paymentStatus === 'Paid' ? 'success' :
                    sale.paymentStatus === 'Partial' ? 'warning' : 'danger';

                const row = `
                    <tr>
                        <td>${sale.invoiceNumber}</td>
                        <td>${sale.date}</td>
                        <td>${sale.customer}</td>
                        <td>${sale.items}</td>
                        <td>$${sale.subtotal.toFixed(2)}</td>
                        <td>$${sale.tax.toFixed(2)}</td>
                        <td>$${sale.discount.toFixed(2)}</td>
                        <td><strong>$${sale.total.toFixed(2)}</strong></td>
                        <td><span class="badge bg-${statusBadge}">${sale.paymentStatus}</span></td>
                        <td>${sale.paymentMethods}</td>
                        <td>${sale.cashier}</td>
                        <td>
                            <button class="btn btn-sm btn-success me-1" onclick="loadInvoiceForEdit(${sale.id})" title="Edit Invoice">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-primary" onclick="printInvoiceFromSalesReport(${sale.id})" title="Print Invoice">
                                <i class="fas fa-print"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
            
            // Initialize DataTable with export buttons
            salesTable = $('#salesTable').DataTable({
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="fas fa-file-excel"></i> Export to Excel',
                        className: 'btn btn-success btn-sm',
                        exportOptions: {
                            columns: ':not(:last-child)' // Exclude Actions column
                        }
                    },
                    {
                        extend: 'print',
                        text: '<i class="fas fa-print"></i> Print Report',
                        className: 'btn btn-info btn-sm',
                        exportOptions: {
                            columns: ':not(:last-child)' // Exclude Actions column
                        }
                    }
                ],
                order: [[1, 'desc']], // Sort by date descending
                pageLength: 25,
                responsive: true,
                language: {
                    search: "Search sales:",
                    lengthMenu: "Show _MENU_ sales per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ sales",
                    infoEmpty: "No sales to show",
                    infoFiltered: "(filtered from _MAX_ total sales)"
                }
            });
        }

        function exportToExcel() {
            if (!salesData) {
                alert('Please generate a report first');
                return;
            }

            // Create CSV content
            let csv = 'Invoice #,Date,Customer,Items,Subtotal,Tax,Discount,Total,Status,Payment Method,Cashier\n';
            
            salesData.sales.forEach(sale => {
                csv += `${sale.invoiceNumber},${sale.date},${sale.customer},${sale.items},${sale.subtotal},${sale.tax},${sale.discount},${sale.total},${sale.paymentStatus},${sale.paymentMethods},${sale.cashier}\n`;
            });

            // Download CSV
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'sales_report_' + new Date().toISOString().split('T')[0] + '.csv';
            a.click();
            window.URL.revokeObjectURL(url);
        }

        function printReport() {
            window.print();
        }
        
        function printInvoiceFromSalesReport(saleId) {
            if (!saleId) {
                alert('Invalid sale ID');
                return;
            }
            
            // Fetch invoice data from server
            $.ajax({
                url: '@Url.Action("GetInvoiceData", "POS")',
                type: 'GET',
                data: { saleId: saleId },
                success: function(response) {
                    if (response.success) {
                        // Transform data to match the printInvoice function format
                        // Note: GetInvoiceData returns data at root level, not nested under 'data'
                        const invoice = response.invoice || {};
                        const customer = response.customer || {};
                        const shop = response.shop || {};
                        const items = response.items || [];
                        const payment = response.payment || {};
                        const totals = response.totals || {};
                        
                        const invoiceData = {
                            companyName: shop.name || '',
                            customerName: customer.name || 'Walk-in Customer',
                            customerEmail: customer.email || '',
                            customerAddress: customer.address || '',
                            customerPhone: customer.phone || '',
                            invoiceDate: invoice.date ? new Date(invoice.date).toLocaleDateString() : '',
                            invoiceNumber: invoice.number || '',
                            shopName: shop.name || '',
                            shopEmail: shop.email || '',
                            shopAddress: shop.address || '',
                            shopLogo: shop.logoPath || shop.logo || '',
                            items: items.map(item => ({
                                name: item.name || item.itemName || '',
                                description: item.description || '',
                                imei: item.imei || '',
                                serialNumber: item.serialNumber || '',
                                quantity: item.quantity || 1,
                                price: parseFloat(item.price || item.unitPrice || 0),
                                total: parseFloat(item.total || item.totalPrice || 0)
                            })),
                            subtotal: parseFloat(totals.subtotal || 0),
                            tax: parseFloat(totals.tax || 0),
                            discount: parseFloat(totals.discount || 0),
                            totalAmount: parseFloat(totals.total || totals.totalAmount || 0),
                            paymentMethods: payment.methods || [],
                            notes: invoice.notes || '',
                            website: shop.website || ''
                        };
                        
                        // Use the global printInvoice function from the partial
                        if (typeof window.printInvoice === 'function') {
                            window.printInvoice(invoiceData);
                        } else {
                            console.error('printInvoice function not found. Make sure _InvoicePrintTemplate partial is loaded.');
                            alert('Print function not available. Please refresh the page and try again.');
                        }
                    } else {
                        alert('Error loading invoice: ' + (response.message || 'Unknown error'));
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error fetching invoice:', error);
                    alert('Failed to load invoice. Please try again.');
                }
            });
        }
        
        function populateInvoiceTemplate(data) {
            // Safely handle response structure
            if (!data) {
                console.error('No data provided to populateInvoiceTemplate');
                return;
            }
            
            // Backend returns: invoice, customer, shop, items, totals, payment
            const invoice = data.invoice || data || {};
            const customer = data.customer || {};
            const shop = data.shop || {};
            const items = data.items || [];
            const payment = data.payment || {};
            const totals = data.totals || {};
            
            // Populate template fields
            document.getElementById('printSalesInvoiceNumber').textContent = invoice.number || 'N/A';
            document.getElementById('printSalesInvoiceDate').textContent = invoice.date ? new Date(invoice.date).toLocaleDateString() : 'N/A';
            
            // Shop info (appears twice - header and from section)
            document.getElementById('printSalesShopName').textContent = shop.name || 'N/A';
            document.getElementById('printSalesShopNameFrom').textContent = shop.name || 'N/A';
            document.getElementById('printSalesShopEmail').textContent = shop.email || '';
            document.getElementById('printSalesShopAddress').textContent = shop.address || '';
            document.getElementById('printSalesShopWebsite').textContent = shop.website || '';
            
            // Customer info
            document.getElementById('printSalesCustomerName').textContent = customer.name || 'Walk-in Customer';
            document.getElementById('printSalesCustomerEmail').textContent = customer.email || '';
            document.getElementById('printSalesCustomerAddress').textContent = customer.address || '';
            document.getElementById('printSalesCustomerPhone').textContent = customer.phone || 'N/A';
            
            // Populate items table
            const itemsBody = document.getElementById('printSalesInvoiceItems');
            itemsBody.innerHTML = '';
            items.forEach(item => {
                const row = document.createElement('tr');
                const itemName = item.name || item.itemName || 'N/A';
                const itemDesc = item.description || '';
                const fullDescription = itemDesc ? `${itemName} - ${itemDesc}` : itemName;
                
                row.innerHTML = `
                    <td class="desc-col">${fullDescription}</td>
                    <td class="qty-col" style="text-align: right;">${item.quantity || 0}</td>
                    <td class="price-col" style="text-align: right;">$${(item.unitPrice || 0).toFixed(2)}</td>
                    <td class="total-col" style="text-align: right;">$${(item.totalPrice || 0).toFixed(2)}</td>
                `;
                itemsBody.appendChild(row);
            });
            
            // Populate totals
            document.getElementById('printSalesSubtotal').textContent = '$' + totals.subtotal.toFixed(2);
            
            if (totals.tax > 0) {
                document.getElementById('printSalesTax').textContent = '$' + totals.tax.toFixed(2);
                document.getElementById('printSalesTaxRow').style.display = 'flex';
            } else {
                document.getElementById('printSalesTaxRow').style.display = 'none';
            }
            
            if (totals.discount > 0) {
                document.getElementById('printSalesDiscount').textContent = '-$' + totals.discount.toFixed(2);
                document.getElementById('printSalesDiscountRow').style.display = 'flex';
            } else {
                document.getElementById('printSalesDiscountRow').style.display = 'none';
            }
            
            document.getElementById('printSalesTotal').textContent = '$' + totals.total.toFixed(2);
            
            // Populate payment methods
            const paymentMethodsDiv = document.getElementById('printSalesPaymentMethods');
            paymentMethodsDiv.innerHTML = '';
            
            // Backend returns payment.methods as array of {method, amount}
            const paymentMethods = payment.methods || [];
            if (paymentMethods.length > 0) {
                paymentMethods.forEach(pm => {
                    const p = document.createElement('p');
                    const methodName = pm.method || pm.paymentMethod || 'Unknown';
                    const amount = pm.amount || 0;
                    p.innerHTML = `${methodName}: $${amount.toFixed(2)}`;
                    paymentMethodsDiv.appendChild(p);
                });
            } else {
                const p = document.createElement('p');
                p.textContent = payment.method || 'Cash';
                paymentMethodsDiv.appendChild(p);
            }
            
            // Populate notes
            const notesDiv = document.getElementById('printSalesNotes');
            notesDiv.innerHTML = '';
            const notes = invoice.notes || payment.notes || '';
            if (notes) {
                const p = document.createElement('p');
                p.textContent = notes;
                notesDiv.appendChild(p);
            }

        }
        
        // Sales Analytics Functions
        let currentAnalyticsView = 'day';
        
        function loadAnalytics(groupBy) {
            console.log('Loading analytics with groupBy:', groupBy);
            currentAnalyticsView = groupBy;
            
            // Update button states
            $('#btnDaily, #btnMonthly, #btnYearly').removeClass('active btn-primary').addClass('btn-outline-primary');
            if (groupBy === 'day') {
                $('#btnDaily').removeClass('btn-outline-primary').addClass('btn-primary active');
            } else if (groupBy === 'month') {
                $('#btnMonthly').removeClass('btn-outline-primary').addClass('btn-primary active');
            } else if (groupBy === 'year') {
                $('#btnYearly').removeClass('btn-outline-primary').addClass('btn-primary active');
            }
            
            const filters = {
                dateFrom: $('#dateFrom').val(),
                dateTo: $('#dateTo').val(),
                groupBy: groupBy
            };
            
            $.ajax({
                url: '@Url.Action("GetSalesAnalytics", "Reports")',
                type: 'GET',
                data: filters,
                success: function(response) {
                    console.log('Analytics API response:', response);
                    if (response.success) {
                        console.log('Analytics data loaded successfully');
                        updateAnalyticsSummary(response.summary);
                        renderAnalyticsChart(response.data, groupBy);
                    } else {
                        alert('Error loading analytics: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading analytics:', xhr, status, error);
                    console.error('Response text:', xhr.responseText);
                    alert('Error loading analytics data: ' + error);
                }
            });
        }
        
        function updateAnalyticsSummary(summary) {
            $('#analyticsTotalCost').text('$' + summary.totalInventoryCost.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
            $('#analyticsTotalSales').text('$' + summary.totalSales.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
            $('#analyticsTotalProfit').text('$' + summary.totalProfit.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}));
            $('#analyticsProfitMargin').text(summary.profitMargin.toFixed(1) + '%');
        }
        
        function renderAnalyticsChart(data, groupBy) {
            // Destroy existing analytics chart if it exists
            if (charts.analytics) {
                charts.analytics.destroy();
            }
            
            const ctx = document.getElementById('analyticsChart').getContext('2d');
            
            charts.analytics = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.map(d => d.displayLabel),
                    datasets: [
                        {
                            label: 'Inventory Cost',
                            data: data.map(d => d.inventoryCost),
                            borderColor: 'rgb(220, 53, 69)',
                            backgroundColor: 'rgba(220, 53, 69, 0.1)',
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        },
                        {
                            label: 'Sales Revenue',
                            data: data.map(d => d.sales),
                            borderColor: 'rgb(13, 110, 253)',
                            backgroundColor: 'rgba(13, 110, 253, 0.1)',
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        },
                        {
                            label: 'Profit',
                            data: data.map(d => d.profit),
                            borderColor: 'rgb(25, 135, 84)',
                            backgroundColor: 'rgba(25, 135, 84, 0.1)',
                            borderWidth: 2,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: {
                                usePointStyle: true,
                                padding: 15,
                                font: {
                                    size: 12,
                                    weight: 'bold'
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    label += '$' + context.parsed.y.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                                    return label;
                                }
                            },
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            titleFont: {
                                size: 14
                            },
                            bodyFont: {
                                size: 13
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            },
                            ticks: {
                                callback: function(value) {
                                    return '$' + value.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0});
                                }
                            }
                        }
                    }
                }
            });
        }
