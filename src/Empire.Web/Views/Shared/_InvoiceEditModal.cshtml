@* Shared Invoice Edit Modal - Can be used from POS and Sales Report *@

<div class="modal fade" id="invoiceEditModal" tabindex="-1" aria-labelledby="invoiceEditModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="invoiceEditModalLabel">
                    <i class="fas fa-edit me-2"></i>Edit Invoice: <span id="editInvoiceNumber"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Invoice Info Section -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Invoice Number</label>
                        <input type="text" class="form-control" id="editInvoiceNumberDisplay" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Invoice Date</label>
                        <input type="text" class="form-control" id="editInvoiceDate" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Customer</label>
                        <select class="form-select" id="editCustomerSelect">
                            <option value="">Walk-in Customer</option>
                        </select>
                    </div>
                </div>

                <hr>

                <!-- Items Section -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0"><i class="fas fa-list me-2"></i>Invoice Items</h6>
                    <button type="button" class="btn btn-sm btn-success" id="addItemBtn">
                        <i class="fas fa-plus me-1"></i>Add Item
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 30%;">Item Name</th>
                                <th style="width: 20%;">Description</th>
                                <th style="width: 10%;">Quantity</th>
                                <th style="width: 15%;">Unit Price</th>
                                <th style="width: 15%;">Total Price</th>
                                <th style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="editItemsTableBody">
                            <!-- Items will be populated here -->
                        </tbody>
                    </table>
                </div>

                <hr>

                <!-- Totals Section -->
                <div class="row">
                    <div class="col-md-8"></div>
                    <div class="col-md-4">
                        <table class="table table-sm">
                            <tr>
                                <td class="fw-bold">Subtotal:</td>
                                <td class="text-end" id="editSubtotal">$0.00</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Tax:</td>
                                <td class="text-end">
                                    <input type="number" class="form-control form-control-sm text-end" id="editTax" value="0" step="0.01" min="0">
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Discount:</td>
                                <td class="text-end" id="editDiscount">$0.00</td>
                            </tr>
                            <tr class="table-primary">
                                <td class="fw-bold">Total:</td>
                                <td class="text-end fw-bold" id="editTotal">$0.00</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <hr>

                <!-- Payment Section -->
                <h6 class="mb-3"><i class="fas fa-credit-card me-2"></i>Payment Information</h6>
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Payment Status</label>
                        <select class="form-select" id="editPaymentStatus">
                            <option value="Paid">Paid</option>
                            <option value="Partial">Partial</option>
                            <option value="Unpaid">Unpaid</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Payment Method</label>
                        <select class="form-select" id="editPaymentMethod">
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="Check">Check</option>
                            <option value="Zelle">Zelle</option>
                            <option value="Venmo">Venmo</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveInvoiceBtn">
                    <i class="fas fa-save me-1"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Add Item Modal (nested) -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addItemModalLabel">Add Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Search Item</label>
                    <input type="text" class="form-control" id="searchItemInput" placeholder="Search by name, SKU, IMEI...">
                    <div id="searchItemResults" class="list-group mt-2" style="max-height: 200px; overflow-y: auto;"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Item Name *</label>
                    <input type="text" class="form-control" id="newItemName" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <input type="text" class="form-control" id="newItemDescription">
                </div>
                <div class="mb-3">
                    <label class="form-label">Quantity *</label>
                    <input type="number" class="form-control" id="newItemQuantity" value="1" min="1" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Unit Price *</label>
                    <input type="number" class="form-control" id="newItemPrice" value="0" step="0.01" min="0" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmAddItemBtn">Add Item</button>
            </div>
        </div>
    </div>
</div>

<script>
// Global variables for invoice editing
let currentEditingSaleId = null;
let editingItems = [];
let editingCustomerId = null;

// Initialize invoice edit modal
function initInvoiceEditModal() {
    // Load customers for dropdown
    loadCustomersForEdit();
    
    // Add item button
    $('#addItemBtn').click(function() {
        $('#addItemModal').modal('show');
        $('#searchItemInput').val('');
        $('#searchItemResults').html('');
        $('#newItemName').val('');
        $('#newItemDescription').val('');
        $('#newItemQuantity').val(1);
        $('#newItemPrice').val(0);
    });
    
    // Search item
    $('#searchItemInput').on('input', debounce(function() {
        const query = $(this).val();
        if (query.length < 2) {
            $('#searchItemResults').html('');
            return;
        }
        searchItemsForEdit(query);
    }, 300));
    
    // Confirm add item
    $('#confirmAddItemBtn').click(function() {
        addNewItemToInvoice();
    });
    
    // Save invoice button
    $('#saveInvoiceBtn').click(function() {
        saveInvoiceChanges();
    });
    
    // Tax change
    $('#editTax').on('input', function() {
        recalculateEditTotals();
    });
}

// Load invoice for editing
function loadInvoiceForEdit(saleId) {
    $.ajax({
        url: '@Url.Action("GetInvoiceData", "POS")',
        type: 'GET',
        data: { saleId: saleId },
        success: function(response) {
            if (response.success) {
                populateEditModal(response, saleId);
                $('#invoiceEditModal').modal('show');
            } else {
                alert('Error loading invoice: ' + response.message);
            }
        },
        error: function(xhr) {
            console.error('Error fetching invoice:', xhr);
            alert('Error loading invoice data. Please try again.');
        }
    });
}

// Populate edit modal with invoice data
function populateEditModal(data, saleId) {
    currentEditingSaleId = saleId;
    
    // Set invoice info
    $('#editInvoiceNumber').text(data.invoice.number);
    $('#editInvoiceNumberDisplay').val(data.invoice.number);
    $('#editInvoiceDate').val(new Date(data.invoice.date).toLocaleString());
    
    // Set customer
    if (data.customer && data.customer.name !== 'Walk-in Customer') {
        // Try to find customer ID from name (will need to enhance this)
        $('#editCustomerSelect').val(editingCustomerId || '');
    }
    
    // Populate items
    editingItems = data.items.map(item => ({
        name: item.name,
        description: item.description || '',
        quantity: item.quantity,
        unitPrice: item.unitPrice,
        totalPrice: item.totalPrice,
        inventoryItemId: item.inventoryItemId || null,
        costPrice: item.costPrice || 0,
        isCustomItem: false
    }));
    
    renderEditItems();
    
    // Set tax
    $('#editTax').val(data.totals.tax || 0);
    
    // Set payment info
    $('#editPaymentStatus').val(data.payment.status || 'Paid');
    if (data.payment.methods && data.payment.methods.length > 0) {
        $('#editPaymentMethod').val(data.payment.methods[0].method || 'Cash');
    }
    
    recalculateEditTotals();
}

// Render items in edit table
function renderEditItems() {
    const tbody = $('#editItemsTableBody');
    tbody.html('');
    
    editingItems.forEach((item, index) => {
        const row = $(`
            <tr data-index="${index}">
                <td>
                    <input type="text" class="form-control form-control-sm" value="${item.name}" 
                           onchange="updateEditItem(${index}, 'name', this.value)">
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm" value="${item.description}" 
                           onchange="updateEditItem(${index}, 'description', this.value)">
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm" value="${item.quantity}" min="1"
                           onchange="updateEditItem(${index}, 'quantity', parseInt(this.value))">
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm" value="${item.unitPrice.toFixed(2)}" step="0.01" min="0"
                           onchange="updateEditItem(${index}, 'unitPrice', parseFloat(this.value))">
                </td>
                <td class="text-end">$${item.totalPrice.toFixed(2)}</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-danger" onclick="removeEditItem(${index})">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        `);
        tbody.append(row);
    });
}

// Update item in editing array
function updateEditItem(index, field, value) {
    editingItems[index][field] = value;
    
    // Recalculate total price for this item
    if (field === 'quantity' || field === 'unitPrice') {
        editingItems[index].totalPrice = editingItems[index].quantity * editingItems[index].unitPrice;
    }
    
    renderEditItems();
    recalculateEditTotals();
}

// Remove item from editing array
function removeEditItem(index) {
    if (confirm('Are you sure you want to remove this item?')) {
        editingItems.splice(index, 1);
        renderEditItems();
        recalculateEditTotals();
    }
}

// Recalculate totals
function recalculateEditTotals() {
    const subtotal = editingItems.reduce((sum, item) => sum + item.totalPrice, 0);
    const tax = parseFloat($('#editTax').val()) || 0;
    const discount = 0; // Can be enhanced later
    const total = subtotal + tax - discount;
    
    $('#editSubtotal').text('$' + subtotal.toFixed(2));
    $('#editDiscount').text('$' + discount.toFixed(2));
    $('#editTotal').text('$' + total.toFixed(2));
}

// Load customers for dropdown
function loadCustomersForEdit() {
    $.ajax({
        url: '@Url.Action("GetCustomers", "POS")',
        type: 'GET',
        success: function(response) {
            const select = $('#editCustomerSelect');
            select.html('<option value="">Walk-in Customer</option>');
            
            if (response && Array.isArray(response)) {
                response.forEach(customer => {
                    select.append(`<option value="${customer.id}">${customer.firstName} ${customer.lastName}</option>`);
                });
            }
        },
        error: function(xhr) {
            console.error('Error loading customers:', xhr);
        }
    });
}

// Search items for adding
function searchItemsForEdit(query) {
    $.ajax({
        url: '@Url.Action("SearchItemsTab", "POS")',
        type: 'GET',
        data: { query: query },
        success: function(response) {
            const resultsDiv = $('#searchItemResults');
            resultsDiv.html('');
            
            if (response && response.length > 0) {
                response.forEach(item => {
                    const resultItem = $(`
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <strong>${item.Name}</strong>
                                    <br><small>${item.SKU || ''}</small>
                                </div>
                                <div class="text-end">
                                    <strong>$${item.Price.toFixed(2)}</strong>
                                </div>
                            </div>
                        </a>
                    `);
                    
                    resultItem.click(function(e) {
                        e.preventDefault();
                        $('#newItemName').val(item.Name);
                        $('#newItemPrice').val(item.Price);
                        $('#searchItemResults').html('');
                    });
                    
                    resultsDiv.append(resultItem);
                });
            } else {
                resultsDiv.html('<div class="list-group-item">No items found</div>');
            }
        },
        error: function(xhr) {
            console.error('Error searching items:', xhr);
        }
    });
}

// Add new item to invoice
function addNewItemToInvoice() {
    const name = $('#newItemName').val().trim();
    const description = $('#newItemDescription').val().trim();
    const quantity = parseInt($('#newItemQuantity').val()) || 1;
    const unitPrice = parseFloat($('#newItemPrice').val()) || 0;
    
    if (!name) {
        alert('Please enter item name');
        return;
    }
    
    editingItems.push({
        name: name,
        description: description,
        quantity: quantity,
        unitPrice: unitPrice,
        totalPrice: quantity * unitPrice,
        inventoryItemId: null,
        costPrice: 0,
        isCustomItem: true
    });
    
    renderEditItems();
    recalculateEditTotals();
    $('#addItemModal').modal('hide');
}

// Save invoice changes
function saveInvoiceChanges() {
    if (!currentEditingSaleId) {
        alert('No invoice selected');
        return;
    }
    
    if (editingItems.length === 0) {
        alert('Invoice must have at least one item');
        return;
    }
    
    const customerId = $('#editCustomerSelect').val();
    const tax = parseFloat($('#editTax').val()) || 0;
    const paymentStatus = $('#editPaymentStatus').val();
    const paymentMethod = $('#editPaymentMethod').val();
    
    const updateData = {
        SaleId: currentEditingSaleId,
        CustomerId: customerId ? parseInt(customerId) : null,
        Items: editingItems.map(item => ({
            ItemName: item.name,
            Description: item.description,
            Quantity: item.quantity,
            UnitPrice: item.unitPrice,
            DiscountAmount: 0,
            CostPrice: item.costPrice,
            InventoryItemId: item.inventoryItemId,
            IsCustomItem: item.isCustomItem
        })),
        TaxAmount: tax,
        PaymentStatus: paymentStatus,
        Payments: [{
            Amount: parseFloat($('#editTotal').text().replace('$', '')),
            PaymentMethod: paymentMethod,
            TransactionId: ''
        }]
    };
    
    $.ajax({
        url: '@Url.Action("UpdateSale", "POS")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(updateData),
        success: function(response) {
            if (response.success) {
                alert('Invoice updated successfully!');
                $('#invoiceEditModal').modal('hide');
                
                // Refresh the page or table
                if (typeof loadSalesData === 'function') {
                    loadSalesData(); // For Sales Report
                }
                location.reload(); // Fallback
            } else {
                alert('Error: ' + response.message);
            }
        },
        error: function(xhr) {
            console.error('Error saving invoice:', xhr);
            alert('Error saving invoice. Please try again.');
        }
    });
}

// Debounce helper
function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
        const later = () => {
            clearTimeout(timeout);
            func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
    };
}

// Initialize on document ready
$(document).ready(function() {
    initInvoiceEditModal();
});
</script>

<style>
#editItemsTableBody input {
    font-size: 0.875rem;
}

#searchItemResults {
    position: relative;
    z-index: 1050;
}

.modal-xl {
    max-width: 1200px;
}
</style>
