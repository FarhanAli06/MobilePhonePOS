<!-- Global Add New Repair Modal -->
<div class="modal fade" id="addNewRepairModal" tabindex="-1" role="dialog" aria-labelledby="addNewRepairModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addNewRepairModalLabel">Add New Repair</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="createRepairForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="repairCustomer">Customer <span class="text-danger">*</span></label>
                                <select class="form-control select2-customer" id="repairCustomer" name="CustomerId" required></select>
                            </div>
                            <div class="form-group">
                                <label for="repairIssue">Issue <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="repairIssue" name="Issue" required>
                            </div>
                            <div class="form-group">
                                <label for="repairCost">Cost <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" id="repairCost" name="Cost" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="repairBrand">Brand</label>
                                <select class="form-control" id="repairBrand" name="BrandId"></select>
                            </div>
                            <div class="form-group">
                                <label for="repairModel">Model</label>
                                <select class="form-control" id="repairModel" name="DeviceModelId"></select>
                            </div>
                            <div class="form-group">
                                <label for="repairDescription">Description</label>
                                <textarea class="form-control" id="repairDescription" name="Description"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Repair</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Initialize Select2 for Customer Search
        $('#repairCustomer').select2({
            dropdownParent: $('#addNewRepairModal'),
            theme: "bootstrap-5",
            placeholder: "Search by Name, Phone, or Email",
            minimumInputLength: 2,
            ajax: {
                url: '@Url.Action("SearchCustomers", "Customers")',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        term: params.term // search term
                    };
                },
                processResults: function (data) {
                    var results = data.map(function(item) {
                        return {
                            id: item.id,
                            text: item.firstName + ' ' + item.lastName + ' (' + (item.phone || item.email || 'No Contact') + ')'
                        };
                    });

                    // Add "Create New Customer" option if no results
                    if (results.length === 0) {
                        results.push({
                            id: 'new',
                            text: 'Create New Customer: ' + params.term,
                            isNew: true
                        });
                    }

                    return {
                        results: results
                    };
                },
                cache: true
            }
        }).on('select2:select', function (e) {
            var data = e.params.data;
            if (data.isNew) {
                // Open the Add New Customer modal
                $('#addNewRepairModal').modal('hide');
                $('#addNewCustomerModal').modal('show');
                // Pre-fill the first name field with the search term for convenience
                $('#customerFirstName').val(data.text.replace('Create New Customer: ', ''));
            }
        });

        // --- Repair Creation ---
        $('#createRepairForm').on('submit', function (e) {
            e.preventDefault();
            var formData = $(this).serialize();

            $.post('@Url.Action("Create", "Repairs")', formData)
                .done(function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                        $('#addNewRepairModal').modal('hide');
                        $('#createRepairForm')[0].reset();
                        // Optionally reload the repairs page or update the list
                    } else {
                        toastr.error(response.message);
                    }
                })
                .fail(function (xhr) {
                    toastr.error("An error occurred during repair creation.");
                });
        });
    });
</script>
