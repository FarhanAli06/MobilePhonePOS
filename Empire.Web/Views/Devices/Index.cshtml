@model IEnumerable<Empire.Web.DTOs.Device.DeviceSelectionDto>
@{
    ViewData["Title"] = "Device Management";
}

<style>
    .device-view-toggle { display:inline-flex; padding:4px; gap:4px; border:1px solid #dfe5ee; border-radius:12px; background:#f7f9fc; }
    .device-view-toggle .btn { border:0; border-radius:8px; color:#667085; min-width:40px; }
    .device-view-toggle .btn.active { color:#fff; background:#2563eb; box-shadow:0 4px 10px rgba(37,99,235,.22); }
    #devicesGridView { display:none; grid-template-columns:repeat(auto-fill,minmax(285px,1fr)); gap:16px; }
    #devicesGridView .grid-column-all { grid-column:1/-1; }
    .device-grid-card { border:1px solid #e2e8f0; border-radius:16px; background:#fff; padding:17px; box-shadow:0 4px 15px rgba(15,23,42,.045); }
    .device-grid-card .device-grid-icon { width:44px; height:44px; display:grid; place-items:center; border-radius:13px; color:#2563eb; background:#eff6ff; font-size:20px; }
    .device-grid-card .device-grid-specs { display:grid; grid-template-columns:1fr 1fr; gap:9px; margin:14px 0; }
    .device-grid-card .device-grid-specs > div { border-radius:10px; background:#f8fafc; padding:8px 10px; }
    .device-grid-card .device-grid-specs small { display:block; color:#64748b; }
    .device-grid-actions { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; }
    .device-grid-actions .btn { white-space:nowrap; }
    .device-history-entry { border-left:3px solid #2563eb; padding:4px 0 4px 14px; margin-bottom:16px; }
    .device-history-change { display:grid; grid-template-columns:minmax(90px,.8fr) 1fr 22px 1fr; gap:8px; align-items:center; margin-top:8px; padding:9px 10px; border-radius:10px; background:#f8fafc; font-size:.9rem; }
    .device-history-change .old-value { color:#b42318; text-decoration:line-through; }
    .device-history-change .new-value { color:#067647; font-weight:700; }
    .create-device-section { border:1px solid #e2e8f0; border-radius:14px; background:#f8fafc; padding:18px; margin-bottom:16px; }
    .create-device-section-title { display:flex; align-items:center; gap:10px; margin-bottom:14px; color:#1e293b; font-weight:800; }
    .create-device-section-title span { width:28px; height:28px; display:grid; place-items:center; color:#2563eb; background:#dbeafe; border-radius:8px; }
    #createDeviceModal .form-label { min-height:20px; margin-bottom:6px; color:#334155; font-size:.84rem; font-weight:700; }
    #createDeviceModal .form-control, #createDeviceModal .form-select, #createDeviceModal .select2-selection { min-height:44px; border-color:#d7dee8; border-radius:10px; }
    #createDeviceModal .select2-selection__rendered { line-height:42px; }
    #createDeviceModal .select2-selection__arrow { height:42px; }
    #createDeviceLookupModal { z-index:1070; }
    .device-lookup-backdrop { z-index:1060 !important; }
    #createDeviceLookupModal .modal-content { border:0; border-radius:16px; overflow:hidden; box-shadow:0 24px 60px rgba(15,23,42,.3); }
    #createDeviceLookupModal .modal-header { padding:17px 20px; background:linear-gradient(135deg,#172033,#2563eb); color:#fff; }
    #createDeviceLookupModal .form-control { min-height:44px; border-radius:10px; }
    .device-label-preview-wrap { padding:18px; border-radius:14px; background:#e9edf3; overflow:auto; }
    .device-label-preview { position:relative; width:min(100%,675px); aspect-ratio:2.25/1.25; margin:auto; overflow:hidden; background:#fff; color:#000; font-family:Arial,sans-serif; box-shadow:0 8px 24px rgba(15,23,42,.18); }
    .device-label-preview-logo { position:absolute; top:.8%; left:40.4%; width:19.1%; height:16%; object-fit:contain; }
    .device-label-preview-model { position:absolute; left:2.7%; top:16%; width:94.6%; height:19.2%; display:flex; align-items:center; justify-content:center; overflow:hidden; white-space:nowrap; font-weight:700; line-height:1; }
    .device-label-preview-price { position:absolute; left:2.7%; top:36%; width:42.7%; height:20.8%; display:flex; align-items:center; overflow:hidden; white-space:nowrap; font-weight:700; line-height:1; }
    .device-label-preview-details { position:absolute; left:46.7%; top:34.4%; width:50.7%; height:34.4%; display:flex; align-items:center; overflow:hidden; white-space:pre-line; font-size:8pt; font-weight:700; line-height:1.12; }
    .device-label-preview-barcode { position:absolute; left:5.8%; top:72.8%; width:88.4%; height:17.6%; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; overflow:hidden; font-size:6pt; }
    .device-label-preview-bars { width:88%; flex:1; min-height:20px; background:repeating-linear-gradient(90deg,#000 0,#000 2px,#fff 2px,#fff 4px,#000 4px,#000 5px,#fff 5px,#fff 8px); }
    @@media(max-width:767px) { .device-history-change { grid-template-columns:1fr; } }
    @@media print {
        .no-print {
            display: none !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .table {
            font-size: 10px;
        }

            .table th, .table td {
                padding: 4px !important;
            }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <h2><i class="fas fa-mobile-alt me-2"></i>Devices for Sale</h2>
    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <div class="device-view-toggle" role="group" aria-label="Device view">
            <button type="button" class="btn active" id="deviceTableViewBtn" title="List view" aria-pressed="true"><i class="fas fa-list"></i></button>
            <button type="button" class="btn" id="deviceGridViewBtn" title="Grid view" aria-pressed="false"><i class="fas fa-th-large"></i></button>
        </div>
        <button type="button" class="btn btn-primary" id="addDeviceBtn">
            <i class="fas fa-plus me-2"></i>Add New Device
        </button>
        <button type="button" class="btn btn-success" id="availableDevicesBtn">
            <i class="fas fa-check-circle me-2"></i>Available for Sale
        </button>
        <button type="button" class="btn btn-info" id="soldDevicesBtn">
            <i class="fas fa-history me-2"></i>Sold Devices
        </button>
    </div>
</div>

<!-- Filter Section -->
<div class="card mb-4 no-print">
    <div class="card-body">
        <h5 class="card-title">Find a Device</h5>
        <form id="deviceFilterForm" class="row g-3">
            <div class="col-md-2">
                <label class="form-label">Device Type</label>
                <select class="form-select" id="filterDeviceType">
                    <option value="">All Types</option>
                    <option value="0">Phone</option>
                    <option value="1">Laptop</option>
                    <option value="2">Part</option>
                    <option value="3">Accessories</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Brand</label>
                <select class="form-select no-select2" id="filterBrand">
                    <option value="">All Brands</option>
                    @foreach (var brand in Model.Select(d => d.Brand).Where(b => !string.IsNullOrWhiteSpace(b)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(b => b))
                    {
                        <option value="@brand">@brand</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Model</label>
                <input type="text" class="form-control" id="filterModel" placeholder="Enter model">
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select class="form-select" id="filterStatus">
                    <option value="">All Status</option>
                    <option value="available">Available for Sale</option>
                    <option value="sold">Sold</option>
                    <option value="not-for-sale">Not for Sale</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Network Status</label>
                <select class="form-select" id="filterNetworkStatus">
                    <option value="">All</option>
                    <option value="Unlocked">Unlocked</option>
                    <option value="Locked">Locked</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Condition</label>
                <select class="form-select" id="filterCondition">
                    <option value="">All Conditions</option>
                    <option value="Excellent">Excellent</option>
                    <option value="None">No Scratches</option>
                    <option value="Minor">Minor Scratches</option>
                    <option value="Major">Major Scratches</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Company</label>
                <select class="form-select" id="filterCompany" style="width: 100%;">
                    <option value="">All Companies</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Search</label>
                <input type="text" class="form-control" id="filterSearch" placeholder="Brand, model, IMEI, color or carrier">
            </div>
            <div class="col-md-2">
                <label class="form-label">&nbsp;</label>
                <div class="d-grid gap-2 d-md-flex">
                    <button type="button" class="btn btn-primary" id="applyFiltersBtn">
                        <i class="fas fa-search me-2"></i>Filter
                    </button>
                    <button type="button" class="btn btn-secondary" id="clearFiltersBtn">
                        <i class="fas fa-refresh me-2"></i>Clear
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Devices Table -->
<div class="card" id="devicesTableView">
    <div class="card-body">
        <table id="devicesTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Device Details</th>
                    <th>IMEI/Serial</th>
                    <th>GB</th>
                    <th>Network Status</th>
                    <th>Selling Price</th>
                    <th>Condition</th>
                    <th>Notes</th>
                    <th>Status</th>
                    <th>Sold To</th>
                    <th>Created</th>
                    <th class="no-print">Actions</th>
                </tr>
            </thead>
            <tbody id="devicesTableBody">
                @foreach (var device in Model)
                {
                    <tr data-device-id="@device.Id">
                        <td>
                            <div class="fw-bold">@device.Brand @device.Model @(!string.IsNullOrEmpty(device.ModelNumber) ? $"({device.ModelNumber})" : "")</div>
                            <small class="text-muted">@device.DeviceType @(device.Year.HasValue ? $"({device.Year})" : "")</small>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@(device.IMEISerialNumber ?? "N/A")</span>
                        </td>
                        <td>
                            <span class="badge bg-info">@(device.GB ?? "N/A")</span>
                        </td>
                        <td>
                            <span class="badge @(device.NetworkStatus == "Unlocked" ? "bg-success" : "bg-warning")">
                                @device.NetworkStatus
                            </span>
                        </td>
                        <td>
                            <strong>$@(device.SellingPrice?.ToString("F2") ?? "0.00")</strong>
                            @if (device.BuyingPrice.HasValue)
                            {
                                <br>
                        
                                <small class="text-muted">Buy: $@device.BuyingPrice.Value.ToString("F2")</small>
                            }
                        </td>
                        <td>
                            <div>
                                <small>Battery: @(device.BatteryHealthPercentage ?? 0)%</small><br>
                                <small>Scratches: @device.ScratchesCondition</small>
                            </div>
                        </td>
                        <td>
                            <small>@(string.IsNullOrEmpty(device.Notes) ? "-" : device.Notes)</small>
                        </td>
                        <td class="status-cell">
                            @if (device.IsSold)
                            {
                                <span class="badge bg-success">Sold</span>
                                @if (device.SoldDate.HasValue)
                                {
                                    <br>
                                    <small class="text-muted">@device.SoldDate.Value.ToString("MM/dd/yyyy hh:mm tt")</small>
                                }
                            }
                            else if (device.IsAvailableForSale)
                            {
                                <span class="badge bg-primary">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Not for Sale</span>
                            }
                        </td>
                        <td>
                            @if (device.IsSold && !string.IsNullOrEmpty(device.SoldToCustomerName))
                            {
                                <span>@device.SoldToCustomerName</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <small>@device.CreatedDate.ToString("MM/dd/yyyy hh:mm tt")</small>
                        </td>
	                        <td class="actions-cell no-print">
	                            <div class="btn-group" role="group">
	                                @if (!device.IsSold && device.IsAvailableForSale)
	                                {
	                                    <button type="button" class="btn btn-sm btn-success add-to-cart-btn"
	                                            data-id="@device.Id"
	                                            data-brand="@device.Brand"
	                                            data-model="@device.Model"
	                                            data-price="@device.SellingPrice?.ToString("F2")"
	                                            data-imei="@device.IMEISerialNumber"
	                                            title="Add to POS Cart">
	                                        <i class="fas fa-cart-plus"></i>
	                                    </button>
	                                }
	                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="viewDevice(@device.Id)" title="View Details">
	                                    <i class="fas fa-eye"></i>
	                                </button>
	                                <button type="button" class="btn btn-sm btn-outline-warning" onclick="editDevice(@device.Id)" title="Edit">
	                                    <i class="fas fa-edit"></i>
	                                </button>
                                    <button type="button" class="btn btn-sm btn-outline-info" onclick="showDeviceHistory(@device.Id, '@($"{device.Brand} {device.Model}".Replace("'", "\\'"))')" title="History">
                                        <i class="fas fa-history"></i>
                                    </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary print-device-btn"
                                        data-device-id="@device.Id"
                                        data-brand="@device.Brand"
                                        data-model="@device.Model"
                                        data-storage="@device.GB"
                                        data-imei="@device.IMEISerialNumber"
                                        data-network-status="@device.NetworkStatus"
                                        data-carrier="@device.Carrier"
                                        data-buying-price="@device.BuyingPrice?.ToString("F2")"
                                        data-battery="@device.BatteryHealthPercentage"
                                        data-scratches="@device.ScratchesCondition"
                                        data-selling-price="@device.SellingPrice?.ToString("F2")"
                                        data-notes="@device.Notes"
                                        data-created-date="@device.CreatedDate.ToString("MM/dd/yyyy")">
	                                    <i class="fas fa-print"></i>
	                                </button>
	                                @if (!device.IsSold)
	                                {
	                                    <button type="button" class="btn btn-sm @(device.IsAvailableForSale ? "btn-outline-secondary" : "btn-outline-success")"
	                                            onclick="toggleAvailableForSale(@device.Id)"
	                                            title="@(device.IsAvailableForSale ? "Mark as Not for Sale" : "Mark as Available for Sale")">
	                                        <i class="fas @(device.IsAvailableForSale ? "fa-times" : "fa-check")"></i>
	                                    </button>
	                                }
	                                @if (!device.IsSold && device.IsAvailableForSale)
	                                {
	                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="markAsSold(@device.Id)" title="Mark as Sold">
	                                        <i class="fas fa-dollar-sign"></i>
	                                    </button>
	                                }
	                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteDevice(@device.Id)" title="Delete">
	                                    <i class="fas fa-trash"></i>
	                                </button>
	                            </div>
	                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div id="devicesGridView" aria-live="polite"></div>

<!-- Hidden Print Template for DYMO 2.25 x 1.25 inch inventory label -->
<div id="printTemplate" style="display: none;">
    <div class="dymo-label">
        <div class="label-header">
            <span class="brand-lockup">
                <img class="label-logo" src="/images/empire-logo.png" alt="Empire Solutions" />
                <span class="company-name">EMPIRE SOLUTIONS</span>
            </span>
            <span class="phone" id="printShopPhone"></span>
        </div>
        <div class="device-line" id="printDeviceInfo"></div>
        <div class="imei-line">
            <span>IMEI</span>
            <strong id="printIMEI"></strong>
        </div>
        <div class="label-bottom">
            <span id="printNetworkStatus"></span>
            <strong id="printSellPrice"></strong>
        </div>
        <div class="condition-line" id="printCondition"></div>
        <span id="printCreatedDate" hidden></span>
        <span id="printNotes" hidden></span>
    </div>
</div>

<!-- Create Device Modal -->
<div class="modal fade" id="createDeviceModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius:18px;overflow:hidden">
            <div class="modal-header text-white" style="background:linear-gradient(135deg,#111827,#2563eb);padding:18px 24px">
                <div><h5 class="modal-title mb-1"><i class="fas fa-mobile-alt me-2"></i>Add New Device</h5><small class="opacity-75">Device identity, specifications and pricing</small></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createDeviceForm">
                    <!-- ── Generic Brand → Category → Model selector ── -->
                    <div class="create-device-section">
                        <div class="create-device-section-title"><span>1</span><div>Choose the device<small class="d-block text-muted fw-normal">Brand, family and exact model</small></div></div>
                        <div id="createDeviceSelectorContainer"></div>
                        <input type="hidden" id="brandId"         name="BrandId" />
                        <input type="hidden" id="deviceCategoryId" name="DeviceCategoryId" />
                        <input type="hidden" id="deviceModelId"    name="DeviceModelId" />
                    </div>
                    <div class="create-device-section">
                        <div class="create-device-section-title"><span>2</span><div>Device details<small class="d-block text-muted fw-normal">Identity, condition, pricing and ownership</small></div></div>
                        <div class="row g-3 mx-0">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">IMEI/Serial Number</label>
                                <input type="text" class="form-control" id="imeiSerialNumber">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Storage</label>
                                <select class="form-select" id="gb"><option value="">Select or type storage</option><option value="16">16 GB</option><option value="32">32 GB</option><option value="64">64 GB</option><option value="128">128 GB</option><option value="256">256 GB</option><option value="512">512 GB</option><option value="1 TB">1 TB</option><option value="2 TB">2 TB</option></select>
                            </div>
                        </div>
                        <div class="col-md-6"><div class="mb-3"><label class="form-label fw-semibold">Color</label><input type="text" class="form-control" id="color" placeholder="Black, Blue, Natural Titanium"></div></div>
                        <div class="col-md-6"><div class="mb-3"><label class="form-label fw-semibold">Carrier</label><select class="form-select" id="carrier"><option value="">Select or type carrier</option><option>Unlocked</option><option>AT&amp;T</option><option>T-Mobile</option><option>Verizon</option><option>Boost Mobile</option><option>Metro by T-Mobile</option><option>Cricket</option><option>US Cellular</option></select></div></div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Battery Health (%)</label>
                                <input type="number" class="form-control" id="batteryHealth" min="0" max="100">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Network Status</label>
                                <select class="form-select" id="networkStatus">
                                    <option value="Unlocked">Unlocked</option>
                                    <option value="Locked">Locked</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Scratches</label>
                                <select class="form-select" id="scratches">
                                    <option value="Excellent">Excellent (No Scratches)</option>
                                    <option value="None">None</option>
                                    <option value="Minor">Minor</option>
                                    <option value="Major">Major</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Buying Price</label>
                                <input type="number" class="form-control" id="buyingPrice" step="0.01" min="0">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Selling Price</label>
                                <input type="number" class="form-control" id="sellingPrice" step="0.01" min="0">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Source</label>
                                <input type="text" class="form-control" id="source" placeholder="Where did you buy this device?">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="form-label" for="companyId">Owning company (optional)</label>
                                    <button type="button" class="btn btn-link btn-sm p-0" onclick="toggleNewDeviceCompany(true)">+ Add Company</button>
                                </div>
                                <select class="form-select" id="companyId">
                                    <option value="">Select Company (Optional)</option>
                                </select>
                                <div id="deviceCompanyNotice" class="form-text">Leave blank if this device belongs to your current store.</div>
                                <div id="newDeviceCompany" class="mt-2 d-none">
                                    <input id="newDeviceCompanyName" class="form-control form-control-sm" maxlength="100" placeholder="Company name" aria-label="New company name">
                                    <div class="d-flex gap-2 mt-2">
                                        <button type="button" class="btn btn-primary btn-sm" id="saveDeviceCompanyButton" onclick="createDeviceCompany()">Save Company</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleNewDeviceCompany(false)">Cancel</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="mb-3">
                                <label class="form-label">Notes</label>
                                <textarea class="form-control" id="notes" rows="3" placeholder="Any additional notes about the device condition or issues"></textarea>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="isAvailableForSale" checked>
                                <label class="form-check-label" for="isAvailableForSale">
                                    Available for Sale
                                </label>
                            </div>
                        </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createDevice()">
                    <i class="fas fa-plus me-2"></i>Add Device
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Saved Brand / Device Type / Model popup used inside Add New Device -->
<div class="modal fade" id="createDeviceLookupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1" id="deviceLookupModalTitle">Add New Brand</h5>
                    <small class="opacity-75">Saved for future devices</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="deviceLookupForm">
                    <input type="hidden" id="deviceLookupKind" />
                    <div class="alert alert-light border small" id="deviceLookupContext"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" id="deviceLookupNameLabel" for="deviceLookupName">Brand name</label>
                        <input type="text" class="form-control" id="deviceLookupName" maxlength="100" autocomplete="off" required />
                        <div class="invalid-feedback">Enter a name.</div>
                    </div>
                    <div class="row g-3 d-none" id="deviceLookupModelFields">
                        <div class="col-sm-7">
                            <label class="form-label fw-semibold" for="deviceLookupModelNumber">Model number <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="text" class="form-control" id="deviceLookupModelNumber" maxlength="100" placeholder="Example: A2849" />
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label fw-semibold" for="deviceLookupYear">Release year <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="number" class="form-control" id="deviceLookupYear" min="1980" max="2100" placeholder="2026" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label fw-semibold" for="deviceLookupDescription">Description <span class="text-muted fw-normal">(optional)</span></label>
                        <textarea class="form-control" id="deviceLookupDescription" rows="2" maxlength="250"></textarea>
                    </div>
                    <div class="alert alert-danger d-none mt-3 mb-0" id="deviceLookupError"></div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveDeviceLookupButton" onclick="saveDeviceLookup()">
                    <i class="fas fa-save me-2"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

