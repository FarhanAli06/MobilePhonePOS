@section Scripts {
    <!-- Select2 JS for searchable dropdowns -->
    
<script>
    let inventoryTable;
    let inventoryAllItems = [];
    let inventoryBrandNames = [];
    let inventoryMode = 'guided';
    let guidedBrowseOrder = 'brand';
    const isInventoryAdmin = @(isInventoryAdmin.ToString().ToLowerInvariant());
    const guidedSelection = { brand: null, family: null, part: null };

    $(document).ready(function() {
        // Initialize DataTable with AJAX data loading
        inventoryTable = $('#inventoryTable').DataTable({
            ajax: {
                url: '@Url.Action("GetInventoryItems", "Inventories")',
                type: 'GET',
                dataSrc: function(json) {
                    console.log('AJAX Response:', json); // Debug log
                    if (json && json.success) {
                        updateInventorySummary(json.data || []);
                        if (!inventoryAllItems.length || !String(inventoryTable?.ajax?.url?.() || '').includes('?')) {
                            inventoryAllItems = json.data || [];
                            renderGuidedInventory();
                        }
                        return json.data;
                    } else {
                        console.error('Error loading inventory data:', json ? json.message : 'No response');
                        return [];
                    }
                },
                error: function(xhr, error, thrown) {
                    console.error('AJAX Error:', error, thrown);
                    console.error('Response:', xhr.responseText);
                    alert('Error loading inventory data: ' + error + '. Please check console for details.');
                }
            },
            columns: [
                {
                    data: null, orderable: false, searchable: false,
                    render: function(data, type, row) {
                        return '<input type="checkbox" class="inventory-row-select" value="' + row.id + '" aria-label="Select ' + $('<div>').text(row.name).html() + '">';
                    }
                },
                {
                    data: 'name',
                    render: function(data, type, row) {
                        const path = [row.brandName, row.deviceCategoryName, row.deviceModelName].filter(x => x && x !== 'Unknown').join(' › ');
                        return '<div class="part-name">' + $('<div>').text(data || '').html() + '</div><div class="device-path">' + $('<div>').text(path).html() + '</div>';
                    }
                },
                { data: 'sku' },
                {
                    data: 'currentStock',
                    render: function(data, type, row) {
                        return '<input class="form-control form-control-sm inline-qty" value="' + (data || 0) + '" readonly title="Use Receive shipment or Stock movement to change quantity">';
                    }
                },
                { data: 'latestCost', render: function(data, type, row) { return '<button type="button" class="form-control form-control-sm inline-money text-end" onclick="showReceiveBatchModal(' + row.id + ', \'' + String(row.name).replace(/'/g, "\\'") + '\', ' + row.currentStock + ', ' + (data || 0) + ')" title="Receive a new cost batch">$' + parseFloat(data || 0).toFixed(2) + '</button>'; } },
                { data: 'averageCost', render: function(data) { return '$' + parseFloat(data || 0).toFixed(2); } },
                {
                    data: 'retailPrice',
                    render: function(data, type, row) {
                        return '<input type="number" min="0" step="0.01" class="form-control form-control-sm inline-money" value="' + parseFloat(data || 0).toFixed(2) + '" onchange="quickUpdateInventoryField(' + row.id + ',\'retailPrice\',this.value,this)">';
                    }
                },
                { data: 'reorderPoint', render: function(data, type, row) { return '<input type="number" min="0" class="form-control form-control-sm inline-qty" value="' + (data || 0) + '" onchange="quickUpdateInventoryField(' + row.id + ',\'reorderPoint\',this.value,this)">'; } },
