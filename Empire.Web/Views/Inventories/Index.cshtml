    async function prepareSupplierNewItem(rowIndex) {
        const line = supplierImportLines[rowIndex];
        if (!line) return;
        try {
            await supplierImportEnsureLookups();
            const brands = supplierImportLookups.brands;
            const categories = supplierImportLookups.categories;
            const models = supplierImportLookups.models;
            const detectedBrand = supplierImportDetectedBrand(line.description,brands);
            const detectedModelId = Number(line.detectedModelIds?.[0] || 0);
            const detectedExistingModel = models.find(model => Number(supplierLookupValue(model,'id','Id')) === detectedModelId);
            const suggested = supplierImportSuggestedModel(line, supplierLookupValue(detectedBrand,'name','Name') || '');
            const modelNumberMatch = suggested.modelNumber && models.find(model => supplierImportNormalize(supplierLookupValue(model,'modelNumber','ModelNumber')) === supplierImportNormalize(suggested.modelNumber));
            const existingModel = detectedExistingModel || modelNumberMatch || null;
            const brandId = Number(supplierLookupValue(existingModel,'brandId','BrandId') || supplierLookupValue(detectedBrand,'id','Id') || 0);
            const brandName = supplierLookupValue(existingModel,'brandName','BrandName') || supplierLookupValue(detectedBrand,'name','Name') || '';
            const categoryHint = /ipad|tablet/i.test(line.description) ? 'tablet' : /macbook|laptop/i.test(line.description) ? 'computer' : /playstation|ps5|xbox/i.test(line.description) ? 'console' : /watch/i.test(line.description) ? 'watch' : 'smartphone';
            const detectedCategory = categories.find(category => supplierImportNormalize(supplierLookupValue(category,'name','Name')).includes(categoryHint));
            const categoryId = Number(supplierLookupValue(existingModel,'deviceCategoryId','DeviceCategoryId') || supplierLookupValue(detectedCategory,'id','Id') || 0);

            $('#supplierNewPartRow').val(rowIndex);
            $('#supplierNewPartRaw').text(line.description);
            $('#supplierNewPartCleaned').val(line.cleanedDescription || supplierImportCleanDescription(line.description));
            $('#supplierNewPartSku').val(line.sku || '');
            $('#supplierNewPartQty').val(line.quantity || 1);
            $('#supplierNewPartCost').val(Number(line.unitCost || 0).toFixed(2));
            $('#supplierNewPartRetail').val('');
            $('#supplierNewPartReorder').val(2);
            $('#supplierNewPartColor').val(supplierImportDetectedColor(line.description));
            $('#supplierNewPartModelName').val(suggested.name || '');
            $('#supplierNewPartModelNumber').val(suggested.modelNumber || '');
            $('#supplierNewPartError').addClass('d-none').text('');

            const brandSelect = $('#supplierNewPartBrand').empty().append('<option value="">Choose brand…</option>');
            brands.forEach(brand => brandSelect.append(new Option(supplierLookupValue(brand,'name','Name'),supplierLookupValue(brand,'id','Id'))));
            brandSelect.val(brandId ? String(brandId) : '');
            const categorySelect = $('#supplierNewPartDeviceCategory').empty().append('<option value="">Choose category…</option>');
            categories.forEach(category => categorySelect.append(new Option(supplierLookupValue(category,'name','Name'),supplierLookupValue(category,'id','Id'))));
            categorySelect.val(categoryId ? String(categoryId) : '');

            supplierNewPartTemplates = new Map();
            const templateSelect = $('#supplierNewPartType').empty().append('<option value="">Choose part type…</option>');
            inventoryAllItems.filter(item => !/\bSERVICE_ONLY\b/i.test(item.notes || '')).forEach(item => {
                const partName = supplierImportPart([item.name,item.inventoryCategoryName,item.description].filter(Boolean).join(' ')) || item.name;
                const key = [Number(item.categoryId || item.itemId || 0),Number(item.inventoryCategoryId || 0),supplierImportNormalize(partName)].join(':');
                if (!supplierNewPartTemplates.has(key) && Number(item.categoryId || item.itemId || 0) > 0 && Number(item.inventoryCategoryId || 0) > 0) {
                    supplierNewPartTemplates.set(key,{categoryId:Number(item.categoryId || item.itemId),inventoryCategoryId:Number(item.inventoryCategoryId),partName:item.name || partName});
                }
            });
            [...supplierNewPartTemplates.entries()].sort((a,b) => a[1].partName.localeCompare(b[1].partName)).forEach(entry => templateSelect.append(new Option(entry[1].partName,entry[0])));
            const detectedPart = supplierImportPart(line.description);
            const preferredTemplate = [...supplierNewPartTemplates.entries()].find(entry => supplierImportPart(entry[1].partName) === detectedPart);
            if (preferredTemplate) templateSelect.val(preferredTemplate[0]);
            const quality = supplierImportQuality(line.description,brandName);
            const qualityOption = $('#supplierNewPartQuality option').filter(function(){ return supplierImportQuality(this.value,brandName) === quality; }).first();
            $('#supplierNewPartQuality').val(qualityOption.length ? qualityOption.val() : '');
            supplierNewPartTypeChanged();
            supplierNewPartRefreshModels(existingModel ? supplierLookupValue(existingModel,'id','Id') : 0);

            $('#supplierNewPartBrand,#supplierNewPartDeviceCategory').off('.supplierNew').on('change.supplierNew',function(){ supplierNewPartRefreshModels(); });
            $('#supplierNewPartExistingModel').off('.supplierNew').on('change.supplierNew',function(){ supplierNewPartToggleModelFields(); updateSupplierNewPartPreview(); });
            $('#supplierNewPartType').off('.supplierNew').on('change.supplierNew',supplierNewPartTypeChanged);
            $('#supplierNewPartModelName,#supplierNewPartModelNumber,#supplierNewPartName,#supplierNewPartQuality').off('.supplierNew').on('input.supplierNew change.supplierNew',updateSupplierNewPartPreview);

            supplierNewPartReturnToReview = true;
            bootstrap.Modal.getInstance(document.getElementById('supplierOrderImportModal'))?.hide();
            setTimeout(function(){ bootstrap.Modal.getOrCreateInstance(document.getElementById('supplierNewPartModal')).show(); },180);
        } catch(error) { showToast('error',error.message || 'The new-part popup could not be opened.'); }
    }
    async function createSupplierPartAndReceive() {
        const rowIndex = Number($('#supplierNewPartRow').val());
        const line = supplierImportLines[rowIndex];
        const button = $('#supplierNewPartCreate');
        const errorBox = $('#supplierNewPartError').addClass('d-none').text('');
        const brandId = Number($('#supplierNewPartBrand').val() || 0);
        const deviceCategoryId = Number($('#supplierNewPartDeviceCategory').val() || 0);
        const template = supplierNewPartTemplates.get($('#supplierNewPartType').val());
        const sku = $('#supplierNewPartSku').val().trim();
        const quantity = Number($('#supplierNewPartQty').val() || 0);
        const unitCost = Number($('#supplierNewPartCost').val());
        const partName = $('#supplierNewPartName').val().trim();
        if (!line || !brandId || !deviceCategoryId || !template || !partName || quantity < 1 || !Number.isFinite(unitCost) || unitCost < 0) {
            errorBox.removeClass('d-none').text('Complete Brand, Device category, Part type, Inventory name, Quantity, and Unit cost.'); return;
        }
        button.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Creating and receiving…');
        try {
            let inventoryItemId = 0;
            const exactSkuItem = sku ? inventoryAllItems.find(item => supplierImportNormalize(item.sku) === supplierImportNormalize(sku)) : null;
            if (exactSkuItem) {
                const expectedPart = supplierImportPart(line.description);
                const existingPart = supplierImportPart([exactSkuItem.name,exactSkuItem.inventoryCategoryName,exactSkuItem.description].filter(Boolean).join(' '));
                if (expectedPart && existingPart && expectedPart !== existingPart) {
                    throw new Error('SKU ' + sku + ' already exists as ' + existingPart + ', but this invoice line is a ' + expectedPart + '. Nothing was added. Correct the existing SKU mapping first.');
                }
                inventoryItemId = Number(exactSkuItem.id);
            } else {
                let deviceModelId = Number($('#supplierNewPartExistingModel').val() || 0);
                if (!deviceModelId) {
                    const modelName = $('#supplierNewPartModelName').val().trim();
                    const modelNumber = $('#supplierNewPartModelNumber').val().trim();
                    if (!modelName) throw new Error('Enter the new model name.');
                    const duplicateModel = (supplierImportLookups.models || []).find(model => Number(supplierLookupValue(model,'brandId','BrandId')) === brandId
                        && Number(supplierLookupValue(model,'deviceCategoryId','DeviceCategoryId')) === deviceCategoryId
                        && ((modelNumber && supplierImportNormalize(supplierLookupValue(model,'modelNumber','ModelNumber')) === supplierImportNormalize(modelNumber))
                            || supplierImportNormalize(supplierLookupValue(model,'name','Name')) === supplierImportNormalize(modelName)));
                    if (duplicateModel) deviceModelId = Number(supplierLookupValue(duplicateModel,'id','Id'));
                    else {
                        const modelResponse = await fetch('/LookupManagement/CreateDeviceModel',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                            Name:modelName,ModelNumber:modelNumber || null,Description:'Created from supplier invoice: ' + line.description,
                            BrandId:brandId,DeviceCategoryId:deviceCategoryId,DisplayOrder:1,IsActive:true
                        })}).then(response => response.json());
                        if (!modelResponse.success || !modelResponse.id) throw new Error(modelResponse.message || 'The device model could not be created.');
                        deviceModelId = Number(modelResponse.id);
                        supplierImportLookups.models.push(modelResponse.data || {id:deviceModelId,name:modelName,modelNumber,brandId,deviceCategoryId});
                    }
                }
                const quality = $('#supplierNewPartQualityWrap').hasClass('d-none') ? '' : $('#supplierNewPartQuality').val();
                const color = $('#supplierNewPartColor').val().trim();
                const duplicatePart = inventoryAllItems.find(item => Number(item.brandId) === brandId && Number(item.deviceModelId) === deviceModelId
                    && supplierImportPart([item.name,item.inventoryCategoryName,item.description].filter(Boolean).join(' ')) === supplierImportPart(partName)
                    && supplierImportNormalize(item.variant) === supplierImportNormalize(quality)
                    && supplierImportNormalize(item.color) === supplierImportNormalize(color));
                if (duplicatePart) inventoryItemId = Number(duplicatePart.id);
                else {
                    const createResponse = await fetch('@Url.Action("CreateInventoryItem", "Inventories")',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                        CategoryId:template.categoryId,Name:partName,SKU:sku,Variant:quality || '',Color:color,
                        Description:line.cleanedDescription || supplierImportCleanDescription(line.description),BrandId:brandId,
                        DeviceCategoryId:deviceCategoryId,DeviceModelId:deviceModelId,InventoryCategoryId:template.inventoryCategoryId,
                        CurrentStock:0,ReorderPoint:Number($('#supplierNewPartReorder').val() || 0),CostPrice:unitCost,
                        RetailPrice:Number($('#supplierNewPartRetail').val() || 0),WholesalePrice:0,EnableLowStockNotifications:true,IsActive:true,
                        Notes:'Supplier import source: ' + line.description
                    })}).then(response => response.json());
                    if (!createResponse.success || !createResponse.id) throw new Error(createResponse.message || 'The inventory part could not be created.');
                    inventoryItemId = Number(createResponse.id);
                }
            }
            const vendor = $('#supplierImportVendor').val();
            const reference = $('#supplierImportReference').val().trim();
            const receivedDate = $('#supplierImportDate').val();
            if (reference) {
                const history = await fetch('@Url.Action("BatchHistory", "Inventories")/' + inventoryItemId).then(response => response.json());
                const duplicateBatch = (history.data || []).some(batch => String(batch.referenceNumber || '').toLowerCase() === reference.toLowerCase()
                    && String(batch.vendor || '').toLowerCase() === String(vendor || '').toLowerCase());
                if (duplicateBatch) throw new Error('Order ' + reference + ' was already received for this inventory item. Nothing was added twice.');
            }
            const receiveResponse = await fetch('@Url.Action("ReceiveBatch", "Inventories")/' + inventoryItemId,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                Quantity:quantity,UnitCost:unitCost,Vendor:vendor,ReferenceNumber:reference,ReceivedDate:receivedDate || null,
                Notes:'Supplier SKU: ' + (sku || 'unknown') + ' | Original description: ' + line.description
            })}).then(response => response.json());
            if (!receiveResponse.success) throw new Error(receiveResponse.message || 'The inventory batch could not be received.');

            const importRow = document.querySelector('#supplierImportRows tr[data-row="' + rowIndex + '"]');
            if (importRow) {
                const select = importRow.querySelector('.supplier-import-match');
                if (select) { select.append(new Option(partName + ' (added)',inventoryItemId,true,true)); select.disabled = true; }
                const include = importRow.querySelector('.supplier-import-include');
                if (include) { include.checked = false; include.disabled = true; }
                const status = importRow.querySelector('.supplier-import-status');
                if (status) { status.className = 'supplier-import-status text-success fw-semibold'; status.textContent = 'Added to inventory'; }
            }
            line.imported = true; line.matchId = inventoryItemId;
            bootstrap.Modal.getInstance(document.getElementById('supplierNewPartModal'))?.hide();
            showToast('success',partName + ' created and ' + quantity + ' received into inventory.');
            inventoryAllItems = []; inventoryTable.ajax.reload(null,false); updateSupplierImportReady();
        } catch(error) {
            errorBox.removeClass('d-none').text(error.message || 'The supplier part could not be added.');
        } finally {
            button.prop('disabled',false).html('<i class="fas fa-plus me-1"></i>Create Part &amp; Add to Invoice');
        }
    }
    $(document).on('hidden.bs.modal','#supplierNewPartModal',function(){
        if (!supplierNewPartReturnToReview) return;
        supplierNewPartReturnToReview = false;
