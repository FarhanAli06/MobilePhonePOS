    const screenInventoryVariants = ['Incell','Soft OLED','Hard OLED','OEM','Original/Refurbished'];
    function screenVariantsForBrand(brand) { return /^samsung$/i.test(brand || '') ? ['Aftermarket','Original'] : screenInventoryVariants; }
    async function connectIphoneScreenQualities() {
        if (!isInventoryAdmin) return;
        const groups = new Map();
        inventoryAllItems.filter(item => /^apple$/i.test(item.brandName || '') && inventoryFamily(item) === 'iPhone' && inventoryPartType(item) === 'Screen' && Number(item.deviceModelId) > 0).forEach(item => {
            if (!groups.has(Number(item.deviceModelId))) groups.set(Number(item.deviceModelId), []);
            groups.get(Number(item.deviceModelId)).push(item);
        });
        const missing = [];
        groups.forEach(items => screenInventoryVariants.forEach(quality => {
            if (!items.some(item => String(item.variant || '').trim().toLowerCase() === quality.toLowerCase())) missing.push({template:items[0], quality});
        }));
        if (!missing.length) { showToast('success','All displayed iPhone screen qualities already have inventory items.'); return; }
        const button = document.getElementById('connectIphoneScreensButton');
        if (button) button.disabled = true;
        let created = 0; const failures = [];
        try {
            for (const entry of missing) {
                const template = entry.template;
                const sku = 'SC-' + template.brandId + '-' + template.deviceModelId + '-' + entry.quality.toUpperCase().replace(/[^A-Z0-9]+/g,'-').replace(/^-|-$/g,'');
                if (button) button.textContent = 'Connecting ' + (created + failures.length + 1) + ' / ' + missing.length + '…';
                try {
                    const response = await fetch('@Url.Action("CreateInventoryItem", "Inventories")', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                        CategoryId:template.categoryId || template.itemId, ItemId:template.itemId, Name:template.name, SKU:sku, Variant:entry.quality, Color:'',
                        BrandId:template.brandId, DeviceCategoryId:template.deviceCategoryId, DeviceModelId:template.deviceModelId,
                        InventoryCategoryId:template.inventoryCategoryId, CurrentStock:0, ReorderPoint:0,
                        CostPrice:0, RetailPrice:0, WholesalePrice:0, EnableLowStockNotifications:false, IsActive:true
                    })}).then(r => r.json());
                    if (!response.success || !response.id) throw new Error(response.message || 'Creation failed');
                    created++;
                } catch (error) { failures.push((template.deviceModelName || template.deviceModelId) + ' ' + entry.quality + ': ' + error.message); }
            }
            inventoryTable.ajax.reload();
            showToast(failures.length ? 'warning' : 'success', 'Connected ' + created + ' screen qualities.' + (failures.length ? ' ' + failures.length + ' could not be created; retry after reviewing them.' : ''));
            if (failures.length) console.warn('Screen quality inventory connection failures:', failures);
        } finally { if (button) { button.disabled = false; button.textContent = 'Connect screen qualities to inventory'; } }
    }
    let openBackGlassModelId = 0;
    let openInventoryVariantMode = 'Back Glass';
    let openInventoryVariantBrand = 'Apple';
    function inventoryModelSequence(referenceItem, matchVariantAndColor) {
        if (!referenceItem) return [];
        const brand = String(referenceItem.brandName || '').toLowerCase();
        const family = inventoryFamily(referenceItem);
        const part = inventoryPartType(referenceItem);
        const variant = String(referenceItem.variant || '').toLowerCase();
        const color = String(referenceItem.color || '').toLowerCase();
        const byModel = new Map();
        inventoryAllItems.filter(item => String(item.brandName || '').toLowerCase() === brand
            && inventoryFamily(item) === family
            && inventoryPartType(item) === part
            && (!matchVariantAndColor || (String(item.variant || '').toLowerCase() === variant && String(item.color || '').toLowerCase() === color)))
            .forEach(item => {
                const modelId = Number(item.deviceModelId || 0);
                if (modelId && !byModel.has(modelId)) byModel.set(modelId, item);
            });
        return [...byModel.values()].sort(newestModelFirst);
    }
    function renderInventoryModelTabs(containerId, sequence, activeModelId, onClickName) {
        const container = document.getElementById(containerId);
        if (!container) return;
        container.innerHTML = sequence.map(item => {
            const modelId = Number(item.deviceModelId || 0);
            const modelName = escapeInventoryHtml(item.deviceModelName || item.name || 'Model');
            return '<button type="button" class="inventory-model-tab ' + (modelId === Number(activeModelId) ? 'active' : '') + '" onclick="' + onClickName + '(' + modelId + ')">' + modelName + '</button>';
        }).join('');
        requestAnimationFrame(() => container.querySelector('.inventory-model-tab.active')?.scrollIntoView({behavior:'smooth', block:'nearest', inline:'center'}));
    }
    function groupedInventoryModelSequence() {
        const reference = inventoryAllItems.find(item => Number(item.deviceModelId) === openBackGlassModelId
            && String(item.brandName || '').toLowerCase() === openInventoryVariantBrand.toLowerCase()
            && inventoryPartType(item) === openInventoryVariantMode);
        return inventoryModelSequence(reference, false);
    }
    function groupedInventoryHasEntries() {
        return [...document.querySelectorAll('.backglass-add-qty')].some(input => Number(input.value) > 0);
    }
    function switchInventoryVariantModel(modelId) {
        if (Number(modelId) === openBackGlassModelId) return;
        if (groupedInventoryHasEntries() && !confirm('This model has unsaved quantities. Switch models and discard them?')) return;
        openBackGlassModel(modelId, openInventoryVariantMode);
    }
    function navigateInventoryVariantModel(direction) {
        const sequence = groupedInventoryModelSequence();
        const index = sequence.findIndex(item => Number(item.deviceModelId) === openBackGlassModelId);
        const target = sequence[index + Number(direction)];
        if (!target) { showToast('warning', direction > 0 ? 'This is the last model.' : 'This is the first model.'); return; }
        switchInventoryVariantModel(target.deviceModelId);
    }
    function openBackGlassModel(modelId, mode = 'Back Glass') {
        const modalWasOpen = document.getElementById('backGlassModelModal').classList.contains('show');
        openInventoryVariantMode = mode === 'Screen' ? 'Screen' : 'Back Glass';
        openInventoryVariantBrand = guidedSelection.brand || 'Apple';
        openBackGlassModelId = Number(modelId);
        const items = inventoryAllItems.filter(item => Number(item.deviceModelId) === openBackGlassModelId && String(item.brandName || '').toLowerCase() === openInventoryVariantBrand.toLowerCase() && inventoryPartType(item) === openInventoryVariantMode);
        if (!items.length) { showToast('error','No ' + openInventoryVariantMode.toLowerCase() + ' inventory record is available for this model.'); return; }
        const modelName = items[0].deviceModelName || items[0].name;
        const isScreen = openInventoryVariantMode === 'Screen';
        const screenVariants = screenVariantsForBrand(openInventoryVariantBrand);
        const options = isScreen ? [...new Set([...screenVariants, ...items.filter(item => !screenVariants.some(variant => variant.toLowerCase() === String(item.variant || '').toLowerCase())).map(item => item.variant || 'Unspecified')])] : (iphoneBackGlassColors[normalizedIphoneModel(modelName)] || []);
        renderInventoryModelTabs('backGlassModelTabs', groupedInventoryModelSequence(), openBackGlassModelId, 'switchInventoryVariantModel');
        $('#backGlassModelTitle').text(modelName + ' — ' + openInventoryVariantMode);
        $('#backGlassModelHelp').text('Enter quantities and purchase costs for several ' + (isScreen ? 'screen qualities' : 'colors') + ', then save once. Each option stays a separate inventory item and receives its own FIFO batch.');
        $('#saveBackGlassColorsButton').text('Save');
        if (!modalWasOpen) $('#backGlassVendor').val('');
        $('#backGlassColorRows').html('<div class="row fw-semibold border-bottom py-2"><div class="col-4">' + (isScreen ? 'Quality' : 'Color') + '</div><div class="col-2">In stock</div><div class="col-2">Add qty</div><div class="col-2">Unit cost</div><div class="col-2">Item</div></div>' + options.map(option => {
            const matchingItems = items.filter(x => String((isScreen ? x.variant : x.color) || 'Unspecified').toLowerCase() === option.toLowerCase());
            const item = matchingItems[0];
            const safe = escapeInventoryHtml(option);
            return '<div class="row align-items-center py-2 border-bottom backglass-edit-row" data-option="' + safe.replace(/"/g,'&quot;') + '" data-item-id="' + (item ? item.id : 0) + '">'
                + '<div class="col-4">' + safe + '</div><div class="col-2">' + matchingItems.reduce((sum,match) => sum + (match.currentStock || 0), 0) + '</div>'
                + '<div class="col-2"><input class="form-control form-control-sm backglass-add-qty" type="number" min="0" step="1" value="0" aria-label="Quantity for ' + safe + '"></div>'
                + '<div class="col-2"><input class="form-control form-control-sm backglass-unit-cost" type="number" min="0" step="0.01" value="' + (item ? parseFloat(item.latestCost || item.costPrice || 0).toFixed(2) : '0.00') + '" aria-label="Cost for ' + safe + '"></div>'
                + '<div class="col-2">' + (item ? '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="bootstrap.Modal.getInstance(document.getElementById(\'backGlassModelModal\')).hide();editInventoryItem(' + item.id + ')">Edit</button>' + (isInventoryAdmin && matchingItems.every(match => (match.currentStock || 0) === 0) ? ' <button type="button" class="btn btn-sm btn-outline-danger" title="Delete this empty inventory item" onclick="deleteInventoryItem(' + item.id + ',true)">Delete</button>' : '') : '<small class="text-muted">New</small>') + '</div></div>';
        }).join(''));
        bootstrap.Modal.getOrCreateInstance(document.getElementById('backGlassModelModal')).show();
    }

    async function saveBackGlassColors(moveAfter = 'stay') {
        const isScreen = openInventoryVariantMode === 'Screen';
        const template = inventoryAllItems.find(item => Number(item.deviceModelId) === openBackGlassModelId && String(item.brandName || '').toLowerCase() === openInventoryVariantBrand.toLowerCase() && inventoryPartType(item) === openInventoryVariantMode);
        if (!template) return;
        const rows = [...document.querySelectorAll('.backglass-edit-row')].map(row => ({
            option:row.dataset.option, id:Number(row.dataset.itemId), quantity:Number(row.querySelector('.backglass-add-qty').value), cost:Number(row.querySelector('.backglass-unit-cost').value)
        })).filter(row => row.quantity > 0);
        if (!rows.length) { showToast('warning','Enter a quantity for at least one option.'); return; }
        if (rows.some(row => !Number.isInteger(row.quantity) || row.quantity < 1 || !Number.isFinite(row.cost) || row.cost < 0)) { showToast('error','Enter valid whole quantities and costs.'); return; }
        const buttons = [...document.querySelectorAll('.inventory-variant-save')];
        buttons.forEach(button => button.disabled = true);
        const nextSequence = groupedInventoryModelSequence();
        const currentIndex = nextSequence.findIndex(item => Number(item.deviceModelId) === openBackGlassModelId);
        const nextModelId = moveAfter === 'next' && nextSequence[currentIndex + 1] ? Number(nextSequence[currentIndex + 1].deviceModelId) : 0;
        let saved = 0;
        try {
            for (const row of rows) {
                let id = row.id;
                if (!id) {
                    const sku = (isScreen ? 'SC-' : 'BG-') + template.brandId + '-' + template.deviceModelId + '-' + row.option.toUpperCase().replace(/[^A-Z0-9]+/g,'-').replace(/^-|-$/g,'');
                    const create = await fetch('@Url.Action("CreateInventoryItem", "Inventories")', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                        CategoryId:template.categoryId || template.itemId, Name:template.name, SKU:sku, Variant:isScreen ? row.option : '', Color:isScreen ? '' : row.option,
                        BrandId:template.brandId, DeviceCategoryId:template.deviceCategoryId, DeviceModelId:template.deviceModelId,
                        InventoryCategoryId:template.inventoryCategoryId, CurrentStock:0, ReorderPoint:template.reorderPoint || 0,
                        CostPrice:row.cost, RetailPrice:template.retailPrice || 0, WholesalePrice:template.wholesalePrice || 0,
                        EnableLowStockNotifications:template.enableLowStockNotifications, IsActive:true
                    })}).then(response => response.json());
                    if (!create.success || !create.id) throw new Error(create.message || 'Could not add ' + row.option);
                    id = create.id;
                }
                const receive = await fetch('@Url.Action("ReceiveBatch", "Inventories")/' + id, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                    Quantity:row.quantity, UnitCost:row.cost, Vendor:document.getElementById('backGlassVendor').value.trim(), ReceivedDate:new Date().toISOString().slice(0,10)
                })}).then(response => response.json());
                if (!receive.success) throw new Error(receive.message || 'Could not receive ' + row.option);
                saved++;
            }
            showToast('success','Received ' + saved + ' ' + (isScreen ? 'screen-quality' : 'back-glass color') + ' batches.');
            inventoryTable.ajax.reload(function() {
                openBackGlassModel(nextModelId || openBackGlassModelId, openInventoryVariantMode);
                if (moveAfter === 'next' && !nextModelId) showToast('warning','Saved. This is the last model.');
            }, false);
        } catch (error) { showToast('error',(saved ? saved + ' saved; ' : '') + error.message); inventoryTable.ajax.reload(); }
        finally { buttons.forEach(button => button.disabled = false); }
    }

    function normalizedIphoneModel(modelName) {
        return (modelName || '').toLowerCase().replace(/^apple\s+/, '').replace(/\s+/g, ' ').trim();
    }

    function updateInventoryPartOptions() {
        const partName = $('#itemId option:selected').text().trim().toLowerCase();
        const state = window.EmpireDeviceSelector ? EmpireDeviceSelector.getState('inventoryItem') : {};
        const isScreen = partName === 'screen';
        const isBackGlass = partName === 'back glass';
        $('#screenVariantField').toggleClass('d-none', !isScreen);
        if (isScreen) {
            const previousVariant = $('#itemVariant').val() || $('#itemVariant').data('existingVariant') || '';
            $('#itemVariant').removeData('existingVariant');
            const variants = screenVariantsForBrand(state.brandName);
            $('#itemVariant').empty().append(new Option('-- Select Screen Quality --', ''));
            variants.forEach(variant => $('#itemVariant').append(new Option(variant, variant)));
            if (previousVariant && !variants.includes(previousVariant)) $('#itemVariant').append(new Option(previousVariant + ' (existing)', previousVariant));
            if (previousVariant) $('#itemVariant').val(previousVariant);
        }
        if (!isScreen) $('#itemVariant').val('').removeClass('is-invalid');

        const colors = state.brandName === 'Apple' ? (iphoneBackGlassColors[normalizedIphoneModel(state.modelName)] || []) : [];
        if (isBackGlass && state.modelId && colors.length === 0) {
            $('#itemId').val('').trigger('change.select2');
            $('#backGlassColorField').addClass('d-none');
            showToast('warning', 'Back Glass is only available for compatible iPhone models.');
            return;
        }
        const canUseBackGlass = isBackGlass && colors.length > 0;
        $('#backGlassColorField').toggleClass('d-none', !canUseBackGlass);
        const previousColor = $('#itemColor').val();
        $('#itemColor').empty().append('<option value="">-- Select Original Phone Color --</option>');
        colors.forEach(color => $('#itemColor').append($('<option>', { value: color, text: color })));
        if (colors.includes(previousColor)) $('#itemColor').val(previousColor);
        if (!canUseBackGlass) $('#itemColor').val('').removeClass('is-invalid');
    }

    $(document).on('change', '#itemId', updateInventoryPartOptions);
    document.addEventListener('eds:modelSelected', function(event) {
        if (event.detail && event.detail.selectorId === 'inventoryItem') {
            updateInventoryPartOptions();
            updateCompatibleModelOptions();
        }
    });

