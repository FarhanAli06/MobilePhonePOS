@{
    ViewData["Title"] = "Inventory Management";
}

@section Styles {
    <!-- Select2 CSS for searchable dropdowns -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    
    <style>
        /* Ensure table header text is visible */
        #inventoryTable thead th {
            background-color: #212529 !important;
            color: #ffffff !important;
            font-weight: 600;
            padding: 12px;
        }
        
        /* Ensure DataTables controls are visible */
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            color: #212529 !important;
        }
        
        /* Ensure table body text is visible */
        #inventoryTable tbody td {
            color: #212529;
            padding: 10px;
        }
        
        /* Fix modal backdrop and overlay - CLEAN approach */
        .modal-backdrop {
            z-index: 1040 !important;
            background-color: rgba(0, 0, 0, 0.5) !important;
        }
        
        .modal {
            z-index: 1050 !important;
            /* DO NOT add background-color here - it makes modal black! */
        }
        
        .modal-dialog {
            z-index: 1051 !important;
        }
        
        .modal-content {
            z-index: 1052 !important;
            background-color: #fff !important;
        }
        
        /* Select2 dropdowns MUST be above modal */
        .select2-dropdown {
            z-index: 10000 !important;
            background-color: white !important;
        }
        
        .select2-container--open .select2-dropdown {
            z-index: 10001 !important;
        }
        
        .select2-results {
            background-color: white !important;
        }
        
        /* Make sure Select2 search box is visible and functional */
        .select2-container--open .select2-search--dropdown .select2-search__field {
            background-color: white !important;
            border: 1px solid #ced4da !important;
        }
               /* Make sure Select2 search input is accessible */
        .select2-search__field {
            width: 100% !important;
        }

        /* Inventory modal section cards */
        .section-card {
            border-color: #dee2e6 !important;
            transition: box-shadow 0.15s ease;
        }
        .section-card:hover {
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }
        .section-title {
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid #dee2e6;
            padding-bottom: 0.5rem;
        }
        /* SKU preview badge */
        #skuPreviewBadge code {
            font-size: 1rem;
            font-weight: 600;
            color: #0a3622;
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-boxes me-2"></i>Inventory Management</h2>
        <p class="text-muted mb-0">Manage inventory items with proper categorization and stock tracking</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" onclick="showAddInventoryItemModal()">
            <i class="fas fa-plus me-2"></i>Add Inventory Item
        </button>
        <button type="button" class="btn btn-info" onclick="showLowStockReport()">
            <i class="fas fa-exclamation-triangle me-2"></i>Low Stock Report
        </button>
        <button type="button" class="btn btn-success" onclick="showStockMovements()">
            <i class="fas fa-exchange-alt me-2"></i>Stock Movements
        </button>
        <button type="button" class="btn btn-warning" onclick="testAjaxCall()">
            <i class="fas fa-bug me-2"></i>Test API Call
        </button>
    </div>
</div>

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Filter Inventory Items</h5>
    </div>
    <div class="card-body">
        <form id="inventoryFilterForm" class="row g-3">
            <div class="col-md-2">
                <label class="form-label">Brand</label>
                <select class="form-select" id="filterBrand">
                    <option value="">All Brands</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Device Category</label>
                <select class="form-select" id="filterDeviceCategory">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Device Model</label>
                <select class="form-select" id="filterDeviceModel">
                    <option value="">All Models</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Inventory Category</label>
                <select class="form-select" id="filterInventoryCategory">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Stock Status</label>
                <select class="form-select" id="filterStockStatus">
                    <option value="">All Status</option>
                    <option value="in_stock">In Stock</option>
                    <option value="low_stock">Low Stock</option>
                    <option value="out_of_stock">Out of Stock</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-primary me-2" onclick="applyFilters()">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="clearFilters()">
                    <i class="fas fa-times me-1"></i>Clear
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Inventory Items Table -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Inventory Items</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="inventoryTable" class="table table-striped table-hover">
                <thead class="table-dark" style="background-color: #212529; color: #ffffff;">
                    <tr>
                        <th>Name</th>
                        <th>SKU</th>
                        <th>Brand</th>
                        <th>Category</th>
                        <th>Model</th>
                        <th>Current Stock</th>
                        <th>Reorder Point</th>
                        <th>Cost Price</th>
                        <th>Retail Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add/Edit Inventory Item Modal -->
<div class="modal fade" id="inventoryItemModal" tabindex="-1" aria-labelledby="inventoryItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header bg-primary text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-box-open fs-5"></i>
                    <h5 class="modal-title mb-0" id="inventoryItemModalLabel">Add Inventory Item</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <form id="inventoryItemForm" novalidate>
                    <input type="hidden" id="inventoryItemId" value="0">

                    <!-- ── Section 1: Device ──────────────────────────────────────── -->
                    <div class="section-card mb-4 p-3 border rounded bg-light">
                        <h6 class="section-title text-primary mb-3">
                            <i class="fas fa-mobile-alt me-2"></i>Device Selection
                            <span class="text-danger">*</span>
                        </h6>
                        <div id="inventorySelectorContainer"></div>
                        <input type="hidden" id="itemBrand"          name="BrandId" />
                        <input type="hidden" id="itemDeviceCategory" name="DeviceCategoryId" />
                        <input type="hidden" id="itemDeviceModel"    name="DeviceModelId" />
                        <div id="deviceSelectionError" class="text-danger small mt-1 d-none">
                            <i class="fas fa-exclamation-circle me-1"></i>Please select Brand, Category and Model.
                        </div>
                    </div>

                    <!-- ── Section 2: Item Details ───────────────────────────────── -->
                    <div class="section-card mb-4 p-3 border rounded bg-light">
                        <h6 class="section-title text-primary mb-3">
                            <i class="fas fa-tag me-2"></i>Item Details
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="itemId" class="form-label fw-semibold">
                                    Item Type <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" id="itemId" required style="width: 100%;">
                                    <option value="">-- Select Item Type --</option>
                                </select>
                                <div class="invalid-feedback">Please select an item type.</div>
                                <div class="form-text">
                                    e.g. Screen, Battery, Charging Port.
                                    <a href="/LookupManagement/Index" target="_blank" class="text-decoration-none">
                                        <i class="fas fa-external-link-alt me-1"></i>Manage Categories
                                    </a>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="itemInventoryCategory" class="form-label fw-semibold">
                                    Inventory Category <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" id="itemInventoryCategory" required>
                                    <option value="">-- Select Category --</option>
                                </select>
                                <div class="invalid-feedback">Please select an inventory category.</div>
                            </div>
                            <div class="col-md-12">
                                <label for="itemDescription" class="form-label fw-semibold">Description</label>
                                <textarea class="form-control" id="itemDescription" rows="2"
                                          placeholder="Optional: describe the part, condition, compatibility..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- ── Section 3: SKU ────────────────────────────────────────── -->
                    <div class="section-card mb-4 p-3 border rounded bg-light">
                        <h6 class="section-title text-primary mb-3">
                            <i class="fas fa-barcode me-2"></i>SKU / Identifier
                        </h6>
                        <div class="row g-3 align-items-end">
                            <div class="col-md-8">
                                <label for="itemSku" class="form-label fw-semibold">SKU</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                                    <input type="text" class="form-control" id="itemSku"
                                           placeholder="Leave blank to auto-generate">
                                    <button type="button" class="btn btn-outline-secondary" id="btnPreviewSku"
                                            onclick="previewSku()" title="Preview auto-generated SKU">
                                        <i class="fas fa-sync-alt me-1"></i>Preview
                                    </button>
                                </div>
                                <div class="form-text">Leave blank to auto-generate from Brand / Category / Model. Click Preview to see what will be generated.</div>
                            </div>
                            <div class="col-md-4">
                                <div id="skuPreviewBadge" class="d-none">
                                    <label class="form-label fw-semibold text-success">Generated SKU Preview</label>
                                    <div class="alert alert-success py-2 mb-0 d-flex align-items-center gap-2">
                                        <i class="fas fa-check-circle"></i>
                                        <code id="skuPreviewValue" class="fs-6"></code>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Section 4: Stock ──────────────────────────────────────── -->
                    <div class="section-card mb-4 p-3 border rounded bg-light">
                        <h6 class="section-title text-primary mb-3">
                            <i class="fas fa-warehouse me-2"></i>Stock Levels
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="itemCurrentStock" class="form-label fw-semibold">
                                    Initial Stock <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-cubes"></i></span>
                                    <input type="number" class="form-control" id="itemCurrentStock" min="0" value="0" required>
                                </div>
                                <div class="form-text">Set opening quantity. Use Stock Movements for future changes.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="itemReorderPoint" class="form-label fw-semibold">Reorder Point</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-exclamation-triangle text-warning"></i></span>
                                    <input type="number" class="form-control" id="itemReorderPoint" min="0" value="5">
                                </div>
                                <div class="form-text">Alert when stock falls to or below this level.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold d-block">&nbsp;</label>
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           id="itemLowStockNotifications" checked>
                                    <label class="form-check-label" for="itemLowStockNotifications">
                                        <i class="fas fa-bell me-1 text-warning"></i>Low Stock Alerts
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Section 5: Pricing ────────────────────────────────────── -->
                    <div class="section-card mb-4 p-3 border rounded bg-light">
                        <h6 class="section-title text-primary mb-3">
                            <i class="fas fa-dollar-sign me-2"></i>Pricing
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="itemCostPrice" class="form-label fw-semibold">Cost Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="itemCostPrice"
                                           step="0.01" min="0" placeholder="0.00">
                                </div>
                                <div class="form-text">What you paid for it.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="itemRetailPrice" class="form-label fw-semibold">Retail Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="itemRetailPrice"
                                           step="0.01" min="0" placeholder="0.00">
                                </div>
                                <div class="form-text">Sell price to walk-in customers.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="itemWholesalePrice" class="form-label fw-semibold">Wholesale Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="itemWholesalePrice"
                                           step="0.01" min="0" placeholder="0.00">
                                </div>
                                <div class="form-text">Bulk / trade price.</div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Section 6: Notes & Status ─────────────────────────────── -->
                    <div class="section-card p-3 border rounded bg-light">
                        <h6 class="section-title text-primary mb-3">
                            <i class="fas fa-sticky-note me-2"></i>Notes &amp; Status
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-9">
                                <label for="itemNotes" class="form-label fw-semibold">Notes</label>
                                <textarea class="form-control" id="itemNotes" rows="2"
                                          placeholder="Any additional notes about this item..."></textarea>
                            </div>
                            <div class="col-md-3 d-flex align-items-center">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           id="itemIsActive" checked>
                                    <label class="form-check-label fw-semibold" for="itemIsActive">
                                        <i class="fas fa-toggle-on me-1 text-success"></i>Active
                                    </label>
                                    <div class="form-text">Inactive items are hidden from POS.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary px-4" id="btnSaveInventoryItem"
                        onclick="saveInventoryItem()">
                    <i class="fas fa-save me-1"></i><span id="btnSaveLabel">Save Item</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Stock Movement Modal -->
<div class="modal fade" id="stockMovementModal" tabindex="-1" aria-labelledby="stockMovementModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="stockMovementModalLabel">Record Stock Movement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="stockMovementForm">
                    <input type="hidden" id="movementInventoryItemId">
                    
                    <div class="mb-3">
                        <label for="movementType" class="form-label">Movement Type *</label>
                        <select class="form-select" id="movementType" required>
                            <option value="">Select Type</option>
                            <option value="IN">Stock In</option>
                            <option value="OUT">Stock Out</option>
                            <option value="ADJUSTMENT">Adjustment</option>
                            <option value="TRANSFER">Transfer</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label for="movementQuantity" class="form-label">Quantity *</label>
                        <input type="number" class="form-control" id="movementQuantity" min="1" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="movementUnitCost" class="form-label">Unit Cost</label>
                        <input type="number" class="form-control" id="movementUnitCost" step="0.01" min="0">
                    </div>
                    
                    <div class="mb-3">
                        <label for="movementReason" class="form-label">Reason *</label>
                        <input type="text" class="form-control" id="movementReason" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="movementReference" class="form-label">Reference Number</label>
                        <input type="text" class="form-control" id="movementReference">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveStockMovement()">Record Movement</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Select2 JS for searchable dropdowns -->
    
<script>
    let inventoryTable;

    $(document).ready(function() {
        // Initialize DataTable with AJAX data loading
        inventoryTable = $('#inventoryTable').DataTable({
            ajax: {
                url: '@Url.Action("GetInventoryItems", "Inventories")',
                type: 'GET',
                dataSrc: function(json) {
                    console.log('AJAX Response:', json); // Debug log
                    if (json && json.success) {
                        return json.data;
                    } else {
                        console.error('Error loading inventory data:', json ? json.message : 'No response');
                        return [];
                    }
                },
                error: function(xhr, error, thrown) {
                    console.error('AJAX Error:', error, thrown);
                    console.error('Response:', xhr.responseText);
                    alert('Error loading inventory data: ' + error + '. Please check console for details.');
                }
            },
            columns: [
                {
                    data: 'name',
                    render: function(data, type, row) {
                        let html = '<strong>' + data + '</strong>';
                        if (row.description) {
                            html += '<br><small class="text-muted">' + row.description + '</small>';
                        }
                        return html;
                    }
                },
                { data: 'sku' },
                { data: 'brandName' },
                { data: 'inventoryCategoryName' },
                { data: 'deviceModelName' },
                {
                    data: 'currentStock',
                    render: function(data, type, row) {
                        const isLow = row.isLowStockAggregated;
                        const tip = (row.aggregatedStock !== undefined && row.aggregatedStock !== data)
                            ? ' title="Group total: ' + row.aggregatedStock + '"'
                            : '';
                        return '<span class="' + (isLow ? 'text-danger fw-bold' : '') + '"' + tip + '>' + data + '</span>';
                    }
                },
                { data: 'reorderPoint' },
                {
                    data: 'costPrice',
                    render: function(data) {
                        return '$' + parseFloat(data).toFixed(2);
                    }
                },
                {
                    data: 'retailPrice',
                    render: function(data) {
                        return '$' + parseFloat(data).toFixed(2);
                    }
                },
                {
                    data: null,
                    render: function(data, type, row) {
                        if (row.currentStock <= 0) {
                            return '<span class="badge bg-danger">Out of Stock</span>';
                        } else if (row.isLowStockAggregated) {
                            return '<span class="badge bg-warning" title="Group total: ' + (row.aggregatedStock || row.currentStock) + '">Low Stock</span>';
                        } else {
                            return '<span class="badge bg-success">In Stock</span>';
                        }
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function(data, type, row) {
                        return `
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-warning" onclick="editInventoryItem(${row.id})" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-outline-info" onclick="showStockMovementModal(${row.id})" title="Stock Movement">
                                    <i class="fas fa-exchange-alt"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" onclick="deleteInventoryItem(${row.id})" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        `;
                    }
                }
            ],
            responsive: true,
            pageLength: 25,
            order: [[0, 'asc']],
            language: {
                emptyTable: "No inventory items found"
            },
            rowCallback: function(row, data) {
                if (data.currentStock <= 0) {
                    $(row).addClass('table-danger');
                } else if (data.isLowStockAggregated) {
                    $(row).addClass('table-warning');
                }
            }
        });

        console.log('DataTable initialized with AJAX data loading');

        // Initialize Select2 for all dropdowns - same as device page
        safeInitializeSelect2();

        // Load inventory categories for the modal dropdown
        loadInventoryCategories();
        loadItems();
        // Load filter bar dropdowns
        loadFilterDropdowns();
    });

    // Use the same safeInitializeSelect2 function as device page
    function safeInitializeSelect2(selector = '.form-select') {
        try {
            if (typeof $.fn.select2 !== 'undefined') {
                $(selector).each(function() {
                    if (!$(this).hasClass('select2-hidden-accessible')) {
                        $(this).select2({
                            theme: 'bootstrap-5',
                            width: '100%',
                            placeholder: $(this).find('option:first').text(),
                            allowClear: true
                        });
                    }
                });
            } else {
                console.warn('Select2 not available, using standard dropdowns');
            }
        } catch (error) {
            console.error('Error initializing Select2:', error);
        }
    }

    // Load inventory categories from the InventoryCategories SQL table
    function loadInventoryCategories() {
        $.get('@Url.Action("GetInventoryCategories", "LookupManagement")')
            .done(function(response) {
                console.log('Inventory categories response:', response);
                const data = response.success ? response.data : (Array.isArray(response) ? response : []);
                $('#filterInventoryCategory, #itemInventoryCategory').each(function() {
                    const dropdown = $(this);
                    const firstOption = dropdown.find('option:first');
                    dropdown.empty().append(firstOption);
                    
                    if (data && Array.isArray(data)) {
                        data.forEach(function(category) {
                            const id = category.Id || category.id;
                            const name = category.Name || category.name;
                            dropdown.append(`<option value="${id}">${name}</option>`);
                        });
                    }
                });
                
                safeInitializeSelect2('#filterInventoryCategory, #itemInventoryCategory');
                console.log('Loaded', data.length, 'inventory categories successfully');
            })
            .fail(function(xhr, status, error) {
                console.error('Failed to load inventory categories:', error);
                alert('Failed to load inventory categories. Please refresh the page.');
            });
    }

    // Load item types from the Categories SQL table (categoryType = 'Inventory')
    function loadItems() {
        $.get('@Url.Action("GetCategories", "LookupManagement")', { categoryType: 'Inventory' })
            .done(function(response) {
                console.log('Item types (categories) response:', response);
                const data = response.success ? response.data : (Array.isArray(response) ? response : []);
                $('#itemId').each(function() {
                    const dropdown = $(this);
                    const firstOption = dropdown.find('option:first');
                    dropdown.empty().append(firstOption);
                    
                    if (data && Array.isArray(data)) {
                        data.forEach(function(item) {
                            if (item.isActive !== false) {
                                const id = item.Id || item.id;
                                const name = item.Name || item.name;
                                dropdown.append(`<option value="${id}">${name}</option>`);
                            }
                        });
                    }
                });
                
                safeInitializeSelect2('#itemId');
                console.log('Loaded', data.length, 'item types from Categories successfully');
            })
            .fail(function(xhr, status, error) {
                console.error('Failed to load item types:', error);
                alert('Failed to load item types. Please refresh the page.');
            });
    }

    // Populate filter-bar dropdowns (simple selects, not the card selector)
    function loadFilterDropdowns() {
        // Brands
        $.get('/LookupManagement/GetBrands').done(function(res) {
            var brands = (res.success && res.data) ? res.data : (Array.isArray(res) ? res : []);
            var sel = $('#filterBrand').empty().append('<option value="">All Brands</option>');
            brands.forEach(function(b) { sel.append('<option value="' + (b.id||b.Id) + '">' + (b.name||b.Name) + '</option>'); });
            safeInitializeSelect2('#filterBrand');
        });
        // Device Categories
        $.get('/LookupManagement/GetDeviceCategories').done(function(res) {
            var cats = (res.success && res.data) ? res.data : (Array.isArray(res) ? res : []);
            var sel = $('#filterDeviceCategory').empty().append('<option value="">All Categories</option>');
            cats.forEach(function(c) { sel.append('<option value="' + (c.id||c.Id) + '">' + (c.name||c.Name) + '</option>'); });
            safeInitializeSelect2('#filterDeviceCategory');
        });
        // Device Models (load all, filter client-side or on demand)
        $.get('/Repairs/GetDeviceModels').done(function(res) {
            var models = (res.success && res.data) ? res.data : (Array.isArray(res) ? res : []);
            var sel = $('#filterDeviceModel').empty().append('<option value="">All Models</option>');
            models.forEach(function(m) { sel.append('<option value="' + (m.id||m.Id) + '">' + (m.name||m.Name) + '</option>'); });
            safeInitializeSelect2('#filterDeviceModel');
        });
    }

    // ── Live SKU Preview ──────────────────────────────────────────────────────
    function previewSku() {
        const brandId    = parseInt($('#itemBrand').val()) || 0;
        const catId      = parseInt($('#itemDeviceCategory').val()) || 0;
        const modelId    = parseInt($('#itemDeviceModel').val()) || 0;

        if (!brandId || !catId || !modelId) {
            showToast('info', 'Please select Brand, Category and Model first.');
            return;
        }

        const $btn = $('#btnPreviewSku');
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Loading...');

        $.get('@Url.Action("GenerateSku", "Inventories")', {
            brandId: brandId, categoryId: catId, modelId: modelId
        })
        .done(function(res) {
            if (res.success) {
                $('#skuPreviewValue').text(res.sku);
                $('#skuPreviewBadge').removeClass('d-none');
                // Auto-fill the SKU field if it is still empty
                if (!$('#itemSku').val().trim()) {
                    $('#itemSku').val(res.sku);
                }
            } else {
                showToast('error', 'SKU preview failed: ' + res.message);
            }
        })
        .fail(function() {
            showToast('error', 'Could not reach the server to preview SKU.');
        })
        .always(function() {
            $btn.prop('disabled', false).html('<i class="fas fa-sync-alt me-1"></i>Preview');
        });
    }

    function showAddInventoryItemModal() {
        $('#inventoryItemModalLabel').text('Add Inventory Item');
        $('#btnSaveLabel').text('Save Item');
        $('#inventoryItemId').val('0');
        $('#inventoryItemForm')[0].reset();
        $('#itemLowStockNotifications').prop('checked', true);
        $('#itemIsActive').prop('checked', true);
        $('#skuPreviewBadge').addClass('d-none');
        $('#deviceSelectionError').addClass('d-none');

        // Make CurrentStock editable for new items
        $('#itemCurrentStock').prop('readonly', false).val('0');
        // Restore the Stock section label (in case it was changed by edit)
        var $stockLabel = $('label[for="itemCurrentStock"]');
        $stockLabel.html('Initial Stock <span class="text-danger">*</span>');
        $('#itemCurrentStock').closest('.input-group').show();
        $stockLabel.closest('.col-md-4').show();

        // Build the generic device selector inside the modal
        EmpireDeviceSelector.create('inventorySelectorContainer', {
            selectorId:     'inventoryItem',
            showParts:      false,
            hiddenBrand:    'itemBrand',
            hiddenCategory: 'itemDeviceCategory',
            hiddenModel:    'itemDeviceModel'
        });

        // Load existing item names and initialize Select2 with tags
        loadItemNames();

        // Show modal first (Bootstrap 5 syntax)
        var modalElement = document.getElementById('inventoryItemModal');
        var modal = new bootstrap.Modal(modalElement);
        modal.show();

        // Reinitialize Select2 after modal is fully shown (only for non-EDS dropdowns)
        $(modalElement).one('shown.bs.modal', function () {
            $('#itemInventoryCategory, #itemId').each(function() {
                if ($(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2('destroy');
                }
            });
            $('#itemInventoryCategory, #itemId').select2({
                theme: 'bootstrap-5',
                width: '100%',
                dropdownParent: $('#inventoryItemModal'),
                placeholder: function() {
                    return $(this).find('option:first').text() || 'Select...';
                },
                allowClear: true
            });
            console.log('Select2 reinitialized in add modal with dropdownParent');
        });
    }

    // Holds the itemId to pre-select once loadItemNames finishes (used by editInventoryItem)
    var _pendingItemTypeId = null;

    function loadItemNames() {
        // Load Item Types from Categories table (categoryType = 'Inventory')
        $.get('@Url.Action("GetCategories", "LookupManagement")', { categoryType: 'Inventory' })
            .done(function(response) {
                console.log('Loaded item types (categories):', response);
                if (response.success && Array.isArray(response.data)) {
                    $('#itemId').empty().append('<option value="">Select Item Type</option>');
                    response.data.forEach(function(item) {
                        if (item.isActive !== false) {
                            $('#itemId').append(`<option value="${item.id}">${item.name}</option>`);
                        }
                    });
                }

                // Re-initialize Select2 (destroy first to avoid duplicate widgets)
                if ($('#itemId').hasClass('select2-hidden-accessible')) {
                    $('#itemId').select2('destroy');
                }
                var s2opts = {
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: 'Select Item Type',
                    allowClear: true
                };
                // If the edit modal is open, scope the dropdown to it
                if ($('#inventoryItemModal').hasClass('show')) {
                    s2opts.dropdownParent = $('#inventoryItemModal');
                }
                $('#itemId').select2(s2opts);

                // Apply any deferred selection from editInventoryItem
                if (_pendingItemTypeId) {
                    $('#itemId').val(_pendingItemTypeId).trigger('change');
                    _pendingItemTypeId = null;
                }
            })
            .fail(function(xhr, status, error) {
                console.error('Failed to load items:', error);
                if ($('#itemId').hasClass('select2-hidden-accessible')) {
                    $('#itemId').select2('destroy');
                }
                $('#itemId').select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: 'Select Item Type',
                    allowClear: true
                });
            });
    }



    function editInventoryItem(id) {
        $.get('@Url.Action("GetInventoryItem", "Inventories")/' + id)
            .done(function(response) {
                if (response.success) {
                    const item = response.data;

                    // ── Header & hidden ID
                    $('#inventoryItemModalLabel').text('Edit Inventory Item');
                    $('#btnSaveLabel').text('Update Item');
                    $('#inventoryItemId').val(item.id);
                    $('#skuPreviewBadge').addClass('d-none');
                    $('#deviceSelectionError').addClass('d-none');

                    // ── Item Details section
                    $('#itemSku').val(item.sku);
                    $('#itemDescription').val(item.description);

                    // ── Stock section: readonly for edits (use Stock Movements instead)
                    $('#itemCurrentStock').val(item.currentStock).prop('readonly', true);
                    $('label[for="itemCurrentStock"]').html(
                        'Current Stock <small class="text-muted fw-normal">(use Stock Movements to change)</small>');
                    $('#itemReorderPoint').val(item.reorderPoint);
                    $('#itemLowStockNotifications').prop('checked', item.enableLowStockNotifications);

                    // ── Pricing section
                    $('#itemCostPrice').val(item.costPrice);
                    $('#itemRetailPrice').val(item.retailPrice);
                    $('#itemWholesalePrice').val(item.wholesalePrice);

                    // ── Notes & Status section
                    $('#itemIsActive').prop('checked', item.isActive);
                    $('#itemNotes').val(item.notes);

                    // ── Device selector
                    EmpireDeviceSelector.create('inventorySelectorContainer', {
                        selectorId:     'inventoryItem',
                        showParts:      false,
                        hiddenBrand:    'itemBrand',
                        hiddenCategory: 'itemDeviceCategory',
                        hiddenModel:    'itemDeviceModel'
                    });
                    if (item.brandId && item.deviceCategoryId && item.deviceModelId) {
                        EmpireDeviceSelector.setValue('inventoryItem', item.brandId, item.deviceCategoryId, item.deviceModelId);
                    }

                    // Show modal
                    var modalElement = document.getElementById('inventoryItemModal');
                    var modal = new bootstrap.Modal(modalElement);
                    modal.show();

                    // Reinitialize non-EDS Select2 dropdowns after modal is shown
                    $(modalElement).one('shown.bs.modal', function () {
                        $('#itemInventoryCategory, #itemId').each(function() {
                            if ($(this).hasClass('select2-hidden-accessible')) {
                                $(this).select2('destroy');
                            }
                        });
                        $('#itemInventoryCategory, #itemId').select2({
                            theme: 'bootstrap-5',
                            width: '100%',
                            dropdownParent: $('#inventoryItemModal'),
                            placeholder: function() {
                                return $(this).find('option:first').text() || 'Select...';
                            },
                            allowClear: true
                        });
                        // Restore inventory category selection
                        if (item.inventoryCategoryId) {
                            $('#itemInventoryCategory').val(item.inventoryCategoryId).trigger('change');
                        }
                        // Restore item type selection (categoryId takes priority over legacy itemId)
                        const typeId = item.categoryId || item.itemId;
                        if (typeId) {
                            if ($('#itemId option[value="' + typeId + '"]').length > 0) {
                                $('#itemId').val(typeId).trigger('change');
                            } else {
                                _pendingItemTypeId = typeId;
                                loadItemNames();
                            }
                        }
                        console.log('Select2 reinitialized in edit modal');
                    });
                } else {
                    showToast('error', 'Error loading inventory item: ' + response.message);
                }
            })
            .fail(function() {
                showToast('error', 'Error loading inventory item. Please try again.');
            });
    }

    function saveInventoryItem() {
        const id = $('#inventoryItemId').val();
        const isEdit = id !== '0';
        
        // Validate required fields
        const categoryId        = parseInt($('#itemId').val()) || 0;  // #itemId now holds a Category.Id
        const brandId           = parseInt($('#itemBrand').val()) || 0;
        const deviceCategoryId  = parseInt($('#itemDeviceCategory').val()) || 0;
        const deviceModelId     = parseInt($('#itemDeviceModel').val()) || 0;
        const inventoryCategoryId = parseInt($('#itemInventoryCategory').val()) || 0;

        let invValid = true;
        if (!categoryId) {
            $('#itemId').addClass('is-invalid'); invValid = false;
        } else { $('#itemId').removeClass('is-invalid').addClass('is-valid'); }
        if (!brandId || !deviceCategoryId || !deviceModelId) {
            $('#deviceSelectionError').removeClass('d-none');
            invValid = false;
        } else {
            $('#deviceSelectionError').addClass('d-none');
        }
        if (!inventoryCategoryId) {
            $('#itemInventoryCategory').addClass('is-invalid'); invValid = false;
        } else { $('#itemInventoryCategory').removeClass('is-invalid').addClass('is-valid'); }
        if (!invValid) {
            // Scroll to the top of the modal body so the user sees the errors
            $('#inventoryItemModal .modal-body').scrollTop(0);
            return;
        }
        
        // Get the item name from the selected item type dropdown text
        const itemName = $('#itemId option:selected').text().trim();
        
        const data = {
            CategoryId: categoryId,
            Name: itemName,
            SKU: $('#itemSku').val().trim(),
            Description: $('#itemDescription').val().trim(),
            BrandId: brandId,
            DeviceCategoryId: deviceCategoryId,
            DeviceModelId: deviceModelId,
            InventoryCategoryId: inventoryCategoryId,
            ReorderPoint: parseInt($('#itemReorderPoint').val()) || 0,
            CostPrice: parseFloat($('#itemCostPrice').val()) || 0,
            RetailPrice: parseFloat($('#itemRetailPrice').val()) || 0,
            WholesalePrice: parseFloat($('#itemWholesalePrice').val()) || 0,
            EnableLowStockNotifications: $('#itemLowStockNotifications').is(':checked'),
            IsActive: $('#itemIsActive').is(':checked'),
            Notes: $('#itemNotes').val().trim()
        };
        
        // Only include CurrentStock when creating new items
        if (!isEdit) {
            data.CurrentStock = parseInt($('#itemCurrentStock').val()) || 0;
        }

        console.log('Saving inventory item:', data);

        const url = isEdit ? 
            '@Url.Action("UpdateInventoryItem", "Inventories")/' + id : 
            '@Url.Action("CreateInventoryItem", "Inventories")';
        
        const method = isEdit ? 'PUT' : 'POST';

        const $saveBtn = $('#btnSaveInventoryItem');
        $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Saving...');

        $.ajax({
            url: url,
            type: method,
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function(response) {
                console.log('Save response:', response);
                if (response.success) {
                    // Bootstrap 5: hide via instance
                    var modalEl = document.getElementById('inventoryItemModal');
                    var bsModal = bootstrap.Modal.getInstance(modalEl);
                    if (bsModal) bsModal.hide();
                    // Reload the DataTable to show the new/updated item
                    inventoryTable.ajax.reload();
                    showToast('success', response.message || (isEdit ? 'Inventory item updated!' : 'Inventory item created!'));
                } else {
                    showToast('error', 'Error: ' + response.message);
                }
            },
            error: function(xhr, status, error) {
                console.error('Save error:', error);
                try {
                    const errorResponse = JSON.parse(xhr.responseText);
                    showToast('error', 'Error: ' + (errorResponse.message || error));
                } catch (e) {
                    showToast('error', 'Error saving inventory item. Please try again.');
                }
            },
            complete: function() {
                $saveBtn.prop('disabled', false)
                        .html('<i class="fas fa-save me-1"></i><span id="btnSaveLabel">' + (isEdit ? 'Update Item' : 'Save Item') + '</span>');
            }
        });
    }

    function deleteInventoryItem(id) {
        if (confirm('Are you sure you want to delete this inventory item?')) {
            $.ajax({
                url: '@Url.Action("DeleteInventoryItem", "Inventories")/' + id,
                type: 'DELETE',
                success: function(response) {
                    if (response.success) {
                        inventoryTable.ajax.reload();
                        showToast('success', response.message || 'Inventory item deleted!');
                    } else {
                        showToast('error', 'Error: ' + response.message);
                    }
                },
                error: function() {
                    showToast('error', 'Error deleting inventory item. Please try again.');
                }
            });
        }
    }

    function showStockMovementModal(inventoryItemId) {
        $('#movementInventoryItemId').val(inventoryItemId);
        $('#stockMovementForm')[0].reset();
        $('#stockMovementModal').modal('show');
    }

    function saveStockMovement() {
        const data = {
            InventoryItemId: parseInt($('#movementInventoryItemId').val()),
            MovementType: $('#movementType').val(),
            Quantity: parseInt($('#movementQuantity').val()),
            UnitCost: parseFloat($('#movementUnitCost').val()) || 0,
            Reason: $('#movementReason').val(),
            ReferenceNumber: $('#movementReference').val()
        };

        $.ajax({
            url: '@Url.Action("RecordStockMovement", "Inventories")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function(response) {
                if (response.success) {
                    $('#stockMovementModal').modal('hide');
                    $('#inventoryTable').DataTable().ajax.reload();
                    showToast('success', response.message || 'Stock movement recorded!');
                } else {
                    showToast('error', 'Error: ' + response.message);
                }
            },
            error: function() {
                showToast('error', 'Error recording stock movement. Please try again.');
            }
        });
    }

    function applyFilters() {
        const filters = {
            brandId: $('#filterBrand').val(),
            deviceCategoryId: $('#filterDeviceCategory').val(),
            deviceModelId: $('#filterDeviceModel').val(),
            inventoryCategoryId: $('#filterInventoryCategory').val(),
            stockStatus: $('#filterStockStatus').val()
        };

        // Build query string
        const queryParams = [];
        Object.keys(filters).forEach(key => {
            if (filters[key]) {
                queryParams.push(`${key}=${encodeURIComponent(filters[key])}`);
            }
        });

        const url = '/Inventories/GetInventoryItems' + (queryParams.length > 0 ? '?' + queryParams.join('&') : '');
        inventoryTable.ajax.url(url).load();
    }

    function clearFilters() {
        $('#inventoryFilterForm')[0].reset();
        inventoryTable.ajax.url('/Inventories/GetInventoryItems').load();
    }

    function testAjaxCall() {
        console.log('Testing AJAX call to /Inventories/GetInventoryItems');
        $.ajax({
            url: '/Inventories/GetInventoryItems',
            type: 'GET',
            success: function(response) {
                console.log('Test AJAX Success:', response);
                alert('AJAX call successful! Check console for response. Items found: ' + (response.data ? response.data.length : 'N/A'));
            },
            error: function(xhr, error, thrown) {
                console.error('Test AJAX Error:', error, thrown);
                console.error('Response Text:', xhr.responseText);
                console.error('Status:', xhr.status);
                alert('AJAX call failed: ' + error + ' (Status: ' + xhr.status + ')');
            }
        });
    }

    function showLowStockReport() {
        // Filter to show only low stock items
        $('#filterStockStatus').val('low_stock');
        applyFilters();
    }

    function showStockMovements() {
        showToast('info', 'Stock movements report feature coming soon!');
    }

    function showToast(type, message) {
        const colors = { success: '#198754', error: '#dc3545', info: '#0d6efd' };
        const bg = colors[type] || colors.info;
        const toast = $(`<div style="position:fixed;bottom:20px;right:20px;z-index:9999;background:${bg};color:#fff;padding:12px 20px;border-radius:6px;box-shadow:0 4px 12px rgba(0,0,0,.2);font-size:14px;">${message}</div>`);
        $('body').append(toast);
        setTimeout(() => toast.fadeOut(400, function() { $(this).remove(); }), 3500);
    }
</script>
