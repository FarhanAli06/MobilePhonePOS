    async function saveInventoryWorkspace() {
        const entries = [...document.querySelectorAll('.inventory-workspace-entry')].map(row => ({
            row, id:Number(row.dataset.itemId), templateId:Number(row.dataset.templateId), modelId:Number(row.dataset.modelId), part:row.dataset.part, option:row.dataset.option,
            quantity:Number(row.querySelector('.inventory-workspace-qty').value), cost:Number(row.querySelector('.inventory-workspace-cost').value), supplier:row.querySelector('.inventory-workspace-supplier').value.trim()
        })).filter(entry => entry.quantity > 0);
        if (!entries.length) { showToast('warning','Enter a quantity for at least one model.'); return; }
        if (entries.some(entry => !Number.isInteger(entry.quantity) || entry.quantity < 1 || !Number.isFinite(entry.cost) || entry.cost < 0)) { showToast('error','Enter valid whole quantities and unit costs.'); return; }
        if (!confirm('Receive ' + entries.reduce((sum,entry) => sum + entry.quantity,0) + ' parts across ' + new Set(entries.map(entry => entry.modelId)).size + ' models?')) return;
        $('#inventoryWorkspaceSaveTop,#inventoryWorkspaceSaveBottom').prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Saving…');
        let saved = 0;
        try {
            for (const entry of entries) {
                let id = entry.id;
                const template = inventoryAllItems.find(item => Number(item.id) === entry.templateId);
                const model = inventoryAllItems.find(item => Number(item.deviceModelId) === entry.modelId);
                if (!id) {
                    if (!template || !model) throw new Error('A template is missing for ' + entry.part + '.');
                    const code = entry.part.replace(/[^A-Za-z0-9]+/g,'-').toUpperCase();
                    const optionCode = entry.option.replace(/[^A-Za-z0-9]+/g,'-').toUpperCase();
                    const create = await fetch('@Url.Action("CreateInventoryItem", "Inventories")', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                        CategoryId:template.categoryId || template.itemId, ItemId:template.itemId, Name:entry.part, SKU:code + '-' + model.brandId + '-' + entry.modelId + '-' + optionCode,
                        Variant:entry.part === 'Screen' && guidedSelection.family !== 'MacBook' ? entry.option : '', Color:entry.part === 'Back Glass' ? entry.option : '', Description:'', BrandId:model.brandId,
                        DeviceCategoryId:model.deviceCategoryId, DeviceModelId:entry.modelId, InventoryCategoryId:template.inventoryCategoryId, CurrentStock:0,
                        ReorderPoint:template.reorderPoint || 0, CostPrice:entry.cost, RetailPrice:template.retailPrice || 0, WholesalePrice:template.wholesalePrice || 0,
                        EnableLowStockNotifications:template.enableLowStockNotifications, IsActive:true
                    })}).then(response => response.json());
                    if (!create.success || !create.id) throw new Error(create.message || 'Could not create ' + entry.part + ' for this model.');
                    id = create.id;
                }
                const receive = await fetch('@Url.Action("ReceiveBatch", "Inventories")/' + id, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({Quantity:entry.quantity,UnitCost:entry.cost,Vendor:entry.supplier,ReceivedDate:new Date().toISOString().slice(0,10)})}).then(response => response.json());
                if (!receive.success) throw new Error(receive.message || 'Could not receive inventory.');
                saved++;
            }
            inventoryWorkspaceDirty = false;
            showToast('success','Saved ' + saved + ' inventory batches.');
            inventoryTable.ajax.reload(function(){ renderGuidedInventory(); },false);
        } catch(error) { showToast('error',(saved ? saved + ' saved; ' : '') + error.message); inventoryTable.ajax.reload(null,false); }
        finally { $('#inventoryWorkspaceSaveTop').prop('disabled',false).html('<i class="fas fa-save me-1"></i>Save All'); $('#inventoryWorkspaceSaveBottom').prop('disabled',false).text('Review & Save'); }
    }
    function renderGuidedInventory() {
        const grid = $('#guidedInventoryGrid');
        if (!inventoryAllItems.length) { grid.html('<div class="guided-empty">No inventory records found.</div>'); return; }
        let rows = inventoryAllItems;
        let title = guidedBrowseOrder === 'brand' ? 'Choose a brand' : 'Choose a part type'; let breadcrumb = 'Inventory'; let html = '';
        const firstLevel = guidedBrowseOrder === 'brand' ? 'brand' : 'part';
        const secondLevel = guidedBrowseOrder === 'brand' ? 'family' : 'brand';
        const firstValue = guidedSelection[firstLevel];
        const secondValue = guidedSelection[secondLevel];
        if (!firstValue) {
            const getter = firstLevel === 'brand' ? x => x.brandName : inventoryPartType;
            const values = firstLevel === 'brand' ? uniqueInventoryValues([...inventoryBrandNames, ...rows.map(getter)]) : uniqueInventoryValues(rows.map(getter));
            values.forEach(value => html += guidedChoiceMarkup(value, rows.filter(x => getter(x) === value).length, firstLevel));
            html += guidedAddChoiceMarkup(firstLevel === 'brand' ? 'brand' : 'part');
        } else {
            rows = rows.filter(x => firstLevel === 'brand' ? x.brandName === firstValue : inventoryPartType(x) === firstValue);
            breadcrumb += ' › ' + guidedBreadcrumbValue(firstValue, firstLevel);
            if (!secondValue) {
                title = secondLevel === 'brand' ? 'Choose a brand' : 'Choose a device family';
                const getter = secondLevel === 'brand' ? x => x.brandName : inventoryFamily;
                uniqueInventoryValues(rows.map(getter)).forEach(value => html += guidedChoiceMarkup(value, rows.filter(x => getter(x) === value).length, secondLevel));
                html += guidedAddChoiceMarkup(secondLevel === 'brand' ? 'brand' : 'family');
            } else {
                rows = rows.filter(x => secondLevel === 'brand' ? x.brandName === secondValue : inventoryFamily(x) === secondValue);
                breadcrumb += ' › ' + guidedBreadcrumbValue(secondValue, secondLevel);
                if (guidedBrowseOrder === 'part' && !guidedSelection.family) {
                    title = 'Choose a device family';
                    uniqueInventoryValues(rows.map(inventoryFamily)).forEach(value => html += guidedChoiceMarkup(value, rows.filter(x => inventoryFamily(x) === value).length, 'family'));
                    html += guidedAddChoiceMarkup('family');
                } else if (guidedBrowseOrder === 'brand') {
                    title = guidedSelection.family + ' inventory workspace';
                    html = renderInventoryWorkspace(rows);
                } else {
                    rows = rows.filter(x => (guidedBrowseOrder === 'part' ? inventoryFamily(x) === guidedSelection.family : inventoryPartType(x) === guidedSelection.part)).sort(newestModelFirst);
                    const finalValue = guidedBrowseOrder === 'part' ? guidedSelection.family : guidedSelection.part;
                    breadcrumb += ' › <strong>' + escapeInventoryHtml(finalValue) + '</strong>';
                    const total = rows.reduce((sum,x) => sum + (x.currentStock || 0), 0);
                    const low = rows.filter(x => x.currentStock <= x.reorderPoint).length;
                    title = rows.length + ' models • ' + total + ' parts total • ' + low + ' low stock';
                    if (guidedBrowseOrder === 'brand' && ((/^apple$/i.test(guidedSelection.brand || '') && guidedSelection.family === 'iPhone' && guidedSelection.part === 'Back Glass') || (guidedSelection.part === 'Screen' && (/^samsung$/i.test(guidedSelection.brand || '') || (/^apple$/i.test(guidedSelection.brand || '') && guidedSelection.family === 'iPhone'))))) {
                        const isScreen = guidedSelection.part === 'Screen';
                        const screenVariants = screenVariantsForBrand(guidedSelection.brand);
                        const models = new Map();
                        rows.forEach(item => {
                            const key = String(item.deviceModelId || item.deviceModelName || item.name);
                            if (!models.has(key)) models.set(key, []);
                            models.get(key).push(item);
                        });
                        const supportedModels = [...models.values()].filter(items => isScreen || (iphoneBackGlassColors[normalizedIphoneModel(items[0].deviceModelName || items[0].name)] || []).length);
                        title = supportedModels.length + ' models • ' + supportedModels.reduce((sum,items) => sum + items.reduce((count,item) => count + (item.currentStock || 0), 0), 0) + ' parts total';
                        if (isScreen && isInventoryAdmin && /^apple$/i.test(guidedSelection.brand || '') && guidedSelection.family === 'iPhone') {
                            html += '<div class="guided-empty" style="grid-column:1/-1;text-align:left;"><button type="button" id="connectIphoneScreensButton" class="btn btn-outline-primary btn-sm" onclick="connectIphoneScreenQualities()">Connect screen qualities to inventory</button><span class="small text-muted ms-2">Creates only missing zero-stock quality items; existing stock stays unchanged.</span></div>';
                        }
                        models.forEach(items => {
                            const modelName = items[0].deviceModelName || items[0].name;
                            const options = isScreen ? screenVariants : (iphoneBackGlassColors[normalizedIphoneModel(modelName)] || []);
                            if (!options.length) return;
                            const unknownStock = isScreen ? items.filter(item => (item.currentStock || 0) > 0 && !screenVariants.some(variant => variant.toLowerCase() === String(item.variant || '').toLowerCase())) : [];
                            const unknownNames = [...new Set(unknownStock.map(item => item.variant || 'Unspecified'))];
                            const total = items.reduce((sum,item) => sum + (item.currentStock || 0), 0);
                            html += '<article class="guided-model-card backglass-model-card" data-value="' + escapeInventoryHtml(modelName) + '">'
                                + '<div class="guided-model-name">' + escapeInventoryHtml(modelName) + '</div>'
                                + '<div class="backglass-color-grid">' + options.map(option => {
                                    const item = items.find(x => String(isScreen ? x.variant : x.color || '').toLowerCase() === option.toLowerCase());
                                    return '<div class="backglass-color-line"><span>' + escapeInventoryHtml(option) + '</span><strong>' + (item ? item.currentStock || 0 : 0) + '</strong></div>';
                                }).join('') + unknownNames.map(name => '<div class="backglass-color-line"><span>' + escapeInventoryHtml(name) + '</span><strong>' + unknownStock.filter(item => (item.variant || 'Unspecified') === name).reduce((sum,item) => sum + (item.currentStock || 0), 0) + '</strong></div>').join('') + '</div>'
                                + '<div class="mt-auto"><strong>' + total + '</strong> total in stock <button type="button" class="btn btn-primary btn-sm float-end" onclick="openBackGlassModel(' + (items[0].deviceModelId || 0) + ',\'' + (isScreen ? 'Screen' : 'Back Glass') + '\')">Open / Edit</button></div></article>';
                        });
                    } else rows.forEach(item => {
                        const status = item.currentStock <= 0 ? 'Out of stock' : item.currentStock <= item.reorderPoint ? 'Low stock' : 'In stock';
                        const dot = item.currentStock <= 0 ? 'low' : item.currentStock <= item.reorderPoint ? 'warning' : '';
                        const safeName = escapeInventoryHtml(item.name).replace(/'/g, '&#39;');
                        const adminDelete = isInventoryAdmin ? '<button class="btn btn-sm btn-outline-danger" onclick="deleteInventoryItem(' + item.id + ')" title="Admin: delete inventory"><i class="fas fa-trash"></i></button>' : '';
                        const optionDetail = [item.variant, item.color].filter(Boolean).join(' • ');
                        html += '<article class="guided-model-card" data-value="' + item.id + '"><div class="guided-model-name">' + escapeInventoryHtml(item.deviceModelName || item.name) + '</div>'
                            + (optionDetail ? '<div class="small text-primary fw-semibold">' + escapeInventoryHtml(optionDetail) + '</div>' : '')
                            + '<div class="guided-card-status"><span class="stock-status"><span class="stock-dot ' + dot + '"></span>' + status + '</span><button type="button" class="inventory-alert-toggle ' + (item.enableLowStockNotifications ? 'active' : '') + '" onclick="toggleInventoryAlert(' + item.id + ',this)" title="' + (item.enableLowStockNotifications ? 'Low-stock alert is on' : 'Low-stock alert is off') + '"><i class="fas ' + (item.enableLowStockNotifications ? 'fa-bell' : 'fa-bell-slash') + '"></i></button></div>'
                            + '<div class="guided-stock">' + (item.currentStock || 0) + ' <small class="text-muted fs-6">available</small></div>'
                            + '<div class="guided-costs">Oldest cost: $' + parseFloat(item.fifoCost || 0).toFixed(2) + '<br>Latest cost: $' + parseFloat(item.latestCost || 0).toFixed(2) + '<br>Average cost: $' + parseFloat(item.averageCost || 0).toFixed(2) + '</div>'
                            + '<div class="guided-card-actions"><button class="btn btn-sm btn-primary flex-grow-1" onclick="showReceiveBatchModal(' + item.id + ',\'' + safeName + '\',' + item.currentStock + ',' + (item.latestCost || 0) + ')"><i class="fas fa-box-open me-1"></i>Receive</button>'
                            + '<button class="btn btn-sm btn-outline-secondary" onclick="editInventoryItem(' + item.id + ')"><i class="fas fa-edit"></i></button>' + adminDelete + '</div></article>';
                    });
                    html += guidedAddChoiceMarkup('model');
                }
            }
        }
        if (guidedSelection.brand && /^(motorola|moto)$/i.test(guidedSelection.brand) && !rows.length) {
            title = 'No Motorola models added yet';
            html = '<div class="guided-empty"><i class="fas fa-mobile-alt fa-2x mb-3 d-block"></i>Motorola is ready. Add your own device models when needed.</div>' + guidedAddChoiceMarkup('model');
        }
        $('#guidedTitle').text(title); $('#guidedBreadcrumb').html(breadcrumb); grid.html(html || '<div class="guided-empty">No matching inventory.</div>');
        enableGuidedDrag(grid[0]);
        $('#guidedBackButton').toggleClass('d-none', !guidedSelection.brand && !guidedSelection.part);
    }
    function selectGuidedInventory(level, value) {
        if (level === 'brand') {
            guidedSelection.brand = value;
            guidedSelection.family = null;
            if (guidedBrowseOrder === 'brand') guidedSelection.part = null;
        }
        if (level === 'family') {
            guidedSelection.family = value;
            if (guidedBrowseOrder === 'brand') guidedSelection.part = null;
        }
        if (level === 'part') {
            guidedSelection.part = value;
            if (guidedBrowseOrder === 'part') { guidedSelection.brand = null; guidedSelection.family = null; }
        }
        renderGuidedInventory();
    }
    function guidedBack() {
        if (guidedBrowseOrder === 'brand') {
            guidedSelection.part = null;
            if (guidedSelection.family) guidedSelection.family = null;
            else guidedSelection.brand = null;
        } else {
            if (guidedSelection.family) guidedSelection.family = null;
            else if (guidedSelection.brand) guidedSelection.brand = null;
            else guidedSelection.part = null;
        }
        renderGuidedInventory();
    }
    function setGuidedBrowseOrder(order) {
        guidedBrowseOrder = order === 'part' ? 'part' : 'brand';
        guidedSelection.brand = guidedSelection.family = guidedSelection.part = null;
        $('#browseBrandButton,#browsePartButton').removeClass('active');
        $('#' + (guidedBrowseOrder === 'brand' ? 'browseBrandButton' : 'browsePartButton')).addClass('active');
        renderGuidedInventory();
    }
    function setInventoryMode(mode) {
        inventoryMode = mode;
        $('#guidedViewButton,#allViewButton,#lowViewButton').removeClass('active');
        $('#' + mode + 'ViewButton').addClass('active');
        $('#guidedInventoryBrowser').toggleClass('d-none', mode !== 'guided');
        $('#inventoryTableControls').toggleClass('d-none', mode === 'guided');
        if (mode === 'guided') { guidedSelection.brand = guidedSelection.family = guidedSelection.part = null; renderGuidedInventory(); }
        else {
            $('#filterStockStatus').val(mode === 'low' ? 'low_stock' : '').trigger('change.select2');
            applyFilters(); setTimeout(() => inventoryTable.columns.adjust(), 0);
        }
    }

    function selectedInventoryIds() { return $('.inventory-row-select:checked').map(function(){ return parseInt(this.value); }).get(); }
    function updateBulkActions() {
        const count = selectedInventoryIds().length;
        $('#selectedInventoryCount').text(count);
        $('#bulkActions').toggleClass('d-none', count === 0).toggleClass('d-flex', count > 0);
        $('#noBulkSelection').toggleClass('d-none', count > 0);
    }

    function quickUpdateInventoryField(id, field, value, input) {
        const row = inventoryTable.rows().data().toArray().find(x => x.id === id);
        if (!row) return;
        const parsed = Math.max(0, parseFloat(value) || 0);
        const payload = { CategoryId: row.categoryId, ItemId: row.itemId, Name: row.name, SKU: row.sku, Variant: row.variant || '', Color: row.color || '', Description: row.description,
            BrandId: row.brandId, DeviceCategoryId: row.deviceCategoryId, DeviceModelId: row.deviceModelId,
            InventoryCategoryId: row.inventoryCategoryId, ReorderPoint: field === 'reorderPoint' ? Math.round(parsed) : row.reorderPoint,
            CostPrice: row.latestCost || row.costPrice, RetailPrice: field === 'retailPrice' ? parsed : row.retailPrice,
            WholesalePrice: row.wholesalePrice, EnableLowStockNotifications: row.enableLowStockNotifications,
            IsActive: row.isActive, Notes: row.notes };
        input.disabled = true;
        $.ajax({ url: '@Url.Action("UpdateInventoryItem", "Inventories")/' + id, type: 'PUT', contentType: 'application/json', data: JSON.stringify(payload) })
            .done(function(response) { if (!response.success) showToast('error', response.message || 'Could not update inventory.'); inventoryTable.ajax.reload(null, false); })
            .fail(function() { showToast('error', 'Could not update inventory.'); inventoryTable.ajax.reload(null, false); })
            .always(function() { input.disabled = false; });
    }
    function toggleInventoryAlert(id, button) {
        const row = inventoryTable.rows().data().toArray().find(x => x.id === id) || inventoryAllItems.find(x => x.id === id);
        if (!row) return;
        const enabled = !row.enableLowStockNotifications;
        const payload = { CategoryId: row.categoryId, ItemId: row.itemId, Name: row.name, SKU: row.sku, Variant: row.variant || '', Color: row.color || '', Description: row.description,
            BrandId: row.brandId, DeviceCategoryId: row.deviceCategoryId, DeviceModelId: row.deviceModelId,
            InventoryCategoryId: row.inventoryCategoryId, ReorderPoint: row.reorderPoint, CostPrice: row.latestCost || row.costPrice,
            RetailPrice: row.retailPrice, WholesalePrice: row.wholesalePrice, EnableLowStockNotifications: enabled,
            IsActive: row.isActive, Notes: row.notes };
        button.disabled = true;
        $.ajax({ url: '@Url.Action("UpdateInventoryItem", "Inventories")/' + id, type: 'PUT', contentType: 'application/json', data: JSON.stringify(payload) })
            .done(function(response) {
                if (!response.success) { showToast('error', response.message || 'Could not update the alert.'); return; }
                row.enableLowStockNotifications = enabled;
                const cached = inventoryAllItems.find(x => x.id === id);
                if (cached) cached.enableLowStockNotifications = enabled;
                inventoryTable.ajax.reload(null, false);
                renderGuidedInventory();
                showToast('success', 'Low-stock alert turned ' + (enabled ? 'on.' : 'off.'));
            })
            .fail(function() { showToast('error', 'Could not update the alert.'); })
            .always(function() { button.disabled = false; });
    }
    function clearInventorySelection() { $('.inventory-row-select,#selectAllInventory').prop('checked', false); updateBulkActions(); }
    function bulkSetReorderPoint() {
        const ids = selectedInventoryIds();
        if (!ids.length) return;
        const value = prompt('Set reorder level for ' + ids.length + ' selected parts:');
        if (value === null || value === '' || isNaN(value)) return;
        const rows = inventoryTable.rows().data().toArray().filter(x => ids.includes(x.id));
        Promise.all(rows.map(row => $.ajax({
            url: '@Url.Action("UpdateInventoryItem", "Inventories")/' + row.id, type: 'PUT', contentType: 'application/json',
            data: JSON.stringify({ CategoryId: row.categoryId, ItemId: row.itemId, Name: row.name, SKU: row.sku, Variant: row.variant || '', Color: row.color || '', Description: row.description,
                BrandId: row.brandId, DeviceCategoryId: row.deviceCategoryId, DeviceModelId: row.deviceModelId,
                InventoryCategoryId: row.inventoryCategoryId, ReorderPoint: parseInt(value), CostPrice: row.latestCost || row.costPrice,
                RetailPrice: row.retailPrice, WholesalePrice: row.wholesalePrice, EnableLowStockNotifications: true, IsActive: row.isActive, Notes: row.notes })
        }))).then(function(){ clearInventorySelection(); inventoryTable.ajax.reload(); showToast('success', 'Reorder level updated for selected parts.'); })
           .catch(function(){ showToast('error', 'One or more selected parts could not be updated.'); });
    }

    // Use the same safeInitializeSelect2 function as device page
    function safeInitializeSelect2(selector = '.form-select') {
        try {
            if (typeof $.fn.select2 !== 'undefined') {
                $(selector).each(function() {
                    if (!$(this).hasClass('select2-hidden-accessible')) {
                        $(this).select2({
                            theme: 'bootstrap-5',
                            width: '100%',
                            placeholder: $(this).find('option:first').text(),
                            allowClear: true
                        });
                    }
                });
            } else {
                console.warn('Select2 not available, using standard dropdowns');
            }
        } catch (error) {
            console.error('Error initializing Select2:', error);
        }
    }

    // Load inventory categories from the InventoryCategories SQL table
    function loadInventoryCategories() {
        $.get('@Url.Action("GetInventoryCategories", "LookupManagement")')
            .done(function(response) {
                console.log('Inventory categories response:', response);
                const data = response.success ? response.data : (Array.isArray(response) ? response : []);
                $('#filterInventoryCategory, #itemInventoryCategory').each(function() {
                    const dropdown = $(this);
                    const firstOption = dropdown.find('option:first');
                    dropdown.empty().append(firstOption);
                    
                    if (data && Array.isArray(data)) {
                        data.forEach(function(category) {
                            const id = category.Id || category.id;
                            const name = category.Name || category.name;
                            dropdown.append(`<option value="${id}">${name}</option>`);
                        });
                    }
                });
                
                safeInitializeSelect2('#filterInventoryCategory, #itemInventoryCategory');
                console.log('Loaded', data.length, 'inventory categories successfully');
            })
            .fail(function(xhr, status, error) {
                console.error('Failed to load inventory categories:', error);
                alert('Failed to load inventory categories. Please refresh the page.');
            });
    }

