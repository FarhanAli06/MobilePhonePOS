    function supplierImportMatchChanged(select) {
        const row = select.closest('tr'); const status = row.querySelector('.supplier-import-status');
        const matched = Number(select.value) > 0;
        status.textContent = matched ? 'Matched' : 'Review'; status.className = 'supplier-import-status ' + (matched ? 'text-success' : 'text-warning');
        if (matched) row.querySelector('.supplier-import-include').checked = true;
        updateSupplierImportReady();
    }
    function updateSupplierImportReady() {
        const selected = [...document.querySelectorAll('#supplierImportRows tr')].filter(row => row.querySelector('.supplier-import-include').checked);
        const valid = selected.length && selected.every(row => Number(row.querySelector('.supplier-import-match').value) > 0
            && Number(row.querySelector('.supplier-import-qty').value) > 0
            && Number(row.querySelector('.supplier-import-cost').value) >= 0);
        $('#supplierImportConfirm').prop('disabled',!valid).html('<i class="fas fa-boxes me-1"></i>Import ' + selected.length + ' selected item' + (selected.length === 1 ? '' : 's'));
    }
    async function importSupplierOrder() {
        const rows = [...document.querySelectorAll('#supplierImportRows tr')].filter(row => row.querySelector('.supplier-import-include').checked);
        if (!rows.length) return;
        const vendor = $('#supplierImportVendor').val(); const reference = $('#supplierImportReference').val().trim(); const receivedDate = $('#supplierImportDate').val();
        if (!confirm('Receive ' + rows.length + ' supplier line(s) into inventory?')) return;
        const button = $('#supplierImportConfirm').prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Importing…');
        let imported = 0;
        try {
            if (reference) {
                const uniqueIds = [...new Set(rows.map(row => Number(row.querySelector('.supplier-import-match').value)))];
                for (const id of uniqueIds) {
                    const history = await fetch('@Url.Action("BatchHistory", "Inventories")/' + id).then(response => response.json());
                    if ((history.data || []).some(batch => String(batch.referenceNumber || '').toLowerCase() === reference.toLowerCase() && String(batch.vendor || '').toLowerCase() === String(vendor).toLowerCase())) throw new Error('Order ' + reference + ' was already imported for one of these inventory items.');
                }
            }
            for (const row of rows) {
                const response = await fetch('@Url.Action("ReceiveBatch", "Inventories")/' + Number(row.querySelector('.supplier-import-match').value), {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                    Quantity:Number(row.querySelector('.supplier-import-qty').value), UnitCost:Number(row.querySelector('.supplier-import-cost').value), Vendor:vendor,
                    ReferenceNumber:reference, ReceivedDate:receivedDate || null, Notes:'Imported supplier SKU: ' + (supplierImportLines[Number(row.dataset.row)]?.sku || 'unknown')
                })}).then(result => result.json());
                if (!response.success) throw new Error(response.message || 'An inventory line could not be received.');
                imported++;
            }
            showToast('success','Imported ' + imported + ' supplier line(s) as FIFO inventory batches.');
            bootstrap.Modal.getInstance(document.getElementById('supplierOrderImportModal')).hide();
            inventoryAllItems = []; inventoryTable.ajax.reload();
        } catch(error) { showToast('error',(imported ? imported + ' line(s) imported before the error. ' : '') + error.message); }
        finally { button.prop('disabled',false); updateSupplierImportReady(); }
    }

    function updateInventorySummary(items) {
        const rows = items || [];
        $('#inventoryPartCount').text(rows.length);
        $('#inventoryLowCount').text(rows.filter(x => x.currentStock <= x.reorderPoint).length);
        const value = rows.reduce((sum, x) => sum + ((x.currentStock || 0) * (x.averageCost || x.costPrice || 0)), 0);
        $('#inventoryValue').text('$' + value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    }

    function loadGuidedBrandNames() {
        $.get('/LookupManagement/GetBrands').done(function(res) {
            const brands = res && res.success && Array.isArray(res.data) ? res.data : [];
            inventoryBrandNames = uniqueInventoryValues(brands
                .filter(x => x.isActive !== false && x.IsActive !== false)
                .map(x => x.name || x.Name));
            // Motorola is intentionally shown even when it has no models or parts yet.
            if (!inventoryBrandNames.some(x => /^(motorola|moto)$/i.test(x))) inventoryBrandNames.push('Motorola');
            inventoryBrandNames = uniqueInventoryValues(inventoryBrandNames);
            if (inventoryMode === 'guided' && !guidedSelection.brand && guidedBrowseOrder === 'brand') renderGuidedInventory();
        });
    }

    function escapeInventoryHtml(value) { return $('<div>').text(value == null ? '' : String(value)).html(); }
    function inventoryFamily(item) {
        const brand = String(item.brandName || '').toLowerCase();
        const model = String(item.deviceModelName || item.name || '').toLowerCase();
        const category = String(item.deviceCategoryName || '').trim();
        if (brand.includes('apple')) {
            if (model.includes('ipad') || category.toLowerCase().includes('ipad') || category.toLowerCase().includes('tablet')) return 'iPad';
            if (model.includes('macbook') || model.includes('mac book') || category.toLowerCase().includes('computer')) return 'MacBook';
            if (model.includes('watch') || category.toLowerCase().includes('watch')) return 'Apple Watch';
            return 'iPhone';
        }
        if (brand.includes('samsung')) {
            if (/tab\s*s/.test(model)) return 'Tab S Series';
            if (/tab\s*a/.test(model)) return 'Tab A Series';
            if (/note/.test(model)) return 'Note Series';
            if (/galaxy\s*z|\bz\s*(flip|fold|[0-9])/.test(model)) return 'Z Series';
            if (/galaxy\s*a|\ba[0-9]/.test(model)) return 'A Series';
            if (/galaxy\s*s|\bs[0-9]/.test(model)) return 'S Series';
        }
        return category && category !== 'Unknown' ? category : 'Other devices';
    }
    function inventoryPartType(item) {
        const types = [
            ['Back Glass', /back\s*glass|rear\s*glass/], ['Charging Port', /charg(e|ing)\s*port|dock\s*connector/],
            ['Home Button', /home\s*button/], ['Screen', /screen|display|lcd|oled|digitizer/],
            ['Battery', /battery/], ['Camera', /camera/], ['Speaker', /speaker|earpiece/],
            ['Microphone', /microphone|\bmic\b/], ['Housing', /housing|frame/]
        ];
        // The inventory name is the authoritative part type. Older seeded records
        // share a legacy CategoryId, so reading category first incorrectly groups
        // batteries, cameras, and ports under Screen.
        const primaryName = String(item.name || item.itemName || '').trim();
        const primaryMatch = types.find(x => x[1].test(primaryName.toLowerCase()));
        if (primaryMatch) return primaryMatch[0];
        if (primaryName) return primaryName;
        const fallback = [item.itemName, item.categoryName, item.inventoryCategoryName].filter(Boolean).join(' ').toLowerCase();
        const fallbackMatch = types.find(x => x[1].test(fallback));
        return fallbackMatch ? fallbackMatch[0] : 'Other';
    }
    function guidedIcon(label, level) {
        if (level === 'brand' && window.EmpireManufacturerLogos) return window.EmpireManufacturerLogos.markup(label);
        const lower = String(label).toLowerCase();
        const icon = lower.includes('screen') ? 'fa-mobile-screen-button' : lower.includes('battery') ? 'fa-battery-half' :
            lower.includes('glass') ? 'fa-gem' : lower.includes('charg') ? 'fa-plug' : lower.includes('camera') ? 'fa-camera' :
            lower.includes('speaker') ? 'fa-volume-high' : lower.includes('button') ? 'fa-circle-dot' :
            level === 'family' ? 'fa-mobile-alt' : level === 'brand' ? 'fa-building' : 'fa-screwdriver-wrench';
        return '<i class="fas ' + icon + '"></i>';
    }
    function guidedBreadcrumbValue(value, level) {
        const hasBrandLogo = level === 'brand' && window.EmpireManufacturerLogos && window.EmpireManufacturerLogos.hasLogo(value);
        return hasBrandLogo
            ? '<strong class="guided-breadcrumb-logo" aria-label="' + escapeInventoryHtml(value) + '">' + guidedIcon(value, 'brand') + '</strong>'
            : '<strong>' + escapeInventoryHtml(value) + '</strong>';
    }
    function uniqueInventoryValues(values) { return [...new Set(values.filter(Boolean))].sort((a,b) => a.localeCompare(b, undefined, { numeric:true })); }
    function compatibleInventoryModelIds(notes) {
        const match = String(notes || '').match(/COMPAT_MODELS:((?:\|\d+\|)+);/i);
        return match ? [...new Set((match[1].match(/\d+/g) || []).map(Number).filter(Boolean))] : [];
    }
    function mergeCompatibilityNotes(notes, modelIds) {
        const clean = String(notes || '').replace(/\s*COMPAT_MODELS:(?:\|\d+\|)+;/ig, '').trim();
        const ids = [...new Set((modelIds || []).map(Number).filter(Boolean))];
        const marker = ids.length ? 'COMPAT_MODELS:' + ids.map(id => '|' + id + '|').join('') + ';' : '';
        return [clean, marker].filter(Boolean).join(' ');
    }
    function updateCompatibleModelOptions(selectedIds) {
        const state = window.EmpireDeviceSelector ? EmpireDeviceSelector.getState('inventoryItem') : {};
        const primaryId = Number(state.modelId || $('#itemDeviceModel').val() || 0);
        const brandId = Number(state.brandId || $('#itemBrand').val() || 0);
        const categoryId = Number(state.categoryId || state.deviceCategoryId || $('#itemDeviceCategory').val() || 0);
        const selected = [...new Set((selectedIds || compatibleInventoryModelIds($('#itemNotes').val())).map(Number).filter(id => id && id !== primaryId))];
        const models = new Map();
        inventoryAllItems.forEach(item => {
            const id = Number(item.deviceModelId || 0);
            if (!id || id === primaryId) return;
            if (brandId && Number(item.brandId || 0) !== brandId) return;
            if (categoryId && Number(item.deviceCategoryId || 0) !== categoryId) return;
            if (!models.has(id)) models.set(id, item.deviceModelName || item.name || ('Model ' + id));
        });
        const select = $('#itemCompatibleModels');
        if (select.hasClass('select2-hidden-accessible')) select.select2('destroy');
        select.empty();
        [...models.entries()].sort((a,b) => String(a[1]).localeCompare(String(b[1]), undefined, {numeric:true})).forEach(([id,name]) => select.append(new Option(name,id,selected.includes(id),selected.includes(id))));
        select.select2({ theme:'bootstrap-5', width:'100%', dropdownParent:$('#inventoryItemModal'), placeholder:'Select other models that use this exact part', allowClear:true });
        select.val(selected.map(String)).trigger('change.select2');
    }
    function expandCompatibleInventoryRows(rows) {
        const result = [...rows];
        const existing = new Set(result.map(item => String(item.id) + ':' + String(item.deviceModelId)));
        rows.forEach(item => compatibleInventoryModelIds(item.notes).forEach(modelId => {
            const key = String(item.id) + ':' + String(modelId);
            if (existing.has(key) || Number(item.deviceModelId) === Number(modelId)) return;
