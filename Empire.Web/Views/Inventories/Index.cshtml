    function supplierImportNormalize(value) { return String(value || '').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim(); }
    function supplierImportCleanDescription(value) {
        let cleaned = String(value || '').replace(/\[([^\]]+)\]\([^)]*\)/g,'$1').trim();
        // Supplier product-line names are useful for quality detection, but they
        // must not become the device/model or inventory name.
        for (let pass = 0; pass < 4; pass++) {
            const before = cleaned;
            cleaned = cleaned
                .replace(/^\s*\((?:mp\+?(?:\s+cof)?|xic|upcell|gen|premium(?:\s+pro)?|aftermarket(?:\s+pro)?)[^)]*\)\s*/i,'')
                .replace(/^\s*(?:mp\+?(?:\s+cof)?|xic|upcell|premium(?:\s+pro)?|gen|aftermarket(?:\s+pro)?|suave|ltps|cof)\s*[-:|]?\s*/i,'');
            if (cleaned === before) break;
        }
        return cleaned.replace(/\s+/g,' ').trim();
    }
    function supplierImportItemLabel(item) {
        return [item.brandName, item.deviceModelName, item.name, item.variant, item.color, item.sku].filter(Boolean).join(' › ');
    }
    function supplierImportCanonical(value) {
        return supplierImportNormalize(supplierImportCleanDescription(value)
            .replace(/digitizer|lcd\s*(?:assembly)?|display\s*(?:assembly)?/ig,' screen ')
            .replace(/charging\s+port\s+flex(?:\s+cable)?/ig,' charging port ')
            .replace(/replacement\s+battery/ig,' battery ')
            .replace(/playstation\s*5/ig,' sony ps5 ')
            .replace(/ipad\s+(\d+)\s*\((\d{4})\)/ig,'ipad $1 $2'));
    }
    function supplierImportPart(value) {
        if (/\bback\s*glass\b|\brear\s*glass\b/i.test(value)) return 'back glass';
        if (/proximity|light\s*sensor/i.test(value)) return 'proximity sensor';
        if (/camera|lens\s*glass/i.test(value)) return 'camera';
        if (/hdmi/i.test(value)) return 'hdmi port';
        if (/charging\s*port/i.test(value)) return 'charging port';
        if (/battery/i.test(value)) return 'battery';
        if (/digitizer|screen|lcd|display|\boled\b|\bincell\b|screen\s*assembly/i.test(value)) return 'screen';
        return '';
    }
    function supplierImportQuality(value, brand) {
        const text = String(value || ''); const samsung = /samsung/i.test(brand || text);
        if (samsung && /refurbished|original|oem/i.test(text)) return 'original';
        if (samsung && /aftermarket/i.test(text)) return 'aftermarket';
        if (/suave|soft\s*oled/i.test(text)) return 'soft oled';
        if (/hard\s*oled/i.test(text)) return 'hard oled';
        if (/in[ -]?cell|\bltps\b|\bcof\b|\blcd\b/i.test(text)) return 'incell';
        if (/refurbished|original|oem/i.test(text)) return 'original refurbished';
        if (/\bgen\s*oled\b/i.test(text)) return 'gen oled';
        return '';
    }
    function supplierCompatibleModelIds(notes) {
        const match = String(notes || '').match(/COMPAT_MODELS:\s*([^;]+)/i);
        return match ? [...match[1].matchAll(/\|(\d+)\|/g)].map(value => Number(value[1])) : [];
    }
    function supplierDetectedModels(description, sku) {
        const expanded = String(description || '').replace(/\b(iphone|ipad)\s+(\d+[a-z]*(?:\s+(?:pro|max|plus|mini|air))*)\s*\/\s*(\d+[a-z]*(?:\s+(?:pro|max|plus|mini|air))*)/ig,
            function(_,family,left,right){ return family + ' ' + left + ' ' + family + ' ' + right; });
        const normalized = supplierImportNormalize(expanded + ' ' + (sku || ''));
        const found = [...new Map(inventoryAllItems.map(item => {
            const model = supplierImportNormalize(item.deviceModelName);
            const index = model ? normalized.indexOf(model) : -1;
            return [Number(item.deviceModelId), {id:Number(item.deviceModelId),name:item.deviceModelName,normalized:model,index:index}];
        }).filter(entry => entry[1].id && entry[1].index >= 0)).values()];
        return found.filter(candidate => !found.some(other => other.id !== candidate.id
            && other.normalized.length > candidate.normalized.length
            && other.index === candidate.index
            && other.normalized.startsWith(candidate.normalized)))
            .sort((a,b) => a.index-b.index || b.normalized.length-a.normalized.length);
    }
    function supplierImportScore(line, item) {
        if (/\bSERVICE_ONLY\b/i.test(item.notes || '')) return -1000;
        if (line.sku && item.sku && supplierImportNormalize(line.sku) === supplierImportNormalize(item.sku)) return 5000;
        const source = supplierImportCanonical(line.description + ' ' + line.sku);
        const target = supplierImportNormalize(supplierImportItemLabel(item));
        let score = 0;
        const part = supplierImportPart(line.description);
        const itemPart = supplierImportPart([item.name,item.inventoryCategoryName,item.description].filter(Boolean).join(' '));
        if (!part || !itemPart || part !== itemPart) return -1000;
        const compatibleIds = [Number(item.deviceModelId), ...supplierCompatibleModelIds(item.notes)];
        if (line.detectedModelIds?.length && !line.detectedModelIds.some(id => compatibleIds.includes(Number(id)))) return -1000;
        score += 140;
        if (line.detectedModelIds?.length && line.detectedModelIds.every(id => compatibleIds.includes(Number(id)))) score += 80;
        const quality = supplierImportQuality(line.description, item.brandName);
        const itemQuality = supplierImportQuality(item.variant || '', item.brandName);
        if (quality && quality !== itemQuality) return -1000;
        if (quality) score += 90;
        const sourceTokens = [...new Set(source.split(' ').filter(token => token.length > 1))];
        const targetTokens = target.split(' ');
        sourceTokens.forEach(token => { if (targetTokens.includes(token)) score += /^a\d{4}$|^iphone$|^ipad$|^macbook$|^ps5$|^incell$|^oled$|^\d{2}$/.test(token) ? 16 : 4; });
        return score;
    }
    function parseSupplierOrderLine(raw, index) {
        let cells = raw.split(/\t|\s{3,}/).map(value => value.trim()).filter(Boolean);
        const moneyMatches = [...raw.matchAll(/\$?(-?\d{1,6}(?:,\d{3})*(?:\.\d{2}))/g)];
        const labeledQty = raw.match(/(?:qty|quantity)\s*[:x]?\s*(\d+)/i);
        let quantity = labeledQty ? Number(labeledQty[1]) : 0;
        let unitCost = moneyMatches.length ? Number(moneyMatches[moneyMatches.length > 1 ? moneyMatches.length - 2 : 0][1].replace(/,/g,'')) : null;
        if (!quantity && cells.length > 1) {
            const candidates = cells.map((value,cellIndex) => ({value,cellIndex})).filter(entry => /^\d+$/.test(entry.value) && Number(entry.value) > 0 && Number(entry.value) < 10000);
            const moneyCell = cells.findIndex(value => /\$|\.\d{2}/.test(value));
            const preferred = candidates.filter(entry => moneyCell < 0 || entry.cellIndex < moneyCell).pop() || candidates[0];
            if (preferred) quantity = Number(preferred.value);
        }
        const skuMatch = raw.match(/\bsku\s*[:#]?\s*([A-Z0-9][A-Z0-9._-]{2,})\b/i)
            || raw.match(/\b(?=[A-Z0-9._-]{5,}\b)(?=[A-Z0-9._-]*\d)(?=[A-Z0-9._-]*[A-Z])[A-Z0-9][A-Z0-9._-]+\b/i)
            || raw.match(/\b(\d{8,})\b/);
        let description = cells.filter(value => !/^\$?-?\d+(?:,\d{3})*(?:\.\d{2})?$/.test(value) && !/^(qty|quantity)$/i.test(value)).join(' ');
        description = description.replace(/\b(?:qty|quantity)\s*[:x]?\s*\d+\b/ig,'').replace(/\s+/g,' ').trim();
        return { index, raw, description:description || raw.trim(), sku:skuMatch ? skuMatch[1] : '', quantity, unitCost };
    }
    function parseSupplierOrderBlocks(text) {
        const rows = [];
        const lines = String(text || '').replace(/\u00a0/g,' ').split(/\r?\n/).map(value => value.trim()).filter(Boolean);
        const ignored = /^(?:product\s+sku\s+price\s+quantity\s+total|fulfilled\b.*|track shipment\b.*|ups(?:®)?\s*#.*|tracking\b.*|subtotal\b.*|shipping\b.*|tax\b.*|discount\b.*|grand total\b.*|order date\b.*|invoice date\b.*)$/i;
        let description = [];
        lines.forEach((raw,index) => {
            if (/^\|/.test(raw)) {
                const cells = raw.split('|').slice(1,-1).map(cell => cell.trim().replace(/<br\s*\/?\s*>/ig,'').replace(/\[([^\]]+)\]\([^)]*\)/g,'$1'));
                if (!cells.length || cells.every(cell => /^:?-{2,}:?$/.test(cell)) || /^product\b/i.test(cells[0])) return;
                const skuIndex = cells.findIndex(cell => /^[A-Z][A-Z0-9._-]{5,}$/i.test(cell));
                const moneyCells = cells.filter(cell => /^\$[0-9,]+(?:\.\d{2})$/.test(cell));
                if (skuIndex > 0 && moneyCells.length >= 2) {
                    const quantity = Number(cells.slice(skuIndex + 1).find(cell => /^\d+$/.test(cell)) || 0);
                    rows.push({index,raw,description:cells[0],sku:cells[skuIndex],quantity,unitCost:Number(moneyCells[0].replace(/[$,]/g,'')),total:Number(moneyCells[moneyCells.length-1].replace(/[$,]/g,''))});
                    description = []; return;
                }
            }
            if (ignored.test(raw)) return;
            const detail = raw.match(/^([A-Z][A-Z0-9._-]{5,})\s+\$?([0-9,]+(?:\.\d{2}))\s+(\d+)\s+\$?([0-9,]+(?:\.\d{2}))$/i);
            if (detail) {
                const unitCost = Number(detail[2].replace(/,/g,'')); const quantity = Number(detail[3]); const total = Number(detail[4].replace(/,/g,''));
                rows.push({index,raw:description.concat(raw).join(' | '),description:description.join(' ').replace(/\s+/g,' ').trim() || detail[1],sku:detail[1],quantity,unitCost,total});
                description = []; return;
            }
            const oneLine = parseSupplierOrderLine(raw,index);
            if (oneLine.quantity > 0 && oneLine.unitCost !== null && oneLine.description.length > 2) { rows.push(oneLine); description=[]; return; }
            if (!/^(?:order|invoice)\s*(?:number|no\.?|#)/i.test(raw)) description.push(raw);
        });
        return rows;
    }
    function parseSupplierOrder() {
        const text = $('#supplierImportText').val().trim();
        if (!text) { showToast('warning','Paste the supplier order first.'); return; }
        if (!$('#supplierImportReference').val()) {
            const order = text.match(/(?:order|invoice)\s*(?:number|no\.?|#)?\s*[:#]?\s*([A-Z0-9-]{3,})/i);
            if (order) $('#supplierImportReference').val(order[1]);
        }
        supplierImportLines = parseSupplierOrderBlocks(text).filter(line => line.quantity > 0 && line.unitCost !== null && line.unitCost >= 0 && line.description.length > 2);
        supplierImportLines.forEach(line => { line.cleanedDescription = supplierImportCleanDescription(line.description); });
        if (!supplierImportLines.length) {
            $('#supplierImportMessage').removeClass('d-none alert-success').addClass('alert-warning').text('No complete items were found. Keep the product description above its SKU, unit price, quantity and total row, or upload a clearer document.');
            $('#supplierImportReview').addClass('d-none'); $('#supplierImportConfirm').prop('disabled',true); return;
        }
        $('#supplierImportMessage').removeClass('d-none alert-warning').addClass('alert-success').text('Found ' + supplierImportLines.length + ' item line(s). Confirm each match before importing.');
        const rows = supplierImportLines.map((line,rowIndex) => {
            line.detectedModels = supplierDetectedModels(line.description, line.sku);
            line.detectedModelIds = line.detectedModels.map(model => model.id);
            const ranked = inventoryAllItems.filter(item => !/\bSERVICE_ONLY\b/i.test(item.notes || '')).map(item => ({item,score:supplierImportScore(line,item)})).filter(entry => entry.score > 0).sort((a,b) => b.score-a.score).slice(0,12);
            const best = ranked[0]; const second = ranked[1];
            const exactSku = best && line.sku && best.item.sku && supplierImportNormalize(line.sku) === supplierImportNormalize(best.item.sku);
            const coversAllModels = best && (!line.detectedModelIds.length || line.detectedModelIds.every(id => [Number(best.item.deviceModelId),...supplierCompatibleModelIds(best.item.notes)].includes(Number(id))));
            const confident = !!(best && best.score >= 140 && (exactSku || (coversAllModels && (!second || best.score > second.score))));
            const options = '<option value="">Choose inventory item…</option>' + ranked.map((entry,index) => '<option value="' + entry.item.id + '" ' + (index === 0 && confident ? 'selected' : '') + '>' + escapeInventoryHtml(supplierImportItemLabel(entry.item)) + '</option>').join('');
            line.matchId = confident ? Number(best.item.id) : 0;
            return '<tr data-row="' + rowIndex + '"><td><input type="checkbox" class="form-check-input supplier-import-include" ' + (confident ? 'checked' : '') + ' onchange="updateSupplierImportReady()"></td>'
                + '<td class="supplier-import-description"><strong>' + escapeInventoryHtml(line.cleanedDescription || line.description) + '</strong>'
                + ((line.cleanedDescription || '') !== line.description ? '<div class="small text-muted">Supplier text: ' + escapeInventoryHtml(line.description) + '</div>' : '')
                + '<div class="small text-muted">SKU: ' + escapeInventoryHtml(line.sku || '—') + '</div></td>'
                + '<td><input type="number" min="1" step="1" class="form-control form-control-sm supplier-import-qty" value="' + line.quantity + '" oninput="updateSupplierImportReady()"></td>'
                + '<td><input type="number" min="0" step="0.01" class="form-control form-control-sm supplier-import-cost" value="' + line.unitCost.toFixed(2) + '" oninput="updateSupplierImportReady()"></td>'
                + '<td><select class="form-select form-select-sm supplier-import-match" onchange="supplierImportMatchChanged(this)">' + options + '</select></td>'
                + '<td class="supplier-import-status ' + (confident ? 'text-success' : 'text-warning') + '">' + (confident ? 'Matched' : '<span>Not matched</span><button type="button" class="btn btn-sm btn-outline-primary d-block mt-1" onclick="prepareSupplierNewItem(' + rowIndex + ')">Create new part</button>') + '</td></tr>';
        }).join('');
        $('#supplierImportRows').html(rows); $('#supplierImportReview').removeClass('d-none');
        if (typeof $.fn.select2 !== 'undefined') {
            $('.supplier-import-match').select2({
                theme:'bootstrap-5', width:'100%', dropdownParent:$('#supplierOrderImportModal'), placeholder:'Search inventory…', allowClear:true,
                minimumInputLength:1,
                ajax:{
                    url:'@Url.Action("GetInventoryItems", "Inventories")', dataType:'json', delay:200,
                    data:params => ({search:params.term || ''}),
                    processResults:response => ({results:(response && response.success ? response.data : []).filter(item => !/\bSERVICE_ONLY\b/i.test(item.notes || '')).map(item => ({id:item.id,text:supplierImportItemLabel(item)}))})
                }
            }).on('change', function(){ supplierImportMatchChanged(this); });
        }
        updateSupplierImportReady();
    }
    async function supplierImportEnsureLookups() {
        if (supplierImportLookups) return supplierImportLookups;
        const responses = await Promise.all([
            fetch('/LookupManagement/GetBrands').then(response => response.json()),
            fetch('/LookupManagement/GetDeviceCategories').then(response => response.json()),
            fetch('/LookupManagement/GetDeviceModels').then(response => response.json())
        ]);
        supplierImportLookups = {
            brands: responses[0].success ? (responses[0].data || []) : [],
            categories: responses[1].success ? (responses[1].data || []) : [],
            models: responses[2].success ? (responses[2].data || []) : []
        };
        return supplierImportLookups;
    }
    function supplierLookupValue(value, lower, upper) { return value?.[lower] ?? value?.[upper]; }
    function supplierImportDetectedBrand(description, brands) {
        const text = supplierImportNormalize(description);
        const aliases = [
            [/\biphone\b|\bipad\b|\bmacbook\b|\bapple watch\b/,'apple'],
            [/\bsamsung\b|\bgalaxy\b/,'samsung'], [/\bmotorola\b|\bmoto\b/,'motorola'],
            [/\bgoogle\b|\bpixel\b/,'google'], [/\bplaystation\b|\bps5\b/,'sony'], [/\bxbox\b/,'microsoft']
        ];
        const alias = aliases.find(entry => entry[0].test(text));
        return brands.find(brand => {
            const name = supplierImportNormalize(supplierLookupValue(brand,'name','Name'));
            return name && (text.includes(name) || (alias && name.includes(alias[1])));
        }) || null;
    }
    function supplierImportSuggestedModel(line, brandName) {
        const text = supplierImportCleanDescription(line.description);
        const modelNumberMatch = text.match(/\b(XT\d{4}[A-Z0-9-]*|SM-[A-Z0-9-]+|A\d{4})\b/i);
        const modelNumber = modelNumberMatch ? modelNumberMatch[1].toUpperCase() : '';
        const patterns = [
            /\b(iPhone\s+(?:SE(?:\s+\d(?:st|nd|rd)?\s*Gen)?|\d{1,2}[A-Za-z]?(?:\s+(?:Pro\s+Max|Pro|Plus|Mini|Air|Max))?))/i,
            /\b(iPad\s+(?:Pro|Air|Mini)?\s*\d{1,2}(?:\.\d)?(?:\s*\([^)]*\))?)/i,
            /\b(Galaxy\s+(?:S|A|Note|Z|Tab\s+[AS])\s*\d{1,3}(?:\s+(?:Ultra|Plus|FE|5G|Fold|Flip))*)/i,
            /\b(Pixel\s+\d{1,2}[A-Za-z]?(?:\s+(?:Pro\s+XL|Pro|XL|Fold))*)/i,
            /\b(PlayStation\s*5(?:\s+(?:Slim|Pro))?|PS5(?:\s+(?:Slim|Pro))?)/i,
            /\b(Xbox\s+(?:Series\s+[XS]|One\s+[XS]?))/i
        ];
        let match = patterns.map(pattern => text.match(pattern)).find(Boolean);
        let name = match ? match[1].trim() : '';
        if (!name && /motorola|\bmoto\b/i.test(brandName + ' ' + text)) {
            let segment = text.split(/\bfor\b/i).pop() || text;
            segment = segment.replace(/^.*?\b(?:motorola|moto)\b\s*/i,'');
            if (modelNumber) segment = segment.split(new RegExp('\\b' + modelNumber.replace(/[-/\\^$*+?.()|[\]{}]/g,'\\$&') + '\\b','i'))[0];
            name = segment.replace(/\b(?:replacement|premium|screen|display|lcd|oled|assembly|digitizer|battery|charging\s+port|flex|cable|black|white)\b/ig,' ').replace(/[-–—()]+/g,' ').replace(/\s+/g,' ').trim();
        }
        if (!name && modelNumber) name = modelNumber;
        return { name, modelNumber };
    }
    function supplierImportDetectedColor(description) {
        const match = String(description || '').match(/\s[-–—]\s*([A-Za-z][A-Za-z ]{1,32})\s*(?:\([^)]*\))?$/);
        if (!match || /assembly|sensor|technology|installed|required/i.test(match[1])) return '';
        return match[1].trim();
    }
    function supplierNewPartRefreshModels(preferredId) {
