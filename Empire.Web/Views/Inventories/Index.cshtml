    // ── Live SKU Preview ──────────────────────────────────────────────────────
    function previewSku() {
        const brandId    = parseInt($('#itemBrand').val()) || 0;
        const catId      = parseInt($('#itemDeviceCategory').val()) || 0;
        const modelId    = parseInt($('#itemDeviceModel').val()) || 0;

        if (!brandId || !catId || !modelId) {
            showToast('info', 'Please select Brand, Category and Model first.');
