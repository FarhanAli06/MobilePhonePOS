@{
    ViewData["Title"] = "Inventory Management";
    var isInventoryAdmin = ViewBag.IsInventoryAdmin == true;
}

@section Styles {
    <!-- Select2 CSS for searchable dropdowns -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    
    <style>
        .inventory-page { --inv-gold:#f4bc12; --inv-line:#e4e7ec; --inv-subtle:#68707d; }
        .inventory-page .inventory-top { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:20px; }
        .inventory-page .inventory-top-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
        .inventory-page .inventory-toolbar { display:grid; grid-template-columns:minmax(260px,1.5fr) repeat(3,minmax(145px,.6fr)); gap:10px; margin-bottom:14px; }
        .inventory-page .inventory-search { position:relative; }
        .inventory-page .inventory-search i { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--inv-subtle); z-index:2; }
        .inventory-page .inventory-search input { padding-left:38px; }
        .inventory-page .inventory-summary { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:14px; }
        .inventory-page .inventory-stat { background:#fff; border:1px solid var(--inv-line); border-radius:10px; padding:12px 14px; }
        .inventory-page .inventory-stat-label { color:var(--inv-subtle); margin-bottom:3px; }
        .inventory-page .inventory-stat-value { font-size:20px; font-weight:600; }
        .inventory-page .inventory-table-wrap { background:#fff; border:1px solid var(--inv-line); border-radius:12px; overflow:hidden; }
        .inventory-page .inventory-bulk { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 12px; border-bottom:1px solid var(--inv-line); }
        .inventory-page .inventory-bulk-left,.inventory-page .inventory-bulk-right { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
        .inventory-page .part-name { font-weight:600; white-space:nowrap; }
        .inventory-page .device-path { color:var(--inv-subtle); font-size:12px; margin-top:2px; white-space:nowrap; }
        .inventory-page .inline-qty { width:70px; text-align:center; }
        .inventory-page .inline-money { width:88px; text-align:right; }
        .inventory-page .stock-status { display:inline-flex; align-items:center; gap:6px; white-space:nowrap; }
        .inventory-page .stock-dot { width:8px; height:8px; border-radius:50%; background:#198754; }
        .inventory-page .stock-dot.low { background:#dc3545; }
        .inventory-page .stock-dot.warning { background:#f4bc12; }
        .inventory-view-switch { display:inline-flex; background:#eef1f4; border-radius:10px; padding:4px; gap:3px; margin-bottom:14px; }
        .inventory-view-switch button { border:0; background:transparent; color:#68707d; padding:8px 14px; border-radius:7px; font-weight:600; }
        .inventory-view-switch button.active { background:#fff; color:#181a1f; box-shadow:0 1px 4px rgba(0,0,0,.12); }
        .guided-browser { background:#fff; border:1px solid var(--inv-line); border-radius:12px; padding:18px; margin-bottom:14px; }
        .guided-head { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:14px; }
        .guided-head-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
        .guided-browse-switch { display:inline-flex; align-items:center; gap:3px; padding:3px; background:#f0f2f5; border-radius:8px; }
        .guided-browse-switch button { border:0; background:transparent; color:var(--inv-subtle); border-radius:6px; padding:6px 9px; font-size:12px; font-weight:600; }
        .guided-browse-switch button.active { background:#fff; color:#181a1f; box-shadow:0 1px 3px rgba(0,0,0,.12); }
        .guided-breadcrumb { color:var(--inv-subtle); font-size:14px; }
        .guided-breadcrumb strong { color:#181a1f; }
        .guided-breadcrumb-logo .manufacturer-logo { width:auto; max-width:18px; max-height:18px; vertical-align:middle; }
        .guided-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:12px; }
        .guided-choice,.guided-model-card { border:1px solid var(--inv-line); background:#fff; border-radius:11px; padding:16px; text-align:left; transition:.15s ease; }
        .guided-choice { cursor:pointer; min-height:112px; display:flex; flex-direction:column; justify-content:space-between; }
        .guided-choice:hover { border-color:var(--inv-gold); box-shadow:0 5px 16px rgba(0,0,0,.08); transform:translateY(-1px); }
        .guided-choice.add-choice { border-style:dashed; border-color:#c6cbd2; color:#49515c; }
        .guided-choice.add-choice .guided-choice-icon { color:#b78300; }
        .guided-choice-icon { font-size:28px; color:#1d232b; margin-bottom:12px; min-height:34px; display:flex; align-items:center; }
        .guided-choice-icon .manufacturer-logo { max-height:34px; max-width:105px; }
        .guided-choice.brand-logo-only { align-items:center; justify-content:center; text-align:center; }
        .guided-choice.brand-logo-only .guided-choice-icon { width:100%; min-height:58px; margin:0; justify-content:center; }
        .guided-choice.brand-logo-only .manufacturer-logo { height:52px; max-height:52px; max-width:145px; }
        .guided-choice-name { font-weight:700; }
        .guided-choice-count { color:var(--inv-subtle); font-size:12px; margin-top:3px; }
        .guided-model-card { min-height:190px; display:flex; flex-direction:column; }
        .backglass-model-card { grid-column:span 2; min-height:285px; }
        .backglass-color-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px 12px; margin:10px 0; }
        .backglass-color-line { display:flex; justify-content:space-between; gap:8px; border-bottom:1px solid #edf0f3; padding:4px 0; font-size:13px; }
        @@media (max-width:700px) { .backglass-model-card { grid-column:span 1; } }
        .guided-model-name { font-weight:700; font-size:15px; margin-bottom:4px; }
        .guided-stock { font-size:23px; font-weight:700; margin:8px 0; }
        .guided-costs { color:var(--inv-subtle); font-size:12px; line-height:1.7; margin-bottom:12px; }
        .guided-card-actions { display:flex; gap:7px; margin-top:auto; }
        .guided-card-status { display:flex; align-items:center; justify-content:space-between; gap:8px; }
        .inventory-alert-toggle { border:1px solid var(--inv-line); background:#fff; color:#8a919c; border-radius:7px; padding:4px 7px; line-height:1; }
        .inventory-alert-toggle.active { color:#b77d00; border-color:#f4bc12; background:#fff9df; }
        .guided-empty { grid-column:1/-1; padding:35px; text-align:center; color:var(--inv-subtle); }
        .inventory-workspace { grid-column:1/-1; border:1px solid var(--inv-line); border-radius:12px; overflow:hidden; background:#fff; }
        .inventory-workspace-top { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:0 14px; border-bottom:1px solid var(--inv-line); }
        .inventory-workspace-tabs { display:flex; gap:24px; overflow-x:auto; }
        .inventory-workspace-tab { flex:0 0 auto; border:0; border-bottom:3px solid transparent; background:transparent; padding:15px 2px 12px; color:#596273; font-weight:600; white-space:nowrap; }
        .inventory-workspace-tab.active { color:#0d6efd; border-bottom-color:#0d6efd; }
        .inventory-workspace-tools { display:grid; grid-template-columns:minmax(220px,1fr) auto auto; gap:10px; padding:12px 14px; align-items:center; border-bottom:1px solid var(--inv-line); }
        .inventory-workspace-search { position:relative; }
        .inventory-workspace-search i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#87909d; }
        .inventory-workspace-search input { padding-left:36px; }
        .inventory-workspace-columns,.inventory-workspace-entry { display:grid; grid-template-columns:minmax(145px,1fr) 82px 92px 105px minmax(130px,170px) 78px; gap:10px; align-items:center; }
        .inventory-workspace-columns { padding:9px 16px; color:#707987; font-size:12px; font-weight:700; background:#f7f9fb; border-bottom:1px solid var(--inv-line); }
        .inventory-workspace-model { border-bottom:1px solid var(--inv-line); }
        .inventory-workspace-model:last-child { border-bottom:0; }
        .inventory-workspace-model-head { display:grid; grid-template-columns:32px 54px minmax(190px,1fr) auto; gap:10px; align-items:center; padding:12px 16px; background:#fff; cursor:pointer; }
        .inventory-workspace-model-head:hover { background:#f8fbff; }
        .inventory-workspace-chevron { border:0; background:transparent; color:#4d5968; }
        .inventory-model-thumbnail { width:46px; height:54px; object-fit:contain; border-radius:8px; background:#f2f4f7; padding:3px; }
        .inventory-workspace-model-name { font-weight:700; }
        .inventory-workspace-model-meta { color:var(--inv-subtle); font-size:12px; margin-top:2px; }
        .inventory-workspace-total { font-weight:700; white-space:nowrap; }
        .inventory-workspace-entries { padding:0 16px 10px 112px; background:#fbfcfe; }
        .inventory-workspace-entry { min-height:48px; padding:7px 0; border-top:1px solid #e9edf2; }
        .inventory-workspace-option { font-weight:600; min-width:0; overflow-wrap:anywhere; }
        .inventory-workspace-stock { display:flex; align-items:center; gap:6px; font-weight:600; }
        .inventory-workspace-stock-dot { width:9px; height:9px; border-radius:50%; background:#198754; flex:0 0 9px; }
        .inventory-workspace-stock-dot.warning { background:#f4b400; }
        .inventory-workspace-stock-dot.low { background:#dc3545; }
        .inventory-workspace-entry .form-control { min-width:0; }
        .inventory-workspace-actions { display:flex; gap:5px; justify-content:flex-end; }
        .inventory-workspace-footer { position:sticky; bottom:0; display:flex; justify-content:space-between; align-items:center; gap:12px; padding:12px 16px; background:#fff; border-top:1px solid var(--inv-line); box-shadow:0 -4px 12px rgba(0,0,0,.05); }
        .inventory-workspace-ready { color:#4f5968; font-size:13px; }
        @@media (max-width:900px) { .inventory-workspace-columns { display:none; } .inventory-workspace-entry { grid-template-columns:1fr 70px 80px; } .inventory-workspace-entry > :nth-child(n+4) { grid-column:span 1; } .inventory-workspace-entries { padding-left:16px; } }
        .inventory-page .card, .inventory-page .card:hover { transform:none; box-shadow:none; }
        #inventoryTable { margin:0 !important; border:0; }
        /* Ensure table header text is visible */
        #inventoryTable thead th {
            background-color:#fff !important;
            color:var(--inv-subtle) !important;
            font-weight:500;
            padding:10px 8px;
            border-bottom:1px solid var(--inv-line) !important;
        }
        
        /* Ensure DataTables controls are visible */
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            color: #212529 !important;
        }
        
        /* Ensure table body text is visible */
        #inventoryTable tbody td {
            color: #212529;
            padding:9px 8px;
            vertical-align:middle;
        }
        
        /* Fix modal backdrop and overlay - CLEAN approach */
        .modal-backdrop {
            z-index: 1040 !important;
            background-color: rgba(0, 0, 0, 0.5) !important;
        }
        
        .modal {
            z-index: 1050 !important;
            /* DO NOT add background-color here - it makes modal black! */
        }
        
        .modal-dialog {
            z-index: 1051 !important;
        }
        
        .modal-content {
            z-index: 1052 !important;
            background-color: #fff !important;
        }
        
        /* Select2 dropdowns MUST be above modal */
        .select2-dropdown {
            z-index: 10000 !important;
            background-color: white !important;
        }
        
        .select2-container--open .select2-dropdown {
            z-index: 10001 !important;
        }
        
        .select2-results {
            background-color: white !important;
        }
        
        /* Make sure Select2 search box is visible and functional */
        .select2-container--open .select2-search--dropdown .select2-search__field {
            background-color: white !important;
            border: 1px solid #ced4da !important;
        }
               /* Make sure Select2 search input is accessible */
        .select2-search__field {
            width: 100% !important;
        }

        /* Inventory modal section cards */
        .section-card {
            border-color: #dee2e6 !important;
            transition: box-shadow 0.15s ease;
        }
        .section-card:hover {
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }
        .section-title {
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid #dee2e6;
            padding-bottom: 0.5rem;
        }
        /* SKU preview badge */
        #skuPreviewBadge code {
            font-size: 1rem;
            font-weight: 600;
            color: #0a3622;
        }
        .inventory-model-tabs-wrap { margin-bottom:14px; padding-bottom:10px; border-bottom:1px solid var(--inv-line); }
        .inventory-model-tabs-label { color:var(--inv-subtle); font-size:12px; font-weight:700; margin-bottom:7px; text-transform:uppercase; letter-spacing:.04em; }
        .inventory-model-tabs { display:flex; gap:7px; overflow-x:auto; padding:1px 1px 7px; scrollbar-width:thin; }
        .inventory-model-tab { flex:0 0 auto; border:1px solid #cfd5dc; background:#fff; color:#343a40; border-radius:8px; padding:7px 11px; font-size:12px; font-weight:600; white-space:nowrap; }
        .inventory-model-tab:hover { border-color:#0d6efd; color:#0d6efd; }
        .inventory-model-tab.active { border-color:#0d6efd; background:#0d6efd; color:#fff; box-shadow:0 2px 6px rgba(13,110,253,.22); }
        .supplier-import-table th { white-space:nowrap; }
        .supplier-import-description { min-width:260px; max-width:420px; white-space:normal; }
        .supplier-import-match { min-width:330px; }
        .supplier-import-status { white-space:nowrap; font-size:12px; font-weight:700; }
        @@media (max-width: 1100px) { .inventory-page .inventory-toolbar { grid-template-columns:1fr 1fr; } }
        @@media (max-width: 700px) { .inventory-page .inventory-top { flex-direction:column; } .inventory-page .inventory-toolbar,.inventory-page .inventory-summary { grid-template-columns:1fr; } }
    </style>
}

<div class="inventory-page">
<div class="inventory-top">
    <div>
        <h2 class="mb-1">Inventory</h2>
        <p class="text-muted mb-0">Manage individual repair parts—no service or labor bundles.</p>
    </div>
    <div class="inventory-top-actions">
        <button type="button" class="btn btn-outline-primary" onclick="openSupplierOrderImport()"><i class="fas fa-file-import me-2"></i>Import supplier order</button>
        <button type="button" class="btn btn-primary" onclick="showAddInventoryItemModal()"><i class="fas fa-plus me-2"></i>Add inventory part</button>
    </div>
</div>

<div class="inventory-view-switch" role="tablist" aria-label="Inventory view">
    <button type="button" id="guidedViewButton" class="active" onclick="setInventoryMode('guided')"><i class="fas fa-sitemap me-1"></i>Guided view</button>
    <button type="button" id="allViewButton" onclick="setInventoryMode('all')"><i class="fas fa-list me-1"></i>All inventory</button>
    <button type="button" id="lowViewButton" onclick="setInventoryMode('low')"><i class="fas fa-exclamation-circle me-1"></i>Low stock</button>
</div>

<section id="guidedInventoryBrowser" class="guided-browser" aria-label="Guided inventory browser">
    <div class="guided-head">
        <div><div id="guidedBreadcrumb" class="guided-breadcrumb">Inventory</div><h5 id="guidedTitle" class="mb-0 mt-1">Choose a brand</h5></div>
        <div class="guided-head-actions">
            <div class="guided-browse-switch" aria-label="Browse inventory by">
                <button type="button" id="browseBrandButton" class="active" onclick="setGuidedBrowseOrder('brand')">Brand first</button>
                <button type="button" id="browsePartButton" onclick="setGuidedBrowseOrder('part')">Part first</button>
            </div>
            <button type="button" id="guidedBackButton" class="btn btn-sm btn-outline-secondary d-none" onclick="guidedBack()"><i class="fas fa-arrow-left me-1"></i>Back</button>
        </div>
    </div>
    <div id="guidedInventoryGrid" class="guided-grid"><div class="guided-empty">Loading inventory…</div></div>
</section>

<div class="modal fade" id="backGlassModelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="backGlassModelTitle">Back Glass Colors</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">
            <div class="inventory-model-tabs-wrap"><div class="inventory-model-tabs-label">Choose another model</div><div class="inventory-model-tabs" id="backGlassModelTabs"></div></div>
            <p class="text-muted small" id="backGlassModelHelp">Enter quantities and purchase costs for several colors, then save once. Each color stays a separate inventory item and receives its own FIFO batch.</p>
            <div id="backGlassColorRows"></div>
            <div class="mt-3"><label for="backGlassVendor" class="form-label">Supplier (optional)</label><input id="backGlassVendor" class="form-control" placeholder="Supplier name"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary me-auto" onclick="navigateInventoryVariantModel(-1)"><i class="fas fa-chevron-left me-1"></i>Previous</button>
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" class="btn btn-outline-primary inventory-variant-save" id="saveBackGlassColorsButton" onclick="saveBackGlassColors('stay')">Save</button>
            <button type="button" class="btn btn-primary inventory-variant-save" id="saveBackGlassNextButton" onclick="saveBackGlassColors('next')">Save &amp; Next <i class="fas fa-chevron-right ms-1"></i></button>
        </div>
    </div></div>
</div>

<div id="inventoryTableControls" class="d-none">
<div class="inventory-toolbar">
    <div class="inventory-search"><i class="fas fa-search"></i><input class="form-control" id="inventorySearch" placeholder="Search model, part, SKU or vendor"></div>
    <select class="form-select" id="filterBrand"><option value="">All brands</option></select>
    <select class="form-select" id="filterDeviceCategory"><option value="">All families</option></select>
    <select class="form-select" id="filterStockStatus"><option value="">All stock</option><option value="in_stock">In stock</option><option value="low_stock">Low stock</option><option value="out_of_stock">Out of stock</option></select>
    <select class="d-none" id="filterDeviceModel"><option value=""></option></select>
    <select class="d-none" id="filterInventoryCategory"><option value=""></option></select>
</div>

<div class="inventory-summary">
    <div class="inventory-stat"><div class="inventory-stat-label">Inventory parts</div><div class="inventory-stat-value" id="inventoryPartCount">0</div></div>
    <div class="inventory-stat"><div class="inventory-stat-label">Low-stock parts</div><div class="inventory-stat-value" id="inventoryLowCount">0</div></div>
    <div class="inventory-stat"><div class="inventory-stat-label">Inventory value</div><div class="inventory-stat-value" id="inventoryValue">$0.00</div></div>
</div>

<!-- Inventory Items Table -->
<div class="inventory-table-wrap">
    <div class="inventory-bulk">
        <div class="inventory-bulk-left">
            <div id="bulkActions" class="d-none gap-2 align-items-center"><strong><span id="selectedInventoryCount">0</span> selected</strong><button class="btn btn-sm btn-outline-primary" onclick="bulkSetReorderPoint()">Edit selected</button><button class="btn btn-sm btn-outline-secondary" onclick="clearInventorySelection()">Clear</button></div>
            <span id="noBulkSelection" class="text-muted small">Select rows to edit multiple parts</span>
        </div>
        <div class="inventory-bulk-right"><button class="btn btn-sm btn-outline-secondary" onclick="showLowStockReport()">Low stock</button><button class="btn btn-sm btn-outline-secondary" onclick="showStockMovements()">Stock movements</button></div>
    </div>
    <div class="table-responsive">
            <table id="inventoryTable" class="table table-sm">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="selectAllInventory" aria-label="Select all inventory rows"></th>
                        <th>Part and device</th>
                        <th>SKU</th>
                        <th>Quantity</th>
                        <th>Latest Cost</th>
                        <th>Average Cost</th>
                        <th>Selling Price</th>
                        <th>Reorder At</th>
                        <th>Vendor</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded via AJAX -->
                </tbody>
            </table>
    </div>
</div>
</div>
</div>

<div class="modal fade" id="supplierOrderImportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><div><h5 class="modal-title"><i class="fas fa-file-import me-2"></i>Import supplier order</h5><div class="small text-muted">Paste an order or upload a PDF/screenshot. Review every match before inventory is received.</div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4"><label class="form-label">Supplier</label><select id="supplierImportVendor" class="form-select"><option>SEG Mobile</option><option>Mobile Sentrix</option><option>Fast Cellular</option></select></div>
                <div class="col-md-4"><label class="form-label">Order / invoice number</label><input id="supplierImportReference" class="form-control" placeholder="Detected automatically when possible"></div>
                <div class="col-md-4"><label class="form-label">Date received</label><input id="supplierImportDate" type="date" class="form-control"></div>
                <div class="col-12">
                    <label class="form-label">Upload invoice PDF or screenshot</label>
                    <div class="input-group"><input id="supplierImportFile" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg,.webp,application/pdf,image/png,image/jpeg,image/webp" onchange="extractSupplierDocument(this)"><button id="supplierImportExtractButton" type="button" class="btn btn-outline-primary" onclick="extractSupplierDocument(document.getElementById('supplierImportFile'))"><i class="fas fa-eye me-1"></i>Read file</button></div>
                    <div class="form-text">PDFs and screenshots are read into the box below. Nothing is added until you review and confirm it.</div>
                </div>
                <div class="col-12"><label class="form-label">Supplier order text</label><textarea id="supplierImportText" class="form-control font-monospace" rows="11" placeholder="Paste the complete order exactly as the supplier shows it. Multi-line items, fulfillment lines, tracking numbers, SKU, price and quantity are supported."></textarea></div>
            </div>
            <div class="d-flex align-items-center gap-2 mb-3"><button type="button" class="btn btn-primary" onclick="parseSupplierOrder()"><i class="fas fa-magic me-1"></i>Read and match order</button><span class="small text-muted">No inventory is changed during this step.</span></div>
            <div id="supplierImportMessage" class="alert alert-light border d-none"></div>
