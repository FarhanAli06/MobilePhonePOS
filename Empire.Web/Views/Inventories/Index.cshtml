    function newestModelFirst(a, b) {
        const left = String(a.deviceModelName || a.name || '');
        const right = String(b.deviceModelName || b.name || '');
        const number = value => {
            const matches = String(value).match(/\d+(?:\.\d+)?/g);
            return matches && matches.length ? Math.max(...matches.map(Number)) : -1;
        };
        const numberDifference = number(right) - number(left);
        if (numberDifference) return numberDifference;
        const variantRank = value => /pro\s*max/i.test(value) ? 5 : /ultra/i.test(value) ? 4 : /pro/i.test(value) ? 3 : /plus/i.test(value) ? 2 : /mini/i.test(value) ? 0 : 1;
        const variantDifference = variantRank(right) - variantRank(left);
        return variantDifference || right.localeCompare(left, undefined, { numeric:true, sensitivity:'base' });
    }
