    function enableGuidedDrag(grid) {
        const key = guidedOrderKey();
        const cards = [...grid.querySelectorAll('.guided-choice:not(.add-choice),.guided-model-card')];
        let saved = [];
        try { saved = JSON.parse(localStorage.getItem(key) || '[]'); } catch (_) { saved = []; }
        cards.sort((a,b) => {
            const ai = saved.indexOf(a.dataset.value), bi = saved.indexOf(b.dataset.value);
            return (ai < 0 ? 9999 : ai) - (bi < 0 ? 9999 : bi);
        }).forEach(card => grid.append(card));
        let dragging = null;
        cards.forEach(card => {
            card.draggable = true;
            card.title = 'Drag to rearrange';
            card.addEventListener('dragstart', event => { dragging = card; grid.dataset.dragged = '1'; event.dataTransfer.effectAllowed = 'move'; });
            card.addEventListener('dragover', event => {
                event.preventDefault();
                if (!dragging || dragging === card) return;
                const box = card.getBoundingClientRect();
                grid.insertBefore(dragging, event.clientY > box.top + box.height / 2 || event.clientX > box.left + box.width / 2 ? card.nextSibling : card);
            });
            card.addEventListener('dragend', () => {
                dragging = null;
                localStorage.setItem(key, JSON.stringify([...grid.querySelectorAll('.guided-choice:not(.add-choice),.guided-model-card')].map(x => x.dataset.value)));
                setTimeout(() => { grid.dataset.dragged = ''; }, 120);
