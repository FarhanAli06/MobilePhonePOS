@model Empire.Web.Models.RepairIndexViewModel
@{
    ViewData["Title"] = "Repairs";
}

<!-- Material Icons -->
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --primary: #2196f3;
        --primary-dark: #1976d2;
        --secondary: #4caf50;
        --danger: #f44336;
        --warning: #ff9800;
        --purple: #9c27b0;
        --bg-light: #f8f9fa;
        --text-dark: #1a1a1a;
        --text-light: #666666;
        --border: #e0e0e0;
        --shadow: 0 4px 12px rgba(0,0,0,0.1);
        --radius: 8px;
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--bg-light);
    }

    .repairs-header {
        background: white;
        padding: 25px 30px;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .repairs-title {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-dark);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .repairs-title i {
        color: var(--primary);
        font-size: 32px;
    }

    .filters-card {
        background: white;
        border-radius: var(--radius);
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: var(--shadow);
    }

    .filters-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid var(--bg-light);
    }

    .filters-header i {
        color: var(--primary);
    }

    .filters-header h6 {
        margin: 0;
        font-weight: 600;
        font-size: 18px;
    }

    .form-label {
        font-weight: 500;
        font-size: 14px;
        color: var(--text-dark);
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 10px 12px;
        font-size: 14px;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.1);
    }

    .btn-modern {
        padding: 10px 20px;
        border-radius: var(--radius);
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
        border: none;
    }

    .btn-primary-modern {
        background: var(--primary);
        color: white;
    }

    .btn-primary-modern:hover {
        background: var(--primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(33, 150, 243, 0.3);
    }

    .btn-secondary-modern {
        background: var(--bg-light);
        color: var(--text-dark);
        border: 1px solid var(--border);
    }

    .btn-secondary-modern:hover {
        background: #e9ecef;
    }

    .repairs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 20px;
        margin-top: 25px;
    }

    .repair-card {
        background: white;
        border-radius: var(--radius);
        padding: 20px;
        min-width: 0;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border-left: 4px solid var(--primary);
        transition: 0.3s;
        position: relative;
    }

    .repair-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
    }

    .repair-card-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 15px;
    }

    .repair-customer-heading { font-size:20px; font-weight:800; color:var(--text-dark); line-height:1.2; }
    .repair-customer-phone { margin-top:3px; color:var(--text-light); font-size:13px; font-weight:600; }

    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .status-pending { background: #fff3cd; color: #856404; }
    .status-in-progress { background: #d1ecf1; color: #0c5460; }
    .status-completed { background: #d4edda; color: #155724; }
    .status-cancelled { background: #f8d7da; color: #721c24; }
    .status-ready { background: #e2d9f3; color: #6f42c1; }
    .repair-status-select, .repair-payment-select { width:132px; max-width:132px; height:32px; border:1px solid currentColor; border-radius:16px; padding:3px 24px 3px 10px; font-size:11px; font-weight:800; line-height:20px; cursor:pointer; vertical-align:middle; }
    .repair-status-select:disabled, .repair-payment-select:disabled { opacity:.6; cursor:wait; }
    .repair-card-meta { min-width:0; text-align:left; }
    .repair-card-statuses { display:flex; flex-direction:row; align-items:center; justify-content:flex-end; gap:6px; flex:0 0 auto; white-space:nowrap; }
    .repair-card-statuses .payment-badge { margin:0; flex:0 0 auto; }
    .repair-view-switch { display:flex; gap:8px; margin:0 0 16px; }
    .repair-view-switch a { border:1px solid #d8dee8; border-radius:9px; padding:8px 13px; text-decoration:none; color:#27313f; font-weight:700; background:#fff; }
    .repair-view-switch a.active { color:#fff; background:#218bdb; border-color:#218bdb; }
    .repair-trash-trigger { margin-left:auto; border:1px solid #efc4c4; border-radius:9px; padding:8px 13px; color:#9f2525; background:#fff7f7; font-weight:700; }
    .repair-trash-trigger:hover { background:#fdeaea; }
    .repair-trash-item { border:1px solid #e5e9ef; border-radius:12px; padding:14px; margin-bottom:10px; background:#fff; }
    .repair-trash-item-title { font-weight:800; color:#202937; }
    .repair-trash-item-meta { color:#6d7785; font-size:12px; margin-top:3px; }
    .repair-trash-empty { text-align:center; color:#7c8796; padding:54px 16px; }
    .repair-search-wrap { position:relative; }
    .repair-search-suggestions { display:none; position:absolute; top:100%; left:0; right:0; z-index:30; background:#fff; border:1px solid #d8dee8; border-radius:9px; box-shadow:0 8px 24px #0002; max-height:280px; overflow:auto; }
    .repair-search-suggestions a { display:block; padding:9px 11px; color:#263238; text-decoration:none; border-bottom:1px solid #edf0f3; }
    .repair-search-suggestions a:hover { background:#eef6ff; }
    .repair-search-suggestions small { display:block; color:#697584; }
    .repair-status-inprogress { background:#e8f1ff; color:#1769aa; }
    .repair-status-pending { background:#fff7d6; color:#8a6500; }
    .repair-status-waitingforparts { background:#fff0e1; color:#b34f00; }
    .repair-status-diagnose { background:#e8f7f5; color:#087f72; }
    .repair-status-completed { background:#e5f7e9; color:#237a3b; }
    .repair-status-cancelled, .repair-status-unrepairable, .repair-status-abandoned { background:#fde9e9; color:#a72d2d; }

    .payment-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
        margin-left: 5px;
    }

    .payment-unpaid { background: #f8d7da; color: #721c24; }
    .payment-partial { background: #fff3cd; color: #856404; }
    .payment-paid { background: #d4edda; color: #155724; }

    .repair-device-focus { margin:14px 0 4px; padding:14px; border-radius:12px; background:#f7f9fc; border:1px solid #e6ebf2; }
    .repair-device-name { display:flex; align-items:center; gap:8px; font-size:19px; line-height:1.25; font-weight:800; color:#182230; }
    .repair-issue-title { margin-top:7px; font-size:17px; line-height:1.3; font-weight:800; color:#1769aa; overflow-wrap:anywhere; }

    .repair-customer {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--bg-light);
    }

    .repair-customer i {
        color: var(--text-light);
    }

    .customer-name {
        font-weight: 600;
        font-size: 15px;
    }

    .repair-device {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
        font-size: 14px;
        color: var(--text-light);
    }

    .repair-device i {
        font-size: 18px;
    }

    .repair-cost {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid var(--bg-light);
    }

    .cost-label {
        font-size: 13px;
        color: var(--text-light);
    }

    .cost-value {
        font-weight: 700;
        font-size: 18px;
        color: var(--primary);
    }

    .repair-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 15px;
    }

    .repair-primary-actions,
    .repair-utility-actions {
        display: grid;
        gap: 8px;
        width: 100%;
    }

    .repair-primary-actions {
        grid-template-columns: repeat(auto-fit, minmax(125px, 1fr));
    }

    .repair-utility-actions {
        grid-template-columns: repeat(auto-fit, minmax(38px, 1fr));
    }

    .action-btn {
        width: 100%;
        min-width: 0;
        padding: 8px 12px;
        border-radius: var(--radius);
        font-size: 13px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        transition: 0.3s;
    }

    .action-btn-edit {
        background: var(--primary);
        color: white;
    }

    .action-btn-edit:hover {
        background: var(--primary-dark);
    }

    .action-btn-delete {
        background: var(--danger);
        color: white;
    }

    .action-btn-delete:hover {
        background: #d32f2f;
    }

    .action-btn-view {
        background: var(--bg-light);
        color: var(--text-dark);
    }

    .action-btn-view:hover {
        background: #e9ecef;
    }

    .action-btn-cart {
        background: #28a745;
        color: white;
    }

    .action-btn-checkout {
        white-space: nowrap;
    }

    .action-btn-payment {
        background: #0d6efd;
        color: white;
        white-space: nowrap;
    }

    .action-btn-payment:hover {
        background: #0b5ed7;
        color: white;
    }

    .action-btn-history {
        background: linear-gradient(135deg, #6f42c1, #5a32a3);
        color: white;
    }
    .action-btn-history:hover {
        background: linear-gradient(135deg, #5a32a3, #4a2890);
        transform: translateY(-1px);
    }
    .action-btn-cart:hover {
        background: #218838;
    }

    .no-repairs {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    .no-repairs i {
        font-size: 64px;
        color: var(--text-light);
        opacity: 0.5;
        margin-bottom: 20px;
    }

    .no-repairs h4 {
        color: var(--text-dark);
        margin-bottom: 10px;
    }

    .no-repairs p {
        color: var(--text-light);
    }

    .repair-date {
        font-size: 12px;
        color: var(--text-light);
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 10px;
    }

    @@media (max-width: 768px) {
        .repairs-grid {
            grid-template-columns: 1fr;
            min-width: 0;
        }
        
        .repairs-header {
            flex-direction: column;
            align-items: stretch;
        }

        .repair-card-header {
            flex-wrap: wrap;
            gap: 10px;
        }

        .repair-card-statuses {
            max-width: 100%;
            flex-wrap: wrap;
            white-space: normal;
        }
    }

    @@media (max-width: 480px) {
        .repair-card {
            padding: 16px;
        }

        .repair-number {
            overflow-wrap: anywhere;
        }

        .repair-primary-actions {
            grid-template-columns: 1fr;
        }

        .repair-utility-actions {
            grid-template-columns: repeat(5, minmax(34px, 1fr));
        }

        .action-btn {
            padding: 8px 6px;
        }
    }
</style>

<!-- Header -->
<div class="repairs-header">
    <div>
        <h1 class="repairs-title">
            <i class="material-icons">build_circle</i>
            Repair Management
        </h1>
        <p style="margin: 5px 0 0 44px; color: var(--text-light); font-size: 14px;">
            Manage and track all repair orders
        </p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-modern btn-primary-modern">
            <i class="material-icons" style="font-size: 20px;">add</i>
            New Repair Order
        </a>
    </div>
</div>

<div class="repair-view-switch" aria-label="Repair views">
    <a class="@(ViewBag.RepairView == "previous" ? "" : "active")" href="@Url.Action("Index", "Repairs", new { view = "active" })">Active Repairs</a>
    <a class="@(ViewBag.RepairView == "previous" ? "active" : "")" href="@Url.Action("Index", "Repairs", new { view = "previous" })">Previous Jobs</a>
    @if (ViewBag.CanManageTrash == true)
    {
        <button type="button" class="repair-trash-trigger" data-bs-toggle="offcanvas" data-bs-target="#repairTrashPanel" onclick="loadRepairTrash()">
            <i class="material-icons" style="font-size:17px;vertical-align:middle;">delete_outline</i> Repair Trash
        </button>
    }
</div>

@if (ViewBag.CanManageTrash == true)
{
    <div class="offcanvas offcanvas-end" tabindex="-1" id="repairTrashPanel" aria-labelledby="repairTrashTitle" style="width:min(440px,94vw);">
        <div class="offcanvas-header border-bottom">
            <div>
                <h5 class="offcanvas-title fw-bold" id="repairTrashTitle"><i class="material-icons" style="vertical-align:middle;color:#b3261e;">delete_outline</i> Repair Trash</h5>
                <small class="text-muted">Restore a repair or permanently empty the trash.</small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <div id="repairTrashList" class="flex-grow-1"><div class="repair-trash-empty">Loading deleted repairs…</div></div>
            <button type="button" id="emptyRepairTrashButton" class="btn btn-outline-danger w-100 mt-3" onclick="emptyRepairTrash()" disabled>
                <i class="material-icons" style="font-size:17px;vertical-align:middle;">delete_forever</i> Permanently Delete All
            </button>
        </div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">check_circle</i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">error</i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters -->
<div class="filters-card">
    <div class="filters-header">
        <i class="material-icons">filter_alt</i>
        <h6>Search & Filters</h6>
    </div>
    
    <form method="get" asp-action="Index">
        <input type="hidden" name="view" value="@ViewBag.RepairView" />
        <div class="row g-3">
            <div class="col-md-3">
                <label for="searchTerm" class="form-label">
                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">search</i>
                    Search
                </label>
                <div class="repair-search-wrap">
                    <input type="text" class="form-control" id="searchTerm" name="searchTerm" autocomplete="off"
                           value="@Model.SearchTerm" placeholder="Search name, phone, repair #, device...">
                    <div class="repair-search-suggestions" id="repairSearchSuggestions" role="listbox"></div>
                </div>
            </div>

            <div class="col-md-2">
                <label for="status" class="form-label">
                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">track_changes</i>
                    Status
                </label>
                <select class="form-select" id="status" name="status" asp-items="ViewBag.RepairStatuses">
                    <option value="">All Status</option>
                </select>
            </div>

            <div class="col-md-2">
                <label for="paymentStatus" class="form-label">
                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">payments</i>
                    Payment
                </label>
                <select class="form-select" id="paymentStatus" name="paymentStatus" asp-items="ViewBag.PaymentStatuses">
                    <option value="">All Payments</option>
                </select>
            </div>

            <div class="col-md-2">
                <label for="startDate" class="form-label">
                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">event</i>
                    Start Date
                </label>
                <input type="date" class="form-control" id="startDate" name="startDate"
                       value="@Model.StartDate?.ToString("yyyy-MM-dd")">
            </div>

            <div class="col-md-2">
                <label for="endDate" class="form-label">
                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">event</i>
                    End Date
                </label>
                <input type="date" class="form-control" id="endDate" name="endDate"
                       value="@Model.EndDate?.ToString("yyyy-MM-dd")">
            </div>

            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-modern btn-primary-modern w-100">
                    <i class="material-icons" style="font-size: 18px;color:white">search</i>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Repairs Grid -->
@if (Model.Repairs != null && Model.Repairs.Any())
{
    <div style="margin-bottom: 15px; color: var(--text-light);">
        Showing <strong>@Model.Repairs.Count()</strong> of <strong>@Model.TotalCount</strong> repair(s)
        &nbsp;(Page @Model.PageNumber of @(Model.TotalPages > 0 ? Model.TotalPages : 1))
    </div>

    <div class="repairs-grid">
        @foreach (var repair in Model.Repairs)
        {
            var deviceDisplay = string.Join(" ", new[] { repair.DeviceBrand, repair.DeviceModel }.Where(value => !string.IsNullOrWhiteSpace(value))).Trim();
            var issueDisplay = repair.RepairPartNames != null && repair.RepairPartNames.Any()
                ? string.Join(", ", repair.RepairPartNames)
                : (!string.IsNullOrWhiteSpace(repair.IssueDescription) ? repair.IssueDescription : repair.Description);
            if (string.IsNullOrWhiteSpace(deviceDisplay) && !string.IsNullOrWhiteSpace(issueDisplay) && issueDisplay.Contains(" — "))
            {
                var customSegments = issueDisplay.Split(" — ", 2, StringSplitOptions.TrimEntries);
                deviceDisplay = customSegments[0];
                issueDisplay = customSegments.Length > 1 ? customSegments[1] : issueDisplay;
            }
            if (string.IsNullOrWhiteSpace(deviceDisplay)) deviceDisplay = "Custom Device";
            if (string.IsNullOrWhiteSpace(issueDisplay)) issueDisplay = "Repair service";
            <div class="repair-card" id="repair-card-@repair.Id">
                <div class="repair-card-header">
                    <div class="repair-card-meta">
                        <div class="repair-customer-heading">@repair.CustomerName</div>
                        @if (!string.IsNullOrWhiteSpace(repair.CustomerPhone))
                        {
                            <div class="repair-customer-phone">@repair.CustomerPhone</div>
                        }
                        <div class="repair-date">
                            <i class="material-icons" style="font-size: 14px;">schedule</i>
                            @repair.CreatedDate.ToString("MMM dd, yyyy hh:mm tt")
                        </div>
                    </div>
                    <div class="repair-card-statuses">
                        <select class="repair-status-select no-select2" data-repair-id="@repair.Id" data-current-status="@repair.Status" onchange="updateRepairStatus(this)">
                            <option value="@repair.Status">@repair.Status</option>
                        </select>
                        <select class="repair-payment-select no-select2 payment-@repair.PaymentStatus.ToLower().Replace(" ", "-")" data-repair-id="@repair.Id" data-customer-name="@repair.CustomerName" data-balance="@repair.RemainingDues.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" data-current-payment-status="@repair.PaymentStatus" onchange="updateRepairPaymentStatus(this)" aria-label="Payment status for @repair.CustomerName">
                            <option value="Unpaid" selected="@(string.Equals(repair.PaymentStatus, "Unpaid", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Unpaid</option>
                            <option value="Partial" selected="@(string.Equals(repair.PaymentStatus, "Partial", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Partial</option>
                            <option value="Paid" selected="@(string.Equals(repair.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Paid</option>
                        </select>
                    </div>
                </div>

                <div class="repair-device-focus">
                    <div class="repair-device-name"><i class="material-icons">smartphone</i><span>@deviceDisplay</span></div>
                    <div class="repair-issue-title">@issueDisplay</div>
                </div>

                <div class="repair-cost">
                    <div>
                        <div class="cost-label">Cost</div>
                        <div class="cost-value">$@repair.Cost.ToString("N2")</div>
                    </div>
                    @if (repair.RemainingDues > 0)
                    {
                        <div style="text-align: right;">
                            <div class="cost-label">Balance Due</div>
                            <div style="font-weight: 700; font-size: 16px; color: var(--danger);">
                                $@repair.RemainingDues.ToString("N2")
                            </div>
                        </div>
                    }
                </div>

                <div class="repair-actions">
                    <div class="repair-primary-actions">
                        <button type="button" class="action-btn action-btn-cart action-btn-checkout" title="Checkout this repair"
                            onclick="addRepairToCart(@repair.Id, @repair.CustomerId, '@Html.Raw(repair.RepairNumber)', '@Html.Raw((repair.CustomerName ?? string.Empty).Replace("'", "\'"))', '@Html.Raw((repair.CustomerPhone ?? string.Empty).Replace("'", "\'"))', @repair.Cost.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @repair.PartCost.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @repair.RemainingDues.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))">
                            <i class="material-icons" style="font-size: 16px;">add_shopping_cart</i>
                            <span>Checkout</span>
                        </button>
                        @if (repair.RemainingDues > 0)
                        {
                            <button type="button" class="action-btn action-btn-payment" title="Accept a payment on this repair"
                                onclick="openRepairPaymentModal(@repair.Id, '@Html.Raw((repair.CustomerName ?? string.Empty).Replace("'", "\'"))', @repair.RemainingDues.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), 'partial', null)">
                                <i class="material-icons" style="font-size: 16px;">payments</i>
                                <span>Accept Payment</span>
                            </button>
                        }
                    </div>
                    <div class="repair-utility-actions">
                        @if (!string.Equals(repair.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                        {
                            <button type="button" class="action-btn action-btn-cart" title="Finish Job" aria-label="Finish Job" onclick="finishRepairJob(@repair.Id)">
                                <i class="material-icons" style="font-size:16px;">check_circle</i>
                            </button>
                        }
                        <a asp-action="Details" asp-route-id="@repair.Id" class="action-btn action-btn-view">
                            <i class="material-icons" style="font-size: 16px;">visibility</i>
                        </a>
                        <button type="button" class="action-btn action-btn-view" title="Print drop-off slip" aria-label="Print drop-off slip" onclick="printRepairDropOffSlip(@repair.Id, this)">
                            <i class="material-icons" style="font-size: 16px;">receipt_long</i>
                        </button>
                        <button type="button" class="action-btn action-btn-history"
                            onclick="openHistoryModal(@repair.Id, '@Html.Raw(repair.RepairNumber)')">
                            <i class="material-icons" style="font-size: 16px;">history</i>
                        </button>
                        <button type="button" class="action-btn action-btn-delete" onclick="confirmDelete(@repair.Id)">
                            <i class="material-icons" style="font-size: 16px;">delete</i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Pagination *@
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Repairs pagination" style="margin-top:20px;">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { view = ViewBag.RepairView, searchTerm = Model.SearchTerm, status = Model.Status, paymentStatus = Model.PaymentStatus, startDate = Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "", endDate = Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "", pageNumber = Model.PageNumber - 1, pageSize = Model.PageSize })">&laquo; Prev</a>
                </li>
                @for (int pg = Math.Max(1, Model.PageNumber - 2); pg <= Math.Min(Model.TotalPages, Model.PageNumber + 2); pg++)
                {
                    <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { view = ViewBag.RepairView, searchTerm = Model.SearchTerm, status = Model.Status, paymentStatus = Model.PaymentStatus, startDate = Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "", endDate = Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "", pageNumber = pg, pageSize = Model.PageSize })">@pg</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { view = ViewBag.RepairView, searchTerm = Model.SearchTerm, status = Model.Status, paymentStatus = Model.PaymentStatus, startDate = Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "", endDate = Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "", pageNumber = Model.PageNumber + 1, pageSize = Model.PageSize })">Next &raquo;</a>
                </li>
            </ul>
            <p class="text-center text-muted" style="font-size:13px;">Page @Model.PageNumber of @Model.TotalPages &nbsp;|&nbsp; @Model.TotalCount total repair(s)</p>
        </nav>
    }
}
else
{
    <div class="no-repairs">
        <i class="material-icons">build_circle</i>
        <h4>No Repairs Found</h4>
        <p>Start by creating a new repair order</p>
        <a asp-action="Create" class="btn btn-modern btn-primary-modern" style="margin-top: 20px;">
            <i class="material-icons" style="font-size: 20px;">add</i>
            Create First Repair
        </a>
    </div>
}


<!-- Repair History Modal -->
