<!-- Accept Payment Modal -->
<div class="modal fade" id="repairPaymentModal" tabindex="-1" aria-labelledby="repairPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="repairPaymentModalLabel"><i class="material-icons" style="vertical-align:middle;">payments</i> Accept Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="repairPaymentRepairId" />
                <input type="hidden" id="repairPaymentBalance" />
                <input type="hidden" id="repairPaymentTargetStatus" />
                <div class="alert alert-light border d-flex justify-content-between mb-3">
                    <strong id="repairPaymentCustomerName"></strong>
                    <strong>Balance: <span id="repairPaymentBalanceText"></span></strong>
                </div>
                <div class="mb-3">
                    <label for="repairPaymentAmount" class="form-label fw-semibold">Payment amount</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" id="repairPaymentAmount" min="0.01" step="0.01" inputmode="decimal" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label for="repairPaymentMethod" class="form-label fw-semibold">Payment method</label>
                    <select class="form-select form-select-lg no-select2" id="repairPaymentMethod">
                        <option value="Cash">Cash</option>
                        <option value="Card">Card</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div>
                    <label for="repairPaymentReference" class="form-label">Reference <span class="text-muted">(optional)</span></label>
                    <input type="text" class="form-control" id="repairPaymentReference" placeholder="Transaction or confirmation number" />
                </div>
                <div class="alert alert-danger mt-3 mb-0 d-none" id="repairPaymentError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" id="repairPaymentSubmit" onclick="submitRepairPayment()">
                    <i class="material-icons" style="font-size:18px;vertical-align:middle;">check_circle</i> Accept Payment
                </button>
            </div>
        </div>
    </div>
</div>

@* Hidden form purely to get ASP.NET Core to inject an antiforgery token on this page *@
<form id="_deleteTokenForm" method="post" asp-action="Delete" asp-route-id="0" style="display:none;">
</form>

<script>
    function repairStatusLabel(value) {
        var labels = { inprogress:'In Progress', waitingforparts:'Waiting for Parts', diagnose:'Diagnose', pending:'Pending', completed:'Completed', cancelled:'Cancelled', unrepairable:'Unrepairable', abandoned:'Abandoned' };
        return labels[String(value || '').toLowerCase().replace(/[\s-]/g, '')] || value;
    }

    function colorRepairStatus(select) {
        Array.from(select.classList).filter(function(c) { return c.indexOf('repair-status-') === 0 && c !== 'repair-status-select'; }).forEach(function(c) { select.classList.remove(c); });
        select.classList.add('repair-status-' + String(select.value || '').toLowerCase().replace(/[\s-]/g, ''));
    }

    function colorRepairPaymentStatus(select) {
        ['payment-unpaid', 'payment-partial', 'payment-paid'].forEach(function(cssClass) { select.classList.remove(cssClass); });
        select.classList.add('payment-' + String(select.value || 'unpaid').toLowerCase());
    }

    document.querySelectorAll('.repair-payment-select').forEach(colorRepairPaymentStatus);

    (function loadInlineRepairStatuses() {
        fetch('@Url.Action("GetRepairStatuses", "Repairs")')
            .then(function(r) { return r.json(); })
            .then(function(statuses) {
                var values = Array.isArray(statuses) ? statuses : (statuses.data || []);
                document.querySelectorAll('.repair-status-select').forEach(function(select) {
                    var current = select.dataset.currentStatus || '';
                    select.innerHTML = '';
                    values.forEach(function(item) {
                        var value = item.value || item.name || item.text || item;
                        var option = new Option(repairStatusLabel(item.text || item.name || value), value, false, String(value).toLowerCase().replace(/\s|-/g,'') === current.toLowerCase().replace(/\s|-/g,''));
                        select.add(option);
                    });
                    if (!select.value) select.add(new Option(repairStatusLabel(current), current, true, true), 0);
                    colorRepairStatus(select);
                });
            });
    })();

    window.updateRepairStatus = function(select) {
        var oldStatus = select.dataset.currentStatus;
        if (String(select.value).toLowerCase() === 'completed' && !confirm('Are you sure you want to finish this job? It will move to Previous Jobs.')) {
            select.value = oldStatus;
            colorRepairStatus(select);
            return;
        }
        select.disabled = true;
        fetch('@Url.Action("UpdateStatusJson", "Repairs")', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ repairId: parseInt(select.dataset.repairId), status: select.value })
        }).then(function(r) { return r.json(); }).then(function(result) {
            select.disabled = false;
            if (!result.success) { select.value = oldStatus; colorRepairStatus(select); alert(result.message || 'Could not update status'); return; }
            select.dataset.currentStatus = result.status;
            var option = Array.from(select.options).find(function(o){ return o.value === result.status; });
            if (!option) select.add(new Option(repairStatusLabel(result.status), result.status, true, true), 0); else select.value = result.status;
            colorRepairStatus(select);
            if (String(result.status).toLowerCase() === 'completed') window.location.reload();
        }).catch(function() { select.disabled = false; select.value = oldStatus; colorRepairStatus(select); alert('Could not update status'); });
    };

    window.updateRepairPaymentStatus = function(select) {
        var oldStatus = select.dataset.currentPaymentStatus || 'Unpaid';
        var requested = select.value;
        if (requested === oldStatus) return;
        if (requested === 'Unpaid') {
            select.value = oldStatus;
            colorRepairPaymentStatus(select);
            alert('Recorded payments cannot be erased by changing this label. Use Payment History to correct or refund a payment.');
            return;
        }
        var balance = Number(select.dataset.balance || 0);
        if (balance <= 0) {
            select.value = 'Paid';
            select.dataset.currentPaymentStatus = 'Paid';
            colorRepairPaymentStatus(select);
            return;
        }
        select.value = oldStatus;
        colorRepairPaymentStatus(select);
        openRepairPaymentModal(
            Number(select.dataset.repairId),
            select.dataset.customerName || 'Customer',
            balance,
            requested.toLowerCase(),
            select
        );
    };

    function restorePendingPaymentSelect() {
        var select = window.pendingRepairPaymentSelect;
        if (select) {
            select.disabled = false;
            select.value = select.dataset.currentPaymentStatus || 'Unpaid';
            colorRepairPaymentStatus(select);
        }
        window.pendingRepairPaymentSelect = null;
    }

    document.getElementById('repairPaymentModal').addEventListener('hidden.bs.modal', function() {
        if (!window.repairPaymentSubmitted) restorePendingPaymentSelect();
        window.repairPaymentSubmitted = false;
    });

    window.finishRepairJob = function(repairId) {
        if (!confirm('Are you sure you want to finish this job? It will move to Previous Jobs.')) return;
        fetch('@Url.Action("UpdateStatusJson", "Repairs")', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body:JSON.stringify({repairId:repairId,status:'Completed'})
        }).then(function(r){return r.json();}).then(function(result){
            if (!result.success) throw new Error(result.message || 'Could not finish job');
            window.location.reload();
        }).catch(function(error){alert(error.message || 'Could not finish job');});
    };

    // Match customers and repairs without changing the saved records.
    (function() {
        var searchInput = document.getElementById('searchTerm');
        var list = document.getElementById('repairSearchSuggestions');
        if (!searchInput || !list) return;
        var debounceTimer, requestNumber = 0;
        function addResult(label, detail, href) {
            var link = document.createElement('a');
            link.href = href;
            link.setAttribute('role','option');
            var name = document.createElement('strong'); name.textContent = label;
            var sub = document.createElement('small'); sub.textContent = detail;
            link.append(name,sub); list.appendChild(link);
        }
        searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            var term = searchInput.value.trim();
            if (term.length < 2) { list.style.display='none'; list.replaceChildren(); return; }
            var currentRequest = ++requestNumber;
            debounceTimer = setTimeout(function() {
                Promise.all([
                    fetch('@Url.Action("GetRepairsJson", "Repairs")?searchTerm=' + encodeURIComponent(term)).then(function(r){return r.json();}),
                    fetch('@Url.Action("GetCustomers", "Repairs")?searchTerm=' + encodeURIComponent(term)).then(function(r){return r.json();})
                ]).then(function(results) {
                    if (currentRequest !== requestNumber) return;
                    list.replaceChildren();
                    (results[0].data || []).slice(0,6).forEach(function(job) {
                        addResult('Repair #' + job.repairNumber + ' — ' + job.customerName,
                            [job.customerPhone, job.deviceBrand, job.deviceModel, job.status].filter(Boolean).join(' · '),
                            '/Repairs/Details/' + job.id);
                    });
                    (results[1].data || []).slice(0,4).forEach(function(customer) {
                        addResult([customer.firstName,customer.lastName].filter(Boolean).join(' '),
                            [customer.phone,customer.email].filter(Boolean).join(' · '), '/Customers/Edit/' + customer.id);
                    });
                    list.style.display = list.children.length ? 'block' : 'none';
                }).catch(function(){ list.style.display='none'; });
            }, 250);
        });
        document.addEventListener('click',function(event){if (!event.target.closest('.repair-search-wrap')) list.style.display='none';});
    })();

    window.addRepairToCart = function(id, customerId, repairNumber, customerName, customerPhone, cost, partCost, remainingDues) {
        var repairItem = {
            type: 'repair',
            repairId: id,
            customerId: customerId,
            repairNumber: repairNumber,
            customerName: customerName,
            customerPhone: customerPhone,
            cost: parseFloat(cost),
            partCost: parseFloat(partCost) || 0,
            remainingDues: parseFloat(remainingDues),
            description: customerName + ' repair',
            quantity: 1,
            unitPrice: Math.max(0, parseFloat(remainingDues) || 0)
        };
        var pending = [];
        try { pending = JSON.parse(sessionStorage.getItem('pendingRepairCart') || '[]'); } catch(e) { pending = []; }
        pending = pending.filter(function(r) { return r.repairId !== id; });
        pending.push(repairItem);
        sessionStorage.setItem('pendingRepairCart', JSON.stringify(pending));
        window.location.href = '/POS';
    };

    window.printRepairDropOffSlip = function(repairId, button) {
        var original = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>';
        fetch('@Url.Action("PrintDropOffSlip", "Repairs")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ repairId: repairId })
        }).then(function(response) { return response.json(); })
          .then(function(result) {
              if (!result.success) throw new Error(result.message || 'Drop-off slip could not be printed.');
              button.innerHTML = '<i class="material-icons" style="font-size:16px;">check</i>';
              setTimeout(function() { button.innerHTML = original; button.disabled = false; }, 1200);
          })
          .catch(function(error) {
              button.innerHTML = original;
              button.disabled = false;
              alert(error.message || 'Drop-off slip could not be printed.');
          });
    };

    window.openRepairPaymentModal = function(repairId, customerName, balance, targetStatus, sourceSelect) {
        var amount = Number(balance || 0);
        window.pendingRepairPaymentSelect = sourceSelect || null;
        window.repairPaymentSubmitted = false;
        if (sourceSelect) sourceSelect.disabled = true;
        document.getElementById('repairPaymentRepairId').value = repairId;
        document.getElementById('repairPaymentBalance').value = amount.toFixed(2);
        document.getElementById('repairPaymentTargetStatus').value = targetStatus || 'partial';
        document.getElementById('repairPaymentCustomerName').textContent = customerName || 'Customer';
        document.getElementById('repairPaymentBalanceText').textContent = '$' + amount.toFixed(2);
        document.getElementById('repairPaymentAmount').value = targetStatus === 'paid' ? amount.toFixed(2) : '';
        document.getElementById('repairPaymentAmount').max = amount.toFixed(2);
        document.getElementById('repairPaymentMethod').value = 'Cash';
        document.getElementById('repairPaymentReference').value = '';
        document.getElementById('repairPaymentError').classList.add('d-none');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('repairPaymentModal')).show();
        setTimeout(function() { document.getElementById('repairPaymentAmount').select(); }, 250);
    };

    window.submitRepairPayment = function() {
        var repairId = Number(document.getElementById('repairPaymentRepairId').value);
        var balance = Number(document.getElementById('repairPaymentBalance').value);
        var amount = Number(document.getElementById('repairPaymentAmount').value);
        var error = document.getElementById('repairPaymentError');
        var submit = document.getElementById('repairPaymentSubmit');
        error.classList.add('d-none');

        if (!amount || amount <= 0 || amount > balance) {
            error.textContent = 'Enter an amount between $0.01 and $' + balance.toFixed(2) + '.';
            error.classList.remove('d-none');
            return;
        }

        submit.disabled = true;
        fetch('@Url.Action("AddRepairPayment", "Repairs")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                repairId: repairId,
                type: 'Payment',
                amount: amount,
                paymentMethod: document.getElementById('repairPaymentMethod').value,
                reference: document.getElementById('repairPaymentReference').value || null,
                notes: 'Payment accepted from Repairs page'
            })
        }).then(function(response) { return response.json(); })
          .then(function(result) {
              if (!result.success) throw new Error(result.message || 'Payment could not be saved.');
              window.repairPaymentSubmitted = true;
              window.location.reload();
          })
          .catch(function(ex) {
              error.textContent = ex.message || 'Payment could not be saved.';
              error.classList.remove('d-none');
              submit.disabled = false;
          });
    };

    // ── Repair History Modal ─────────────────────────────────────────────────
    function openHistoryModal(repairId, repairNumber) {
        document.getElementById('historyModalTitle').textContent = 'Activity History — Repair #' + repairNumber;
        var body = document.getElementById('historyModalBody');
        body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Loading history...</p></div>';
        var modal = new bootstrap.Modal(document.getElementById('repairHistoryModal'));
        modal.show();

        fetch('/Repairs/GetRepairActivities?repairId=' + repairId)
            .then(function(r) { return r.json(); })
            .then(function(resp) {
                if (!resp.success || !resp.data || resp.data.length === 0) {
                    body.innerHTML = '<p class="text-muted text-center py-3"><i class="material-icons" style="vertical-align:middle;">info</i> No activity recorded yet.</p>';
                    return;
                }
                var actionBadge = {
                    'Created': 'bg-success',
                    'Updated': 'bg-primary',
                    'PartsUpdated': 'bg-warning text-dark',
                    'StatusChanged': 'bg-info text-dark',
                    'Deleted': 'bg-danger'
                };
                var html = '<div class="timeline-container" style="position:relative;padding-left:24px;">';
                resp.data.forEach(function(a) {
                    var badge = actionBadge[a.action] || 'bg-secondary';
                    html += '<div class="timeline-item mb-3" style="position:relative;">';
                    html += '<div style="position:absolute;left:-20px;top:4px;width:12px;height:12px;border-radius:50%;background:#6f42c1;border:2px solid #fff;box-shadow:0 0 0 2px #6f42c1;"></div>';
                    html += '<div class="card border-0 shadow-sm">';
                    html += '<div class="card-body py-2 px-3">';
                    html += '<div class="d-flex justify-content-between align-items-start">';
                    html += '<span class="badge ' + badge + ' me-2">' + a.action + '</span>';
                    html += '<small class="text-muted">' + (a.performedAtFormatted || a.performedAt) + '</small>';
                    html += '</div>';
                    if (a.description) html += '<p class="mb-0 mt-1" style="font-size:0.9rem;">' + a.description + '</p>';
                    if (a.newValues) html += '<small class="text-muted"><strong>Changes:</strong> ' + a.newValues + '</small>';
                    html += '<div class="mt-1"><small class="text-muted"><i class="material-icons" style="font-size:13px;vertical-align:middle;">person</i> ' + (a.performedByUserName || 'System') + '</small></div>';
                    html += '</div></div></div>';
                });
                html += '</div>';
                body.innerHTML = html;
            })
            .catch(function(err) {
                body.innerHTML = '<p class="text-danger text-center py-3">Failed to load history. Please try again.</p>';
            });
    }

    function confirmDelete(id) {
        if (!confirm('Move this repair to Repair Trash? Any parts used on this job will be returned to inventory.')) return;

        var card = document.getElementById('repair-card-' + id);
        var button = card ? card.querySelector('.action-btn-delete') : null;
        if (button) {
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>';
        }

        fetch('@Url.Action("DeleteRepairJson", "Repairs")?id=' + encodeURIComponent(id), { method:'POST' })
            .then(function(response) {
                if (!response.ok) throw new Error('Delete request failed (' + response.status + ')');
                return response.json();
            })
            .then(function(result) {
                if (!result.success) throw new Error(result.message || 'Repair could not be deleted');
                if (card) card.remove();
                var remaining = document.querySelectorAll('.repairs-grid .repair-card').length;
                if (remaining === 0) window.location.reload();
            })
            .catch(function(error) {
                if (button) {
                    button.disabled = false;
                    button.innerHTML = '<i class="material-icons" style="font-size:16px;">delete</i>';
                }
                alert(error.message || 'Repair could not be deleted');
            });
    }

    function escapeRepairTrashHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function(character) {
            return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'})[character];
        });
    }

    window.loadRepairTrash = function() {
        var list = document.getElementById('repairTrashList');
        var emptyButton = document.getElementById('emptyRepairTrashButton');
        if (!list || !emptyButton) return;
        list.innerHTML = '<div class="repair-trash-empty"><div class="spinner-border spinner-border-sm text-secondary"></div><div class="mt-2">Loading deleted repairs…</div></div>';
        fetch('@Url.Action("GetRepairTrash", "Repairs")').then(function(response){ return response.json(); }).then(function(result) {
            if (!result.success) throw new Error(result.message || 'Could not load Repair Trash');
            var repairs = result.data || [];
            emptyButton.disabled = repairs.length === 0;
            if (!repairs.length) {
                list.innerHTML = '<div class="repair-trash-empty"><i class="material-icons" style="font-size:40px;">delete_sweep</i><div class="fw-bold mt-2">Repair Trash is empty</div></div>';
                return;
            }
            list.innerHTML = repairs.map(function(repair) {
                return '<div class="repair-trash-item"><div class="d-flex justify-content-between gap-3">'
                    + '<div><div class="repair-trash-item-title">#' + escapeRepairTrashHtml(repair.repairNumber) + ' · ' + escapeRepairTrashHtml(repair.customerName) + '</div>'
                    + '<div class="repair-trash-item-meta">' + escapeRepairTrashHtml(repair.device || 'No device') + '</div>'
                    + '<div class="repair-trash-item-meta">Deleted ' + escapeRepairTrashHtml(repair.deletedDate) + '</div></div>'
                    + '<button type="button" class="btn btn-sm btn-primary align-self-center" onclick="restoreRepairFromTrash(' + Number(repair.id) + ')"><i class="material-icons" style="font-size:15px;vertical-align:middle;">restore</i> Restore</button>'
                    + '</div></div>';
            }).join('');
        }).catch(function(error) {
            emptyButton.disabled = true;
            list.innerHTML = '<div class="alert alert-danger">' + escapeRepairTrashHtml(error.message) + '</div>';
        });
    };

    window.restoreRepairFromTrash = function(id) {
        if (!confirm('Restore this repair? Its returned inventory parts will be applied to the repair again.')) return;
        fetch('@Url.Action("RestoreRepairJson", "Repairs")?id=' + encodeURIComponent(id), { method:'POST' })
            .then(function(response){ return response.json(); })
            .then(function(result) {
                if (!result.success) throw new Error(result.message || 'Could not restore repair');
                loadRepairTrash();
                alert(result.message);
                window.location.reload();
            }).catch(function(error){ alert(error.message || 'Could not restore repair'); });
    };

    window.emptyRepairTrash = function() {
        if (!confirm('Permanently delete every repair in Repair Trash? This cannot be undone.')) return;
        fetch('@Url.Action("EmptyRepairTrashJson", "Repairs")', { method:'POST' })
            .then(function(response){ return response.json(); })
            .then(function(result) {
                if (!result.success) throw new Error(result.message || 'Could not empty Repair Trash');
                loadRepairTrash();
            }).catch(function(error){ alert(error.message || 'Could not empty Repair Trash'); });
    };
</script>
