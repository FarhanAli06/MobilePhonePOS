@model Empire.Web.Models.RepairIndexViewModel
@{
    ViewData["Title"] = "Repairs";
}

<!-- Material Icons -->
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --primary: #2196f3;
        --primary-dark: #1976d2;
        --secondary: #4caf50;
        --danger: #f44336;
        --warning: #ff9800;
        --purple: #9c27b0;
        --bg-light: #f8f9fa;
        --text-dark: #1a1a1a;
        --text-light: #666666;
        --border: #e0e0e0;
        --shadow: 0 4px 12px rgba(0,0,0,0.1);
        --radius: 8px;
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--bg-light);
    }

    .repairs-header {
        background: white;
        padding: 25px 30px;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .repairs-title {
        font-size: 28px;
        font-weight: 700;
        color: var(--text-dark);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .repairs-title i {
        color: var(--primary);
        font-size: 32px;
    }

    .filters-card {
        background: white;
        border-radius: var(--radius);
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: var(--shadow);
    }

    .filters-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid var(--bg-light);
    }

    .filters-header i {
        color: var(--primary);
    }

    .filters-header h6 {
        margin: 0;
        font-weight: 600;
        font-size: 18px;
    }

    .form-label {
        font-weight: 500;
        font-size: 14px;
        color: var(--text-dark);
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 10px 12px;
        font-size: 14px;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.1);
    }

    .btn-modern {
        padding: 10px 20px;
        border-radius: var(--radius);
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
        border: none;
    }

    .btn-primary-modern {
        background: var(--primary);
        color: white;
    }

    .btn-primary-modern:hover {
        background: var(--primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(33, 150, 243, 0.3);
    }

    .btn-secondary-modern {
        background: var(--bg-light);
        color: var(--text-dark);
        border: 1px solid var(--border);
    }

    .btn-secondary-modern:hover {
        background: #e9ecef;
    }

    .repairs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 20px;
        margin-top: 25px;
    }

    .repair-card {
        background: white;
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border-left: 4px solid var(--primary);
        transition: 0.3s;
        position: relative;
    }

    .repair-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
    }

    .repair-card-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 15px;
    }

    .repair-number {
        font-weight: 700;
        font-size: 16px;
        color: var(--primary);
        font-family: monospace;
    }

    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .status-pending { background: #fff3cd; color: #856404; }
    .status-in-progress { background: #d1ecf1; color: #0c5460; }
    .status-completed { background: #d4edda; color: #155724; }
    .status-cancelled { background: #f8d7da; color: #721c24; }
    .status-ready { background: #e2d9f3; color: #6f42c1; }

    .payment-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
        margin-left: 5px;
    }

    .payment-unpaid { background: #f8d7da; color: #721c24; }
    .payment-partial { background: #fff3cd; color: #856404; }
    .payment-paid { background: #d4edda; color: #155724; }

    .repair-customer {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--bg-light);
    }

    .repair-customer i {
        color: var(--text-light);
    }

    .customer-name {
        font-weight: 600;
        font-size: 15px;
    }

    .repair-device {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
        font-size: 14px;
        color: var(--text-light);
    }

    .repair-device i {
        font-size: 18px;
    }

    .repair-cost {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid var(--bg-light);
    }

    .cost-label {
        font-size: 13px;
        color: var(--text-light);
    }

    .cost-value {
        font-weight: 700;
        font-size: 18px;
        color: var(--primary);
    }

    .repair-actions {
        display: flex;
        gap: 8px;
        margin-top: 15px;
    }

    .action-btn {
        flex: 1;
        padding: 8px 12px;
        border-radius: var(--radius);
        font-size: 13px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        transition: 0.3s;
    }

    .action-btn-edit {
        background: var(--primary);
        color: white;
    }

    .action-btn-edit:hover {
        background: var(--primary-dark);
    }

    .action-btn-delete {
        background: var(--danger);
        color: white;
    }

    .action-btn-delete:hover {
        background: #d32f2f;
    }

    .action-btn-view {
        background: var(--bg-light);
        color: var(--text-dark);
    }

    .action-btn-view:hover {
        background: #e9ecef;
    }

    .action-btn-cart {
        background: #28a745;
        color: white;
    }

    .action-btn-history {
        background: linear-gradient(135deg, #6f42c1, #5a32a3);
        color: white;
    }
    .action-btn-history:hover {
        background: linear-gradient(135deg, #5a32a3, #4a2890);
        transform: translateY(-1px);
    }
    .action-btn-cart:hover {
        background: #218838;
    }

    .no-repairs {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    .no-repairs i {
        font-size: 64px;
        color: var(--text-light);
        opacity: 0.5;
        margin-bottom: 20px;
    }

    .no-repairs h4 {
        color: var(--text-dark);
        margin-bottom: 10px;
    }

    .no-repairs p {
        color: var(--text-light);
    }

    .repair-date {
        font-size: 12px;
        color: var(--text-light);
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 10px;
    }

    @@media (max-width: 768px) {
        .repairs-grid {
            grid-template-columns: 1fr;
        }
        
        .repairs-header {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<!-- Header -->
<div class="repairs-header">
    <div>
        <h1 class="repairs-title">
            <i class="material-icons">build_circle</i>
            Repair Management
        </h1>
        <p style="margin: 5px 0 0 44px; color: var(--text-light); font-size: 14px;">
            Manage and track all repair orders
        </p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-modern btn-primary-modern">
            <i class="material-icons" style="font-size: 20px;">add</i>
            New Repair Order
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">check_circle</i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="material-icons" style="vertical-align: middle; margin-right: 8px;">error</i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters -->
<div class="filters-card">
    <div class="filters-header">
        <i class="material-icons">filter_alt</i>
        <h6>Search & Filters</h6>
    </div>
    
    <form method="get" asp-action="Index">
        <div class="row g-3">
            <div class="col-md-3">
                <label for="searchTerm" class="form-label">
                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">search</i>
                    Search
                </label>
                <input type="text" class="form-control" id="searchTerm" name="searchTerm"
                       value="@Model.SearchTerm" placeholder="Search by repair #, customer, device...">
            </div>

            <div class="col-md-2">
                <label for="status" class="form-label">
                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">track_changes</i>
                    Status
                </label>
                <select class="form-select" id="status" name="status" asp-items="ViewBag.RepairStatuses">
                    <option value="">All Status</option>
                </select>
            </div>

            <div class="col-md-2">
                <label for="paymentStatus" class="form-label">
                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">payments</i>
                    Payment
                </label>
                <select class="form-select" id="paymentStatus" name="paymentStatus" asp-items="ViewBag.PaymentStatuses">
                    <option value="">All Payments</option>
                </select>
            </div>

            <div class="col-md-2">
                <label for="startDate" class="form-label">
                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">event</i>
                    Start Date
                </label>
                <input type="date" class="form-control" id="startDate" name="startDate"
                       value="@Model.StartDate?.ToString("yyyy-MM-dd")">
            </div>

            <div class="col-md-2">
                <label for="endDate" class="form-label">
                    <i class="material-icons" style="font-size: 16px; vertical-align: middle;">event</i>
                    End Date
                </label>
                <input type="date" class="form-control" id="endDate" name="endDate"
                       value="@Model.EndDate?.ToString("yyyy-MM-dd")">
            </div>

            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-modern btn-primary-modern w-100">
                    <i class="material-icons" style="font-size: 18px;color:white">search</i>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Repairs Grid -->
@if (Model.Repairs != null && Model.Repairs.Any())
{
    <div style="margin-bottom: 15px; color: var(--text-light);">
        Showing <strong>@Model.Repairs.Count()</strong> of <strong>@Model.TotalCount</strong> repair(s)
        &nbsp;(Page @Model.PageNumber of @(Model.TotalPages > 0 ? Model.TotalPages : 1))
    </div>

    <div class="repairs-grid">
        @foreach (var repair in Model.Repairs)
        {
            <div class="repair-card">
                <div class="repair-card-header">
                    <div>
                        <div class="repair-number">#@repair.RepairNumber</div>
                        <div class="repair-date">
                            <i class="material-icons" style="font-size: 14px;">schedule</i>
                            @repair.CreatedDate.ToString("MMM dd, yyyy hh:mm tt")
                        </div>
                    </div>
                    <div>
                        <span class="status-badge status-@repair.Status.ToLower().Replace(" ", "-")">
                            @repair.Status
                        </span>
                        <span class="payment-badge payment-@repair.PaymentStatus.ToLower().Replace(" ", "-")">
                            @repair.PaymentStatus
                        </span>
                    </div>
                </div>

                <div class="repair-customer">
                    <i class="material-icons">person</i>
                    <div>
                        <div class="customer-name">@repair.CustomerName</div>
                        @if (!string.IsNullOrEmpty(repair.CustomerPhone))
                        {
                            <div style="font-size: 13px; color: var(--text-light);">@repair.CustomerPhone</div>
                        }
                    </div>
                </div>

                <div class="repair-device">
                    <i class="material-icons">smartphone</i>
                    <span>@repair.DeviceBrand @repair.DeviceModel</span>
                </div>

                @if (!string.IsNullOrEmpty(repair.IssueDescription))
                {
                    <div class="repair-device">
                        <i class="material-icons">description</i>
                        <span>@(repair.IssueDescription.Length > 50 ? repair.IssueDescription.Substring(0, 50) + "..." : repair.IssueDescription)</span>
                    </div>
                }

                <div class="repair-cost">
                    <div>
                        <div class="cost-label">Cost</div>
                        <div class="cost-value">$@repair.Cost.ToString("N2")</div>
                    </div>
                    @if (repair.RemainingDues > 0)
                    {
                        <div style="text-align: right;">
                            <div class="cost-label">Balance Due</div>
                            <div style="font-weight: 700; font-size: 16px; color: var(--danger);">
                                $@repair.RemainingDues.ToString("N2")
                            </div>
                        </div>
                    }
                </div>

                <div class="repair-actions">
                    <a asp-action="Details" asp-route-id="@repair.Id" class="action-btn action-btn-view">
                        <i class="material-icons" style="font-size: 16px;">visibility</i>
                        
                    </a>
                    <a asp-action="Edit" asp-route-id="@repair.Id" class="action-btn action-btn-edit">
                        <i class="material-icons" style="font-size: 16px;">edit</i>
                        
                    </a>
                    <button type="button" class="action-btn action-btn-cart"
                        onclick="addRepairToCart(@repair.Id, '@Html.Raw(repair.RepairNumber)', '@Html.Raw((repair.CustomerName ?? string.Empty).Replace("'", "\'"))', @repair.Cost.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @repair.RemainingDues.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))">
                        <i class="material-icons" style="font-size: 16px;">add_shopping_cart</i>
                       
                    </button>
                    <button type="button" class="action-btn action-btn-history"
                        onclick="openHistoryModal(@repair.Id, '@Html.Raw(repair.RepairNumber)')">
                        <i class="material-icons" style="font-size: 16px;">history</i>
                       
                    </button>
                    <button type="button" class="action-btn action-btn-delete" onclick="confirmDelete(@repair.Id)">
                        <i class="material-icons" style="font-size: 16px;">delete</i>
                       
                    </button>
                </div>
            </div>
        }
    </div>

    @* Pagination *@
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Repairs pagination" style="margin-top:20px;">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, status = Model.Status, paymentStatus = Model.PaymentStatus, startDate = Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "", endDate = Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "", pageNumber = Model.PageNumber - 1, pageSize = Model.PageSize })">&laquo; Prev</a>
                </li>
                @for (int pg = Math.Max(1, Model.PageNumber - 2); pg <= Math.Min(Model.TotalPages, Model.PageNumber + 2); pg++)
                {
                    <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, status = Model.Status, paymentStatus = Model.PaymentStatus, startDate = Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "", endDate = Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "", pageNumber = pg, pageSize = Model.PageSize })">@pg</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, status = Model.Status, paymentStatus = Model.PaymentStatus, startDate = Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "", endDate = Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "", pageNumber = Model.PageNumber + 1, pageSize = Model.PageSize })">Next &raquo;</a>
                </li>
            </ul>
            <p class="text-center text-muted" style="font-size:13px;">Page @Model.PageNumber of @Model.TotalPages &nbsp;|&nbsp; @Model.TotalCount total repair(s)</p>
        </nav>
    }
}
else
{
    <div class="no-repairs">
        <i class="material-icons">build_circle</i>
        <h4>No Repairs Found</h4>
        <p>Start by creating a new repair order</p>
        <a asp-action="Create" class="btn btn-modern btn-primary-modern" style="margin-top: 20px;">
            <i class="material-icons" style="font-size: 20px;">add</i>
            Create First Repair
        </a>
    </div>
}


<!-- Repair History Modal -->
<div class="modal fade" id="repairHistoryModal" tabindex="-1" aria-labelledby="historyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #6f42c1, #5a32a3); color: white;">
                <h5 class="modal-title" id="historyModalTitle">
                    <i class="material-icons" style="vertical-align:middle;font-size:20px;">history</i>
                    Activity History
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="historyModalBody" style="min-height:200px;">
                <!-- Populated by JS -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@* Hidden form purely to get ASP.NET Core to inject an antiforgery token on this page *@
<form id="_deleteTokenForm" method="post" asp-action="Delete" asp-route-id="0" style="display:none;">
</form>

<script>
    // Auto-submit search form on input (debounced 400ms)
    (function() {
        var searchInput = document.getElementById('searchTerm');
        var searchForm  = searchInput && searchInput.closest('form');
        if (!searchInput || !searchForm) return;
        var debounceTimer;
        searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function() { searchForm.submit(); }, 400);
        });
    })();

    window.addRepairToCart = function(id, repairNumber, customerName, cost, remainingDues) {
        var repairItem = {
            type: 'repair',
            repairId: id,
            repairNumber: repairNumber,
            customerName: customerName,
            cost: parseFloat(cost),
            remainingDues: parseFloat(remainingDues),
            description: 'Repair #' + repairNumber + ' - ' + customerName,
            quantity: 1,
            unitPrice: parseFloat(remainingDues) > 0 ? parseFloat(remainingDues) : parseFloat(cost)
        };
        var pending = [];
        try { pending = JSON.parse(sessionStorage.getItem('pendingRepairCart') || '[]'); } catch(e) { pending = []; }
        pending = pending.filter(function(r) { return r.repairId !== id; });
        pending.push(repairItem);
        sessionStorage.setItem('pendingRepairCart', JSON.stringify(pending));
        window.location.href = '/POS';
    };

    // ── Repair History Modal ─────────────────────────────────────────────────
    function openHistoryModal(repairId, repairNumber) {
        document.getElementById('historyModalTitle').textContent = 'Activity History — Repair #' + repairNumber;
        var body = document.getElementById('historyModalBody');
        body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Loading history...</p></div>';
        var modal = new bootstrap.Modal(document.getElementById('repairHistoryModal'));
        modal.show();

        fetch('/Repairs/GetRepairActivities?repairId=' + repairId)
            .then(function(r) { return r.json(); })
            .then(function(resp) {
                if (!resp.success || !resp.data || resp.data.length === 0) {
                    body.innerHTML = '<p class="text-muted text-center py-3"><i class="material-icons" style="vertical-align:middle;">info</i> No activity recorded yet.</p>';
                    return;
                }
                var actionBadge = {
                    'Created': 'bg-success',
                    'Updated': 'bg-primary',
                    'PartsUpdated': 'bg-warning text-dark',
                    'StatusChanged': 'bg-info text-dark',
                    'Deleted': 'bg-danger'
                };
                var html = '<div class="timeline-container" style="position:relative;padding-left:24px;">';
                resp.data.forEach(function(a) {
                    var badge = actionBadge[a.action] || 'bg-secondary';
                    html += '<div class="timeline-item mb-3" style="position:relative;">';
                    html += '<div style="position:absolute;left:-20px;top:4px;width:12px;height:12px;border-radius:50%;background:#6f42c1;border:2px solid #fff;box-shadow:0 0 0 2px #6f42c1;"></div>';
                    html += '<div class="card border-0 shadow-sm">';
                    html += '<div class="card-body py-2 px-3">';
                    html += '<div class="d-flex justify-content-between align-items-start">';
                    html += '<span class="badge ' + badge + ' me-2">' + a.action + '</span>';
                    html += '<small class="text-muted">' + (a.performedAtFormatted || a.performedAt) + '</small>';
                    html += '</div>';
                    if (a.description) html += '<p class="mb-0 mt-1" style="font-size:0.9rem;">' + a.description + '</p>';
                    if (a.newValues) html += '<small class="text-muted"><strong>Changes:</strong> ' + a.newValues + '</small>';
                    html += '<div class="mt-1"><small class="text-muted"><i class="material-icons" style="font-size:13px;vertical-align:middle;">person</i> ' + (a.performedByUserName || 'System') + '</small></div>';
                    html += '</div></div></div>';
                });
                html += '</div>';
                body.innerHTML = html;
            })
            .catch(function(err) {
                body.innerHTML = '<p class="text-danger text-center py-3">Failed to load history. Please try again.</p>';
            });
    }

    function confirmDelete(id) {
        if (confirm('Are you sure you want to delete this repair? This action cannot be undone.')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Delete", "Repairs")/' + id;
            // Grab the antiforgery token from the hidden form above
            var token = document.querySelector('#_deleteTokenForm input[name="__RequestVerificationToken"]');
            if (token) {
                var hiddenField = document.createElement('input');
                hiddenField.type = 'hidden';
                hiddenField.name = '__RequestVerificationToken';
                hiddenField.value = token.value;
                form.appendChild(hiddenField);
            }
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
