@model Empire.Web.DTOs.Repair.RepairDto
@{
    ViewData["Title"] = "Repair Details";
}

<style>
    .detail-card { border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08); margin-bottom: 20px; }
    .detail-label { font-size: 12px; font-weight: 600; color: #6c757d; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; }
    .detail-value { font-size: 15px; color: #212529; font-weight: 500; }
    .status-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .status-pending { background: #fff3cd; color: #856404; }
    .status-in-progress { background: #cfe2ff; color: #084298; }
    .status-completed { background: #d1e7dd; color: #0a3622; }
    .status-cancelled { background: #f8d7da; color: #842029; }
    .payment-unpaid { background: #f8d7da; color: #842029; }
    .payment-partial { background: #fff3cd; color: #856404; }
    .payment-paid { background: #d1e7dd; color: #0a3622; }
    .section-title { font-size: 14px; font-weight: 700; color: #495057; border-bottom: 2px solid #e9ecef; padding-bottom: 8px; margin-bottom: 16px; }
</style>

<!-- Header -->
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="fas fa-tools me-2"></i>
        Repair Details
        @if (!string.IsNullOrEmpty(Model.RepairNumber))
        {
            <small class="text-muted fs-5 ms-2">#@Model.RepairNumber</small>
        }
    </h1>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
            <i class="fas fa-edit me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back to Repairs
        </a>
    </div>
</div>

<div class="row">
    <!-- Left column -->
    <div class="col-lg-8">
        <!-- Repair Info -->
        <div class="card detail-card">
            <div class="card-body">
                <div class="section-title"><i class="fas fa-info-circle me-2 text-primary"></i>Repair Information</div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="detail-label">Repair Number</div>
                        <div class="detail-value">@(Model.RepairNumber ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">Status</div>
                        <div>
                            @{
                                var statusClass = (Model.Status ?? "").ToLower().Replace(" ", "-") switch {
                                    "pending"     => "status-pending",
                                    "in-progress" => "status-in-progress",
                                    "completed"   => "status-completed",
                                    "cancelled"   => "status-cancelled",
                                    _             => "status-pending"
                                };
                            }
                            <span class="status-badge @statusClass">@(Model.Status ?? "—")</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">Payment Status</div>
                        <div>
                            @{
                                var payClass = (Model.PaymentStatus ?? "").ToLower() switch {
                                    "paid"    => "payment-paid",
                                    "partial" => "payment-partial",
                                    _         => "payment-unpaid"
                                };
                            }
                            <span class="status-badge @payClass">@(Model.PaymentStatus ?? "—")</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">Created Date</div>
                        <div class="detail-value">@Model.CreatedDate.ToString("MMM dd, yyyy hh:mm tt")</div>
                    </div>
                    @if (Model.CompletedDate.HasValue)
                    {
                        <div class="col-md-4">
                            <div class="detail-label">Completed Date</div>
                            <div class="detail-value">@Model.CompletedDate.Value.ToString("MMM dd, yyyy hh:mm tt")</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.CreatedByUser))
                    {
                        <div class="col-md-4">
                            <div class="detail-label">Created By</div>
                            <div class="detail-value">@Model.CreatedByUser</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Device Info -->
        <div class="card detail-card">
            <div class="card-body">
                <div class="section-title"><i class="fas fa-mobile-alt me-2 text-info"></i>Device Information</div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="detail-label">Brand</div>
                        <div class="detail-value">@(Model.DeviceBrand ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">Category</div>
                        <div class="detail-value">@(Model.DeviceCategory ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">Model</div>
                        <div class="detail-value">@(Model.DeviceModel ?? "—")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.IMEI))
                    {
                        <div class="col-md-6">
                            <div class="detail-label">IMEI</div>
                            <div class="detail-value">@Model.IMEI</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Description & Comments -->
        @if (!string.IsNullOrEmpty(Model.Description) || !string.IsNullOrEmpty(Model.IssueDescription) || !string.IsNullOrEmpty(Model.Comments))
        {
            <div class="card detail-card">
                <div class="card-body">
                    <div class="section-title"><i class="fas fa-file-alt me-2 text-secondary"></i>Description &amp; Notes</div>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-3">
                            <div class="detail-label">Description</div>
                            <div class="detail-value">@Model.Description</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.IssueDescription))
                    {
                        <div class="mb-3">
                            <div class="detail-label">Issue Description</div>
                            <div class="detail-value">@Model.IssueDescription</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Comments))
                    {
                        <div>
                            <div class="detail-label">Comments / Notes</div>
                            <div class="detail-value">@Model.Comments</div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Parts Used -->
        @if (Model.RepairPartNames != null && Model.RepairPartNames.Any())
        {
            <div class="card detail-card">
                <div class="card-body">
                    <div class="section-title"><i class="fas fa-cogs me-2 text-warning"></i>Parts Used</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var part in Model.RepairPartNames)
                        {
                            <span class="badge bg-light text-dark border" style="font-size:13px; padding: 6px 12px;">
                                <i class="fas fa-puzzle-piece me-1 text-warning"></i>@part
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Right column -->
    <div class="col-lg-4">
        <!-- Customer Info -->
        <div class="card detail-card">
            <div class="card-body">
                <div class="section-title"><i class="fas fa-user me-2 text-success"></i>Customer</div>
                <div class="mb-2">
                    <div class="detail-label">Name</div>
                    <div class="detail-value">@(Model.CustomerName ?? "—")</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                {
                    <div>
                        <div class="detail-label">Phone</div>
                        <div class="detail-value">
                            <a href="tel:@Model.CustomerPhone">@Model.CustomerPhone</a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Financials -->
        <div class="card detail-card">
            <div class="card-body">
                <div class="section-title"><i class="fas fa-dollar-sign me-2 text-success"></i>Financials</div>
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr>
                            <td class="detail-label border-0 ps-0">Repair Cost</td>
                            <td class="text-end fw-bold text-primary border-0">$@Model.Cost.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="detail-label border-0 ps-0">Advance Paid</td>
                            <td class="text-end fw-semibold text-success border-0">$@Model.AdvancePayment.ToString("N2")</td>
                        </tr>
                        @if (Model.RemainingDues > 0)
                        {
                            <tr class="table-danger">
                                <td class="detail-label border-0 ps-0">Balance Due</td>
                                <td class="text-end fw-bold text-danger border-0">$@Model.RemainingDues.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Actions -->
        <div class="card detail-card">
            <div class="card-body">
                <div class="section-title"><i class="fas fa-bolt me-2 text-warning"></i>Actions</div>
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit me-2"></i>Edit Repair
                    </a>
                    @if (ViewBag.IsManager == true)
                    {
                        <button type="button" class="btn btn-danger" onclick="confirmDelete(@Model.Id)">
                            <i class="fas fa-trash me-2"></i>Delete Repair
                        </button>
                    }
                    <button type="button" class="btn btn-outline-primary" onclick="openHistoryModal(@Model.Id, '@Model.RepairNumber')">
                        <i class="fas fa-history me-2"></i>View Activity History
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Repair History Modal -->
<div class="modal fade" id="repairHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #6f42c1, #5a32a3); color: white;">
                <h5 class="modal-title" id="historyModalTitle">
                    <i class="fas fa-history me-2"></i>Activity History
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="historyModalBody" style="min-height:200px;"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@* Hidden form for antiforgery token *@
<form id="_deleteTokenForm" method="post" asp-action="Delete" asp-route-id="0" style="display:none;"></form>

@section Scripts {
<script>
    function openHistoryModal(repairId, repairNumber) {
        document.getElementById('historyModalTitle').innerHTML = '<i class="fas fa-history me-2"></i>Activity History &mdash; Repair #' + repairNumber;
        var body = document.getElementById('historyModalBody');
        body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Loading history...</p></div>';
        var modal = new bootstrap.Modal(document.getElementById('repairHistoryModal'));
        modal.show();

        fetch('/Repairs/GetRepairActivities?repairId=' + repairId)
            .then(function(r) { return r.json(); })
            .then(function(resp) {
                if (!resp.success || !resp.data || resp.data.length === 0) {
                    body.innerHTML = '<p class="text-muted text-center py-3"><i class="fas fa-info-circle me-1"></i>No activity recorded yet.</p>';
                    return;
                }
                var actionBadge = {
                    'Created': 'bg-success',
                    'Updated': 'bg-primary',
                    'PartsUpdated': 'bg-warning text-dark',
                    'StatusChanged': 'bg-info text-dark',
                    'Deleted': 'bg-danger'
                };
                var html = '<div style="position:relative;padding-left:24px;border-left:3px solid #6f42c1;margin-left:8px;">';
                resp.data.forEach(function(a) {
                    var badge = actionBadge[a.action] || 'bg-secondary';
                    html += '<div class="mb-3" style="position:relative;">';
                    html += '<div style="position:absolute;left:-30px;top:4px;width:14px;height:14px;border-radius:50%;background:#6f42c1;border:2px solid #fff;box-shadow:0 0 0 2px #6f42c1;"></div>';
                    html += '<div class="card border-0 shadow-sm">';
                    html += '<div class="card-body py-2 px-3">';
                    html += '<div class="d-flex justify-content-between align-items-start flex-wrap gap-1">';
                    html += '<span class="badge ' + badge + '">' + a.action + '</span>';
                    html += '<small class="text-muted">' + (a.performedAtFormatted || a.performedAt) + '</small>';
                    html += '</div>';
                    if (a.description) html += '<p class="mb-0 mt-1" style="font-size:0.9rem;">' + a.description + '</p>';
                    if (a.newValues) html += '<small class="text-muted d-block mt-1"><strong>Changes:</strong> ' + a.newValues + '</small>';
                    html += '<small class="text-muted d-block mt-1"><i class="fas fa-user me-1"></i>' + (a.performedByUserName || 'System') + '</small>';
                    html += '</div></div></div>';
                });
                html += '</div>';
                body.innerHTML = html;
            })
            .catch(function() {
                body.innerHTML = '<p class="text-danger text-center py-3">Failed to load history. Please try again.</p>';
            });
    }

    function confirmDelete(id) {
        if (confirm('Are you sure you want to delete this repair? This action cannot be undone.')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Delete", "Repairs")/' + id;
            var token = document.querySelector('#_deleteTokenForm input[name="__RequestVerificationToken"]');
            if (token) {
                var h = document.createElement('input');
                h.type = 'hidden';
                h.name = '__RequestVerificationToken';
                h.value = token.value;
                form.appendChild(h);
            }
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
}
