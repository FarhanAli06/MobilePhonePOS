<!-- Global Add New Customer Modal -->
<div class="modal fade" id="addNewCustomerModal" tabindex="-1" role="dialog" aria-labelledby="addNewCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addNewCustomerModalLabel">Add New Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createCustomerForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label for="newCustomerFirstName">First Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="newCustomerFirstName" name="FirstName" required>
                    </div>
                    <div class="form-group">
                        <label for="newCustomerLastName">Last Name</label>
                        <input type="text" class="form-control" id="newCustomerLastName" name="LastName">
                    </div>
                    <div class="form-group">
                        <label for="newCustomerPhone">Phone</label>
                        <input type="tel" class="form-control" id="newCustomerPhone" name="Phone">
                    </div>
                    <div class="form-group">
                        <label for="newCustomerEmail">Email</label>
                        <input type="email" class="form-control" id="newCustomerEmail" name="Email">
                    </div>
                    <div class="form-group">
                        <label for="newCustomerAddress">Address</label>
                        <input type="text" class="form-control" id="newCustomerAddress" name="Address">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let phoneInput;
    
    $(document).ready(function () {
        // Initialize international phone input
        const phoneInputField = document.querySelector('#newCustomerPhone');
        phoneInput = window.intlTelInput(phoneInputField, {
            initialCountry: 'us',
            preferredCountries: ['us', 'ca', 'gb', 'au'],
            separateDialCode: true,
            strictMode: true,
            formatOnDisplay: true,
            autoPlaceholder: 'aggressive',
            utilsScript: 'https://cdn.jsdelivr.net/npm/intl-tel-input@19.5.6/build/js/utils.js'
        });
        
        // Add validation on input
        phoneInputField.addEventListener('blur', function() {
            if (phoneInputField.value.trim()) {
                if (!phoneInput.isValidNumber()) {
                    phoneInputField.classList.add('is-invalid');
                } else {
                    phoneInputField.classList.remove('is-invalid');
                }
            } else {
                phoneInputField.classList.remove('is-invalid');
            }
        });
        
        // Restrict to numbers only
        phoneInputField.addEventListener('keypress', function(e) {
            const char = String.fromCharCode(e.which);
            if (!/[0-9\+\-\(\)\s]/.test(char)) {
                e.preventDefault();
            }
        });
        
        $('#createCustomerForm').on('submit', function (e) {
            e.preventDefault();
            
            // Convert form data to JSON object
            var formData = {};
            $(this).serializeArray().forEach(function(item) {
                formData[item.name] = item.value;
            });
            
            // Validate and get full international phone number
            if (phoneInput && phoneInputField.value.trim()) {
                if (!phoneInput.isValidNumber()) {
                    alert('Please enter a valid phone number for the selected country.');
                    phoneInputField.focus();
                    return false;
                }
                formData['Phone'] = phoneInput.getNumber();
            }

            $.ajax({
                url: '@Url.Action("Create", "Customers")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData)
            })
                .done(function (response) {
                    if (response.success) {
                        alert(response.message || 'Customer added successfully!');
                        // Close modal using Bootstrap 5 syntax
                        var modal = bootstrap.Modal.getInstance(document.getElementById('addNewCustomerModal'));
                        if (modal) {
                            modal.hide();
                        }
                        $('#createCustomerForm')[0].reset();
                        
                        // Refresh customer dropdown if it exists on the page
                        var customer = response.customer || response.data;
                        if (!customer) {
                            alert('Customer was saved, but the saved record was not returned. Refresh the customer list.');
                            return;
                        }
                        var custText = [customer.firstName, customer.lastName].filter(Boolean).join(' ') + (customer.phone ? ' \u2014 ' + customer.phone : '');
                        var custId   = customer.id;

                        // POS page: #customerSelect
                        if ($('#customerSelect').length) {
                            var newOption = new Option(custText, custId, true, true);
                            $('#customerSelect').append(newOption).trigger('change');
                            if (typeof selectedCustomerId !== 'undefined') { selectedCustomerId = custId; }
                        }

                        // Repair Create page: #customerName (Select2 with ajax)
                        if ($('#customerName').length) {
                            var repairOption = new Option(custText, custId, true, true);
                            repairOption.dataset.customer = JSON.stringify(customer);
                            $('#customerName').append(repairOption).val(String(custId)).trigger('change');
                            $('#customerName').trigger({ type: 'select2:select', params: { data: { id: custId, text: custText, customer: customer } } });
                            // Auto-fill phone/email/address fields
                            $('#customerPhone').val(customer.phone || '');
                            $('#customerEmail').val(customer.email || '');
                            $('#customerAddress').val(customer.address || '');
                            if (typeof updateIntakeSummary === 'function') { updateIntakeSummary(); }
                        }
                    } else {
                        alert('Error: ' + (response.message || 'Failed to add customer'));
                    }
                })
                .fail(function (xhr) {
                    alert('Error: An error occurred during customer creation.');
                });
        });
    });
</script>
