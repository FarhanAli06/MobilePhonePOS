@* Shared 80mm customer receipt. The public printInvoice(data) contract is unchanged. *@
<div id="invoicePrintTemplate" aria-hidden="true">
    <article class="receipt-80mm">
        <header class="receipt-header">
            <img id="printShopLogo" src="/images/empire-original-logo.png" alt="Empire Phone Repair" />
            <div class="receipt-shop" id="printCompanyName"></div>
            <div id="printShopAddressLine1"></div><div id="printShopAddressLine2"></div>
            <div id="printShopPhone"></div><div id="printShopEmail"></div>
        </header>
        <div class="receipt-rule"></div><h1>REPAIR RECEIPT</h1>
        <dl class="receipt-facts">
            <div><dt>Customer</dt><dd id="printCustomerName"></dd></div>
            <div><dt>Phone / Email</dt><dd id="printCustomerEmail"></dd></div>
            <div><dt>Address</dt><dd id="printCustomerAddress"></dd></div>
            <div><dt>Date</dt><dd id="printInvoiceDate"></dd></div>
            <div><dt>Receipt #</dt><dd id="printInvoiceNumber"></dd></div>
        </dl>
        <table class="receipt-items"><thead><tr><th>ITEM</th><th>QTY</th><th>AMOUNT</th></tr></thead><tbody id="printInvoiceItems"></tbody></table>
        <section class="receipt-totals">
            <div><span>Subtotal</span><strong id="printSubtotal">$0.00</strong></div>
            <div id="printTaxRow"><span>Tax</span><strong id="printTax">$0.00</strong></div>
            <div id="printDiscountRow"><span>Discount</span><strong id="printDiscount">$0.00</strong></div>
            <div class="receipt-total"><span>TOTAL</span><strong id="printTotalAmount">$0.00</strong></div>
        </section>
        <section class="receipt-detail"><strong>Payment:</strong> <span id="printPaymentMethod"></span></section>
        <section class="receipt-detail receipt-notes"><strong>Notes:</strong> <span id="printNotes"></span></section>
        <div class="receipt-barcode"><svg id="printReceiptBarcode" role="img" aria-label="Receipt barcode"></svg><div id="printBarcodeText"></div></div>
        <footer><div class="receipt-thanks">Thank you!</div><div>We appreciate your business.</div><div id="printWebsite"></div></footer>
    </article>
</div>

<style>
    #invoicePrintTemplate{display:none}.receipt-80mm{box-sizing:border-box;width:72mm;margin:0 auto;padding:2mm 1.5mm 4mm;background:#fff;color:#000;font-family:Arial,Helvetica,sans-serif;font-size:10pt;line-height:1.25}.receipt-header{text-align:center}#printShopLogo{display:block;width:29mm;height:29mm;object-fit:contain;margin:0 auto 1mm;filter:grayscale(1) contrast(1.25)}.receipt-shop{font-size:14pt;font-weight:800;text-transform:uppercase}.receipt-rule{border-top:.45mm dashed #000;margin:2.5mm 0}.receipt-80mm h1{margin:0 0 2mm;text-align:center;font-size:13pt;letter-spacing:.5px}.receipt-facts{margin:0 0 2.5mm}.receipt-facts div{display:grid;grid-template-columns:22mm 1fr;gap:1mm;margin:.6mm 0}.receipt-facts dt{font-weight:700}.receipt-facts dd{margin:0;overflow-wrap:anywhere}.receipt-items{width:100%;border-collapse:collapse;table-layout:fixed;margin:2mm 0}.receipt-items th{border-top:.35mm dashed #000;border-bottom:.35mm dashed #000;padding:1.5mm .5mm;font-size:8.5pt;text-align:left}.receipt-items th:nth-child(2),.receipt-items td:nth-child(2){width:9mm;text-align:center}.receipt-items th:last-child,.receipt-items td:last-child{width:19mm;text-align:right}.receipt-items td{padding:1.5mm .5mm;vertical-align:top;overflow-wrap:anywhere}.item-description{font-weight:700}.item-details{margin-top:.5mm;font-size:8pt}.receipt-totals{border-top:.35mm dashed #000;padding-top:1.5mm}.receipt-totals>div{display:flex;justify-content:space-between;gap:4mm;padding:.6mm 0}.receipt-total{border-top:.45mm solid #000;border-bottom:.45mm solid #000;margin-top:1mm;padding:2mm .5mm!important;font-size:17pt;font-weight:900}.receipt-detail{margin-top:2mm}.receipt-notes{font-size:9pt}.receipt-barcode{margin:3mm auto 1.5mm;text-align:center}#printReceiptBarcode{display:block;width:62mm;height:15mm;margin:0 auto}#printBarcodeText{font-family:Consolas,monospace;font-size:9pt;letter-spacing:1.2px}.receipt-80mm footer{border-top:.35mm dashed #000;margin-top:2mm;padding-top:2mm;text-align:center;font-size:9pt}.receipt-thanks{margin-bottom:.5mm;font-family:"Segoe Script","Brush Script MT",cursive;font-size:20pt;font-weight:700}
    @@media print{@@page{size:80mm auto;margin:0}html,body{width:80mm!important;min-width:80mm!important;margin:0!important;padding:0!important;background:#fff!important}body>*{display:none!important}#invoicePrintTemplate{display:block!important;width:80mm!important;margin:0!important;padding:0!important}.receipt-80mm{break-inside:avoid;page-break-inside:avoid}}
</style>

<script>
(function(global){'use strict';
function money(v){return '$'+(Number(v)||0).toFixed(2)}function text(id,v){var n=document.getElementById(id);if(n)n.textContent=v||''}function show(id,v){var n=document.getElementById(id);if(n)n.style.display=v?'flex':'none'}function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
var c39={'0':'nnnwwnwnn','1':'wnnwnnnnw','2':'nnwwnnnnw','3':'wnwwnnnnn','4':'nnnwwnnnw','5':'wnnwwnnnn','6':'nnwwwnnnn','7':'nnnwnnwnw','8':'wnnwnnwnn','9':'nnwwnnwnn','A':'wnnnnwnnw','B':'nnwnnwnnw','C':'wnwnnwnnn','D':'nnnnwwnnw','E':'wnnnwwnnn','F':'nnwnwwnnn','G':'nnnnnwwnw','H':'wnnnnwwnn','I':'nnwnnwwnn','J':'nnnnwwwnn','K':'wnnnnnnww','L':'nnwnnnnww','M':'wnwnnnnwn','N':'nnnnwnnww','O':'wnnnwnnwn','P':'nnwnwnnwn','Q':'nnnnnnwww','R':'wnnnnnwwn','S':'nnwnnnwwn','T':'nnnnwnwwn','U':'wwnnnnnnw','V':'nwwnnnnnw','W':'wwwnnnnnn','X':'nwnnwnnnw','Y':'wwnnwnnnn','Z':'nwwnwnnnn','-':'nwnnnnwnw','.':'wwnnnnwnn',' ':'nwwnnnwnn','$':'nwnwnwnnn','/':'nwnwnnnwn','+':'nwnnnwnwn','%':'nnnwnwnwn','*':'nwnnwnwnn'};
function barcode(raw){var value=String(raw||'RECEIPT').toUpperCase().replace(/[^0-9A-Z. \-$\/+%]/g,''),encoded='*'+value+'*',x=0,bars=[];encoded.split('').forEach(function(ch){(c39[ch]||c39['-']).split('').forEach(function(w,i){var a=w==='w'?3:1;if(i%2===0)bars.push('<rect x="'+x+'" y="0" width="'+a+'" height="46" fill="#000"/>');x+=a});x+=1});var svg=document.getElementById('printReceiptBarcode');if(svg){svg.setAttribute('viewBox','0 0 '+x+' 46');svg.innerHTML=bars.join('')}text('printBarcodeText',value)}
global.printInvoice=function(d){d=d||{};text('printCompanyName',d.companyName||d.shopName||'Empire Phone Repair');text('printCustomerName',d.customerName||'Walk-in Customer');text('printCustomerEmail',[d.customerPhone,d.customerEmail].filter(Boolean).join(' / '));text('printCustomerAddress',d.customerAddress||'');text('printInvoiceDate',d.invoiceDate||new Date().toLocaleDateString('en-US'));text('printInvoiceNumber',d.invoiceNumber||'');text('printShopAddressLine1',d.shopAddress||'');text('printShopAddressLine2',[d.shopCity,d.shopState,d.shopZip].filter(Boolean).join(' '));text('printShopPhone',d.shopPhone||'');text('printShopEmail',d.shopEmail||'');var logo=document.getElementById('printShopLogo');if(logo)logo.src=(d.shopLogo&&String(d.shopLogo).trim())?d.shopLogo:'/images/empire-original-logo.png';var rows=(d.items||[]).map(function(i){var q=Number(i.quantity)||1,p=Number(i.totalPrice!=null?i.totalPrice:i.total)||((Number(i.unitPrice!=null?i.unitPrice:i.price)||0)*q),details=[i.description&&i.description!==i.name?i.description:'',i.imei?'IMEI: '+i.imei:'',i.serialNumber?'S/N: '+i.serialNumber:'',i.details||''].filter(Boolean).join(' · ');return'<tr><td><div class="item-description">'+esc(i.name||i.description||'Item')+'</div>'+(details?'<div class="item-details">'+esc(details)+'</div>':'')+'</td><td>'+q+'</td><td>'+money(p)+'</td></tr>'}).join('');document.getElementById('printInvoiceItems').innerHTML=rows||'<tr><td>Repair service</td><td>1</td><td>'+money(d.subtotal)+'</td></tr>';text('printSubtotal',money(d.subtotal));show('printTaxRow',Number(d.tax)>0);text('printTax',money(d.tax));show('printDiscountRow',Number(d.discount)>0);text('printDiscount','-'+money(d.discount));text('printTotalAmount',money(d.totalAmount));var payment=typeof d.paymentMethod==='string'?d.paymentMethod:((d.paymentMethods||[]).map(function(p){return p.method+': '+money(p.amount)}).join(', ')||'N/A');text('printPaymentMethod',payment);text('printNotes',d.notes||'');text('printWebsite',d.website||'');barcode(d.barcode||d.invoiceNumber);var fire=function(){global.focus();global.requestAnimationFrame(function(){global.requestAnimationFrame(function(){global.setTimeout(function(){global.print()},250)})})};if(logo&&!logo.complete){var once=false;var ready=function(){if(!once){once=true;fire()}};logo.addEventListener('load',ready,{once:true});logo.addEventListener('error',ready,{once:true});global.setTimeout(ready,1500)}else{fire()}};
}(window));
</script>
