@* Shared Invoice Edit Modal - Can be used from POS and Sales Report *@

<div class="modal fade" id="invoiceEditModal" tabindex="-1" aria-labelledby="invoiceEditModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="invoiceEditModalLabel">
                    <i class="fas fa-edit me-2"></i>Edit Invoice: <span id="editInvoiceNumber"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs invoice-modern-tabs mb-4" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#saleDetailsTabPane" type="button"><i class="fas fa-receipt me-2"></i>Sale details</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#saleReturnsTabPane" type="button" onclick="loadSaleReturns()"><i class="fas fa-undo me-2"></i>Returns & refunds <span class="badge bg-danger ms-1" id="saleReturnCount" style="display:none">0</span></button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#saleHistoryTabPane" type="button" onclick="loadSaleHistory()"><i class="fas fa-history me-2"></i>Modification history</button></li>
                </ul>
                <div class="tab-content">
                <div class="tab-pane fade show active" id="saleDetailsTabPane">
                <!-- Invoice Info Section -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Invoice Number</label>
                        <input type="text" class="form-control" id="editInvoiceNumberDisplay" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Invoice Date</label>
                        <input type="text" class="form-control" id="editInvoiceDate" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Customer</label>
                        <select class="form-select" id="editCustomerSelect">
                            <option value="">Walk-in Customer</option>
                        </select>
                    </div>
                </div>

                <hr>

                <!-- Items Section -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0"><i class="fas fa-list me-2"></i>Invoice Items</h6>
                    <button type="button" class="btn btn-sm btn-success" id="addItemBtn">
                        <i class="fas fa-plus me-1"></i>Add Item
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 25%;">Item Name</th>
                                <th style="width: 20%;">Description</th>
                                <th style="width: 10%;">Quantity</th>
                                <th style="width: 15%;">Unit Price</th>
                                <th style="width: 10%;">Cost Price</th>
                                <th style="width: 10%;">Total Price</th>
                                <th style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="editItemsTableBody">
                            <!-- Items will be populated here -->
                        </tbody>
                    </table>
                </div>

                <hr>

                <!-- Totals Section -->
                <div class="row">
                    <div class="col-md-8"></div>
                    <div class="col-md-4">
                        <table class="table table-sm">
                            <tr>
                                <td class="fw-bold">Subtotal:</td>
                                <td class="text-end" id="editSubtotal">$0.00</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Tax:</td>
                                <td class="text-end">
                                    <input type="number" class="form-control form-control-sm text-end" id="editTax" value="0" step="0.01" min="0">
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Discount:</td>
                                <td class="text-end" id="editDiscount">$0.00</td>
                            </tr>
                            <tr class="table-primary">
                                <td class="fw-bold">Total:</td>
                                <td class="text-end fw-bold" id="editTotal">$0.00</td>
                            </tr>
                            <tr>
                                <td colspan="2"><hr class="my-1"></td>
                            </tr>
                            <tr class="text-muted small">
                                <td>Total Cost:</td>
                                <td class="text-end" id="editTotalCost">$0.00</td>
                            </tr>
                            <tr class="small">
                                <td class="fw-bold">Total Profit:</td>
                                <td class="text-end fw-bold" id="editTotalProfit">$0.00</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <hr>

                <!-- Payment Section -->
                <h6 class="mb-3"><i class="fas fa-credit-card me-2"></i>Payment Information</h6>
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Payment Status</label>
                        <select class="form-select" id="editPaymentStatus">
                            <option value="Paid">Paid</option>
                            <option value="Partial">Partial</option>
                            <option value="Unpaid">Unpaid</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Payment Method</label>
                        <select class="form-select" id="editPaymentMethod">
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="Check">Check</option>
                            <option value="Zelle">Zelle</option>
                            <option value="Venmo">Venmo</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
                <div class="mt-3">
                    <label class="form-label fw-bold">Reason for this correction *</label>
                    <input class="form-control" id="editChangeReason" maxlength="500" placeholder="Example: corrected payment method or item price">
                    <small class="text-muted">The original values and this reason are permanently recorded.</small>
                </div>

                </div>
                <div class="tab-pane fade" id="saleReturnsTabPane">
                    <div class="refund-workspace">
                        <div class="refund-section-heading"><div><h6 class="mb-1">Previously refunded items</h6><small class="text-muted">Every completed refund is listed by item.</small></div></div>
                        <div id="processedReturnsList" class="mb-4"><div class="text-muted py-3">Open this tab to load refund history.</div></div>
                        <div class="refund-new-card">
                            <h6 class="mb-1">Create a new return</h6>
                            <small class="text-muted">Select only the items the customer is returning.</small>
                            <div id="returnItemsList" class="my-3"></div>
                            <div class="row g-3">
                                <div class="col-md-4"><label class="form-label">Refund method</label><select id="returnMethod" class="form-select"><option>Cash</option><option>Card</option><option>Zelle</option><option>Store Credit</option><option>Other</option></select></div>
                                <div class="col-md-8"><label class="form-label">Reason *</label><input id="returnReason" class="form-control" placeholder="Required reason for the return"></div>
                            </div>
                            <button type="button" class="btn btn-danger mt-3" onclick="processInvoiceReturn()"><i class="fas fa-undo me-1"></i>Process selected return</button>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="saleHistoryTabPane">
                    <div id="saleHistoryList" class="sale-history-panel">Open this tab to load history.</div>
                </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveInvoiceBtn">
                    <i class="fas fa-save me-1"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Add Item Modal (nested) -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addItemModalLabel">Add Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Search Item</label>
                    <input type="text" class="form-control" id="searchItemInput" placeholder="Search by name, SKU, IMEI...">
                    <div id="searchItemResults" class="list-group mt-2" style="max-height: 200px; overflow-y: auto;"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Item Name *</label>
                    <input type="text" class="form-control" id="newItemName" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <input type="text" class="form-control" id="newItemDescription">
                </div>
                <div class="mb-3">
                    <label class="form-label">Quantity *</label>
                    <input type="number" class="form-control" id="newItemQuantity" value="1" min="1" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Unit Price *</label>
                    <input type="number" class="form-control" id="newItemPrice" value="0" step="0.01" min="0" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmAddItemBtn">Add Item</button>
            </div>
        </div>
    </div>
</div>

<script>
// Global variables for invoice editing
let currentEditingSaleId = null;
let editingItems = [];
let editingCustomerId = null;
let editingPaymentAmount = 0;
let editingPaymentReference = '';

// Initialize invoice edit modal
function initInvoiceEditModal() {
    // Load customers for dropdown
    loadCustomersForEdit();
    
    // Add item button
    $('#addItemBtn').click(function() {
        $('#addItemModal').modal('show');
        $('#searchItemInput').val('');
        $('#searchItemResults').html('');
        $('#newItemName').val('');
        $('#newItemDescription').val('');
        $('#newItemQuantity').val(1);
        $('#newItemPrice').val(0);
    });
    
    // Search item
    $('#searchItemInput').on('input', debounce(function() {
        const query = $(this).val();
        if (query.length < 2) {
            $('#searchItemResults').html('');
            return;
        }
        searchItemsForEdit(query);
    }, 300));
    
    // Confirm add item
    $('#confirmAddItemBtn').click(function() {
        addNewItemToInvoice();
    });
    
    // Save invoice button
    $('#saveInvoiceBtn').click(function() {
        saveInvoiceChanges();
    });
    
    // Tax change
    $('#editTax').on('input', function() {
        recalculateEditTotals();
    });
}

// Load invoice for editing
function loadInvoiceForEdit(saleId) {
    $.ajax({
        url: '@Url.Action("GetInvoiceData", "POS")',
        type: 'GET',
        data: { saleId: saleId },
        success: function(response) {
            if (response.success) {
                populateEditModal(response, saleId);
                $('#invoiceEditModal').modal('show');
            } else {
                alert('Error loading invoice: ' + response.message);
            }
        },
        error: function(xhr) {
            console.error('Error fetching invoice:', xhr);
            alert('Error loading invoice data. Please try again.');
        }
    });
}

// Populate edit modal with invoice data
function populateEditModal(data, saleId) {
    currentEditingSaleId = saleId;
    editingCustomerId = data.customer && data.customer.id ? data.customer.id : null;
    
    // Set invoice info
    $('#editInvoiceNumber').text(data.invoice.number);
    $('#editInvoiceNumberDisplay').val(data.invoice.number);
    $('#editInvoiceDate').val(new Date(data.invoice.date).toLocaleString());
    
    // Set customer
    if (data.customer && data.customer.name !== 'Walk-in Customer') {
        // Try to find customer ID from name (will need to enhance this)
        $('#editCustomerSelect').val(editingCustomerId || '').trigger('change');
    }
    
    // Populate items
    editingItems = data.items.map(item => ({
        id: item.id,
        name: item.name,
        description: item.description || '',
        quantity: item.quantity,
        unitPrice: item.unitPrice,
        totalPrice: item.totalPrice,
        inventoryItemId: item.inventoryItemId || null,
        repairId: item.repairId || null,
        costPrice: item.costPrice || 0, // This is now the UNIT cost price
        isCustomItem: !!item.isCustomItem,
        itemType: item.itemType || (item.repairId ? 'Repair' : (item.inventoryItemId ? 'Inventory' : (item.isCustomItem ? 'Custom' : 'Device'))),
        itemStatus: item.itemStatus || 'In Stock',
        isTaxable: item.isTaxable !== false
    }));
    
    renderEditItems();
    renderReturnItems();
    
    // Set tax
    $('#editTax').val(data.totals.tax || 0);
    
    // Set payment info
    $('#editPaymentStatus').val(data.payment.status || 'Paid');
    $('#editChangeReason').val('');
    if (data.payment.methods && data.payment.methods.length > 0) {
        $('#editPaymentMethod').val(data.payment.methods[0].method || 'Cash');
    }
    editingPaymentAmount = (data.payment.methods || []).reduce((sum, payment) =>
        sum + (parseFloat(payment.amount) || 0), 0);
    editingPaymentReference = data.payment.methods && data.payment.methods.length
        ? (data.payment.methods[0].reference || '')
        : '';
    
    recalculateEditTotals();
}

function renderReturnItems() {
    const host = $('#returnItemsList').empty();
    editingItems.forEach((item, index) => host.append(`
      <div class="row g-2 align-items-center border rounded p-2 mb-2 return-line" data-index="${index}">
       <div class="col-md-4"><label><input type="checkbox" class="return-check me-2">${$('<div>').text(item.name).html()}</label></div>
       <div class="col-md-2"><input type="number" class="form-control return-qty" min="1" max="${item.quantity}" value="1" title="Quantity"></div>
       <div class="col-md-2"><input type="number" class="form-control return-amount" min="0" step="0.01" value="${item.unitPrice.toFixed(2)}" title="Refund amount"></div>
       <div class="col-md-4"><select class="form-select return-disposition"><option value="Restock">Return to stock</option><option value="Available">Device: available for sale</option><option value="NeedsInspection">Device: needs inspection</option><option value="NeedsRepair">Device: needs repair</option><option value="ForParts">Device: for parts</option><option value="DefectiveVendorReturn">Defective / vendor return</option></select></div>
      </div>`));
}

function loadSaleReturns() {
    if (!currentEditingSaleId) return;
    $('#processedReturnsList').html('<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div><span class="ms-2 text-muted">Loading refunds...</span></div>');
    $.get('@Url.Action("GetSaleReturns", "POS")', { saleId: currentEditingSaleId }, function(response) {
        const returns = response && response.success ? (response.data || []) : [];
        $('#saleReturnCount').text(returns.length).toggle(returns.length > 0);
        if (!returns.length) {
            $('#processedReturnsList').html('<div class="refund-empty"><i class="fas fa-check-circle"></i><div><strong>No refunds on this sale</strong><small>This sale has no completed returns.</small></div></div>');
            return;
        }
        $('#processedReturnsList').html(returns.map(function(refund) {
            const items = (refund.items || []).map(function(item) {
                return `<div class="refund-history-item"><div><strong>${$('<div>').text(item.itemName || 'Item').html()}</strong><small>Qty ${item.quantity} · ${$('<div>').text(item.disposition || '').html()}</small></div><strong class="text-danger">−$${Number(item.refundAmount || 0).toFixed(2)}</strong></div>`;
            }).join('');
            return `<article class="refund-history-card"><div class="refund-history-head"><div><strong>${$('<div>').text(refund.returnNumber || 'Return').html()}</strong><small>${new Date(refund.processedAt).toLocaleString()} · ${$('<div>').text(refund.processedBy || 'System').html()}</small></div><div class="text-end"><strong class="text-danger">−$${Number(refund.refundAmount || 0).toFixed(2)}</strong><small>${$('<div>').text(refund.refundMethod || '').html()}</small></div></div>${items}<div class="refund-reason"><strong>Reason:</strong> ${$('<div>').text(refund.reason || '').html()}</div></article>`;
        }).join(''));
    }).fail(function() {
        $('#processedReturnsList').html('<div class="alert alert-danger">Refund history could not be loaded.</div>');
    });
}

function loadSaleHistory() {
    if (!currentEditingSaleId) return;
    $('#saleHistoryList').html('Loading...');
    $.get('@Url.Action("GetSaleHistory", "POS")', { saleId: currentEditingSaleId }, function(r) {
        if (!r.success || !r.data.length) { $('#saleHistoryList').html('<span class="text-muted">No history yet.</span>'); return; }
        $('#saleHistoryList').html(r.data.map(x => `<div class="border-start border-primary ps-3 mb-3"><strong>${x.action}</strong> — ${$('<div>').text(x.description || '').html()}<div class="small text-muted">${new Date(x.performedAt).toLocaleString()} · ${x.performedBy || 'System'}</div></div>`).join(''));
    });
}

function processInvoiceReturn() {
    const reason = $('#returnReason').val().trim();
    const items = [];
    $('.return-line').each(function(){ if ($(this).find('.return-check').is(':checked')) { const i = editingItems[$(this).data('index')]; items.push({ SaleItemId:i.id, Quantity:parseInt($(this).find('.return-qty').val())||0, RefundAmount:parseFloat($(this).find('.return-amount').val())||0, Disposition:$(this).find('.return-disposition').val() }); }});
    if (!items.length) return alert('Select at least one item to return.');
    if (!reason) return alert('Enter the return reason.');
    if (!confirm('Process this return and record the refund?')) return;
    $.ajax({ url:'@Url.Action("ProcessReturn", "POS")?saleId=' + currentEditingSaleId, type:'POST', contentType:'application/json', data:JSON.stringify({ RefundMethod:$('#returnMethod').val(), Reason:reason, Items:items }), success:function(r){ if(r.success){ alert(`Return ${r.data.returnNumber} recorded. Refund: $${Number(r.data.refundAmount).toFixed(2)}`); $('#returnReason').val(''); renderReturnItems(); loadSaleReturns(); loadSaleHistory(); } else alert(r.message || 'Return failed'); }, error:function(xhr){ alert(xhr.responseJSON?.message || 'Return failed'); } });
}

// Render items in edit table
function renderEditItems() {
    const tbody = $('#editItemsTableBody');
    tbody.html('');
    
    editingItems.forEach((item, index) => {
        const row = $(`
            <tr data-index="${index}">
                <td>
                    <input type="text" class="form-control form-control-sm" value="${item.name}" 
                           onchange="updateEditItem(${index}, 'name', this.value)">
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm" value="${item.description}" 
                           onchange="updateEditItem(${index}, 'description', this.value)">
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm" value="${item.quantity}" min="1"
                           onchange="updateEditItem(${index}, 'quantity', parseInt(this.value))">
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm" value="${item.unitPrice.toFixed(2)}" step="0.01" min="0"
                           onchange="updateEditItem(${index}, 'unitPrice', parseFloat(this.value))">
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm" value="${item.costPrice.toFixed(2)}" step="0.01" min="0"
                           onchange="updateEditItem(${index}, 'costPrice', parseFloat(this.value))">
                </td>
                <td class="text-end">$${item.totalPrice.toFixed(2)}</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-danger" onclick="removeEditItem(${index})">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        `);
        tbody.append(row);
    });
}

// Update item in editing array
function updateEditItem(index, field, value) {
    editingItems[index][field] = value;
    
    // Recalculate total price for this item
    if (field === 'quantity' || field === 'unitPrice') {
        editingItems[index].totalPrice = editingItems[index].quantity * editingItems[index].unitPrice;
    }
    
    renderEditItems();
    recalculateEditTotals();
}

// Remove item from editing array
function removeEditItem(index) {
    if (confirm('Are you sure you want to remove this item?')) {
        editingItems.splice(index, 1);
        renderEditItems();
        recalculateEditTotals();
    }
}

// Recalculate totals
function recalculateEditTotals() {
    const subtotal = editingItems.reduce((sum, item) => sum + item.totalPrice, 0);
    const totalCost = editingItems.reduce((sum, item) => sum + (item.costPrice * item.quantity), 0);
    const tax = parseFloat($('#editTax').val()) || 0;
    const discount = 0; // Can be enhanced later
    const total = subtotal + tax - discount;
    const profit = subtotal - totalCost; // Profit is Subtotal (Revenue) - Cost (Tax is pass-through)
    
    $('#editSubtotal').text('$' + subtotal.toFixed(2));
    $('#editDiscount').text('$' + discount.toFixed(2));
    $('#editTotal').text('$' + total.toFixed(2));
    
    // Update Profit & Cost display
    $('#editTotalCost').text('$' + totalCost.toFixed(2));
    
    const profitElement = $('#editTotalProfit');
    profitElement.text('$' + profit.toFixed(2));
    
    // Color code profit
    if (profit > 0) {
        profitElement.removeClass('text-danger text-muted').addClass('text-success');
    } else if (profit < 0) {
        profitElement.removeClass('text-success text-muted').addClass('text-danger');
    } else {
        profitElement.removeClass('text-success text-danger').addClass('text-muted');
    }
}

// Load customers for dropdown
function loadCustomersForEdit() {
    $.ajax({
        url: '@Url.Action("GetCustomers", "POS")',
        type: 'GET',
        data: { search: '' },
        success: function(response) {
            const select = $('#editCustomerSelect');
            select.html('<option value="">Walk-in Customer</option>');
            
            // Handle Select2 format response { results: [...] }
            const customers = response.results || [];
            
            if (customers.length > 0) {
                customers.forEach(customer => {
                    select.append(`<option value="${customer.id}">${customer.name} ${customer.phone ? `(${customer.phone})` : ''}</option>`);
                });
            }
        },
        error: function(xhr) {
            console.error('Error loading customers:', xhr);
        }
    });
}

// Search items for adding
function searchItemsForEdit(query) {
    $.ajax({
        url: '@Url.Action("SearchItemsTab", "POS")',
        type: 'GET',
        data: { query: query },
        success: function(response) {
            const resultsDiv = $('#searchItemResults');
            resultsDiv.html('');
            
            if (response && response.length > 0) {
                response.forEach(item => {
                    const resultItem = $(`
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <strong>${item.Name}</strong>
                                    <br><small>${item.SKU || ''}</small>
                                </div>
                                <div class="text-end">
                                    <strong>$${item.Price.toFixed(2)}</strong>
                                </div>
                            </div>
                        </a>
                    `);
                    
                    resultItem.click(function(e) {
                        e.preventDefault();
                        $('#newItemName').val(item.Name);
                        $('#newItemPrice').val(item.Price);
                        $('#searchItemResults').html('');
                    });
                    
                    resultsDiv.append(resultItem);
                });
            } else {
                resultsDiv.html('<div class="list-group-item">No items found</div>');
            }
        },
        error: function(xhr) {
            console.error('Error searching items:', xhr);
        }
    });
}

// Add new item to invoice
function addNewItemToInvoice() {
    const name = $('#newItemName').val().trim();
    const description = $('#newItemDescription').val().trim();
    const quantity = parseInt($('#newItemQuantity').val()) || 1;
    const unitPrice = parseFloat($('#newItemPrice').val()) || 0;
    
    if (!name) {
        alert('Please enter item name');
        return;
    }
    
    editingItems.push({
        name: name,
        description: description,
        quantity: quantity,
        unitPrice: unitPrice,
        totalPrice: quantity * unitPrice,
        inventoryItemId: null,
        repairId: null,
        costPrice: 0,
        isCustomItem: true,
        itemType: 'Custom',
        itemStatus: 'In Stock',
        isTaxable: true
    });
    
    renderEditItems();
    recalculateEditTotals();
    $('#addItemModal').modal('hide');
}

// Save invoice changes
function saveInvoiceChanges() {
    if (!currentEditingSaleId) {
        alert('No invoice selected');
        return;
    }
    
    if (editingItems.length === 0) {
        alert('Invoice must have at least one item');
        return;
    }
    
    const customerId = $('#editCustomerSelect').val();
    const tax = parseFloat($('#editTax').val()) || 0;
    const paymentStatus = $('#editPaymentStatus').val();
    const paymentMethod = $('#editPaymentMethod').val();
    const changeReason = $('#editChangeReason').val().trim();
    if (!changeReason) { alert('Please enter a reason for this correction.'); return; }
    
    const updateData = {
        SaleId: currentEditingSaleId,
        CustomerId: customerId ? parseInt(customerId) : null,
        Items: editingItems.map(item => ({
            ItemName: item.name,
            Description: item.description,
            Quantity: item.quantity,
            UnitPrice: item.unitPrice,
            DiscountAmount: 0,
            CostPrice: item.costPrice,
            InventoryItemId: item.inventoryItemId,
            RepairId: item.repairId,
            IsCustomItem: item.isCustomItem,
            ItemType: item.itemType,
            ItemStatus: item.itemStatus,
            IsTaxable: item.isTaxable
        })),
        TaxAmount: tax,
        PaymentStatus: paymentStatus,
        ChangeReason: changeReason,
        Payments: [{
            Amount: editingPaymentAmount,
            PaymentMethod: paymentMethod,
            TransactionId: editingPaymentReference,
            ReferenceNumber: editingPaymentReference
        }]
    };
    
    $.ajax({
        url: '@Url.Action("UpdateSale", "POS")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(updateData),
        success: function(response) {
            if (response.success) {
                alert('Invoice updated successfully!');
                $('#invoiceEditModal').modal('hide');
                
                // Refresh the page or table
                if (typeof loadSalesData === 'function') {
                    loadSalesData(); // For Sales Report
                }
                location.reload(); // Fallback
            } else {
                alert('Error: ' + response.message);
            }
        },
        error: function(xhr) {
            console.error('Error saving invoice:', xhr);
            alert('Error saving invoice. Please try again.');
        }
    });
}

// Debounce helper
function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
        const later = () => {
            clearTimeout(timeout);
            func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
    };
}

// Initialize on document ready
$(document).ready(function() {
    initInvoiceEditModal();
});
</script>

