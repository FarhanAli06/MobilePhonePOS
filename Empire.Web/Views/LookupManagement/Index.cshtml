</div>

<!-- Device Model Modal -->
<div class="modal fade" id="deviceModelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deviceModelModalTitle">Add Device Model</h5>
