@{
    ViewData["Title"] = "Stock Movements";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="fas fa-exchange-alt me-2"></i>
        Stock Movements
    </h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <button type="button" class="btn btn-primary" onclick="showAddStockModal()">
            <i class="fas fa-plus me-1"></i>
            Add Stock (IN)
        </button>
        <button type="button" class="btn btn-warning ms-2" onclick="showAdjustStockModal()">
            <i class="fas fa-edit me-1"></i>
            Adjust Stock
        </button>
        <button type="button" class="btn btn-info ms-2" onclick="testSession()">
            <i class="fas fa-bug me-1"></i>
            Test Session
        </button>
    </div>
</div>

<!-- Session Debug Info -->
<div id="sessionDebug" class="alert alert-info" style="display:none;">
    <h5>Session Debug Info:</h5>
    <pre id="sessionData"></pre>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form id="filterForm" class="row g-3">
            <div class="col-md-3">
                <label for="filterType" class="form-label">Transaction Type</label>
                <select id="filterType" class="form-select">
                    <option value="">All Types</option>
                    <option value="IN">IN (Stock Added)</option>
                    <option value="OUT">OUT (Stock Used)</option>
                    <option value="ADJUSTMENT">Adjustment</option>
                    <option value="RETURN">Return</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="filterItem" class="form-label">Inventory Item</label>
                <select id="filterItem" class="form-select">
                    <option value="">All Items</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="filterDateFrom" class="form-label">From Date</label>
                <input type="date" id="filterDateFrom" class="form-control">
            </div>
            <div class="col-md-2">
                <label for="filterDateTo" class="form-label">To Date</label>
                <input type="date" id="filterDateTo" class="form-control">
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-primary w-100" onclick="applyFilters()">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Transactions Table -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="transactionsTable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Item</th>
                        <th>Type</th>
                        <th>Quantity</th>
                        <th>Unit Cost</th>
                        <th>Total Cost</th>
                        <th>Reference</th>
                        <th>Reason</th>
                        <th>Created By</th>
                    </tr>
                </thead>
                <tbody id="transactionsBody">
                    <tr>
                        <td colspan="9" class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Stock Modal -->
<div class="modal fade" id="addStockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>Add Stock (IN)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addStockForm">
                    <div class="mb-3">
                        <label for="addStockItem" class="form-label">Inventory Item *</label>
                        <select id="addStockItem" class="form-select" required>
                            <option value="">Select Item</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="addStockQuantity" class="form-label">Quantity *</label>
                        <input type="number" id="addStockQuantity" class="form-control" min="1" required>
                    </div>
                    <div class="mb-3">
                        <label for="addStockUnitCost" class="form-label">Unit Cost *</label>
                        <input type="number" id="addStockUnitCost" class="form-control" step="0.01" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label for="addStockReference" class="form-label">Reference (PO Number, etc.)</label>
                        <input type="text" id="addStockReference" class="form-control" placeholder="e.g., PO-2025-001">
                    </div>
                    <div class="mb-3">
                        <label for="addStockReason" class="form-label">Reason *</label>
                        <input type="text" id="addStockReason" class="form-control" placeholder="e.g., Purchase from Supplier XYZ" required>
                    </div>
                    <div class="mb-3">
                        <label for="addStockNotes" class="form-label">Notes</label>
                        <textarea id="addStockNotes" class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitAddStock()">
                    <i class="fas fa-save me-1"></i>Add Stock
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Adjust Stock Modal -->
<div class="modal fade" id="adjustStockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Adjust Stock</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="adjustStockForm">
                    <div class="mb-3">
                        <label for="adjustStockItem" class="form-label">Inventory Item *</label>
                        <select id="adjustStockItem" class="form-select" required onchange="loadCurrentStock()">
                            <option value="">Select Item</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Current Stock</label>
                        <input type="text" id="currentStock" class="form-control" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="adjustmentType" class="form-label">Adjustment Type *</label>
                        <select id="adjustmentType" class="form-select" required>
                            <option value="IN">Add Stock (+)</option>
                            <option value="OUT">Remove Stock (-)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="adjustStockQuantity" class="form-label">Quantity *</label>
                        <input type="number" id="adjustStockQuantity" class="form-control" min="1" required>
                    </div>
                    <div class="mb-3">
                        <label for="adjustStockReason" class="form-label">Reason *</label>
                        <input type="text" id="adjustStockReason" class="form-control" placeholder="e.g., Physical inventory count adjustment" required>
                    </div>
                    <div class="mb-3">
                        <label for="adjustStockNotes" class="form-label">Notes</label>
                        <textarea id="adjustStockNotes" class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="submitAdjustStock()">
                    <i class="fas fa-save me-1"></i>Adjust Stock
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        loadInventoryItems();
        loadTransactions();
    });
    
    function testSession() {
        $.ajax({
            url: '@Url.Action("TestSession", "InventoryTransactions")',
            type: 'GET',
            xhrFields: {
                withCredentials: true
            },
            success: function(response) {
                $('#sessionData').text(JSON.stringify(response, null, 2));
                $('#sessionDebug').show();
                console.log('Session Test Result:', response);
            },
            error: function(xhr, status, error) {
                $('#sessionData').text('Error: ' + error + '\n' + xhr.responseText);
                $('#sessionDebug').show();
                console.error('Session Test Error:', error);
            }
        });
    }

    function loadInventoryItems() {
        $.ajax({
            url: '@Url.Action("GetInventoryItems", "InventoryTransactions")',
            type: 'GET',
            xhrFields: {
                withCredentials: true  // Ensure cookies/session are sent
            },
            success: function(response) {
                if (response.success) {
                    const items = response.data;
                    const selects = ['#filterItem', '#addStockItem', '#adjustStockItem'];
                    
                    console.log('Loaded ' + items.length + ' inventory items');
                    
                    selects.forEach(function(selector) {
                        const $select = $(selector);
                        if (selector === '#filterItem') {
                            $select.html('<option value="">All Items</option>');
                        } else {
                            $select.html('<option value="">Select Item</option>');
                        }
                        
                        items.forEach(function(item) {
                            var activeStatus = item.isActive ? '' : ' [INACTIVE]';
                            $select.append(`<option value="${item.id}">${item.name} (Stock: ${item.stock})${activeStatus}</option>`);
                        });
                    });
                } else {
                    console.error('Error loading inventory items:', response.message);
                    alert('Error loading inventory items: ' + response.message);
                }
            },
            error: function(xhr, status, error) {
                console.error('AJAX error loading inventory items:', error);
                console.error('Response:', xhr.responseText);
                alert('Error loading inventory items. Please refresh the page.');
            }
        });
    }

    function loadTransactions() {
        const filters = {
            type: $('#filterType').val(),
            itemId: $('#filterItem').val(),
            dateFrom: $('#filterDateFrom').val(),
            dateTo: $('#filterDateTo').val()
        };

        $.get('@Url.Action("GetTransactions", "InventoryTransactions")', filters, function(response) {
            if (response.success) {
                displayTransactions(response.data);
            }
        });
    }

    function displayTransactions(transactions) {
        const tbody = $('#transactionsBody');
        tbody.empty();

        if (transactions.length === 0) {
            tbody.html('<tr><td colspan="9" class="text-center">No transactions found</td></tr>');
            return;
        }

        transactions.forEach(function(t) {
            const typeColors = {
                'IN': 'success',
                'OUT': 'danger',
                'ADJUSTMENT': 'warning',
                'RETURN': 'info'
            };

            const row = `
                <tr>
                    <td>${new Date(t.transactionDate).toLocaleString()}</td>
                    <td>${t.itemName}</td>
                    <td><span class="badge bg-${typeColors[t.transactionType]}">${t.transactionType}</span></td>
                    <td>${t.quantity}</td>
                    <td>$${t.unitCost.toFixed(2)}</td>
                    <td>$${t.totalCost.toFixed(2)}</td>
                    <td>${t.referenceNumber || '-'}</td>
                    <td>${t.reason || '-'}</td>
                    <td>${t.createdBy || '-'}</td>
                </tr>
            `;
            tbody.append(row);
        });
    }

    function applyFilters() {
        loadTransactions();
    }

    function showAddStockModal() {
        $('#addStockForm')[0].reset();
        $('#addStockModal').modal('show');
    }

    function showAdjustStockModal() {
        $('#adjustStockForm')[0].reset();
        $('#currentStock').val('');
        $('#adjustStockModal').modal('show');
    }

    function loadCurrentStock() {
        const itemId = $('#adjustStockItem').val();
        if (!itemId) {
            $('#currentStock').val('');
            return;
        }

        const selectedOption = $('#adjustStockItem option:selected').text();
        const stockMatch = selectedOption.match(/Stock: (\d+)/);
        if (stockMatch) {
            $('#currentStock').val(stockMatch[1]);
        }
    }

    function submitAddStock() {
        const form = $('#addStockForm')[0];
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const data = {
            inventoryItemId: $('#addStockItem').val(),
            quantity: $('#addStockQuantity').val(),
            unitCost: $('#addStockUnitCost').val(),
            referenceNumber: $('#addStockReference').val(),
            reason: $('#addStockReason').val(),
            notes: $('#addStockNotes').val()
        };

        $.post('@Url.Action("AddStock", "InventoryTransactions")', data, function(response) {
            if (response.success) {
                $('#addStockModal').modal('hide');
                alert('Stock added successfully!');
                loadInventoryItems();
                loadTransactions();
            } else {
                alert('Error: ' + response.message);
            }
        }).fail(function() {
            alert('Error adding stock');
        });
    }

    function submitAdjustStock() {
        const form = $('#adjustStockForm')[0];
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const data = {
            inventoryItemId: $('#adjustStockItem').val(),
            transactionType: $('#adjustmentType').val(),
            quantity: $('#adjustStockQuantity').val(),
            reason: $('#adjustStockReason').val(),
            notes: $('#adjustStockNotes').val()
        };

        $.post('@Url.Action("AdjustStock", "InventoryTransactions")', data, function(response) {
            if (response.success) {
                $('#adjustStockModal').modal('hide');
                alert('Stock adjusted successfully!');
                loadInventoryItems();
                loadTransactions();
            } else {
                alert('Error: ' + response.message);
            }
        }).fail(function() {
            alert('Error adjusting stock');
        });
    }
</script>
}
