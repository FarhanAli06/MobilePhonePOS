@model IEnumerable<Empire.Web.DTOs.User.UserDto>
@{
    ViewData["Title"] = "User Management";
    var currentShopId = Context.Session.GetInt32("CurrentShopId") ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users-cog me-2"></i>User Management</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-user-plus me-2"></i>Add New User
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search / Filter -->
<div class="card mb-4">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-1">Search</label>
                <input type="text" id="searchInput" class="form-control" placeholder="Name, username or email…">
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Status</label>
                <select id="statusFilter" class="form-select">
                    <option value="">All</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" onclick="applyFilter()">
                    <i class="fas fa-search me-1"></i>Filter
                </button>
            </div>
            <div class="col-md-2">
                <button class="btn btn-secondary w-100" onclick="clearFilter()">
                    <i class="fas fa-times me-1"></i>Clear
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Users Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0" id="usersTable">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    @if (Model != null && Model.Any())
                    {
                        var idx = 1;
                        foreach (var user in Model)
                        {
                            var roleDisplay = user.ShopRoles.FirstOrDefault(r => r.ShopId == currentShopId)?.RoleName
                                           ?? user.ShopRoles.FirstOrDefault(r => r.ShopId == currentShopId)?.Role
                                           ?? user.ShopRoles.FirstOrDefault()?.RoleName
                                           ?? user.ShopRoles.FirstOrDefault()?.Role
                                           ?? "—";
                            <tr class="user-row" data-name="@($"{user.FirstName} {user.LastName}".ToLower())" data-username="@user.Username.ToLower()" data-email="@user.Email.ToLower()" data-active="@user.IsActive.ToString().ToLower()">
                                <td>@(idx++)</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;font-size:.85rem;font-weight:600;flex-shrink:0;">
                                            @(string.IsNullOrWhiteSpace(user.FirstName) ? user.Username.Substring(0,1).ToUpper() : user.FirstName.Substring(0,1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@($"{user.FirstName} {user.LastName}".Trim())</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="font-monospace text-muted">@user.Username</span></td>
                                <td>@user.Email</td>
                                <td>@(user.Phone ?? "—")</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(roleDisplay) && roleDisplay != "—")
                                    {
                                        <span class="badge bg-info text-dark">@roleDisplay</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-ban me-1"></i>Inactive</span>
                                    }
                                </td>
                                <td><small class="text-muted">@user.CreatedDate.ToString("MMM dd, yyyy")</small></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" title="Delete"
                                                onclick="confirmDelete(@user.Id, '@user.Username')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyRow">
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="fas fa-users" style="font-size:48px;opacity:.2"></i>
                                <p class="mt-2">No users found. <a asp-action="Create">Add the first user</a>.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center py-2">
        <small class="text-muted" id="rowCount">
            Showing <span id="visibleCount">@(Model?.Count() ?? 0)</span> of @(Model?.Count() ?? 0) users
        </small>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-trash me-2"></i>Delete User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="deleteUsername"></strong>?</p>
                <p class="text-danger small"><i class="fas fa-exclamation-triangle me-1"></i>This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteUserId" name="id" value="" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var totalCount = @(Model?.Count() ?? 0);

    function applyFilter() {
        var search = $('#searchInput').val().toLowerCase().trim();
        var status = $('#statusFilter').val();
        var visible = 0;

        $('.user-row').each(function() {
            var name     = $(this).data('name') || '';
            var username = $(this).data('username') || '';
            var email    = $(this).data('email') || '';
            var active   = $(this).data('active');  // "true" or "false"

            var matchSearch = !search ||
                name.includes(search) ||
                username.includes(search) ||
                email.includes(search);

            var matchStatus = !status ||
                (status === 'active'   && active === 'true') ||
                (status === 'inactive' && active === 'false');

            if (matchSearch && matchStatus) {
                $(this).show();
                visible++;
            } else {
                $(this).hide();
            }
        });

        $('#visibleCount').text(visible);
        $('#emptyRow').toggle(visible === 0 && totalCount > 0);
    }

    function clearFilter() {
        $('#searchInput').val('');
        $('#statusFilter').val('');
        applyFilter();
    }

    function confirmDelete(userId, username) {
        $('#deleteUserId').val(userId);
        $('#deleteUsername').text(username);
        var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    // Live search on keyup
    $('#searchInput').on('keyup', function() { applyFilter(); });
    $('#statusFilter').on('change', function() { applyFilter(); });
</script>
}
