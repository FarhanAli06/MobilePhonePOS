            $('#searchContainer').hide();
            $('#inventoryContainer').hide();
            $('#deviceSearchContainer').show();
            
            // Load dropdowns if not already loaded
            if ($('#deviceBrand option').length === 1) {
                loadDeviceDropdowns();
