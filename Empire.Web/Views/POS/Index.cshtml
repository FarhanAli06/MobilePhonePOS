                        <div class="product-price">$${(item.Price || 0).toFixed(2)}</div>
                        <button class="btn btn-sm btn-danger" onclick="removeFromCartAndRefresh(${cartIndex})">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>
                </div>
            `);
            
            container.append(card);
        });
    }

    // Fill custom item fields with quick suggestions
    function fillCustomItem(itemName, defaultPrice) {
        $('#customItemName').val(itemName);
        $('#customItemPrice').val(defaultPrice.toFixed(2));
        $('#customItemQuantity').val(1);
        $('#customItemName').focus();
    }

    function addCustomItemToCart() {
        const name = $('#customItemName').val();
        const quantity = parseInt($('#customItemQuantity').val());
        const cost = parseFloat($('#customItemCost').val()) || 0;
        const price = parseFloat($('#customItemPrice').val());
        const note = $('#customItemNote').val();

        if (!name || quantity <= 0 || price < 0) {
            alert('Please enter a valid item name, quantity, and price.');
            return;
        }

        const customItem = {
            Id: 'custom_' + Date.now(),
            Type: 'Custom',
            Name: name,
            Description: 'Custom Sale Item',
            Price: price,
            OriginalPrice: price,
            Cost: cost,
            quantity: quantity,
            Note: note,
            ReferenceId: null
        };

        cart.push(customItem);
        updateCart();
        
        // Display added item in the custom items list
        displayCustomItem(customItem);

        // Reset form
        $('#customItemName').val('');
        $('#customItemQuantity').val('1');
        $('#customItemCost').val('0.00');
        $('#customItemPrice').val('0.00');
        $('#customItemNote').val('');
        
        // Focus back to item name for quick entry
        $('#customItemName').focus();
        
        // Keep custom sale tab active instead of switching to all items
        // filterByType(''); // Commented out to stay on custom sale tab
    }
    
    // Display added custom item in the list
    function displayCustomItem(item) {
        // Show the custom items list section
        $('#customItemsList').show();
        
        // Calculate profit
        const profit = (item.Price - item.Cost) * item.quantity;
        const profitColor = profit > 0 ? 'text-success' : (profit < 0 ? 'text-danger' : 'text-muted');
        
        // Create item card
        const itemHtml = `
            <div class="card mb-2" id="customItem_${item.Id}">
                <div class="card-body p-2">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <strong>${item.Name}</strong>
                        </div>
                        <div class="col-md-1 text-center">
                            <small class="text-muted">Qty: ${item.quantity}</small>
                        </div>
                        <div class="col-md-2">
                            <small class="text-muted">Cost: $${item.Cost.toFixed(2)}</small>
                        </div>
                        <div class="col-md-2">
                            <small class="text-muted">Price: $${item.Price.toFixed(2)}</small>
                        </div>
                        <div class="col-md-2">
                            <small class="${profitColor}">Profit: $${profit.toFixed(2)}</small>
                        </div>
                        <div class="col-md-2 text-end">
                            <button class="btn btn-danger btn-sm" onclick="removeCustomItem('${item.Id}')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    ${item.Note ? `<div class="row mt-1"><div class="col-12"><small class="text-muted"><i class="fas fa-sticky-note me-1"></i>${item.Note}</small></div></div>` : ''}
                </div>
            </div>
        `;
        
        $('#customItemsContainer').append(itemHtml);
    }
    
    // Remove custom item from display and cart
    function removeCustomItem(itemId) {
        // Remove from cart
        const index = cart.findIndex(item => item.Id === itemId);
        if (index >= 0) {
            cart.splice(index, 1);
            updateCart();
        }
        
        // Remove from display
        $(`#customItem_${itemId}`).remove();
        
        // Hide list if no items
        if ($('#customItemsContainer').children().length === 0) {
            $('#customItemsList').hide();
        }
    }

    function addToCart(product) {
        console.log('addToCart called with product:', product);
        // Check if item already in cart
        const existingIndex = cart.findIndex(item => item.Id === product.Id);
        
        if (existingIndex >= 0) {
            // Increase quantity for inventory items
            if (product.Type === 'Inventory') {
                cart[existingIndex].quantity++;
            } else {
                alert('This item is already in the cart');
                return;
            }
        } else {
            // Parse ReferenceId safely
            let referenceId = null;
            if (product.Id && typeof product.Id === 'string' && product.Id.includes('_')) {
                referenceId = parseInt(product.Id.split('_')[1]);
            } else if (typeof product.Id === 'number') {
                referenceId = product.Id;
            }
            
            // Ensure Name and Price are never undefined
            const itemName = product.Name || product.name || 'Unknown Item';
            const itemPrice = parseFloat(product.Price || product.price || 0);
            const itemDescription = product.Description || product.description || '';
            
            // Extract RepairId if it exists in product or if Id starts with 'rep_'
            let repairId = product.RepairId || product.repairId || null;
            if (!repairId && product.Id && typeof product.Id === 'string' && product.Id.startsWith('rep_')) {
                repairId = parseInt(product.Id.split('_')[1]);
            }

            cart.push({
                Id: product.Id || `custom_${Date.now()}`,
                Type: product.Type || 'Custom',
                Name: itemName,
                Description: itemDescription,
                Price: itemPrice,
                OriginalPrice: itemPrice,
                Cost: parseFloat(product.Cost || product.cost || 0),
                quantity: product.quantity || 1,
                ReferenceId: referenceId,
                RepairId: repairId,
                Note: product.Note || product.note || '',
                IsCustomItem: product.Type === 'Custom',
                IsTaxable: true
            });
        }

        updateCart();
        
        // Refresh the current tab display to show the newly added item
        if (currentFilter !== 'custom' && currentFilter !== 'search') {
            displayCartItems(currentFilter);
        }
    }

    function removeFromCart(index) {
        cart.splice(index, 1);
        updateCart();
        saveCartToStorage();
    }
    
    function removeFromCartAndRefresh(index) {
        cart.splice(index, 1);
        updateCart();
        saveCartToStorage();
        
        // Refresh the current tab display
        if (currentFilter !== 'custom' && currentFilter !== 'search') {
            displayCartItems(currentFilter);
        }
    }

    function updateQuantity(index, delta) {
        const item = cart[index];
        
        if (item.Type !== 'Inventory' && item.Type !== 'Custom') {
            alert('Quantity can only be changed for inventory items');
            return;
        }

        item.quantity += delta;
        
        if (item.quantity < 1) {
            item.quantity = 1;
        }

        updateCart();
    }

    function updatePrice(index, newPrice) {
        cart[index].Price = parseFloat(newPrice) || 0;
        updateCart();
    }

    // ── Tax UI handlers ──────────────────────────────────────────────────────
    function onPosTaxModeChange() {
        var mode = document.querySelector('input[name="posTaxMode"]:checked').value;
        var wrapper = document.getElementById('posTaxRateWrapper');
        var hidden  = document.getElementById('posTaxRateHidden');
        if (mode === 'apply') {
            wrapper.style.display = 'flex';
            hidden.value = document.getElementById('posTaxRate').value || '10.25';
        } else {
            wrapper.style.display = 'none';
            hidden.value = '0';
        }
        updateSummary();
    }
    function onPosTaxRateInput() {
        var mode = document.querySelector('input[name="posTaxMode"]:checked').value;
        if (mode === 'apply') {
            document.getElementById('posTaxRateHidden').value = document.getElementById('posTaxRate').value || '0';
        }
        updateSummary();
    }
    // ────────────────────────────────────────────────────────────────────────

    function updateCart() {
        const tableBody = $('#cartTableBody');
        const emptyMessage = $('#emptyCartMessage');
        const cartTable = $('#cartTable');

        tableBody.empty();
        if (cart.length === 0) {
            cartTable.hide();
            emptyMessage.show();
            $('#cartCount').text('0');
        } else {
            emptyMessage.hide();
            cartTable.show();

            cart.forEach(function(item, index) {
                if (!item || typeof item !== 'object') return;

                item.Name          = item.Name          || 'Unknown Item';
                item.Description   = item.Description   || '';
                item.Price         = parseFloat(item.Price)         || 0;
                item.OriginalPrice = parseFloat(item.OriginalPrice) || item.Price;
                item.Cost          = parseFloat(item.Cost)          || 0;
                item.quantity      = parseInt(item.quantity)        || 1;
                item.Type          = item.Type                      || 'Custom';

                const itemTotal    = item.Price * item.quantity;
                const priceChanged = item.Price !== item.OriginalPrice;

                const typeColour = { 'Inventory': 'primary', 'Device': 'info', 'Repair': 'warning', 'Custom': 'secondary' }[item.Type] || 'secondary';
                const canChangeQty = (item.Type === 'Inventory' || item.Type === 'Custom');

                const row = $(`
                    <tr style="vertical-align:middle;">
                        <td style="max-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                            <div class="d-flex align-items-start gap-1">
                                <span class="badge bg-${typeColour} mt-1 flex-shrink-0" style="font-size:0.65rem;">${item.Type}</span>
                                <div style="min-width:0;">
                                    <div class="fw-semibold text-truncate" style="font-size:0.85rem;" title="${item.Name}">${item.Name}</div>
                                    ${item.Description ? '<div class="text-muted text-truncate" style="font-size:0.75rem;">' + item.Description + '</div>' : ''}
                                    ${priceChanged ? '<small class="text-warning" style="font-size:0.72rem;"><i class="fas fa-tag me-1"></i>Was $' + (item.OriginalPrice||0).toFixed(2) + '</small>' : ''}
                                    ${item.Cost > 0 ? '<small class="text-muted" style="font-size:0.72rem;">Cost: $' + item.Cost.toFixed(2) + '</small>' : ''}
                                </div>
                            </div>
                        </td>
                        <td style="white-space:nowrap;">
                            <div class="input-group input-group-sm" style="width:90px;">
                                <span class="input-group-text p-1">$</span>
                                <input type="number" class="form-control form-control-sm p-1 text-end"
                                    value="${item.Price.toFixed(2)}"
                                    onchange="updatePrice(${index}, this.value)"
                                    step="0.01" min="0" style="font-size:0.82rem;">
                            </div>
                        </td>
                        <td style="white-space:nowrap;">
                            ${canChangeQty ? '<div class="input-group input-group-sm" style="width:90px;"><button class="btn btn-outline-secondary btn-sm px-2" onclick="updateQuantity(' + index + ',-1)">−</button><input type="number" class="form-control text-center p-0" value="' + item.quantity + '" min="1" onchange="updateQuantityDirect(' + index + ', this.value)" style="font-size:0.82rem;width:32px;"><button class="btn btn-outline-secondary btn-sm px-2" onclick="updateQuantity(' + index + ',1)">+</button></div>' : '<span class="badge bg-light text-dark border">' + item.quantity + '</span>'}
                        </td>
                        <td class="fw-bold text-success" style="white-space:nowrap;font-size:0.9rem;">$${itemTotal.toFixed(2)}</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger px-2" onclick="removeFromCart(${index})" title="Remove item">
                                <i class="fas fa-times"></i>
                            </button>
                        </td>
                    </tr>
                `);
                tableBody.append(row);
            });

            const grandTotal = cart.reduce((s,i)=>s+(parseFloat(i.Price)||0)*(parseInt(i.quantity)||1),0);
            tableBody.append('<tr class="table-light fw-bold border-top"><td colspan="3" class="text-end pe-2" style="font-size:0.85rem;">Grand Total</td><td class="text-success" style="font-size:0.95rem;">$' + grandTotal.toFixed(2) + '</td><td></td></tr>');

            $('#cartCount').text(cart.length);
        }
        updateSummary();
        saveCartToStorage();
    }

    function updateQuantityDirect(index, val) {
        const qty = parseInt(val);
        if (!isNaN(qty) && qty >= 1) {
            cart[index].quantity = qty;
            updateCart();
        }
    }

    // ── POS Payment Icon Card Logic ──────────────────────────────────────────
    var posPayments = []; // array of { method, amount }

    function selectPosPaymentMethod(method, el) {
        document.querySelectorAll('.pos-pm-card').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        document.getElementById('paymentMethod').value = method;
        updateSummary();
    }

    function posAddAnotherPayment() { posAddPaymentLine(); }  // backward compat alias

    function posAddPaymentLine() {
        var total = cart.reduce((s,i)=>s+(parseFloat(i.Price)||0)*(parseInt(i.quantity)||1),0);
        var entered = parseFloat($('#paymentAmount').val()) || 0;
        if (entered <= 0) {
            // If no amount entered, treat as full remaining payment
            var alreadyPaid = posPayments.reduce((s,p)=>s+p.amount,0);
            entered = Math.max(0, total - alreadyPaid);
            if (entered <= 0) { showPosNotif('Cart total is already covered by added payments.', 'info'); return; }
        }
        var method = document.getElementById('paymentMethod').value;
        posPayments.push({ method: method, amount: entered });
        renderPosPaymentHistory();
        var remaining = Math.max(0, total - posPayments.reduce((s,p)=>s+p.amount,0));
        if (remaining > 0.005) {
            $('#paymentAmount').val(remaining.toFixed(2)).attr('placeholder', '0.00');
            showPosNotif('$' + entered.toFixed(2) + ' via ' + method + ' added. $' + remaining.toFixed(2) + ' remaining.', 'success');
        } else {
            $('#paymentAmount').val('').attr('placeholder', '0.00');
            showPosNotif('$' + entered.toFixed(2) + ' via ' + method + ' added. Fully paid!', 'success');
        }
        updateSummary();
    }

    function showPosNotif(msg, type) {
        // Show a small toast-like notification in the cart panel
        var el = document.getElementById('posCartNotif');
        if (!el) {
            el = document.createElement('div');
            el.id = 'posCartNotif';
            el.style.cssText = 'position:fixed;bottom:80px;right:20px;z-index:9999;max-width:300px;';
            document.body.appendChild(el);
        }
        var colors = { success: '#28a745', danger: '#dc3545', info: '#0d6efd', warning: '#ffc107' };
        el.innerHTML = '<div style="background:' + (colors[type]||'#333') + ';color:#fff;padding:10px 16px;border-radius:8px;font-size:13px;box-shadow:0 4px 12px rgba(0,0,0,.2);">' + msg + '</div>';
        el.style.display = 'block';
        setTimeout(function(){ el.style.display = 'none'; }, 2500);
    }

    function removePosPayment(idx) {
        posPayments.splice(idx, 1);
        renderPosPaymentHistory();
        updateSummary();
    }

    function renderPosPaymentHistory() {
        var html = posPayments.map((p,i) =>
            '<div class="pos-payment-row">'
            + '<span class="pm-method"><i class="fas fa-money-bill-wave me-1" style="font-size:10px;"></i>' + p.method + '</span>'
            + '<span class="pm-amount">$' + p.amount.toFixed(2) + '</span>'
            + '<span class="remove-pm" onclick="removePosPayment(' + i + ')" title="Remove this payment">&#x2715;</span>'
            + '</div>'
        ).join('');
        $('#posPaymentHistoryList').html(html);
        var totalPaidSoFar = posPayments.reduce((s,p)=>s+p.amount, 0);
        if (posPayments.length > 0) {
            $('#posPaymentHistorySection').show();
            $('#posPaymentsTotalAmt').text('$' + totalPaidSoFar.toFixed(2));
        } else {
            $('#posPaymentHistorySection').hide();
        }
    }
    // ─────────────────────────────────────────────────────────────────────────

    function updateSummary() {
        const subtotal = cart.reduce((sum, item) => {
            return sum + (parseFloat(item.Price)||0) * (parseInt(item.quantity)||1);
        }, 0);
        const taxRate   = parseFloat(document.getElementById('posTaxRateHidden').value) || 0;
        const tax      = subtotal * (taxRate / 100);
        const discount = parseFloat(document.getElementById('discountInput').value) || 0;
        const total    = subtotal + tax - discount;

        $('#subtotal').text('$' + subtotal.toFixed(2));
        $('#tax').text('$' + tax.toFixed(2));
        $('#taxRateDisplay').text(taxRate.toFixed(2));
        $('#discount').text('-$' + discount.toFixed(2));
        $('#total').text('$' + total.toFixed(2));
        // Update cart header subtotal label
        var cartSubLbl = document.getElementById('cartSubtotalLabel');
        if (cartSubLbl) cartSubLbl.textContent = 'Subtotal: $' + subtotal.toFixed(2);

        // New payment logic: use posPayments array + current amount input
        var historyPaid = posPayments.reduce((s,p)=>s+p.amount, 0);
        var currentEntered = parseFloat($('#paymentAmount').val()) || 0;
        var totalPaid = historyPaid + currentEntered;
        var balance = Math.max(0, total - totalPaid);

        $('#balance').text('$' + balance.toFixed(2));
        $('#balanceRow').css('display', balance > 0.005 ? 'flex' : 'none');

        if (balance > 0.005 && currentEntered > 0) {
            $('#posRemainingHint').show();
            $('#posRemainingAmt').text('$' + balance.toFixed(2));
        } else {
            $('#posRemainingHint').hide();
        }

        // Update payment type hidden select
        if (totalPaid <= 0) {
            $('#paymentType').val('full');
            $('#paymentStatusBadge').removeClass('bg-warning bg-danger text-dark').addClass('bg-success').html('<i class="fas fa-check-circle me-1"></i>Paid in Full');
        } else if (totalPaid >= total - 0.005) {
            $('#paymentType').val('full');
            $('#paymentStatusBadge').removeClass('bg-warning bg-danger text-dark').addClass('bg-success').html('<i class="fas fa-check-circle me-1"></i>Paid in Full');
        } else {
            $('#paymentType').val('partial');
            $('#paymentStatusBadge').removeClass('bg-success bg-danger').addClass('bg-warning text-dark').html('<i class="fas fa-adjust me-1"></i>Partial – $' + balance.toFixed(2) + ' due');
        }
    }

    function clearCart() {
        if (cart.length === 0) return;
        
        if (confirm('Are you sure you want to clear the cart?')) {
            cart = [];
            updateCart();
            saveCartToStorage();
            // Refresh the page to reset everything
            location.reload();
        }
    }

    // Reset payment UI helper
    function resetPosPaymentUI() {
        posPayments = [];
        renderPosPaymentHistory();
        $('#paymentAmount').val('').attr('placeholder','Leave blank for full payment');
        $('#posRemainingHint').hide();
        document.querySelectorAll('.pos-pm-card').forEach(c => c.classList.remove('active'));
        var cashCard = document.querySelector('.pos-pm-card[data-method="Cash"]');
        if (cashCard) cashCard.classList.add('active');
        document.getElementById('paymentMethod').value = 'Cash';
        $('#paymentStatusBadge').removeClass('bg-warning bg-danger text-dark').addClass('bg-success').html('<i class="fas fa-check-circle me-1"></i>Paid in Full');
    }

    function completeSaleUnpaid() {
        if (cart.length === 0) {
            alert('Cart is empty. Please add items first.');
            return;
        }
        const customerId = $('#customerSelect').val();
        if (!customerId) {
            alert('Please select a customer');
            $('#customerSelect').focus();
            return;
        }
        if (!confirm('Save this sale as Unpaid? No payment will be recorded.')) return;

        const subtotal = cart.reduce((sum, item) => sum + (item.Price * item.quantity), 0);
        const totalAmount = subtotal;

        const saleData = {
            CustomerId: parseInt(customerId),
            Items: cart.map(item => ({
                ItemType: item.Type,
                ItemReferenceId: item.ReferenceId,
                RepairId: item.RepairId,
                InventoryItemId: item.Type === 'Inventory' ? item.ReferenceId : null,
                ItemName: item.Name,
                Description: item.Description,
                Quantity: item.quantity,
                UnitPrice: item.Price,
                TotalPrice: item.Price * item.quantity,
                Cost: item.Cost || 0,
                DiscountAmount: 0,
                Note: item.Note || '',
                IsCustomItem: item.Type === 'Custom',
                IsTaxable: item.IsTaxable,
                OriginalPrice: item.OriginalPrice,
            })),
            SubTotal: subtotal,
            TaxAmount: 0,
            DiscountAmount: 0,
            TotalAmount: totalAmount,
            PaymentStatus: 'Unpaid',
            Payments: []
        };

        $('#completeSaleBtn').prop('disabled', true);
        $('#saveUnpaidBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');

        $.ajax({
            url: '@Url.Action("CompleteSale", "POS")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(saleData),
            success: function(response) {
                if (response.success) {
                    $('#invoiceNumber').text(response.invoiceNumber);
                    lastInvoiceNumber = response.invoiceNumber;
                    lastSaleData = { items: Object.assign([], cart), paymentStatus: 'Unpaid', totalAmount: totalAmount };
                    window.lastSaleId = response.saleId;
                    $('#printLastInvoiceBtn').prop('disabled', false);
                    $('#paymentStatusMsg').html('<small class="text-danger"><i class="fas fa-clock me-1"></i>Saved as Unpaid — $' + totalAmount.toFixed(2) + ' due</small>');
                    $('#successModal').modal('show');
                    cart = [];
                    updateCart();
                    saveCartToStorage();
                    $('#customerSelect').val(null).trigger('change');
                    selectedCustomerId = null;
                    posPayments = [];
                    renderPosPaymentHistory();
                    updateSummary();
                } else {
                    alert('Error saving sale: ' + (response.message || 'Unknown error'));
                }
            },
            error: function(xhr) {
                alert('Error saving sale. Please try again.');
            },
            complete: function() {
                $('#completeSaleBtn').prop('disabled', false);
                $('#saveUnpaidBtn').prop('disabled', false).html('<i class="fas fa-clock me-1"></i>Unpaid');
            }
        });
    }

    function completeSale() {
        // Validation
        if (cart.length === 0) {
            alert('Cart is empty. Please add items first.');
            return;
        }

        const customerId = $('#customerSelect').val();
        if (!customerId) {
            alert('Please select a customer');
            $('#customerSelect').focus();
            return;
        }

        const paymentType = $('#paymentType').val();
        const paymentMethod = document.getElementById('paymentMethod').value;

        // Calculate totals
        const subtotal = cart.reduce((sum, item) => sum + (item.Price * item.quantity), 0);
        const taxRate = parseFloat(document.getElementById('posTaxRateHidden').value) || 0;
        const taxAmount = subtotal * (taxRate / 100);
        const discountAmount = parseFloat(document.getElementById('discountInput').value) || 0;
        const totalAmount = subtotal + taxAmount - discountAmount;
        
        // Build payments array from posPayments history + current amount input
        var currentEnteredAmt = parseFloat($('#paymentAmount').val()) || 0;
        var allPayments = posPayments.slice(); // copy history
        if (currentEnteredAmt > 0) {
            allPayments.push({ method: paymentMethod, amount: currentEnteredAmt });
        } else if (allPayments.length === 0) {
            // No amount entered = full payment with selected method
            allPayments.push({ method: paymentMethod, amount: totalAmount });
        }

        var totalPaidAmt = allPayments.reduce((s,p)=>s+p.amount, 0);
        if (totalPaidAmt <= 0) {
            alert('Please enter a payment amount');
            $('#paymentAmount').focus();
            return;
        }

        let paymentStatus = totalPaidAmt >= totalAmount - 0.005 ? 'Paid' : 'Partial';
        let paymentAmount = totalPaidAmt;

        // Prepare payments array
        const payments = allPayments.map(p => ({
            Amount: p.amount,
            PaymentMethod: p.method,
            TransactionId: ''
        }));

        // Prepare sale data
        const saleData = {
            CustomerId: parseInt(customerId),
            Items: cart.map(item => ({
                ItemType: item.Type,
                ItemReferenceId: item.ReferenceId,
                RepairId: item.RepairId,
                InventoryItemId: item.Type === 'Inventory' ? item.ReferenceId : null,
                ItemName: item.Name,
                Description: item.Description,
                Quantity: item.quantity,
                UnitPrice: item.Price,
                TotalPrice: item.Price * item.quantity,
                Cost: item.Cost || 0,
                DiscountAmount: 0,
                Note: item.Note || '',
                IsCustomItem: item.Type === 'Custom',
                IsTaxable: item.IsTaxable,
                OriginalPrice: item.OriginalPrice,
            })),
            SubTotal: subtotal,
            TaxAmount: taxAmount,
            DiscountAmount: discountAmount,
            TotalAmount: totalAmount,
            PaymentStatus: paymentStatus,
            Payments: payments
        };

        // Submit sale
        $.ajax({
            url: '@Url.Action("CompleteSale", "POS")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(saleData),
            success: function(response) {
                if (response.success) {
                    // Store sale data for printing (before clearing cart)
                    const secondPaymentMethodVal = $('#secondPaymentMethod').val();
                    let paymentMethodDisplay = paymentMethod;
                    if (secondPaymentMethodVal) {
                        paymentMethodDisplay = `${paymentMethod} ($${paymentAmount.toFixed(2)}) + ${secondPaymentMethodVal} ($${(totalAmount - paymentAmount).toFixed(2)})`;
                    }
                    
                    // Prepare sale data
                    const customer = $('#customerSelect').select2('data')[0];
                    const customerName = customer ? customer.text : 'Walk-in Customer';
                    
                    const saleData = {
                        items: Object.assign([], cart),
                        customerId: customerId,
                        customerName: customerName,
                        paymentMethod: paymentMethod,
                        paymentStatus: paymentStatus,
                        totalAmount: totalAmount,
                        paymentAmount: paymentAmount
                    };
                    
                    $('#invoiceNumber').text(response.invoiceNumber);
                    
                    // Save last invoice data for printing
                    lastInvoiceNumber = response.invoiceNumber;
                    lastSaleData = saleData;
                    window.lastSaleId = response.saleId; // Store sale ID for invoice printing
                    
                    // Enable print button
                    $('#printLastInvoiceBtn').prop('disabled', false);
                    
                    if (paymentStatus === 'Partial') {
                        const balance = totalAmount - paymentAmount;
                        $('#paymentStatusMsg').html(`<small class="text-warning">Partial Payment: $${paymentAmount.toFixed(2)} paid, $${balance.toFixed(2)} remaining</small>`);
                    } else if (secondPaymentMethodVal) {
                        $('#paymentStatusMsg').html(`<small class="text-success">Fully Paid (${paymentMethod}: $${paymentAmount.toFixed(2)}, ${secondPaymentMethodVal}: $${(totalAmount - paymentAmount).toFixed(2)})</small>`);
                    } else {
                        $('#paymentStatusMsg').html('<small class="text-success">Fully Paid</small>');
                    }
                    
                    $('#successModal').modal('show');
                    
                    // Clear cart
                    cart = [];
                    updateCart();
                    saveCartToStorage();
                    
                    // Reset form
                    $('#customerSelect').val(null).trigger('change');
                    selectedCustomerId = null;
                    resetPosPaymentUI();
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function(xhr) {
                console.error('Error completing sale:', xhr);
                alert('Error completing sale. Please try again.');
            }
        });
    }

    function printLastInvoice() {
        // If we have a recent sale in memory, use it
        if (window.lastSaleId) {
            printInvoiceById(window.lastSaleId);
            return;
        }
        
        // Otherwise, fetch the most recent invoice from the server
        $.ajax({
            url: '@Url.Action("GetLastInvoice", "POS")',
            type: 'GET',
            success: function(response) {
                if (response.success && response.saleId) {
                    window.lastSaleId = response.saleId;
                    printInvoiceById(response.saleId);
                } else {
                    alert('No invoices found. Please complete a sale first.');
                }
            },
            error: function(xhr) {
                console.error('Error fetching last invoice:', xhr);
                alert('Error loading last invoice. Please try again.');
            }
        });
    }
    
    function printCurrentInvoice() {
        // Print the invoice from the success modal after completing a sale
        if (!window.lastSaleId) {
            alert('No invoice to print. Please complete a sale first.');
            return;
        }
        
        printInvoiceById(window.lastSaleId);
    }
    
    function printInvoiceWithData(invoiceNumber, saleData) {
        if (!invoiceNumber) {
            alert('Invoice number not available');
            return;
        }
        
        // Get the sale ID from the last completed sale
        // We'll need to store this when the sale completes
        if (!window.lastSaleId) {
            alert('Sale ID not available. Please try again.');
            return;
        }
        
        // Fetch complete invoice data from server
        $.ajax({
            url: '@Url.Action("GetInvoiceData", "POS")',
            type: 'GET',
            data: { saleId: window.lastSaleId },
            success: function(response) {
                if (response.success) {
                    generateAndPrintInvoice(response);
                } else {
                    alert('Error loading invoice: ' + response.message);
                }
            },
            error: function(xhr) {
                console.error('Error fetching invoice data:', xhr);
                alert('Error loading invoice data. Please try again.');
            }
        });
    }
    
    function generateAndPrintInvoice(data) {
        const shop = data.shop;
        const invoice = data.invoice;
        const customer = data.customer;
        const items = data.items;
        const totals = data.totals;
        const payment = data.payment;
        
        // Prepare invoice data for shared template
        const invoiceData = {
            // Company/Shop info
            companyName: shop.name,
            shopName: shop.name,
            shopEmail: shop.email || '',
            shopAddress: shop.address || '',
            shopCity: shop.city || '',
            shopState: shop.state || '',
            shopZip: shop.zipCode || '',
            shopPhone: shop.phone || '',
            shopLogo: shop.logoPath || '',
            
            // Customer info
            customerName: customer.name || 'Walk-in Customer',
            customerEmail: customer.email || '',
            customerAddress: customer.address || '',
            customerPhone: customer.phone || '',
            
            // Invoice info
            invoiceNumber: invoice.number,
            invoiceDate: window.TimezoneHelper ? window.TimezoneHelper.formatLongDate(new Date(invoice.date)) : invoice.date,
            
            // Items
            items: items.map(item => ({
                name: item.name,
                description: item.description,
                details: item.details || '',
                itemType: item.type || 'N/A',
                quantity: item.quantity,
                unitPrice: item.unitPrice,
                totalPrice: item.totalPrice
            })),
            
            // Totals
            subtotal: totals.subtotal,
            tax: totals.tax,
            discount: totals.discount,
            totalAmount: totals.total,
            
            // Payment
            paymentStatus: payment.status,
            paymentMethod: payment.methods.map(pm => {
                if (typeof pm === 'string') {
                    return pm;
                } else if (pm.method) {
                    return `${pm.method}: $${pm.amount.toFixed(2)}`;
                }
                return 'Unknown';
            }).join(', '),
            balance: payment.balance || 0,
            
            // Additional info
            notes: invoice.notes || 'N/A',
            website: shop.website || ''
        };
        
        // Use the shared template's printInvoice function
        window.printInvoice(invoiceData);
    }
    
