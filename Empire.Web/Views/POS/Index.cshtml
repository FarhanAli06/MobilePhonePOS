        $('#inventoryCartItems').show();
        const container = $('#inventoryCartItemsContainer');
        container.empty();
        
        inventoryItems.forEach(function(item, index) {
            // Find the actual cart index
            const cartIndex = cart.findIndex(c => c.Id === item.Id);
            
