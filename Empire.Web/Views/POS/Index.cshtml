    function addInventoryItemToCart(itemId, inventoryId, name, description, sku, costPrice) {
        costPrice = parseFloat(costPrice) || 0;
        const qtyInput = $('#qty_' + itemId);
        const priceInput = $('#price_' + itemId);
        
        const quantity = parseInt(qtyInput.val());
        const price = parseFloat(priceInput.val());
        const maxQty = parseInt(qtyInput.attr('data-max'));
        
        // Validation
        if (!quantity || quantity < 1) {
            alert('Please enter a valid quantity (minimum 1)');
            qtyInput.focus();
            return;
        }
        
        if (quantity > maxQty) {
            alert('Quantity cannot exceed available stock (' + maxQty + ')');
            qtyInput.focus();
            return;
        }
        
        if (!price || price < 0) {
            alert('Please enter a valid price (minimum 0)');
            priceInput.focus();
            return;
        }
        
        // Add to cart
        addToCart({
            Id: 'inventory_' + inventoryId,
            Name: name,
            Description: description,
            Price: price,
            OriginalPrice: price,
            Cost: costPrice,
            Type: 'Inventory',
            quantity: quantity,
            SKU: sku,
            Stock: maxQty,
            IsTaxable: true
        });
        
        // Show success message
        alert('Item added to cart successfully!');
        
        // Reset quantity to 1
        qtyInput.val(1);
        
        // Refresh inventory cart display
        displayInventoryCartItems();
    }
    
