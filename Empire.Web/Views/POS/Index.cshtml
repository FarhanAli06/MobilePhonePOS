@section Scripts {
<!-- Include Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    console.log('POS JavaScript loaded - Version 4.0 - Cart Persistence Fix');
    
    // Load cart from localStorage or initialize empty
    let cart = [];
    try {
        const savedCart = localStorage.getItem('pos_cart');
        if (savedCart) {
            cart = JSON.parse(savedCart);
            console.log('Loaded cart from localStorage:', cart.length, 'items');
        }
    } catch (e) {
        console.error('Error loading cart from localStorage:', e);
        cart = [];
    }

    // ── Load any repairs added via "Add to Cart" from the Repairs page ──────
    try {
        const pendingRepairs = JSON.parse(sessionStorage.getItem('pendingRepairCart') || '[]');
        if (pendingRepairs.length > 0) {
            console.log('Found', pendingRepairs.length, 'pending repair(s) from Repairs page');
            pendingRepairs.forEach(function(r) {
                // Check if already in cart (avoid duplicates)
                const alreadyIn = cart.some(function(c) {
                    return c.Type === 'Repair' && c.ReferenceId === r.repairId;
                });
                if (!alreadyIn) {
                    cart.push({
                        Id: 'rep_' + r.repairId,
                        Type: 'Repair',
                        Name: 'Repair #' + r.repairNumber + ' - ' + r.customerName,
                        Description: r.description || ('Repair #' + r.repairNumber),
                        Price: parseFloat(r.unitPrice || r.remainingDues || r.cost || 0),
                        OriginalPrice: parseFloat(r.unitPrice || r.remainingDues || r.cost || 0),
                        Cost: parseFloat(r.cost || 0),
                        quantity: 1,
                        ReferenceId: r.repairId,
                        RepairId: r.repairId,
                        Note: '',
                        IsCustomItem: false,
                        IsTaxable: true
                    });
                }
            });
            // Clear the pending queue so items don't get added again on next visit
            sessionStorage.removeItem('pendingRepairCart');
            console.log('Pending repairs loaded into cart, sessionStorage cleared');
        }
    } catch (e) {
        console.error('Error loading pending repairs from sessionStorage:', e);
    }

    // Persist the merged cart (localStorage + sessionStorage repairs) immediately
    try {
        localStorage.setItem('pos_cart', JSON.stringify(cart));
    } catch (e) { /* ignore */ }
    
    let currentFilter = '';
    let lastInvoiceNumber = null;
    let lastSaleData = null;
    let selectedCustomerId = null;
    let allItems = []; // Central storage for all items loaded from database
    let searchTimeout = null; // Timeout for search debouncing

    // Save cart to localStorage
    function saveCartToStorage() {
        try {
            localStorage.setItem('pos_cart', JSON.stringify(cart));
            console.log('Cart saved to localStorage');
