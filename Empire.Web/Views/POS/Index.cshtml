    function addDeviceItemToCart(deviceId) {
        const priceInput = $(`#devicePrice_${deviceId}`);
        const price = parseFloat(priceInput.val());
        
        if (isNaN(price) || price < 0) {
            alert('Please enter a valid price');
            return;
        }
        
        // Find device in results
        const resultsContainer = $('#deviceResults');
        const deviceCard = resultsContainer.find(`input#devicePrice_${deviceId}`).closest('.card');
        
        // Extract device info from card
        const deviceName = deviceCard.find('h6').text();
        const deviceInfo = deviceCard.find('.small').first().text();
        
        // Check if already in cart
        const existingIndex = cart.findIndex(item => item.Id === `device_${deviceId}` && item.Type === 'Device');
        
        if (existingIndex >= 0) {
            alert('This device is already in the cart');
            return;
        }
        
        // Retrieve stored device data
        const deviceData = deviceDataMap[deviceId] || {};

        // Add to cart
        const deviceItem = {
            Id: `device_${deviceId}`,
            Type: 'Device',
            Name: deviceData.name || deviceName,
            Description: deviceInfo,
            Price: price,
            OriginalPrice: price,
            quantity: 1,
            ReferenceId: deviceId,
            IsTaxable: true,
            Brand: deviceData.brandName || 'N/A',
            ModelName: deviceData.modelName || 'N/A',
            Storage: deviceData.storage || 'N/A',
            Imei: deviceData.imei || 'N/A',
            Network: deviceData.network || 'N/A',
            Condition: deviceData.condition || 'N/A',
            BuyingPrice: deviceData.buyingPrice || 0
        };
        
        cart.push(deviceItem);
        updateCart();
        saveCartToStorage();
        
        alert('Device added to cart!');
        
        // Refresh device cart display
        displayDeviceCartItems();
    }
    
    function displayDeviceCartItems() {
        const deviceItems = cart.filter(item => item.Type === 'Device');
        
        if (deviceItems.length === 0) {
            $('#deviceCartItems').hide();
            return;
        }
        
        $('#deviceCartItems').show();
        const container = $('#deviceCartItemsContainer');
        container.empty();
        
        deviceItems.forEach(function(item, index) {
            const actualIndex = cart.findIndex(cartItem => cartItem.Id === item.Id);
            const card = $(`
                <div class="card mb-2" style="border: 1px solid #dee2e6;">
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>${item.Name}</strong><br>
                                <small class="text-muted">
                                    <strong>Brand:</strong> ${item.Brand || 'N/A'} |
                                    <strong>Model:</strong> ${item.ModelName || 'N/A'} |
                                    <strong>Storage:</strong> ${item.Storage || 'N/A'} GB
                                </small><br>
                                <small class="text-muted">
                                    <strong>IMEI:</strong> ${item.Imei || 'N/A'} |
                                    <strong>Network:</strong> ${item.Network || 'N/A'}
                                </small><br>
                                <span class="text-success">$${(item.Price || 0).toFixed(2)}</span>
                            </div>
                            <button class="btn btn-danger btn-sm" onclick="removeDeviceFromCart(${actualIndex})">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `);
            
            container.append(card);
        });
    }
    
    function removeDeviceFromCart(index) {
        cart.splice(index, 1);
        updateCart();
        saveCartToStorage();
        displayDeviceCartItems();
    }
    
    function clearDeviceFilters() {
        $('#deviceBrand').val('');
        $('#deviceCategory').val('');
        $('#deviceModel').val('');
        $('#deviceNetwork').val('');
        $('#deviceGB').val('');
        $('#deviceScratches').val('');
        $('#deviceIMEI').val('');
        
        // Clear models dropdown
        $('#deviceModel').empty();
        $('#deviceModel').append('<option value="">All Models</option>');
        
        // Clear results
        $('#deviceResults').html(`
            <div class="text-center text-muted py-4">
                <i class="fas fa-mobile-alt" style="font-size: 48px; opacity: 0.3;"></i>
                <p class="mt-2">Select filters and click "Search Devices" to find items</p>
            </div>
        `);
        
        // Clear cart display
        displayDeviceCartItems();
    }
    
    // Search Results Modal Functions
    function showSearchResultsModal(results, searchType) {
        const modalBody = $('#searchResultsModalBody');
        modalBody.empty();
        
        if (!results || results.length === 0) {
            modalBody.html('<p class="text-center text-muted">No results found</p>');
        } else {
            const resultHtml = results.map(item => createSearchResultCard(item, searchType)).join('');
            modalBody.html(resultHtml);
        }
        
        $('#searchResultsModal').modal('show');
    }
    
    function createSearchResultCard(item, type) {
        let cardHtml = '';
        
        if (type === 'Device') {
            cardHtml = `
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="mb-1">${item.Name || 'Device'}</h6>
                                <p class="mb-1 small text-muted">
                                    <strong>IMEI:</strong> ${item.IMEI || 'N/A'} | 
                                    <strong>Model:</strong> ${item.Model || 'N/A'} |
                                    <strong>Condition:</strong> ${item.Condition || 'N/A'}
                                </p>
                                <p class="mb-0"><strong class="text-success">$${(item.Price || 0).toFixed(2)}</strong></p>
                            </div>
                            <div class="col-md-4 text-end">
                                <button class="btn btn-primary btn-sm" onclick="addSearchResultToCart('${item.Id}', 'Device')">
                                    <i class="fas fa-cart-plus me-1"></i>Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        } else if (type === 'Repair') {
            cardHtml = `
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="mb-1">Repair #${item.RepairNumber || item.Id}</h6>
                                <p class="mb-1 small text-muted">
                                    <strong>Device:</strong> ${item.DeviceName || 'N/A'} |
                                    <strong>Issue:</strong> ${item.Issue || 'N/A'}
                                </p>
                                <p class="mb-0"><strong class="text-success">$${(item.Price || item.Cost || 0).toFixed(2)}</strong></p>
                            </div>
                            <div class="col-md-4 text-end">
                                <button class="btn btn-primary btn-sm" onclick="addSearchResultToCart('${item.Id}', 'Repair')">
                                    <i class="fas fa-cart-plus me-1"></i>Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        } else { // Inventory
            cardHtml = `
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="mb-1">${item.Name || 'Item'}</h6>
                                <p class="mb-1 small text-muted">
                                    <strong>SKU:</strong> ${item.SKU || 'N/A'} |
                                    <strong>Brand:</strong> ${item.Brand || 'N/A'} |
                                    <strong>Stock:</strong> ${item.Stock || 0}
                                </p>
                                <p class="mb-0"><strong class="text-success">$${(item.Price || 0).toFixed(2)}</strong></p>
                            </div>
                            <div class="col-md-4 text-end">
                                <button class="btn btn-primary btn-sm" onclick="addSearchResultToCart('${item.Id}', 'Inventory')">
                                    <i class="fas fa-cart-plus me-1"></i>Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }
        
        return cardHtml;
    }
    
    function addSearchResultToCart(itemId, itemType) {
        // Find the item in the products array or fetch it
        $.ajax({
            url: '@Url.Action("SearchItemsTab", "POS")',
            type: 'GET',
            data: { query: itemId, type: itemType },
            success: function(response) {
                if (response.success && response.data && response.data.length > 0) {
                    const product = response.data[0];
                    addToCart(product);
                    $('#searchResultsModal').modal('hide');
                    alert('Item added to cart!');
                } else {
                    alert('Error: Item not found');
                }
            },
            error: function(xhr) {
                console.error('Error adding item:', xhr);
                alert('Error adding item to cart');
            }
        });
    }
    
    // ─── Repair Search (POS Repair Tab) ───────────────────────────────────────
    var _repairSearchTimer;
    var _repairSearchUrl = '@Url.Action("GetRepairsJson", "Repairs")';
    var _repairEditUrl   = '@Url.Action("Edit",          "Repairs")';
    var _repairViewUrl   = '@Url.Action("Details",       "Repairs")';
    var _repairDeleteUrl = '@Url.Action("DeleteRepairJson", "Repairs")';
    var _repairRowsCache = {};   // id -> repair object, populated after each search

    // Delegated click handler — avoids inline JSON.stringify breakage
    $(document).on('click', '.pos-add-repair-btn', function() {
        var id = parseInt($(this).data('repair-id'));
        var r  = _repairRowsCache[id];
        if (r) posAddRepairToCart(r);
    });

    // Wire up the search input
    $(document).on('input', '#repairSearchInput', function() {
        clearTimeout(_repairSearchTimer);
        var term = $(this).val();
        _repairSearchTimer = setTimeout(function() { searchRepairOrders(term); }, 350);
    });

    function clearRepairSearch() {
        $('#repairSearchInput').val('');
        searchRepairOrders('');
    }

    function searchRepairOrders(term) {
        $('#repairResultsArea').html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin"></i> Loading...</div>');
        $.ajax({
            url: _repairSearchUrl,
            method: 'GET',
            data: { searchTerm: term },
            success: function(res) {
                if (!res.success) {
                    $('#repairResultsArea').html('<div class="alert alert-danger">'+res.message+'</div>');
                    return;
                }
                var rows = res.data;
                // Cache rows by id for the delegated click handler
                _repairRowsCache = {};
                if (rows) rows.forEach(function(r){ _repairRowsCache[r.id] = r; });
                if (!rows || rows.length === 0) {
                    $('#repairResultsArea').html('<div class="text-center text-muted py-5"><i class="fas fa-tools" style="font-size:48px;opacity:.3"></i><p class="mt-2">No repair orders found</p></div>');
                    return;
                }
                var html = '<div class="table-responsive"><table class="table table-hover table-sm align-middle">';
                html += '<thead class="table-light"><tr>';
                html += '<th>Repair #</th><th>Customer</th><th>Device</th><th>Description</th>';
                html += '<th>Status</th><th>Payment</th><th class="text-end">Cost</th><th class="text-end">Balance</th><th>Date</th><th>Actions</th>';
                html += '</tr></thead><tbody>';
                $.each(rows, function(i, r) {
                    var statusClass = r.status === 'Completed' ? 'success' : r.status === 'InProgress' ? 'info' : r.status === 'Cancelled' ? 'danger' : 'warning';
                    var payClass    = r.paymentStatus === 'Paid' ? 'success' : r.paymentStatus === 'Partial' ? 'warning' : 'danger';
                    html += '<tr>';
                    html += '<td><span class="badge bg-primary font-monospace">'+(r.repairNumber||'—')+'</span></td>';
                    html += '<td><strong>'+(r.customerName||'—')+'</strong><br><small class="text-muted">'+(r.customerPhone||'')+'</small></td>';
                    html += '<td><small>'+(r.deviceBrand||'')+(r.deviceModel?' / '+r.deviceModel:'')+'</small></td>';
                    html += '<td><small class="text-truncate d-inline-block" style="max-width:160px" title="'+(r.description||'')+'">'+(r.description||'—')+'</small></td>';
                    html += '<td><span class="badge bg-'+statusClass+'">'+r.status+'</span></td>';
                    html += '<td><span class="badge bg-'+payClass+'">'+r.paymentStatus+'</span></td>';
                    html += '<td class="text-end">$'+parseFloat(r.cost||0).toFixed(2)+'</td>';
                    html += '<td class="text-end">'+(r.remainingDues>0?'<span class="text-danger fw-bold">$'+parseFloat(r.remainingDues).toFixed(2)+'</span>':'<span class="text-success">—</span>')+'</td>';
                    html += '<td><small>'+r.createdDate+'</small></td>';
                    html += '<td><div class="d-flex gap-1 align-items-center">';
                    html += '<button class="btn btn-success btn-sm px-2 py-1 fw-semibold pos-add-repair-btn" title="Add to Cart" data-repair-id="'+r.id+'"><i class="fas fa-cart-plus me-1"></i>Add</button>';
                    html += '<div class="btn-group btn-group-sm">';
                    html += '<a href="'+_repairViewUrl+'/'+r.id+'" target="_blank" class="btn btn-outline-secondary" title="View"><i class="fas fa-eye"></i></a>';
                    html += '<a href="'+_repairEditUrl+'/'+r.id+'" target="_blank" class="btn btn-outline-primary" title="Edit"><i class="fas fa-edit"></i></a>';
                    html += '<button class="btn btn-outline-danger" title="Delete" onclick="posDeleteRepair('+r.id+',this)"><i class="fas fa-trash"></i></button>';
                    html += '</div></div></td>';
                    html += '</tr>';
                });
                html += '</tbody></table></div>';
                $('#repairResultsArea').html(html);
            },
            error: function() {
                $('#repairResultsArea').html('<div class="alert alert-danger">Failed to load repairs. Please try again.</div>');
            }
        });
    }

    function posAddRepairToCart(r) {
        // Build a unique ID for this repair cart item
        var cartId = 'rep_' + r.id;
        // Check if already in cart
        var existing = cart.find(function(c) { return c.Id === cartId; });
        if (existing) {
            alert('Repair #' + (r.repairNumber || r.id) + ' is already in the cart.');
            return;
        }
        var repairName = 'Repair #' + (r.repairNumber || r.id);
        if (r.customerName) repairName += ' – ' + r.customerName;
        var desc = '';
        if (r.deviceBrand) desc += r.deviceBrand;
        if (r.deviceModel) desc += ' ' + r.deviceModel;
        if (r.description) desc += (desc ? ' | ' : '') + r.description;

        var item = {
            Id: cartId,
            Type: 'Repair',
            Name: repairName,
            Description: desc,
            Price: parseFloat(r.cost || 0),
            OriginalPrice: parseFloat(r.cost || 0),
            Cost: parseFloat(r.cost || 0),
            quantity: 1,
            ReferenceId: r.id,
            RepairId: r.id,
            RepairNumber: r.repairNumber || '',
            Note: '',
            IsCustomItem: false,
            IsTaxable: true
        };
        cart.push(item);
        updateCart();
        saveCartToStorage();

        // Visual feedback on the button
        var $btn = $('button[onclick*="posAddRepairToCart"][onclick*="\"id\":' + r.id + '"]');
        if ($btn.length === 0) {
            // Try alternative selector
            $btn = $('button[onclick*="posAddRepairToCart"]').filter(function() {
                return $(this).attr('onclick') && $(this).attr('onclick').indexOf('"id":' + r.id) !== -1;
            });
        }
        $btn.removeClass('btn-success').addClass('btn-secondary').prop('disabled', true).html('<i class="fas fa-check me-1"></i>Added');

        // Show toast notification
        var toastHtml = '<div class="toast align-items-center text-white bg-success border-0 position-fixed" style="bottom:20px;right:20px;z-index:9999;min-width:260px" role="alert">' +
            '<div class="d-flex"><div class="toast-body"><i class="fas fa-cart-plus me-2"></i>' + repairName + ' added to cart</div>' +
            '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>';
        var $toast = $(toastHtml).appendTo('body');
        var bsToast = new bootstrap.Toast($toast[0], { delay: 3000 });
        bsToast.show();
        $toast[0].addEventListener('hidden.bs.toast', function() { $toast.remove(); });
    }
    function posDeleteRepair(id, btn) {
        if (!confirm('Delete this repair? This cannot be undone.')) return;
        $(btn).prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
        $.ajax({
            url: _repairDeleteUrl,
            method: 'POST',
            data: { id: id },
            success: function(res) {
                if (res.success) {
                    $(btn).closest('tr').fadeOut(300, function() { $(this).remove(); });
                } else {
                    alert(res.message || 'Delete failed');
                    $(btn).prop('disabled', false).html('<i class="fas fa-trash"></i>');
                }
            },
            error: function() {
                alert('Delete request failed');
                $(btn).prop('disabled', false).html('<i class="fas fa-trash"></i>');
            }
        });
    }
    // ─────────────────────────────────────────────────────────────────────────

    // Listen for messages from iframes when items are created
    window.addEventListener('message', function(event) {
        if (event.data.type === 'itemCreated') {
            // Close the modal
            $('.modal').modal('hide');
            // Show success message
            alert(event.data.message || 'Item created successfully!');
            // Refresh the entire page to show the new item
            location.reload();
        }
    });
</script>

}
