@{
    ViewData["Title"] = "Point of Sale";
}

<!-- Include Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<style>
    .pos-container {
        height: calc(100vh - 60px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    
    .pos-search-section {
        background: #f8f9fa;
        padding: 8px 16px;
        border-bottom: 2px solid #dee2e6;
        flex-shrink: 0;
    }
    
    .pos-main-content {
        display: flex;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }
    
    .pos-products-section {
        flex: 1;
        padding: 16px;
        overflow-y: auto;
        border-right: 3px solid #0d6efd;
        position: relative;
        height: 100%;
    }
    
    .pos-cart-section {
        width: 460px;
        min-width: 380px;
        display: flex;
        flex-direction: column;
        background: #f8f9fa;
        box-shadow: -3px 0 10px rgba(0,0,0,0.07);
        height: 100%;
        overflow: hidden;
    }
    
    .cart-header {
        padding: 20px;
        border-bottom: 2px solid #dee2e6;
    }
    
    .cart-items {
        flex: 1;
        overflow-y: auto;
        padding: 10px;
        min-height: 80px;
        background: #fff;
    }
    
    .cart-item {
        background: white;
        padding: 15px;
        margin-bottom: 10px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
        position: relative;
    }
    
    .cart-item-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 10px;
    }
    
    .cart-item-name {
        font-weight: 600;
        font-size: 14px;
        flex: 1;
    }
    
    .cart-item-remove {
        color: #dc3545;
        cursor: pointer;
        font-size: 18px;
        margin-left: 10px;
        transition: all 0.2s;
    }
    
    .cart-item-remove:hover {
        color: #a71d2a;
        transform: scale(1.2);
    }
    
    .cart-item-details {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
    }
    
    .cart-item-quantity {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .qty-btn {
        width: 30px;
        height: 30px;
        border: 1px solid #dee2e6;
        background: white;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
    }
    
    .qty-btn:hover {
        background: #e9ecef;
    }
    
    .cart-item-price {
        font-size: 16px;
        font-weight: 600;
        color: #28a745;
    }
    
    .price-input {
        width: 100px;
        text-align: right;
        font-weight: 600;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 5px;
    }
    
    .price-input:focus {
        outline: none;
        border-color: #007bff;
    }
    
    .cart-summary {
        padding: 12px 16px;/* farhan */
        border-top: 2px solid #dee2e6;
        background: white;
        overflow-y: auto;
        flex-shrink: 0;
        height: 50%;
    }
    
    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 14px;
    }
    
    .summary-row.total {
        font-size: 20px;
        font-weight: bold;
        color: #28a745;
        padding-top: 10px;
        border-top: 2px solid #dee2e6;
    }
    
    .summary-row.balance {
        font-size: 16px;
        font-weight: bold;
        color: #dc3545;
        padding-top: 5px;
    }
    
    .product-card {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 15px;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .product-card:hover {
        border-color: #007bff;
        box-shadow: 0 2px 8px rgba(0,123,255,0.2);
    }
    
    .product-card-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 10px;
    }
    
    .product-name {
        font-weight: 600;
        font-size: 16px;
        color: #212529;
    }
    
    .product-type-badge {
        font-size: 11px;
        padding: 4px 8px;
    }
    
    .product-description {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 10px;
    }
    
    .product-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .product-price {
        font-size: 18px;
        font-weight: 700;
        color: #28a745;
    }
    
    .product-stock {
        font-size: 12px;
        color: #6c757d;
    }
    
    .filter-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
        flex-wrap: wrap;
    }
    
    .filter-tab {
        padding: 8px 16px;
        border: 1px solid #dee2e6;
        background: white;
        border-radius: 20px;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s;
    }
    
    .filter-tab:hover {
        background: #e9ecef;
    }
    
    .filter-tab.active {
        background: #007bff;
        color: white;
        border-color: #007bff;
    }
    
    .add-new-btns {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
    }
    
    .add-new-btn {
        flex: 1;
        padding: 10px;
        border: 2px dashed #007bff;
        background: #f8f9fa;
        border-radius: 8px;
        cursor: pointer;
        text-align: center;
        transition: all 0.2s;
        color: #007bff;
        font-weight: 600;
    }
    
    .add-new-btn:hover {
        background: #e7f1ff;
        border-color: #0056b3;
    }
    
    .empty-cart {
        text-align: center;
        padding: 40px 20px;
        color: #6c757d;
    }
    
    .empty-cart i {
        font-size: 48px;
        margin-bottom: 15px;
        opacity: 0.5;
    }
    
    .no-products {
        text-align: center;
        padding: 40px 20px;
        color: #6c757d;
    }
    
    /* Select2 customization */
    .select2-container--bootstrap-5 .select2-selection {
        min-height: 46px;
        padding: 8px;
    }
    
    .payment-amount-input {
        display: none;
    }
    
    .payment-amount-input.show {
        display: block;
    }
    
    /* Invoice styles */
    #invoicePrintArea {
        font-family: Arial, sans-serif;
        padding: 20px;
    }
    
    #invoicePrintArea .invoice-header {
        text-align: center;
        margin-bottom: 30px;
        border-bottom: 2px solid #000;
        padding-bottom: 20px;
    }
    
    #invoicePrintArea .invoice-header h1 {
        margin: 0;
        font-size: 28px;
    }
    
    #invoicePrintArea .invoice-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
    }
    
    #invoicePrintArea .invoice-info div {
        flex: 1;
    }
    
    #invoicePrintArea table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
    }
    
    #invoicePrintArea th,
    #invoicePrintArea td {
        padding: 10px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }
    
    #invoicePrintArea th {
        background-color: #f8f9fa;
        font-weight: bold;
    }
    
    #invoicePrintArea .text-right {
        text-align: right;
    }
    
    #invoicePrintArea .totals {
        margin-top: 20px;
        text-align: right;
    }
    
    #invoicePrintArea .totals div {
        margin: 5px 0;
    }
    
    #invoicePrintArea .total-row {
        font-size: 18px;
        font-weight: bold;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 2px solid #000;
    }
    
    #invoicePrintArea .footer {
        margin-top: 40px;
        text-align: center;
        font-size: 12px;
        color: #666;
    }
    
    /* Payment Method Icon Cards */
    .pos-pm-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
    }
    .pos-pm-card {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 6px 4px;
        text-align: center;
        cursor: pointer;
        transition: all 0.15s;
        background: #fff;
    }
    .pos-pm-card:hover {
        border-color: #0d6efd;
        background: #f0f6ff;
    }
    .pos-pm-card.active {
        border-color: #0d6efd;
        background: #e7f1ff;
        box-shadow: 0 0 0 2px rgba(13,110,253,.2);
    }
    .pos-pm-icon { font-size: 18px; line-height: 1.2; }
    .pos-pm-label { font-size: 10px; font-weight: 600; color: #333; margin-top: 2px; }

    /* Sticky Complete Sale button */
    .pos-action-sticky {
        position: sticky;
        bottom: 0;
        background: #fff;
        padding: 8px 0 4px;
        border-top: 1px solid #dee2e6;
        z-index: 10;
    }

    /* Payment history rows */
    .pos-payment-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 5px 8px;
        margin-bottom: 4px;
        font-size: 12px;
    }
    .pos-payment-row .remove-pm { cursor: pointer; color: #dc3545; font-size: 14px; }

    /* Multi-payment improvements */
    .pos-payment-add-row {
        display: flex;
        gap: 6px;
        align-items: center;
    }
    .pos-payment-add-row .input-group {
        flex: 1;
    }
    .pos-payment-add-row .btn-add-payment {
        white-space: nowrap;
        font-size: 0.78rem;
        padding: 5px 10px;
    }
    .pos-payment-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #e8f5e9;
        border: 1px solid #a5d6a7;
        border-radius: 6px;
        padding: 6px 10px;
        margin-bottom: 4px;
        font-size: 12px;
    }
    .pos-payment-row .pm-method { font-weight: 700; color: #1b5e20; }
    .pos-payment-row .pm-amount { font-weight: 700; color: #2e7d32; font-size: 13px; }
    .pos-payment-row .remove-pm { cursor: pointer; color: #dc3545; font-size: 15px; margin-left: 6px; }
    .pos-payments-total-bar {
        background: #e3f2fd;
        border: 1px solid #90caf9;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 12px;
        margin-top: 4px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .pos-payments-total-bar .paid-label { color: #1565c0; font-weight: 600; }
    .pos-payments-total-bar .paid-amount { color: #0d47a1; font-weight: 700; font-size: 13px; }
    .cart-header {
        padding: 14px 16px;
        border-bottom: 2px solid #0d6efd;
        background: linear-gradient(135deg, #0d6efd08 0%, #fff 100%);
    }

    /* Print styles */
    @@media print {
        .no-print {
            display: none !important;
        }
        
        #invoicePrintArea {
            display: block !important;
        }
        
        body > *:not(#invoicePrintArea) {
            display: none !important;
        }
    }
</style>

<div class="pos-container">
    <!-- Search Section (compact) -->
    <div class="pos-search-section">
        <div class="input-group input-group-sm" style="max-width:600px;">
            <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0" id="searchInput"
                   placeholder="Search by name, IMEI, repair #, invoice #..." autocomplete="off"
                   style="box-shadow:none;">
        </div>
    </div>

    <!-- Main Content -->
    <div class="pos-main-content">
        <!-- Products Section -->
        <div class="pos-products-section">
            <!-- Add New Buttons -->
            <div class="add-new-btns">
                <div class="add-new-btn" onclick="showAddRepairModal()">
                    <i class="fas fa-wrench me-2"></i>New Repair
                </div>
                <div class="add-new-btn" onclick="showAddDeviceModal()">
                    <i class="fas fa-mobile-alt me-2"></i>New Device
                </div>
                <div class="add-new-btn" onclick="showAddInventoryModal()">
                    <i class="fas fa-box me-2"></i>New Inventory
                </div>
            </div>
            
            <div class="filter-tabs">
                <button class="filter-tab active" data-type="" onclick="filterByType('')">
                    <i class="fas fa-th me-1"></i> All Items
                </button>
                <button class="filter-tab" data-type="device" onclick="filterByType('device')">
                    <i class="fas fa-mobile-alt me-1"></i> Devices
                </button>
                <button class="filter-tab" data-type="inventory" onclick="filterByType('inventory')">
                    <i class="fas fa-box me-1"></i> Inventory
                </button>
                <button class="filter-tab" data-type="repair" onclick="filterByType('repair')">
                    <i class="fas fa-wrench me-1"></i> Repairs
                </button>
                <button class="filter-tab" data-type="custom" onclick="showCustomSaleTab()">
                    <i class="fas fa-plus me-1"></i> Custom Sale
                </button>
                <button class="filter-tab" data-type="search" onclick="showSearchTab()">
                    <i class="fas fa-search me-1"></i> Search
                </button>
            </div>

            <div id="productsContainer">
                <div class="no-products">
                    <i class="fas fa-search"></i>
                    <p>Search for products to add to cart</p>
                </div>
            </div>
            
            <!-- Custom Sale Tab Content -->
            <div id="customSaleContainer" style="display: none; padding: 20px; background: white; border-radius: 8px;">
                <h4 class="mb-4">Add Custom Sale Item</h4>
                
                <!-- Quick Item Suggestions with Price Options -->
                <div class="mb-3">
                    <label class="form-label">Quick Items - Click a price to add</label>
                    
                    <!-- Screen Protector -->
                    <div class="mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span style="min-width: 150px; font-weight: 500;">
                                <i class="fas fa-mobile-alt me-1 text-primary"></i>Screen Protector:
                            </span>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Screen Protector', 10.00)">$10</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Screen Protector', 15.00)">$15</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Screen Protector', 20.00)">$20</button>
                        </div>
                    </div>
                    
                    <!-- Back Case -->
                    <div class="mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span style="min-width: 150px; font-weight: 500;">
                                <i class="fas fa-shield-alt me-1 text-primary"></i>Back Case:
                            </span>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Back Case', 10.00)">$10</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Back Case', 15.00)">$15</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Back Case', 20.00)">$20</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Back Case', 25.00)">$25</button>
                        </div>
                    </div>
                    
                    <!-- Charging Cable -->
                    <div class="mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span style="min-width: 150px; font-weight: 500;">
                                <i class="fas fa-plug me-1 text-primary"></i>Charging Cable:
                            </span>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Charging Cable', 10.00)">$10</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Charging Cable', 15.00)">$15</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Charging Cable', 20.00)">$20</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Charging Cable', 25.00)">$25</button>
                        </div>
                    </div>
                    
                    <!-- Charger -->
                    <div class="mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span style="min-width: 150px; font-weight: 500;">
                                <i class="fas fa-charging-station me-1 text-primary"></i>Charger:
                            </span>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Charger', 10.00)">$10</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Charger', 15.00)">$15</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Charger', 20.00)">$20</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Charger', 25.00)">$25</button>
                        </div>
                    </div>
                    
                    <!-- Cable with Charger (NEW) -->
                    <div class="mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span style="min-width: 150px; font-weight: 500;">
                                <i class="fas fa-box me-1 text-primary"></i>Cable + Charger:
                            </span>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Cable with Charger', 20.00)">$20</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Cable with Charger', 25.00)">$25</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Cable with Charger', 30.00)">$30</button>
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="fillCustomItem('Cable with Charger', 35.00)">$35</button>
                        </div>
                    </div>
                </div>
                
                <!-- Single Line Form -->
                <div class="row g-2 mb-3">
                    <div class="col-md-3">
                        <label for="customItemName" class="form-label small">Item Name *</label>
                        <input type="text" class="form-control form-control-sm" id="customItemName" placeholder="Item name" required>
                    </div>
                    <div class="col-md-1">
                        <label for="customItemQuantity" class="form-label small">Qty *</label>
                        <input type="number" class="form-control form-control-sm" id="customItemQuantity" value="1" min="1" required>
                    </div>
                    <div class="col-md-2">
                        <label for="customItemCost" class="form-label small">Cost</label>
                        <input type="number" class="form-control form-control-sm" id="customItemCost" step="0.01" min="0" value="0.00" placeholder="0.00">
                    </div>
                    <div class="col-md-2">
                        <label for="customItemPrice" class="form-label small">Price *</label>
                        <input type="number" class="form-control form-control-sm" id="customItemPrice" step="0.01" min="0" value="0.00" placeholder="0.00" required>
                    </div>
                    <div class="col-md-3">
                        <label for="customItemNote" class="form-label small">Note</label>
                        <input type="text" class="form-control form-control-sm" id="customItemNote" placeholder="Optional note">
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small">&nbsp;</label>
                        <button class="btn btn-primary btn-sm w-100" onclick="addCustomItemToCart()">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Added Custom Items Display -->
                <div id="customItemsList" style="display: none;">
                    <h6 class="mb-2">Added Custom Items:</h6>
                    <div id="customItemsContainer" class="mb-3"></div>
                </div>
            </div>
            
            <!-- Inventory Tab Content -->
            <div id="inventoryContainer" style="display: none; padding: 20px; background: white; border-radius: 8px;">
                <h4 class="mb-4"><i class="fas fa-box me-2"></i>Search Inventory</h4>
                
                <!-- Inventory Search Filters -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label for="inventoryBrand" class="form-label small mb-1">Brand</label>
                        <select class="form-select form-select-sm" id="inventoryBrand" onchange="onInventoryBrandChange()">
                            <option value="">All Brands</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="inventoryDeviceCategory" class="form-label small mb-1">Device Category</label>
                        <select class="form-select form-select-sm" id="inventoryDeviceCategory" onchange="onInventoryDeviceCategoryChange()">
                            <option value="">All Device Categories</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="inventoryModel" class="form-label small mb-1">Model</label>
                        <select class="form-select form-select-sm" id="inventoryModel">
                            <option value="">All Models</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="inventoryCategory" class="form-label small mb-1">Inventory Category</label>
                        <select class="form-select form-select-sm" id="inventoryCategory">
                            <option value="">All Categories</option>
                        </select>
                    </div>
                </div>
                
                <div class="row mb-4">
                    <div class="col-md-12">
                        <button class="btn btn-primary btn-sm" onclick="searchInventoryItems()">
                            <i class="fas fa-search me-2"></i>Search Inventory
                        </button>
                        <button class="btn btn-secondary btn-sm ms-2" onclick="clearInventoryFilters()">
                            <i class="fas fa-times me-2"></i>Clear Filters
                        </button>
                    </div>
                </div>
                
                <!-- Inventory Search Results -->
                <div id="inventoryResults">
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-box" style="font-size: 48px; opacity: 0.3;"></i>
                        <p class="mt-2">Select filters and click "Search Inventory" to find items</p>
                    </div>
                </div>
                
                <!-- Cart Items in Inventory Tab -->
                <div id="inventoryCartItems" style="margin-top: 30px; display: none;">
                    <h5 class="mb-3"><i class="fas fa-shopping-cart me-2"></i>Items in Cart</h5>
                    <div id="inventoryCartItemsContainer"></div>
                </div>
            </div>
            
            <!-- Device Tab Search Container -->
            <div id="deviceSearchContainer" style="display: none; padding: 20px; background: white; border-radius: 8px;">
                <h4 class="mb-4"><i class="fas fa-mobile-alt me-2"></i>Search Devices</h4>
                
                <!-- Device Search Filters -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label for="deviceBrand" class="form-label small mb-1">Brand</label>
                        <select class="form-select form-select-sm" id="deviceBrand" onchange="onDeviceBrandChange()">
                            <option value="">All Brands</option>
                        </select>
                    </div>
                    <div class="col-md-3">
