@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="fas fa-tachometer-alt me-2"></i>
        Dashboard
    </h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <button type="button" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-download me-1"></i>
                Export
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.Error as string))
{
    <div class="alert alert-danger" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @ViewBag.Error
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1">Total Repairs</div>
                        <div class="h5 mb-0 font-weight-bold">@Model.TotalRepairs</div>
                        <div class="text-xs mt-1">@Model.InProgressRepairs in progress</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-tools fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card-success h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1">Completed Repairs</div>
                        <div class="h5 mb-0 font-weight-bold">@Model.CompletedRepairs</div>
                        <div class="text-xs mt-1">This month</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card-info h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1">Inventory Value</div>
                        <div class="h5 mb-0 font-weight-bold">$@Model.TotalInventoryValue.ToString("N0")</div>
                        <div class="text-xs mt-1">Total retail value</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-dollar-sign fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stat-card-warning h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1">Low Stock Items</div>
                        <div class="h5 mb-0 font-weight-bold">@Model.LowStockItemsCount</div>
                        <div class="text-xs mt-1">Need restocking</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-exclamation-triangle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Daily Statistics -->
<div class="row mb-4">
    <div class="col-xl-6 col-md-6 mb-4">
        <div class="card stat-card-success h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1">Daily Sales</div>
                        <div class="h5 mb-0 font-weight-bold">$@Model.DailySales.ToString("N2")</div>
                        <div class="text-xs mt-1">Today's total sales</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-cash-register fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-6 col-md-6 mb-4">
        <div class="card stat-card-info h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1">Daily Profit</div>
                        <div class="h5 mb-0 font-weight-bold">$@Model.DailyProfit.ToString("N2")</div>
                        <div class="text-xs mt-1">Today's total profit</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-chart-line fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.ReadyWaitingParts.Any())
{
    <div class="card border-success mb-4" id="readyWaitingPartsCard">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold"><i class="fas fa-bell me-2"></i>Parts Arrived — Ready to Use</h6>
            <span class="badge bg-light text-success">@Model.ReadyWaitingParts.Count()</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Customer / Device</th><th>Part</th><th>Waiting</th><th>Stock</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var alert in Model.ReadyWaitingParts)
                    {
                        <tr id="waitingPartRow-@alert.RepairPartId">
                            <td><strong>@alert.CustomerName</strong><br><small class="text-muted">@alert.Device · @alert.CustomerPhone</small></td>
                            <td><strong>@alert.PartName</strong><br><small class="text-muted">@alert.SKU</small></td>
                            <td>@alert.DaysWaiting day@(alert.DaysWaiting == 1 ? "" : "s")</td>
                            <td><span class="badge bg-success">@alert.AvailableStock available / @alert.QuantityNeeded needed</span></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-success" onclick="allocateWaitingPart(@alert.RepairPartId, this)">
                                    <i class="fas fa-check me-1"></i>Use Part
                                </button>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Repairs" asp-action="Index">Open Repair</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Recent Activity -->
<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-tools me-2"></i>
                    Recent Repairs
                </h6>
            </div>
            <div class="card-body">
                @if (Model.RecentRepairs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Device</th>
                                    <th>Status</th>
                                    <th>Payment</th>
                                    <th class="text-center" aria-label="Repair details"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var repair in Model.RecentRepairs)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@repair.CustomerName</div>
                                        </td>
                                        <td><small class="text-muted">@repair.DeviceBrand @repair.DeviceModel</small></td>
                                        <td>
                                            @switch (repair.Status)
                                            {
                                                case "InProgress":
                                                    <span class="badge bg-primary">In Progress</span>
                                                    break;
                                                case "Completed":
                                                    <span class="badge bg-success">Complete</span>
                                                    break;
                                                case "Done":
                                                    <span class="badge bg-success">Done</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">@repair.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (repair.PaymentStatus == "Paid")
                                            {
                                                <span class="badge bg-success">Paid</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Unpaid</span>
                                            }
                                        </td>
                                        <td class="text-center text-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    onclick="toggleDashboardRepairNumber(this)"
                                                    aria-label="Show repair number" title="Show repair number">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <span class="dashboard-repair-number d-none ms-2 fw-semibold">@repair.RepairNumber</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-center mt-3">
                        <a asp-controller="Repairs" asp-action="Index" class="btn btn-sm btn-outline-primary">
                            View All Repairs
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-tools fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No recent repairs</p>
                        <a asp-controller="Repairs" asp-action="Create" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i>
                            Create First Repair
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Low Stock Alert
                </h6>
            </div>
            <div class="card-body">
                @if (Model.LowStockItems.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th>Stock</th>
                                    <th>Reorder</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LowStockItems)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @item.Name
                                            @if (!string.IsNullOrEmpty(item.Brand) || !string.IsNullOrEmpty(item.DeviceModel))
                                            {
                                                <br /><small class="text-muted">@item.Brand @item.DeviceModel</small>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@(item.DeviceCategory ?? item.Category ?? "N/A")</span>
                                        </td>
                                        <td>
                                            <span class="text-danger fw-bold">@item.Stock</span>
                                        </td>
                                        <td>
                                            <small class="text-muted">@item.ReorderPoint</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-center mt-3">
                        <a asp-controller="Inventories" asp-action="Index" class="btn btn-sm btn-outline-warning">
                            Manage Inventory
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                        <p class="text-muted">All items are well stocked</p>
                        <a asp-controller="Inventories" asp-action="Index" class="btn btn-success">
                            <i class="fas fa-boxes me-1"></i>
                            View Inventory
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    async function allocateWaitingPart(repairPartId, button) {
        if (!confirm('Use this part for the repair now? The quantity will be deducted from inventory.')) return;
        button.disabled = true;
        try {
            const response = await fetch('/Repairs/AllocateWaitingPart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ repairPartId: repairPartId })
            });
            const result = await response.json();
            if (!result.success) throw new Error(result.message || 'The part could not be assigned.');
            const row = document.getElementById('waitingPartRow-' + repairPartId);
            if (row) row.remove();
            if (!document.querySelector('#readyWaitingPartsCard tbody tr')) {
                document.getElementById('readyWaitingPartsCard')?.remove();
            }
            alert(result.message);
        } catch (error) {
            button.disabled = false;
            alert(error.message || 'The part could not be assigned.');
        }
    }

    function toggleDashboardRepairNumber(button) {
        const number = button.parentElement.querySelector('.dashboard-repair-number');
        const icon = button.querySelector('i');
        const revealing = number.classList.contains('d-none');
        number.classList.toggle('d-none', !revealing);
        icon.className = revealing ? 'fas fa-eye-slash' : 'fas fa-eye';
        button.title = revealing ? 'Hide repair number' : 'Show repair number';
        button.setAttribute('aria-label', button.title);
    }
</script>
